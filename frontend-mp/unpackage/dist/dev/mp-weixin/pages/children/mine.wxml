<view id="{{C}}" change:eS="{{uV.sS}}" eS="{{$eS[C]}}" change:eA="{{uV.sA}}" eA="{{$eA[C]}}" class="{{['container', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="user-card"><view class="user-info"><image class="avatar" src="{{a}}" mode="aspectFill"></image><view class="info-content"><view class="name-line"><text class="nickname">{{b}}</text></view><view class="phone-line"><text class="phone">{{c}}</text></view></view></view><button class="edit-btn" bindtap="{{d}}">编辑资料</button></view><view class="shop-buttons"><button class="shop-btn" bindtap="{{f}}"><image class="btn-icon" src="{{e}}" mode="aspectFit"></image><text class="btn-text">购物车</text></button><button class="shop-btn" bindtap="{{h}}"><image class="btn-icon" src="{{g}}" mode="aspectFit"></image><text class="btn-text">我的订单</text></button><button class="shop-btn" bindtap="{{j}}"><image class="btn-icon" src="{{i}}" mode="aspectFit"></image><text class="btn-text">AI咨询</text></button></view><view wx:if="{{k}}" class="popup"><view class="popup-mask" bindtap="{{l}}"></view><view class="popup-content"><view class="popup-header"><text class="popup-title">编辑资料</text><text class="popup-close" bindtap="{{m}}">×</text></view><view class="popup-body"><view class="form-item"><text class="form-label">头像</text><view class="avatar-upload" bindtap="{{o}}"><image class="avatar-preview" src="{{n}}" mode="aspectFill"></image><text class="upload-text">点击更换</text></view></view><view class="form-item"><text class="form-label">用户名</text><input class="form-input" type="text" placeholder="请输入用户名" value="{{p}}" bindinput="{{q}}"/></view><view class="form-item"><text class="form-label">手机号</text><input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{r}}" bindinput="{{s}}"/></view><view class="form-item"><text class="form-label">修改密码</text><view class="password-inputs"><input class="form-input" type="password" placeholder="请输入原密码" value="{{t}}" bindinput="{{v}}"/><input class="form-input" type="password" placeholder="请输入新密码" value="{{w}}" bindinput="{{x}}"/><input class="form-input" type="password" placeholder="请确认新密码" value="{{y}}" bindinput="{{z}}"/></view></view></view><view class="popup-footer"><button class="cancel-btn" bindtap="{{A}}">取消</button><button class="submit-btn" bindtap="{{B}}">保存</button></view></view></view></view><wxs src="/common/uniView.wxs" module="uV"/>
