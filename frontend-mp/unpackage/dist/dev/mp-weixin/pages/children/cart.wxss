@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
  min-height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
}
.header {
  position: relative;
  background: #4CAF50;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  z-index: 20;
}
.back-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #4CAF50;
  background: #fff;
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  transition: background 0.2s;
  border: 2rpx solid #4CAF50;
}
.back-icon:active {
  background: #e0e0e0;
}
.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  z-index: 1;
  line-height: 104rpx;
  padding-bottom: 4rpx;
}
.edit-btn {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  font-weight: 500;
  transition: background 0.2s, color 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.06);
}
.edit-btn:active {
  background: #e8f5e9;
  color: #388e3c;
}
.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 160rpx; /* 留出底部栏空间 */
}

/* 老人选择区域 */
.elder-selection {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #4CAF50;
  margin-right: 12rpx;
  border-radius: 3rpx;
}
.elder-scroll {
  width: 100%;
  white-space: nowrap;
}
.elder-list {
  display: inline-flex;
  padding: 8rpx 0;
}
.elder-card {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  margin-right: 20rpx;
  transition: all 0.3s ease;
  position: relative;
  min-width: 260rpx;
  border: 2rpx solid transparent;
}
.elder-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.elder-info {
  flex: 1;
}
.elder-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
  display: block;
}
.elder-age {
  font-size: 26rpx;
  color: #666;
  display: block;
}
.select-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  background: #4CAF50;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.3);
}

/* 商品项 */
.cart-item {
  background: #F1FAF5;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.08);
  transition: transform 0.3s ease;
  align-items: flex-start;
}
.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  object-fit: cover;
}
.item-right {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
}
.item-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.price-section {
  display: flex;
  align-items: baseline;
  margin: 12rpx 0 20rpx 0;
}
.price-symbol {
  color: #4CAF50;
  font-size: 24rpx;
  margin-right: 4rpx;
}
.item-price {
  color: #4CAF50;
  font-size: 32rpx;
  font-weight: 700;
}
.action-bar {
  width: 100%;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 16rpx;
}
.quantity-control-float {
  position: absolute;
  top: 64rpx;
  right: 32rpx;
  z-index: 2;
}
.quantity-control {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: transparent;
  border-radius: 40rpx;
  padding: 0;
}
.control-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4CAF50;
  margin: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.08);
  transition: all 0.2s;
}
.control-btn:active {
  background: #E6F9F0;
}
.quantity-input {
  width: 48rpx;
  height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
  border: none;
  margin: 0 4rpx;
  color: #333;
}
.delete-btn {
  color: #666;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: #f5f7fa;
  transition: all 0.2s ease;
/*  
  &:active {
    background: #eef0f5;
  } */
}

/* 底部结算栏 */
.bottom-bar-taobao {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bottom-bar-content {
  width: 100%;
  max-width: 750rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.total-section-taobao {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
}
.total-label-taobao {
  color: #4CAF50;
  font-size: 36rpx;
  font-weight: 800;
  margin-left: 2rpx;
  letter-spacing: 1rpx;
}
.checkout-btn-taobao {
  background: #4CAF50 !important;
  color: #fff !important;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  padding: 0 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 24rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.15);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkout-btn-taobao:active {
  background: #388e3c !important;
}
.checkout-btn-taobao:disabled {
  background: #b6e9d2 !important;
  color: #fff !important;
}

/* 空购物车状态 */
.empty-cart {
  padding-top: 160rpx;
  text-align: center;
}
.empty-image {
    width: 320rpx;
    height: 320rpx;
    opacity: 0.8;
}
.empty-text {
    color: #666;
    font-size: 32rpx;
    margin: 32rpx 0 48rpx;
}
.browse-btn {
    background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
    color: white;
    width: 280rpx;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 44rpx;
    font-size: 32rpx;
    display: inline-block;
    box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.3);
    transition: all 0.3s ease;
    
   /* &:active {
      transform: scale(0.98);
      box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.2);
    } */
}

/* 骨架屏样式 */
.skeleton-container {
  padding: 24rpx;
}
.skeleton-item {
    display: flex;
    margin-bottom: 24rpx;
    background: white;
    border-radius: 20rpx;
    padding: 28rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.skeleton-info {
    flex: 1;
    margin-left: 28rpx;
}
.skeleton-line {
    height: 36rpx;
    background: #f5f5f5;
    border-radius: 8rpx;
    margin-bottom: 24rpx;
    animation: skeleton-blink 1.2s ease-in-out infinite;
  /*  
    &.short {
      width: 60%;
    } */
}
.skeleton-image {
      width: 200rpx;
      height: 200rpx;
      background: #f5f5f5;
      border-radius: 16rpx;
      animation: skeleton-blink 1.2s ease-in-out infinite;
}
@keyframes skeleton-blink {
0% { opacity: 1
}
50% { opacity: 0.5
}
100% { opacity: 1
}
}
