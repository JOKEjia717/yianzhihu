@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
	min-height: 100vh;
	background: #F5F7FA;
	padding: 12rpx;
}

/* 标签切换 */
.tab-container {
	display: flex;
	flex-direction: row;
	margin-bottom: 20rpx;
	background: #FFFFFF;
	border-radius: 16rpx;
	padding: 8rpx;
	box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.tab-item {
	flex: 1;
	text-align: center;
	padding: 16rpx 0;
	border-radius: 12rpx;
	transition: all 0.3s;
}
.tab-item.active {
	background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
}
.tab-text {
	margin: auto;
	font-size: 28rpx;
	color: #666;
	transition: all 0.3s;
}
.tab-item.active .tab-text {
	color: #FFFFFF;
	font-weight: 500;
}

/* 列表模式样式 */
.list-container {
	height: calc(100vh - 100rpx);
}
.search-card {
	margin-bottom: 16rpx;
	padding: 12rpx;
	background: linear-gradient(135deg, rgba(135, 206, 235, 0.15) 0%, rgba(144, 238, 144, 0.15) 100%);
	border-radius: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
	border: 1rpx solid rgba(135, 206, 235, 0.3);
}
.search-header {
	margin-bottom: 12rpx;
	text-align: center;
	padding: 8rpx;
}
.search-title {
	font-size: 28rpx;
	color: #2D3748;
	font-weight: 500;
	line-height: 1;
	text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}
.search-content {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	padding: 0 8rpx;
}
.search-box {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}
.input-group {
	background: rgba(255, 255, 255, 0.9);
	border-radius: 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	height: 56rpx;
	padding: 0 24rpx;
	border: 1rpx solid rgba(135, 206, 235, 0.4);
	box-shadow: 0 2rpx 8rpx rgba(135, 206, 235, 0.1);
	transition: all 0.3s ease;
}
.input-group:active {
	transform: scale(0.98);
	border-color: rgba(135, 206, 235, 0.6);
	background: rgba(255, 255, 255, 0.95);
}
.search-icon {
	width: 24rpx;
	height: 24rpx;
	margin-right: 8rpx;
	opacity: 0.7;
	margin-top: -2rpx;
}
.search-input {
	flex: 1;
	height: 100%;
	font-size: 24rpx;
	color: #333333;
	margin-top: -2rpx;
	text-align: center;
}
.search-input::-webkit-input-placeholder {
	color: #94A3B8;
	font-size: 24rpx;
	text-align: center;
}
.search-input::placeholder {
	color: #94A3B8;
	font-size: 24rpx;
	text-align: center;
}
.search-btn {
	background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
	border-radius: 16rpx;
	height: 56rpx;
	line-height: 56rpx;
	text-align: center;
	margin-top: 8rpx;
	border: none;
	box-shadow: 0 2rpx 8rpx rgba(79, 209, 197, 0.3);
	transition: all 0.3s ease;
}
.search-btn:active {
	transform: scale(0.98);
	opacity: 0.9;
	box-shadow: 0 1rpx 4rpx rgba(79, 209, 197, 0.2);
}
.search-btn-text {
	color: #FFFFFF;
	font-size: 24rpx;
	font-weight: normal;
}
.nursing-list {
	height: calc(100vh - 280rpx);
	padding: 0 20rpx;
}
.nursing-card {
	background-color: #fff;
	border-radius: 20rpx;
	box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
	margin-bottom: 20rpx;
	padding: 0;
	transition: all 0.3s;
}
.nursing-card-content {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 24rpx;
}
.nursing-card-image {
	width: 180rpx;
	height: 180rpx;
	border-radius: 10rpx;
	background: #F8FAFC;
	margin-right: 32rpx;
	object-fit: cover;
	border: 1rpx solid #eee;
}
.nursing-card-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	justify-content: center;
}
.nursing-card-name {
	font-size: 32rpx;
	font-weight: 600;
	color: #2D3748;
	margin-bottom: 16rpx;
}
.nursing-card-address {
	font-size: 28rpx;
	color: #666;
	word-break: break-all;
}

/* 地图模式样式 */
.map-container {
	height: calc(100vh - 130rpx);
	display: flex;
	flex-direction: column;
	background: #F6F7FB;
}
.search-section {
	padding: 20rpx;
	background: #FFFFFF;
	transform: translateY(0);
	transition: transform 0.3s ease;
	z-index: 2;
	position: relative;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.search-section.hidden {
	transform: translateY(-100%);
}
.map {
	width: 100%;
	height: 60vh;
	position: relative;
	z-index: 1;
	transition: all 0.3s ease;
}
.search-result {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 40%;
	background: #FFFFFF;
	border-radius: 20rpx 20rpx 0 0;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
	padding: 20rpx;
	transform: translateY(0);
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.search-result.expanded {
	height: 80%;
}
.search-result::before {
	content: '';
	position: absolute;
	top: 12rpx;
	left: 50%;
	transform: translateX(-50%);
	width: 60rpx;
	height: 6rpx;
	background: #E2E8F0;
	border-radius: 3rpx;
}
.result-list {
	height: 100%;
	padding-top: 20rpx;
}
.loading-container {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	z-index: 2;
}
.loading-circle {
	width: 80rpx;
	height: 80rpx;
	border: 4rpx solid #E2E8F0;
	border-top-color: #4FD1C5;
	border-radius: 50%;
	animation: spin 1s linear infinite;
}
@keyframes spin {
to {
		transform: rotate(360deg);
}
}
.drag-handle {
	width: 60rpx;
	height: 6rpx;
	background: #E2E8F0;
	border-radius: 3rpx;
	margin: 0 auto 20rpx;
	transition: all 0.3s ease;
}
.drag-handle:active {
	width: 80rpx;
	background: #4FD1C5;
}
.loading-text {
	margin-top: 20rpx;
	font-size: 24rpx;
	color: #666666;
	text-align: center;
}
.ripple-effect {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(255, 255, 255, 0.3);
	border-radius: 8rpx;
	transform: scale(0);
	opacity: 1;
	transition: transform 0.6s ease-out, opacity 0.6s ease-out;
}
.search-btn:active .ripple-effect {
	transform: scale(2);
	opacity: 0;
}
@keyframes fadeIn {
from {
		opacity: 0;
		transform: translateY(20rpx);
}
to {
		opacity: 1;
		transform: translateY(0);
}
}
.loading-container {
	animation: fadeIn 0.3s ease-out;
}
.result-item {
	padding: 20rpx;
	margin-bottom: 16rpx;
	background: #FFFFFF;
	border-radius: 12rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.item-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 16rpx;
}
.item-name {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}
.item-distance {
	font-size: 24rpx;
	color: #4FD1C5;
	background: rgba(79, 209, 197, 0.1);
	padding: 4rpx 12rpx;
	border-radius: 20rpx;
}
.info-row {
	display: flex;
	margin-bottom: 8rpx;
}
.info-label {
	font-size: 26rpx;
	color: #666666;
	width: 100rpx;
}
.info-value {
	font-size: 26rpx;
	color: #333333;
	flex: 1;
}
.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 100rpx 0;
}
.empty-text {
	font-size: 28rpx;
	color: #999999;
}
.fade-in {
	animation: fadeIn 0.5s ease-out forwards;
}
