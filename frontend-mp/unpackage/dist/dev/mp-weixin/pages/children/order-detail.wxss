@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
	min-height: 100vh;
	background: #F6F7FB;
}
.header {
	background: #FFFFFF;
	padding: 24rpx;
	text-align: center;
	position: relative;
}
.title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}
.content {
	height: calc(100vh - 88rpx);
	padding: 24rpx;
}
.detail-card {
	background: #FFFFFF;
	border-radius: 12rpx;
	padding: 24rpx;
}
.section {
	margin-bottom: 32rpx;
}
.section-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 20rpx;
}
.info-row {
	display: flex;
	align-items: center;
	margin-bottom: 16rpx;
}
.label {
	font-size: 26rpx;
	color: #666666;
	width: 160rpx;
}
.value {
	font-size: 26rpx;
	color: #333333;
	flex: 1;
}
.value.status {
	font-weight: bold;
}
.value.price {
	color: #FF5722;
	font-weight: bold;
}
.product-list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}
.product-item {
	display: flex;
	align-items: center;
	padding: 16rpx;
	background: #F8F8F8;
	border-radius: 8rpx;
}
.product-image {
	width: 120rpx;
	height: 120rpx;
	border-radius: 8rpx;
	margin-right: 16rpx;
}
.product-info {
	flex: 1;
}
.product-name {
	font-size: 26rpx;
	color: #333333;
	margin-bottom: 8rpx;
}
.product-price {
	display: flex;
	align-items: center;
}
.price-symbol {
	font-size: 24rpx;
	color: #FF5722;
	font-weight: bold;
}
.price-value {
	font-size: 28rpx;
	color: #FF5722;
	font-weight: bold;
	margin-left: 2rpx;
}
.status-pending {
	color: #FF9800;
}
.status-paid {
	color: #2196F3;
}
.status-completed {
	color: #4CAF50;
}
.status-cancelled {
	color: #9E9E9E;
}
.status-refunding {
	color: #FF9800;
}
.status-refunded {
	color: #9E9E9E;
}
