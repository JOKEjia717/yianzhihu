@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
	min-height: 100vh;
	background: #F6F7FB;
	padding: 0;
}

/* 顶部搜索栏样式 */
.search-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 20rpx 24rpx;
	background: #FFFFFF;
	position: -webkit-sticky;
	position: sticky;
	top: 0;
	z-index: 10;
}
.back-icon {
	width: 60rpx;
	display: flex;
	align-items: center;
}
.iconfont {
	font-family: "iconfont";
}
.icon-back {
	font-size: 36rpx;
	color: #333;
}
.search-bar {
	flex: 1;
	height: 64rpx;
	background: #F5F5F5;
	border-radius: 32rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	
	padding: 0 20rpx;
	margin: 0 20rpx;
}
.search-icon {
	font-size: 32rpx;
	color: #999;
	margin-right: 10rpx;
}
.search-placeholder {
	font-size: 28rpx;
	color: #999;
}
.header-actions {
	display: flex;
	align-items: center;
}
.filter-text {
	font-size: 28rpx;
	color: #333;
	margin-right: 20rpx;
}
.cart-icon-container {
	position: relative;
}
.cart-icon {
	font-size: 36rpx;
	color: #333;
}
.badge {
	position: absolute;
	top: -10rpx;
	right: -16rpx;
	background: #FF0000;
	color: #FFFFFF;
	font-size: 20rpx;
	min-width: 32rpx;
	height: 32rpx;
	line-height: 32rpx;
	text-align: center;
	border-radius: 16rpx;
	padding: 0 6rpx;
}

/* 订单状态标签样式 */
.status-tabs {
	display: flex;
	flex-direction: row;
	background: #FFFFFF;
	padding: 20rpx 0;
	border-bottom: 1rpx solid #F0F0F0;
}
.tab-item {
	flex: 1;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 64rpx;
	position: relative;
}
.tab-item text {
	font-size: 28rpx;
	color: #666;
}
.tab-item.active text {
	color: #FF0000;
	font-weight: bold;
}
.tab-item.active:after {
	content: '';
	position: absolute;
	bottom: -6rpx;
	left: 50%;
	transform: translateX(-50%);
	width: 40rpx;
	height: 6rpx;
	background: #FF0000;
	border-radius: 3rpx;
}

/* 操作按钮样式 */
.action-buttons {
	display: flex;
	background: #FFFFFF;
	padding: 16rpx 24rpx;
	border-bottom: 1rpx solid #F0F0F0;
}
.action-btn {
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 20rpx;
	border-radius: 28rpx;
	margin-right: 16rpx;
	border: 1rpx solid #E0E0E0;
}
.action-btn text {
	font-size: 24rpx;
	color: #666;
}
.buy-again-btn {
	background: #FF0000;
	border: none;
}
.buy-again-btn text {
	color: #FFFFFF;
}

/* 订单列表样式 */
.order-list {
	height: calc(100vh - 260rpx);
	padding: 20rpx;
}
.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 0;
}
.empty-icon {
	width: 200rpx;
	height: 200rpx;
	margin-bottom: 20rpx;
}
.empty-text {
	font-size: 28rpx;
	color: #999999;
}

/* 订单卡片样式 */
.order-card {
	background: #FFFFFF;
	border-radius: 16rpx;
	margin-bottom: 24rpx;
	padding: 0;
	overflow: hidden;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 店铺信息样式 */
.shop-info {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx;
	border-bottom: 1rpx solid #F5F5F5;
}
.shop-name {
	display: flex;
	align-items: center;
}
.shop-icon {
	font-size: 32rpx;
	color: #333;
	margin-right: 10rpx;
}
.name-text {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}
.shop-arrow {
	font-size: 24rpx;
	color: #999;
	margin-left: 8rpx;
}
.status-tag {
	font-size: 24rpx;
	color: #999;
}

/* 商品信息样式 */
.product-container {
	margin: auto;
	display: flex;
	flex-direction: row;
	padding: 24rpx;
	border-bottom: 1rpx solid #F5F5F5;
}
.product-image {
	margin-left: 50px;
	width: 160rpx;
	height: 160rpx;
	border-radius: 8rpx;
	background: #F5F5F5;
	margin-right: 20rpx;
}
.product-details {
	flex: 1;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.product-name {
	margin: auto;
	font-size: 28rpx;
	color: #333;
	margin-bottom: 12rpx;
	line-height: 1.4;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.product-validity {
	font-size: 24rpx;
	color: #999;
	margin-bottom: 12rpx;
}
.price-quantity {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.product-price {
	display: flex;
	flex-direction: row;
	align-items: baseline;
}
.price-symbol {
	font-size: 24rpx;
	color: #FF0000;
}
.price-value {
	font-size: 32rpx;
	color: #FF0000;
	font-weight: bold;
}
.quantity {
	font-size: 24rpx;
	color: #999;
}

/* 操作按钮样式 */
.order-buttons {
	padding: 20rpx 24rpx;
	display: flex;
	
	justify-content: flex-end;
}
.btn-group {
	display: flex;
	flex-direction: row;
	margin: auto;
}
.order-btn {
	height: 56rpx;
	padding: 0 20rpx;
	margin-left: 16rpx;
	border-radius: 28rpx;
	font-size: 24rpx;
	line-height: 56rpx;
	background: #FFFFFF;
	border: 1rpx solid #E0E0E0;
	color: #666;
}
.buy-again {
	background: #FF0000;
	color: #FFFFFF;
	border: none;
}

/* 弹窗样式 */
.modal {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 999;
}
.modal-content {
	width: 600rpx;
	background: #FFFFFF;
	border-radius: 16rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
}
.modal-header {
	padding: 24rpx;
	border-bottom: 1rpx solid #F5F5F5;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.modal-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}
.modal-close {
	font-size: 40rpx;
	color: #999999;
	padding: 0 20rpx;
}
.modal-body {
	max-height: 800rpx;
	padding: 24rpx;
}
.detail-section {
	margin-bottom: 32rpx;
}
.section-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 16rpx;
	position: relative;
	padding-left: 16rpx;
}
.section-title::before {
	content: '';
	position: absolute;
	left: 0;
	top: 6rpx;
	height: 24rpx;
	width: 6rpx;
	background: #FF5722;
	border-radius: 3rpx;
}
.detail-row {
	display: flex;
	align-items: center;
	margin-bottom: 12rpx;
}
.detail-label {
	font-size: 26rpx;
	color: #666666;
	width: 160rpx;
}
.detail-value {
	font-size: 26rpx;
	color: #333333;
	flex: 1;
}
.detail-value.price {
	color: #FF5722;
	font-weight: bold;
}
.product-detail {
	display: flex;
	align-items: center;
	padding: 16rpx;
	background: #F8F8F8;
	border-radius: 12rpx;
	margin-bottom: 12rpx;
}
.detail-image {
	width: 120rpx;
	height: 120rpx;
	border-radius: 10rpx;
	margin-right: 16rpx;
	box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}
.detail-info {
	flex: 1;
}
.detail-name {
	font-size: 26rpx;
	color: #333333;
	margin-bottom: 8rpx;
}
.detail-price {
	font-size: 28rpx;
	color: #FF5722;
	font-weight: bold;
}

/* 状态颜色样式 */
.status-pending {
	color: #FF9800;
}
.status-paid {
	color: #2196F3;
}
.status-completed {
	color: #4CAF50;
}
.status-cancelled {
	color: #9E9E9E;
}
.status-refunding {
	color: #FF9800;
}
.status-refunded {
	color: #9E9E9E;
}
