@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
		min-height: 100vh;
		background: #F8F9FA;
		position: relative;
		padding-bottom: 100rpx;
}
.content {
		height: calc(100vh - 100rpx);
}

	/* 轮播图样式 */
.banner {
		width: 100%;
		height: 400rpx;
		position: relative;
}
.banner image {
		width: 100%;
		height: 100%;
}

	/* 轮播图指示点样式 */
.banner .uni-swiper-dots {
		bottom: 20rpx;
}
.banner .uni-swiper-dot {
		width: 12rpx;
		height: 12rpx;
		margin: 0 8rpx;
}
.banner .uni-swiper-dot-active {
		width: 24rpx;
		border-radius: 6rpx;
}

	/* 介绍部分样式 */
.intro-section {
		padding: 40rpx 30rpx;
		background: #FFFFFF;
		margin: 20rpx;
		border-radius: 20rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.section-title {
		margin-bottom: 30rpx;
}
.title-text {
		font-size: 36rpx;
		font-weight: bold;
		color: #333333;
		display: block;
}
.subtitle-text {
		font-size: 24rpx;
		color: #999999;
		margin-top: 4rpx;
		display: block;
}
.intro-text {
		font-size: 28rpx;
		color: #666666;
		line-height: 1.6;
}

	/* 功能特点样式 */
.features-section {
		padding: 40rpx 30rpx;
		background: #FFFFFF;
		margin: 20rpx;
		border-radius: 20rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.features-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20rpx;
		margin-top: 30rpx;
}
.feature-item {
		display: flex;
		flex-direction: column;
		align-items: center;
}
.feature-item image {
		width: 80rpx;
		height: 80rpx;
		margin-bottom: 10rpx;
}
.feature-item text {
		font-size: 24rpx;
		color: #666666;
}

	/* 服务承诺样式 */
.promise-section {
		padding: 40rpx 30rpx;
		background: #FFFFFF;
		margin: 20rpx;
		border-radius: 20rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.promise-list {
		margin-top: 30rpx;
}
.promise-item {
		margin-bottom: 20rpx;
}
.promise-title {
		font-size: 30rpx;
		color: #333333;
		font-weight: bold;
		margin-bottom: 8rpx;
		display: block;
}
.promise-desc {
		font-size: 26rpx;
		color: #666666;
}

	/* 底部导航栏样式 */
.tab-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		height: 100rpx;
		background: #FFFFFF;
		display: flex;
		justify-content: space-around;
		align-items: center;
		box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.tab-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex: 1;
		height: 100%;
}
.tab-item image {
		width: 48rpx;
		height: 48rpx;
		margin-bottom: 4rpx;
}
.tab-item text {
		font-size: 24rpx;
		color: #999999;
}
.tab-item.active text {
		color: #4FD1C5;
}
