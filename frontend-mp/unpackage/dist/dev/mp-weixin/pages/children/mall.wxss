@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
		min-height: 100vh;
		background: #F5F9F6;
}

	/* 顶部导航栏 */
.nav-bar {
		background: #4CAF50;
		padding: 20rpx 30rpx;
		display: flex;
		align-items: center;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
}
.back-icon {
		color: #FFFFFF;
		font-size: 40rpx;
		font-weight: bold;
		margin-right: 20rpx;
}
.title {
		color: #FFFFFF;
		font-size: 32rpx;
		font-weight: bold;
}

	/* 搜索区域 */
.search-area {
		padding: 20rpx 24rpx;
		background: #4CAF50;
		position: fixed;
		top: 88rpx;
		left: 0;
		right: 0;
		z-index: 100;
}
.search-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		height: 68rpx;
}

	/* 价格筛选 */
.price-filter {
		width: 110rpx;
		height: 100%;
		background: #FFFFFF;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #4CAF50;
		border-radius: 34rpx 0 0 34rpx;
}
.filter-icon {
		font-size: 20rpx;
		margin-left: 2rpx;
		color: #4CAF50;
}

	/* 搜索输入框容器 */
.search-input-wrapper {
		flex: 1;
		height: 100%;
		background: #FFFFFF;
		display: flex;
		align-items: center;
		padding: 0 20rpx;
}

	/* 搜索输入框 */
.search-input {
		flex: 1;
		height: 100%;
		font-size: 28rpx;
		color: #4CAF50;
		padding: 0;
		margin: 0;
		background: transparent;
		border: none;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
}
.placeholder-style {
		color: #A5D6A7;
		font-size: 28rpx;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
}

	/* 搜索按钮 */
.search-btn {
		width: 110rpx;
		height: 100%;
		background: #FFFFFF;
		border-radius: 0 34rpx 34rpx 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #4CAF50;
}
.search-btn:active {
		opacity: 0.9;
}

	/* 价格筛选弹窗 */
.price-filter-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
}
.price-filter-content {
		width: 80%;
		background: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
}
.price-filter-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 30rpx;
}
.price-filter-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
}
.price-filter-close {
		font-size: 40rpx;
		color: #999999;
		padding: 10rpx;
}
.price-range-input {
		display: flex;
		align-items: center;
		gap: 20rpx;
		margin-bottom: 30rpx;
}
.price-range-input input {
		flex: 1;
		height: 80rpx;
		border: 2rpx solid #E0E0E0;
		border-radius: 10rpx;
		padding: 0 20rpx;
		font-size: 28rpx;
		color: #333333;
}
.price-range-separator {
		color: #999999;
		font-size: 28rpx;
}
.price-quick-select {
		display: flex;
		flex-wrap: wrap;
		gap: 20rpx;
		margin-bottom: 30rpx;
}
.price-range-item {
		padding: 15rpx 30rpx;
		border-radius: 30rpx;
		background: #F5F9F6;
		font-size: 24rpx;
		color: #4CAF50;
}
.price-range-item.active {
		background: #4CAF50;
		color: #FFFFFF;
}
.price-filter-actions {
		display: flex;
		gap: 20rpx;
}
.price-filter-actions button {
		flex: 1;
		height: 80rpx;
		border-radius: 40rpx;
		font-size: 28rpx;
		display: flex;
		align-items: center;
		justify-content: center;
}
.reset-btn {
		background: #F5F9F6;
		color: #4CAF50;
		border: 2rpx solid #4CAF50;
}
.confirm-btn {
		background: #4CAF50;
		color: #FFFFFF;
}

	/* 内容区域 */
.content {
		margin-top: 136rpx;
		padding: 12rpx 20rpx;
		box-sizing: border-box;
}

	/* 广告横幅 */
.banner {
		position: relative;
		height: 260rpx;
		border-radius: 16rpx;
		overflow: hidden;
		margin-bottom: 24rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.banner image {
		width: 100%;
		height: 100%;
		object-fit: cover;
}
.banner-content {
		position: absolute;
		right: 30rpx;
		bottom: 30rpx;
		color: #FFFFFF;
		text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
}
.banner-title {
		font-size: 36rpx;
		font-weight: bold;
		margin-bottom: 8rpx;
		display: block;
}
.banner-subtitle {
		font-size: 24rpx;
		margin-bottom: 8rpx;
		display: block;
}
.banner-tag {
		font-size: 20rpx;
		background: rgba(255, 255, 255, 0.3);
		padding: 4rpx 12rpx;
		border-radius: 10rpx;
		display: inline-block;
}

	/* 功能图标网格 */
.function-grid {
		background: #FFFFFF;
		border-radius: 16rpx;
		padding: 24rpx 20rpx;
		margin-bottom: 30rpx;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 24rpx 16rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.function-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12rpx;
}
.function-item image {
		width: 84rpx;
		height: 84rpx;
		transition: transform 0.3s ease;
}
.function-item:active image {
		transform: scale(0.92);
}
.function-item text {
		font-size: 24rpx;
		color: #4CAF50;
}

	/* 商品区域 */
.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #2E7D32;
		margin: 30rpx 0 20rpx;
		padding-left: 10rpx;
}
.product-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20rpx;
}
.product-item {
		background: #FFFFFF;
		border-radius: 16rpx;
		overflow: hidden;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
		transition: transform 0.3s ease;
}
.product-item:active {
		transform: scale(0.98);
}
.product-image {
		width: 100%;
		height: 320rpx;
		object-fit: cover;
}
.product-info {
		padding: 16rpx 20rpx;
}
.product-name {
		font-size: 28rpx;
		color: #333333;
		margin-bottom: 12rpx;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
}
.product-price {
		display: flex;
		align-items: baseline;
}
.price-symbol {
		font-size: 24rpx;
		color: #4CAF50;
}
.price-value {
		font-size: 32rpx;
		color: #4CAF50;
		font-weight: bold;
		margin-right: 12rpx;
}
.sold-count {
		font-size: 24rpx;
		color: #999999;
}
.product-status {
		position: absolute;
		top: 10rpx;
		right: 10rpx;
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		font-size: 20rpx;
}
.status-normal {
		background: rgba(76, 175, 80, 0.1);
		color: #4CAF50;
}
.status-offline {
		background: rgba(255, 152, 0, 0.1);
		color: #FF9800;
}
.status-deleted {
		background: rgba(244, 67, 54, 0.1);
		color: #F44336;
}
.add-to-cart {
		position: absolute;
		right: 20rpx;
		bottom: 20rpx;
		width: 48rpx;
		height: 48rpx;
		background: #4CAF50;
		color: #FFFFFF;
		border-radius: 24rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 32rpx;
		font-weight: bold;
		box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
		transition: transform 0.2s ease;
}
.add-to-cart:active {
		transform: scale(0.9);
}

	/* 加载更多 */
.loading {
		text-align: center;
		padding: 30rpx;
		color: #999999;
		font-size: 24rpx;
}
.no-more {
		text-align: center;
		padding: 30rpx;
		color: #999999;
		font-size: 24rpx;
}
