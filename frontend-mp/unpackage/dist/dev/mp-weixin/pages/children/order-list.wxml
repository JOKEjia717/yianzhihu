<view id="{{n}}" change:eS="{{uV.sS}}" eS="{{$eS[n]}}" change:eA="{{uV.sA}}" eA="{{$eA[n]}}" class="{{['container', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="search-header"><view class="search-bar"><text class="search-placeholder">搜索我的订单</text></view><view class="header-actions"><text class="filter-text">筛选</text><view class="cart-icon-container"><text class="badge">5+</text></view></view></view><view class="status-tabs"><view class="tab-item active"><text>全部</text></view><view class="tab-item"><text>待付款</text></view><view class="tab-item"><text>待收货</text></view><view class="tab-item"><text>待服务</text></view><view class="tab-item"><text>已完成</text></view></view><scroll-view class="order-list" scroll-y enable-flex="true" enhanced="true"><view wx:if="{{a}}" class="empty-state"><image class="empty-icon" src="{{b}}" mode="aspectFit"></image><text class="empty-text">暂无订单记录</text></view><block wx:else><view wx:for="{{c}}" wx:for-item="order" wx:key="e" class="order-card"><view class="shop-info"><view class="shop-name"><text class="name-text">COTTI COFFEE 库迪咖啡旗舰店</text></view><view class="{{['status-tag', order.b]}}">{{order.a}}</view></view><view class="order-content"><view wx:for="{{order.c}}" wx:for-item="item" wx:key="e" class="product-container"><image class="product-image" src="{{item.a}}" mode="aspectFill" bindtap="{{item.b}}"></image><view class="product-details"><text class="product-name">{{item.c}}</text><text class="product-validity">有效期至：2025-04-23 23:59</text><view class="price-quantity"><view class="product-price"><text class="price-symbol">¥</text><text class="price-value">{{item.d}}</text></view><text class="quantity">共{{order.d}}件</text></view></view></view></view><view class="order-buttons"><view class="btn-group"><button class="order-btn invoice-btn">查看发票</button><button class="order-btn refund-after-btn">退款/售后</button><button class="order-btn buy-again">再次购买</button></view></view></view></block></scroll-view><view wx:if="{{d}}" class="modal" bindtap="{{m}}"><view class="modal-content" catchtap="{{l}}"><view class="modal-header"><text class="modal-title">订单详情</text><text class="modal-close" bindtap="{{e}}">×</text></view><scroll-view class="modal-body" scroll-y enable-flex="true" enhanced="true"><view wx:if="{{f}}" class="detail-item"><view class="detail-section"><text class="section-title">订单信息</text><view class="detail-row"><text class="detail-label">订单编号：</text><text class="detail-value">{{g}}</text></view><view class="detail-row"><text class="detail-label">订单状态：</text><text class="{{['detail-value', i]}}">{{h}}</text></view><view class="detail-row"><text class="detail-label">订单金额：</text><text class="detail-value price">¥{{j}}</text></view></view><view class="detail-section"><text class="section-title">商品信息</text><view wx:for="{{k}}" wx:for-item="item" wx:key="d" class="product-detail"><image class="detail-image" src="{{item.a}}" mode="aspectFill"></image><view class="detail-info"><text class="detail-name">{{item.b}}</text><text class="detail-price">¥{{item.c}}</text></view></view></view></view></scroll-view></view></view></view><wxs src="/common/uniView.wxs" module="uV"/>
