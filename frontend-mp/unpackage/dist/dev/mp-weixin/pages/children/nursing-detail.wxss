@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
	min-height: 100vh;
	background: #F5F7FA;
	position: relative;
}
.nav-bar {
	height: 88rpx;
	background: #FFFFFF;
	display: flex;
	align-items: center;
	padding: 0 24rpx;
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	z-index: 100;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.back-btn {
	width: 60rpx;
	height: 60rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	position: absolute;
	left: 24rpx;
}
.back-icon {
	font-size: 40rpx;
	color: #2D3748;
}
.title {
	width: 100%;
	text-align: center;
	font-size: 32rpx;
	font-weight: 500;
	color: #2D3748;
}
.content {
	padding: 108rpx 24rpx 180rpx;
}
.info-card {
	background: #FFFFFF;
	border-radius: 24rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.nursing-image {
	width: 100%;
	height: 400rpx;
	border-radius: 16rpx;
	margin-bottom: 24rpx;
}
.info-content {
	padding: 0 12rpx;
}
.name {
	font-size: 36rpx;
	font-weight: 600;
	color: #2D3748;
	margin-bottom: 12rpx;
	display: block;
}
.address {
	font-size: 28rpx;
	color: #718096;
	display: block;
}
.detail-card {
	background: #FFFFFF;
	border-radius: 24rpx;
	padding: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.detail-item {
	margin-bottom: 24rpx;
}
.detail-item:last-child {
	margin-bottom: 0;
}
.label {
	font-size: 28rpx;
	color: #718096;
	margin-bottom: 8rpx;
	display: block;
}
.value {
	flex: 1;
	color: #333;
	font-size: 28rpx;
	background: transparent;
	border: none;
	outline: none;
	text-align: left;
	height: 48rpx;
	line-height: 48rpx;
	padding: 0;
	box-sizing: border-box;
	display: block;
	width: 100%;
	box-shadow: none;
}
.value:focus {
	border: none;
	outline: none;
	box-shadow: none;
}
.footer-btn {
	position: fixed;
	left: 0; right: 0; bottom: 0;
	background: #fff;
	padding: 24rpx 32rpx;
	box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04);
	z-index: 500;
}
.footer-btn button {
	width: 100%;
	height: 88rpx;
	border-radius: 44rpx;
	font-size: 32rpx;
	background: #4FD1C5;
	color: #fff;
	border: none;
}
.modal-mask {
	position: fixed; 
	left: 0; 
	top: 0; 
	right: 0; 
	bottom: 0;
	background: rgba(0,0,0,0.3);
	z-index: 1000;
	display: flex; 
	align-items: center; 
	justify-content: center;
}
.modal-content {
	background: #fff;
	border-radius: 20rpx;
	padding: 40rpx 32rpx;
	width: 80vw;
	max-height: 80vh;
	overflow-y: auto;
	position: relative;
	z-index: 1001;
}
.modal-title {
	font-size: 32rpx;
	font-weight: bold;
	margin-bottom: 32rpx;
	text-align: center;
}
.modal-actions {
	display: flex;
	justify-content: space-between;
	margin-top: 32rpx;
}
.modal-actions button {
	flex: 1;
	margin: 0 8rpx;
}
.upload-section {
	margin: 24rpx 0 0 0;
}
.upload-label {
	font-size: 28rpx;
	color: #666;
	margin-bottom: 12rpx;
}
.image-grid {
	display: flex;
	flex-wrap: wrap;
	gap: 20rpx;
}
.image-item, .upload-btn {
	width: 160rpx;
	height: 160rpx;
	border-radius: 10rpx;
	position: relative;
	background: #f8fafc;
	border: 1rpx solid #eee;
	display: flex;
	align-items: center;
	justify-content: center;
}
.preview-image {
	width: 100%;
	height: 100%;
	border-radius: 10rpx;
}
.delete-btn {
	position: absolute;
	top: -16rpx;
	right: -16rpx;
	width: 40rpx;
	height: 40rpx;
	background-color: rgba(0,0,0,0.5);
	color: #fff;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 32rpx;
	z-index: 2;
}
.upload-btn {
	border: 2rpx dashed #ddd;
	cursor: pointer;
}
.plus {
	font-size: 60rpx;
	color: #bbb;
}
.info-item {
	margin: 24rpx 0;
	position: relative;
}
.info-item .label {
	font-size: 28rpx;
	color: #666;
	margin-bottom: 12rpx;
	display: block;
}
.info-item .value {
	width: 100%;
	height: 80rpx;
	background: #f8fafc;
	border: 1rpx solid #eee;
	border-radius: 10rpx;
	padding: 0 20rpx;
	font-size: 28rpx;
	color: #333;
}
.info-item .picker {
	position: relative;
	z-index: 10001;
	padding: 0;
	color: #888;
}
.picker {
	position: relative;
	z-index: 10001;
	padding: 0;
	color: #888;
}
.uni-picker-container {
	z-index: 99999 !important;
}
.uni-picker {
	z-index: 99999 !important;
}
.uni-picker-view {
	z-index: 99999 !important;
}
.uni-picker-view-indicator {
	z-index: 99999 !important;
}
.uni-picker-view-content {
	z-index: 99999 !important;
}
.gender-select {
	display: flex;
	gap: 20rpx;
}
.gender-option {
	flex: 1;
	height: 80rpx;
	background: #f8fafc;
	border: 1rpx solid #eee;
	border-radius: 10rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	color: #666;
}
.gender-option.active {
	background: #4FD1C5;
	color: #fff;
	border-color: #4FD1C5;
}
.form-error {
	color: #e53e3e;
	background: #fff0f0;
	border: 1rpx solid #e53e3e;
	border-radius: 8rpx;
	padding: 12rpx 20rpx;
	margin-bottom: 20rpx;
	font-size: 26rpx;
	text-align: center;
}
