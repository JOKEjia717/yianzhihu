@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  padding-bottom: 120rpx;
}
.header {
  height: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  background-color: #26c48b;
  position: relative;
  z-index: 10;
}
.header-left {
  display: flex;
  align-items: center;
}
.header-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.header-right {
  display: flex;
  align-items: center;
}
.search-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.9;
}
.container {
  padding: 20rpx 30rpx 120rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 5;
}
.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.user-info {
  flex: 1;
}
.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}
.user-role {
  font-size: 24rpx;
  color: #999999;
}
.user-arrow {
  width: 40rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.panel {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}
.feedback-panel {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.94));
}
.panel-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.panel-action {
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.action-text {
  font-size: 24rpx;
  color: #666666;
}
.tiny-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
  opacity: 0.6;
}
.icon-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 10rpx 0;
}
.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  transition: transform 0.2s;
}
.icon-item:active {
  transform: scale(0.95);
}
.icon-container {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 45rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.1);
}
.icon-container.small {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.08);
}
.icon-container.blue {
  background: linear-gradient(45deg, #007AFF, #5ac8fa);
}
.icon-container.green {
  background: linear-gradient(45deg, #26c48b, #4cd964);
}
.feature-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.icon-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}
.list-menu {
  background-color: transparent;
  border-radius: 16rpx;
}
.list-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(240, 240, 240, 0.8);
  transition: background-color 0.2s;
}
.list-item:active {
  background-color: rgba(245, 245, 245, 0.8);
}
.list-item:last-child {
  border-bottom: none;
}
.item-left {
  display: flex;
  margin: auto;
  height: inherit;
  align-items: center;
}
.list-icon {
  width: 80rpx;
  height: 80rpx;
}
.item-text {
  font-size: 28rpx;
  color: #333333;
  margin-left: 16rpx;
  font-weight: 500;
}
.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx solid #eeeeee;
  z-index: 10;
  padding: 0 10rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5rpx;
}
.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}
.tabbar-text {
  font-size: 20rpx;
  color: #999999;
}
.tabbar-text.active {
  color: #26c48b;
  font-weight: bold;
}

/* 弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}
.popup-content {
  width: 600rpx;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 30rpx rgba(0, 0, 0, 0.15);
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.close-icon {
  font-size: 40rpx;
  color: #999999;
}
.popup-body {
  padding: 24rpx;
  max-height: calc(80vh - 120rpx);
  overflow-y: auto;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f8f8f8;
}
.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f8f8f8;
}
.level-selector {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.level-item {
  flex: 1;
  height: 70rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 8rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  background-color: #f8f8f8;
  font-size: 26rpx;
  color: #666666;
}
.level-item:first-child {
  margin-left: 0;
}
.level-item:last-child {
  margin-right: 0;
}
.level-selected {
  background-color: #26c48b;
  color: #ffffff;
  border-color: #26c48b;
}
.submit-btn {
  height: 90rpx;
  background-color: #26c48b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 45rpx;
  margin-top: 24rpx;
}
