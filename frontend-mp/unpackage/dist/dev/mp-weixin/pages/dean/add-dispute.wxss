@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}
.header {
  background-color: #26c48b;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  position: relative;
}
.back-btn {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}
.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.form-container {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
  position: relative;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 15rpx;
  display: block;
  font-weight: bold;
}
.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}
.form-textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}
.char-count {
  font-size: 24rpx;
  color: #999999;
  text-align: right;
  margin-top: 10rpx;
}
.time-picker {
  display: flex;
  justify-content: space-between;
}
.picker-value {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.time-picker .picker-value {
  width: 48%;
}
.picker-arrow {
  color: #999999;
  font-size: 24rpx;
}
.urgency-selector {
  display: flex;
  justify-content: space-between;
}
.urgency-item {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #eeeeee;
  border-radius: 8rpx;
  margin: 0 10rpx;
  background-color: #f9f9f9;
}
.urgency-item:first-child {
  margin-left: 0;
}
.urgency-item:last-child {
  margin-right: 0;
}
.urgency-item.selected:nth-child(1) {
  background-color: #26c48b;
  color: #ffffff;
  border-color: #26c48b;
}
.urgency-item.selected:nth-child(2) {
  background-color: #ffaa00;
  color: #ffffff;
  border-color: #ffaa00;
}
.urgency-item.selected:nth-child(3) {
  background-color: #ff6b6b;
  color: #ffffff;
  border-color: #ff6b6b;
}
.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #26c48b;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn:disabled {
  background-color: #cccccc;
}
