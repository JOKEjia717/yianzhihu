@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

/* 样式部分保持不变，仅修正中文注释和说明 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  padding-bottom: 120rpx;
}
.header {
  background: linear-gradient(to bottom, #26c48b, #ffffff);
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.search-box {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 50rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
  position: relative;
}
.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
.search-box input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}
.content-section {
  margin: 20rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.section-title {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.section-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.change-btn {
  background-color: #ff9500;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}
.change-btn text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: normal;
}
.loading, .no-activity {
  padding: 40rpx;
  text-align: center;
}
.loading text, .no-activity text {
  color: #999999;
  font-size: 28rpx;
}
.activity-card {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}
.activity-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.activity-info {
  display: flex;
  flex-direction: column;
}
.activity-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}
.activity-time {
  font-size: 24rpx;
  color: #26c48b;
  margin-bottom: 10rpx;
}
.activity-desc {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}
.activity-tags {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  background-color: #f0f0f0;
  color: #666666;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.feature-section {
  margin: 20rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 30rpx;
}
.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  padding: 0 20rpx;
}
.feature-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 70%;
  background-color: #f5f5f5;
}
.feature-text {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}
.feature-value {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}
.feature-icon {
  display: none;
}
.elderly-list {
  padding: 10rpx 0;
}
.elderly-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}
.elderly-item:last-child {
  border-bottom: none;
}
.elderly-avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  border: 1rpx solid #eeeeee;
  overflow: hidden;
}
.elderly-avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
}
.elderly-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 100rpx;
}
.elderly-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 4rpx;
}
.elderly-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0;
}
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}
.status-tag.good {
  background-color: rgba(38, 196, 139, 0.1);
  color: #26c48b;
}
.status-tag.warning {
  background-color: rgba(255, 107, 107, 0.1);
  color: #ff6b6b;
}
.elderly-contact {
  font-size: 22rpx;
  color: #999999;
}
.query-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
}
.query-btn.good {
  background-color: #26c48b;
}
.query-btn.warning {
  background-color: #ff6b6b;
}
.query-btn text {
  color: #ffffff;
  font-size: 24rpx;
}
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx solid #eeeeee;
  z-index: 10;
  padding: 0 10rpx;
}
.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5rpx;
}
.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}
.tabbar-text {
  font-size: 20rpx;
  color: #999999;
}
.tabbar-item.active .tabbar-icon {
  color: #26c48b;
}
.tabbar-text.active {
  color: #26c48b;
}

/* 修改添加活动按钮样式为可拖动的圆形按钮 */
.add-btn {
  position: fixed;
  width: 100rpx;
  height: 100rpx;
  background-color: #26c48b;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(38, 196, 139, 0.5);
  z-index: 99;
}
.add-icon {
  color: #ffffff;
  font-size: 60rpx;
  font-weight: bold;
  line-height: 90rpx;
}
.moving-tip {
  position: absolute;
  white-space: nowrap;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  top: -40rpx;
  transform: translateX(-50%);
  left: 50%;
}

/* 删除原有的添加活动按钮样式 */
.add-activity-btn {
  display: none;
}

/* 添加活动模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.add-activity-modal {
  width: 650rpx;
  max-height: 90vh;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}
.modal-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #26c48b;
}
.modal-close {
  font-size: 40rpx;
  color: #999999;
  padding: 0 10rpx;
}
.modal-body {
  padding: 24rpx;
  max-height: 70vh;
  overflow-y: auto;
}
.modal-footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
.datetime-picker {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
}
.picker-text {
  font-size: 28rpx;
  color: #666666;
}
.upload-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.upload-icon {
  font-size: 60rpx;
  color: #999999;
  margin-bottom: 10rpx;
}
.upload-text {
  font-size: 24rpx;
  color: #999999;
}
.tag-container {
  display: flex;
  flex-wrap: wrap;
}
.tag-item {
  background-color: #f5f5f5;
  padding: 8rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 30rpx;
}
.tag-item text {
  font-size: 24rpx;
  color: #666666;
}
.tag-selected {
  background-color: rgba(38, 196, 139, 0.1);
  border: 1rpx solid #26c48b;
}
.tag-selected text {
  color: #26c48b;
}
.cancel-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  font-size: 28rpx;
  color: #666666;
  margin-right: 20rpx;
}
.submit-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 30rpx;
  background-color: #26c48b;
  border-radius: 35rpx;
  font-size: 28rpx;
  color: #ffffff;
}
