@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 20rpx;
}
.info-section,
.upload-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.info-header,
.upload-header {
  margin-bottom: 30rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}
.info-item {
  display: flex;
  margin-bottom: 20rpx;
}
.label {
  width: 160rpx;
  color: #666666;
  font-size: 28rpx;
}
.value {
  flex: 1;
  color: #333333;
  font-size: 28rpx;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item,
.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  position: relative;
}
.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}
.delete-btn {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.upload-btn {
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
}
.plus {
  font-size: 60rpx;
  color: #999999;
}
.button-group {
  margin-top: 40rpx;
}
.submit-btn {
  background-color: #007AFF;
  color: #FFFFFF;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}
