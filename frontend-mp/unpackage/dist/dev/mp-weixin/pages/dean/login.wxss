@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container {
  min-height: 100vh;
  background: url('../../static/images/dean-login-bg.png') no-repeat;
  background-size: cover;
  background-position: center;
  position: relative;
  padding: 60rpx 40rpx;
}
.paper-plane {
  width: 80rpx;
  height: 80rpx;
  position: absolute;
  top: 40rpx;
  left: 40rpx;
}
.welcome-text {
  margin-top: 100rpx;
  text-align: center;
}
.welcome-en {
  font-size: 36rpx;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
  text-shadow: 0 2px 4px rgba(255,255,255,0.5);
}
.welcome-cn {
  font-size: 64rpx;
  color: #333333;
  font-weight: bold;
  text-shadow: 0 2px 4px rgba(255,255,255,0.5);
  white-space: pre-line;
  display: block;
}
.form-container {
  background: rgba(255, 255, 255, 0.8);
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-top: 60rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}
.input {
  height: 88rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 44rpx;
  padding: 0 40rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}
.submit-btn {
  background: #007AFF;
  color: #FFFFFF;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  border: none;
}
.submit-btn:disabled {
  background: #999999;
  cursor: not-allowed;
}
