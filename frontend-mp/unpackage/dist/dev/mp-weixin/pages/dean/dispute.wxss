@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  padding-bottom: 120rpx;
}
.header {
  background-color: #26c48b;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.search-box {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 50rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
  position: relative;
}
.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
.search-box input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}
.dispute-list {
  margin: 20rpx 30rpx;
}
.dispute-item {
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
}
.dispute-info {
  flex: 1;
  padding-right: 100rpx;
}
.dispute-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;

  margin-bottom: 8rpx;
}
.dispute-time {
  font-size: 24rpx;

  color: #999999;
  margin-bottom: 8rpx;
}
.dispute-desc {
  font-size: 26rpx;
  color: #666666;
}
.status-tag {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.status-tag.resolved {
  background-color: #666666;
}
.status-tag.resolving {
  background-color: #26c48b;
}
.status-tag.unresolved {
  background-color: #ff6b6b;
}
.status-tag.new {
  background-color: #ffaa00;
}
.status-tag text {
  color: #ffffff;
  font-size: 24rpx;
}
.add-button {
  position: fixed;
  width: 100rpx;
  height: 100rpx;
  background-color: #26c48b;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 99;
}
.add-icon {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: bold;
  line-height: 90rpx;
}
.moving-tip {
  position: absolute;
  white-space: nowrap;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  top: -40rpx;
  transform: translateX(-50%);
  left: 50%;
}
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx solid #eeeeee;
  z-index: 10;
  padding: 0 10rpx;
}
.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5rpx;
}
.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}
.tabbar-text {
  font-size: 20rpx;
  color: #999999;
}
.tabbar-item.active .tabbar-icon {
  color: #26c48b;
}
.tabbar-text.active {
  color: #26c48b;
}
