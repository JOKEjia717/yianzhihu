@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  padding-bottom: 120rpx;
}
.header {
  background: linear-gradient(to bottom, #26c48b, #ffffff);
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
}
.header-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.sub-title {
  color: #ffffff;
  font-size: 24rpx;
  margin-top: 6rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}
.content-section {
  margin: 20rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding-bottom: 20rpx;
}
.section-title {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.section-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.section-subtitle {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
  font-weight: normal;
}
.loading, .no-data {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}
.application-list, .elderly-list {
  padding: 0 10rpx;
}
.application-item, .elderly-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  height: 100px;
  border-bottom: 1rpx solid #f0f0f0;
}
.application-item:last-child, .elderly-item:last-child {
  border-bottom: none;
}
.applicant-info, .elderly-info {
  display: flex;
  flex-direction: row;
  flex: 1;
}
.avatar-container {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  margin-top: 10px;
  border-radius: 50%;
  overflow: hidden;
}
.avatar {
  width: 100%;
  height: 100%;
}
.info-container {
  flex-direction: row;
  flex: 1;
}
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  margin-top: 15px;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}
.gender {
  font-size: 26rpx;
  color: #666666;
  margin-right: 20rpx;
  background-color: #f0f0f0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.age {
  font-size: 26rpx;
  color: #666666;
}
.contact-label, .application-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 10rpx;
  width: 120rpx;
}
.contact, .application-time {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}
.action-buttons {
  display: flex;
  
  margin-top: 16rpx;
}
.approve-btn, .reject-btn {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.approve-btn {
  background-color: #26c48b;
}
.reject-btn {
  background-color: #ff6b6b;
}
.btn-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}
.action-arrow {
  padding: 0 10rpx;
}
.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}
.elderly-entry {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #ffffff;
}
.elderly-icon-container {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}
.elderly-icon {
  width: 100%;
  height: 100%;
}
.elderly-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}
.arrow-container {
  width: 40rpx;
  height: 40rpx;
}
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx solid #eeeeee;
  z-index: 10;
  padding: 0 10rpx;
}
.tabbar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5rpx;
}
.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}
.tabbar-text {
  font-size: 20rpx;
  color: #999999;
}
.tabbar-text.active {
  color: #26c48b;
}
