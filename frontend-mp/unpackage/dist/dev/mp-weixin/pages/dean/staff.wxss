@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
    min-height: 100vh;
    background-color: #f5f5f5;
    position: relative;
    padding-bottom: 100rpx;
}
.header {
    background-color: #26c48b;
    height: 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 30rpx;
}
.header-title {
    color: #ffffff;
    font-size: 36rpx;
    font-weight: bold;
}
.search-box {
    margin: 20rpx 30rpx;
    background-color: #ffffff;
    border-radius: 50rpx;
    display: flex;
	flex-direction: row;
    align-items: center;
    padding: 10rpx 20rpx;
    box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}
.search-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 10rpx;
}
.search-box input {
    flex: 1;
    height: 60rpx;
    font-size: 28rpx;
}
.content-section {
    margin: 20rpx 30rpx;
    background-color: #ffffff;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 10rpx 10rpx 10rpx rgba(0, 0, 0, 0.1);
}
.section-title {
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}
.section-title text {
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
}
.staff-list {
    padding: 10rpx 0;
}
.staff-item {
    display: flex;
	flex-direction: row;
    align-items: center;
    padding: 35rpx;
    border-bottom: 1rpx solid #f0f0f0;
}
.staff-item:last-child {
    border-bottom: none;
}
.staff-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}
.staff-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}
.staff-name {
    font-size: 28rpx;
    color: #333333;
    font-weight: bold;
    margin-bottom: 4rpx;
}
.staff-position {
    font-size: 24rpx;
    color: #999999;
}
.view-btn {
    padding: 10rpx 30rpx;
    background-color: #26c48b;
    border-radius: 30rpx;
}
.view-btn text {
    color: #ffffff;
    font-size: 24rpx;
}
.add-btn {
    position: fixed;
    width: 100rpx;
    height: 100rpx;
    background-color: #26c48b;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 16rpx rgba(38, 196, 139, 0.5);
    z-index: 99;
}
.add-icon {
    color: #ffffff;
    font-size: 60rpx;
    font-weight: bold;
    line-height: 90rpx;
}
.moving-tip {
    position: absolute;
    white-space: nowrap;
    font-size: 20rpx;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 4rpx 10rpx;
    border-radius: 10rpx;
    top: -40rpx;
    transform: translateX(-50%);
    left: 50%;
}
.tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100rpx;
    background-color: #ffffff;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-top: 1rpx solid #eeeeee;
    z-index: 10;
    padding: 0 10rpx;
}
.tabbar-item {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 5rpx;
}
.tabbar-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 4rpx;
}
.tabbar-text {
    font-size: 20rpx;
    color: #999999;
}
.tabbar-item.active .tabbar-icon {
    color: #26c48b;
}
.tabbar-text.active {
    color: #26c48b;
}
.pagination {
    display: flex;
	flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}
.page-btn {
    padding: 10rpx 20rpx;
    background-color: #26c48b;
    border-radius: 8rpx;
}
.page-btn text {
    color: #ffffff;
    font-size: 24rpx;
}
.page-btn.disabled {
    background-color: #cccccc;
    opacity: 0.6;
}
.page-info {
    font-size: 24rpx;
    color: #666666;
}
.empty-state {
    padding: 60rpx 0;
    text-align: center;
}
.empty-state text {
    color: #999999;
    font-size: 28rpx;
}
