@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 120rpx;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  height: 88rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx;
  cursor: pointer;
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.back-icon {
  font-size: 32rpx;
  color: #fff;
  margin-right: 4rpx;
}
.back-text {
  font-size: 28rpx;
  color: #fff;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.dropdown {
  min-width: 200rpx;
  margin-left: auto;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.picker-content {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  -webkit-backdrop-filter: blur(10rpx);
          backdrop-filter: blur(10rpx);
}
.picker-text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
}
.down-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}
.content {
  padding: 30rpx;
}
.section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}
.section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}
.section-header {
  position: relative;
  height: 80rpx;
  margin-bottom: 30rpx;
}
.date-picker {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.section-title {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
  white-space: nowrap;
}
.btn-upload {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(79, 209, 197, 0.3);
}
.section-content {
  min-height: 160rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}
.empty-tip {
  color: #a0aec0;
  font-size: 26rpx;
}
.Bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  border-top: 1rpx solid #edf2f7;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  transition: all 0.3s ease;
}
.tab-text {
  font-size: 24rpx;
  color: #a0aec0;
  transition: all 0.3s ease;
}
.tab-item.active .tab-text {
  color: #319795;
}
.tab-item.active .tab-icon {
  filter: hue-rotate(180deg) saturate(1.5);
}
.time-picker {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  background-color: #f0f9f8;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #319795;
  border: 1rpx solid #e6fffa;
}
.meal-swiper {
  width: 100%;
  height: 400rpx;
}
.meal-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.meal-label {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.clothing-image, .living-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}
.health-info {
  width: 100%;
  padding: 20rpx;
}
.health-item {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}
.health-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.health-value {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}
.banner-swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 30rpx;
}
.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}
.modal-body {
  padding: 30rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-footer {
  padding: 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}
.modal-btn.confirm {
  background-color: #007AFF;
  color: #fff;
}
.modal-btn.confirm:disabled {
  background-color: #ccc;
}

/* AI咨询按钮样式 */
.ai-btn {
  position: fixed;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(49, 151, 149, 0.5);
  z-index: 99;
}
.ai-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 4rpx;
}
.ai-text {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}
.moving-tip {
  position: absolute;
  white-space: nowrap;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  top: -40rpx;
  transform: translateX(-50%);
  left: 50%;
}
