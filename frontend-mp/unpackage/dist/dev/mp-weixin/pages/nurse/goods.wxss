@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 120rpx; /* 为底部导航栏预留空间 */
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  height: 88rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.title-switch {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.title-item {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
}
.switch-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
  transition: transform 0.3s ease;
}
.title-switch:hover .switch-icon {
  transform: rotate(180deg);
}
.dropdown {
  min-width: 200rpx;
  margin-left: auto;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.picker-content {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  -webkit-backdrop-filter: blur(10rpx);
          backdrop-filter: blur(10rpx);
}
.picker-text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
}
.down-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}
.content {
  padding: 30rpx;
}
.items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f0f0f0;
}
.item-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.no-photo {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}
.no-photo-text {
  font-size: 24rpx;
  color: #999;
}
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.status-pending {
  background-color: #fff7e6;
  color: #d46b08;
}
.status-normal {
  background-color: #e6fffb;
  color: #08979c;
}
.status-repairing {
  background-color: #f0f5ff;
  color: #1d39c4;
}
.status-scrapped {
  background-color: #fff1f0;
  color: #cf1322;
}
.status-unknown {
  background-color: #f5f5f5;
  color: #999;
}
.item-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.detail-row {
  display: flex;
  align-items: center;
}
.detail-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
}
.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  border-top: 1rpx solid #edf2f7;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  transition: all 0.3s ease;
}
.tab-text {
  font-size: 24rpx;
  color: #a0aec0;
  transition: all 0.3s ease;
}
.tab-item.active .tab-text {
  color: #319795;
}
.tab-item.active .tab-icon {
  filter: hue-rotate(180deg) saturate(1.5);
}
.logistics-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.logistic-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.logistic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.logistic-company {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.logistic-time {
  font-size: 24rpx;
  color: #999;
}
.logistic-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.info-row {
  display: flex;
  align-items: flex-start;
}
.info-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
}
.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}
.switch-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #edf2f7;
}
.tip-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 10rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #999;
}
