@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  padding-bottom: 120rpx; /* 为底部导航栏预留空间 */
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: #4FD1C5;
  display: flex;

  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  z-index: 100;
}
.back-btn {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-left: -20rpx;
}
.back-icon {
  font-size: 36rpx;
  color: #fff;
}
.title {
	margin-top: 10px;
  font-size: 34rpx;
  color: #fff;
  font-weight: 500;
}
.select-elder-btn {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #fff;
}
.right-icons {
  position: absolute;
  right: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.dropdown {
  min-width: 200rpx;
  margin-right: 20rpx;
}
.picker-content {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  -webkit-backdrop-filter: blur(10rpx);
          backdrop-filter: blur(10rpx);
}
.picker-text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
}
.down-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}
.search-btn, .filter-btn {
  padding: 20rpx;
  margin-right: -20rpx;
}
.icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.8;
}

/* 搜索栏 */
.search-bar {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  z-index: 99;
  animation: slideDown 0.3s ease;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}
.cancel-btn {
  font-size: 28rpx;
  color: #666;
  padding: 20rpx;
  margin-right: -20rpx;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 99;
  animation: slideIn 0.3s ease;
}
.filter-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
}
.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.clear-btn {
  font-size: 28rpx;
  color: #999;
}
.filter-content {
  padding: 30rpx;
}
.filter-section {
  margin-bottom: 40rpx;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.date-range {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.date-text {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}
.date-separator {
  font-size: 28rpx;
  color: #999;
}
.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.status-item {
  padding: 20rpx 40rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}
.status-item.active {
  background: #4FD1C5;
  color: #fff;
}
.filter-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
}
.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: #4FD1C5;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 页面指示器 */
.page-indicator {
  position: fixed;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 98;
  background: rgba(0, 0, 0, 0.6);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
}
.indicator-content {
  display: flex;
  align-items: center;
}
.progress-bar {
  width: 100rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 15rpx;
  border-radius: 2rpx;
  overflow: hidden;
}
.progress {
  height: 100%;
  background: #fff;
  transition: width 0.3s ease;
}
.current, .total {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* 活动列表 */
.activity-list {
  height: 100vh;
  background: #f5f5f5;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}
.activity-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform, opacity;
}
.card-active {
  transform: scale(1) !important;
  opacity: 1 !important;
}
.card-enter {
  animation: cardEnter 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes cardEnter {
from {
    transform: translateY(50rpx);
    opacity: 0;
}
to {
    transform: translateY(0);
    opacity: 1;
}
}
.color-block {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  z-index: 1;
}
.color-0 { background: linear-gradient(to bottom, #4FD1C5, #38B2AC);
}
.color-1 { background: linear-gradient(to bottom, #F6AD55, #ED8936);
}
.color-2 { background: linear-gradient(to bottom, #63B3ED, #4299E1);
}
.color-3 { background: linear-gradient(to bottom, #F687B3, #ED64A6);
}
.color-4 { background: linear-gradient(to bottom, #68D391, #48BB78);
}
.activity-header {
  display: flex;
  margin-top: 20px;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  padding-left: 38rpx;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.activity-tag {
  padding: 4rpx 16rpx;
  background: rgba(79, 209, 197, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #4FD1C5;
}
.activity-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}
.activity-actions {
  display: flex;
  align-items: center;
  gap: 30rpx;
}
.action-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.action-icon {
  width: 40rpx;
  height: 40rpx;
}
.action-count {
  font-size: 24rpx;
  color: #999;
}
.image-container {
  position: relative;
  height: 400rpx;
}
.image-swiper {
  height: 100%;
}
.activity-image {
  width: 100%;
  height: 100%;
  transition: opacity 0.3s ease;
}
.image-loading {
  opacity: 0;
}
.image-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 100rpx 30rpx 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.image-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
}
.image-count {
  font-size: 24rpx;
  color: #fff;
}
.info-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.time-location {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.time-item, .location-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.info-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.8;
}
.time-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.date {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.time {
  font-size: 24rpx;
  color: #666;
}
.location {
  font-size: 28rpx;
  color: #333;
}
.description {
  padding: 30rpx;
}
.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  max-height: 160rpx;
  overflow: hidden;
  transition: max-height 0.3s ease;
}
.description-text.expanded {
  max-height: none;
}
.expand-btn {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4FD1C5;
  text-align: center;
}
.participants {
  padding: 30rpx;
}
.participant-list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.participant-avatars {
  display: flex;
  align-items: center;
}
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  border: 4rpx solid #fff;
  margin-left: -20rpx;
}
.avatar:first-child {
  margin-left: 0;
}
.participant-count {
  font-size: 28rpx;
  color: #666;
}
.action-buttons {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  gap: 20rpx;
}
.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  gap: 10rpx;
  transition: all 0.3s ease;
}
.action-btn:active {
  transform: scale(0.98);
}
.action-btn.share {
  background: #f8f9fa;
  color: #666;
}
.action-btn.register {
  background: #4FD1C5;
  color: #fff;
}
.action-btn.registered {
  background: #E2E8F0;
  color: #A0AEC0;
}
.action-btn.success {
  background: #48BB78;
  color: #fff;
}
.action-btn.rejected {
  background: #F56565;
  color: #fff;
}
.btn-icon {
  width: 32rpx;
  height: 32rpx;
}
.loading-tips {
  position: fixed;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
}
.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
.loading-text {
  font-size: 28rpx;
  color: #fff;
}

/* 动画 */
@keyframes slideDown {
from {
    transform: translateY(-100%);
}
to {
    transform: translateY(0);
}
}
@keyframes slideIn {
from {
    transform: translateX(100%);
}
to {
    transform: translateX(0);
}
}
@keyframes spin {
to {
    transform: rotate(360deg);
}
}
.error-tips {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.6);
  padding: 30rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
}
.error-text {
  font-size: 28rpx;
  color: #fff;
}
.retry-btn {
  padding: 10rpx 30rpx;
  background: #4FD1C5;
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
}
