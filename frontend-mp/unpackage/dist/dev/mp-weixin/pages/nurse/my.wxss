@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 120rpx; /* 为底部导航栏预留空间 */
}
.header {
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  padding: 40rpx 30rpx;
  position: relative;
}
.title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
  display: block;
}
.content {
  padding: 30rpx;
  margin-top: -40rpx;
}
.profile-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.name {
  font-size: 36rpx;
  color: #2d3748;
  font-weight: bold;
}
.info-list {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #edf2f7;
}
.info-item:last-child {
  border-bottom: none;
}
.label {
  font-size: 28rpx;
  color: #718096;
}
.value {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 500;
}
.section {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
}
.section-header {
  margin-bottom: 16px;
}
.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}
.order-stats {
  display: flex;
  justify-content: space-between;
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  margin-bottom: 4px;
  display: block;
}
.stat-label {
  font-size: 12px;
  color: #999;
}
.menu-list {
  background-color: #ffffff;
  border-radius: 12px;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 24px;
  height: 24px;
  margin-right: 12px;
}
.menu-text {
  flex: 1;
  font-size: 16px;
  color: #333;
}
.menu-arrow {
  font-size: 16px;
  color: #999;
}
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  background-color: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #f0f0f0;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4px;
}
.tab-text {
  font-size: 12px;
  color: #999;
}
.tab-item.active .tab-text {
  color: #007AFF;
}
.edit-btn {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  border: none;
  width: 100%;
  box-sizing: border-box;
}
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}
.modal-body {
  padding: 30rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.preview-avatar {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.upload-text {
  font-size: 24rpx;
  color: #999;
}
.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-footer {
  padding: 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}
.modal-btn.confirm {
  background-color: #007AFF;
  color: #fff;
}
.modal-btn.confirm:disabled {
  background-color: #ccc;
}
