:host{display:flex;flex-direction:column}

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #edf2f7;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 9999;
  padding: 0 20rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}
.tab-item:active {
  background-color: #f7fafc;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  transition: all 0.3s ease;
}
.tab-text {
  font-size: 26rpx;
  color: #718096;
  transition: all 0.3s ease;
  font-weight: 500;
}
.tab-text.active {
  color: #319795;
  font-weight: 600;
}
.tab-item.active {
  background-color: #f0fdfa;
}
.tab-item.active .tab-icon {
  transform: scale(1.1);
}
