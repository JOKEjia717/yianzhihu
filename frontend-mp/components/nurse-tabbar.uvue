<template>
  <view class="tabbar">
    <view class="tab-item" @click="navigateTo('/pages/nurse/index')">
      <image class="tab-icon" :src="currentPath === '/pages/nurse/index' ? '/static/images/home-active.png' : '/static/images/home.png'"></image>
      <text class="tab-text" :class="{ active: currentPath === '/pages/nurse/index' }">首页</text>
    </view>
    <view class="tab-item" @click="navigateTo('/pages/nurse/activity')">
      <image class="tab-icon" :src="currentPath === '/pages/nurse/activity' ? '/static/images/activity-active.png' : '/static/images/activity.png'"></image>
      <text class="tab-text" :class="{ active: currentPath === '/pages/nurse/activity' }">活动</text>
    </view>
    <view class="tab-item" @click="navigateTo('/pages/nurse/goods')">
      <image class="tab-icon" :src="currentPath === '/pages/nurse/goods' ? '/static/images/goods-active.png' : '/static/images/goods.png'"></image>
      <text class="tab-text" :class="{ active: currentPath === '/pages/nurse/goods' }">物品</text>
    </view>
    <view class="tab-item" @click="navigateTo('/pages/nurse/my')">
      <image class="tab-icon" :src="currentPath === '/pages/nurse/my' ? '/static/images/mine-active.png' : '/static/images/mine.png'"></image>
      <text class="tab-text" :class="{ active: currentPath === '/pages/nurse/my' }">我的</text>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: {
    currentPath: {
      type: String,
      default: ''
    }
  },
  methods: {
    navigateTo(url: string) {
      uni.navigateTo({
        url: url,
        fail: (err) => {
          console.error('页面跳转失败:', err)
          uni.showToast({
            title: '页面跳转失败',
            icon: 'none'
          })
        }
      })
    }
  }
}
</script>

