		font-size: 26rpx;
		color: #333333;
	}

	.service-list {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.service-item {
		background: #FFFFFF;
		border-radius: 16rpx;
		display: flex;
		gap: 20rpx;
		padding: 20rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
		position: relative;
	}

	.service-image {
		width: 200rpx;
		height: 200rpx;
		border-radius: 12rpx;
		flex-shrink: 0;
	}

	.service-info {
		flex: 1;
