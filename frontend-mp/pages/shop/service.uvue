	}

	.service-count {
		font-size: 22rpx;
		color: #999999;
	}

	.add-cart-btn {
		position: absolute;
		bottom: 16rpx;
		right: 16rpx;
		width: 56rpx;
		height: 56rpx;
		background: #4CAF50;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
	}

	.add-icon {
		font-size: 40rpx;
		color: #FFFFFF;
		font-weight: bold;
		line-height: 1;
	}

	/* 悬浮购物车图标 */
	.float-cart {
		position: fixed;
		right: 50rpx;
		bottom: 170rpx;
		width: 100rpx;
		height: 100rpx;
		background: #FFFFFF;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
		z-index: 9999;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		border: 1rpx solid #F0F0F0;
	}

	.float-cart:active {
		transform: scale(0.92);
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
	}

	.cart-icon {
		font-size: 48rpx;
	}
