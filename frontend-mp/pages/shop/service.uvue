	}

	.service-tag {
		font-size: 22rpx;
		color: #4CAF50;
		background: #E8F5E9;
		padding: 4rpx 12rpx;
		border-radius: 6rpx;
	}

	.service-price-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
	}

	.price {
		font-size: 32rpx;
		color: #E53935;
		font-weight: bold;
	}

	.unit {
		font-size: 22rpx;
