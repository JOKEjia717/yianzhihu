		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
	}

	.back-icon {
		color: #FFFFFF;
		font-size: 44rpx;
		font-weight: bold;
	}

	.title {
		color: #FFFFFF;
		font-size: 34rpx;
		font-weight: 600;
	}

	.placeholder {
		width: 60rpx;
	}

