</template>

<script lang="uts">
	interface Service {
		id: number
		name: string
		desc: string
		price: string
		icon: string
		bgColor: string
	}

	interface Guarantee {
		id: number
		icon: string
		text: string
	}

	export default {
		data() {
			return {
				services: [
					{ id: 1, name: '日常护理', desc: '生活照料、健康监测', price: '¥150/小时起', icon: '💉', bgColor: '#E3F2FD' },
					{ id: 2, name: '康复护理', desc: '术后康复、功能训练', price: '¥200/小时起', icon: '🏥', bgColor: '#E8F5E9' },
					{ id: 3, name: '专业陪护', desc: '医院陪护、全程照顾', price: '¥260/天起', icon: '👩‍⚕️', bgColor: '#FFF3E0' },
					{ id: 4, name: '居家护理', desc: '家庭病床、长期照料', price: '¥300/天起', icon: '🏠', bgColor: '#FCE4EC' },
					{ id: 5, name: '健康管理', desc: '健康评估、定制方案', price: '¥180/次', icon: '📊', bgColor: '#EDE7F6' },
					{ id: 6, name: '心理疏导', desc: '情绪安抚、心理支持', price: '¥200/小时', icon: '💚', bgColor: '#E0F7FA' }
				] as Service[],
				guarantees: [
					{ id: 1, icon: '✅', text: '持证上岗' },
					{ id: 2, icon: '✅', text: '全程保险' },
					{ id: 3, icon: '✅', text: '不满意退款' },
					{ id: 4, icon: '✅', text: '隐私保护' }
				] as Guarantee[]
			}
		},
		methods: {
			goBack() {
				uni.navigateBack()
			},
			selectService(service: Service) {
				uni.showToast({
					title: `已选择：${service.name}`,
					icon: 'none'
				})
			},
			submitOrder() {
				uni.showModal({
					title: '预约成功',
					content: '我们将尽快安排护工上门服务',
					showCancel: false
				})
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			}
		}
	}
</script>

