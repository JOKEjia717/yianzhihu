<template>
	<view class="container">


		<!-- 内容区域 -->
		<scroll-view class="content" scroll-y>
			<!-- 服务介绍 -->
			<view class="service-intro">
				<image src="/static/images/banner.jpg" mode="aspectFill"></image>
				<view class="intro-overlay"></view>
				<view class="intro-content">
					<text class="intro-title">专业护工 贴心服务</text>
					<text class="intro-desc">24小时上门服务 专业护理团队</text>
				</view>
			</view>

			<!-- 服务项目 -->
			<view class="section-header">
				<text class="section-title">服务项目</text>
			</view>

			<view class="service-list">
				<view class="service-item" v-for="item in services" :key="item.id" @click="selectService(item)">
					<view class="service-icon-wrapper" :style="{background: item.bgColor}">
						<text class="service-icon">{{item.icon}}</text>
					</view>
					<view class="service-info">
						<text class="service-name">{{item.name}}</text>
						<text class="service-desc">{{item.desc}}</text>
						<text class="service-price">{{item.price}}</text>
					</view>
				</view>
			</view>

			<!-- 服务保障 -->
			<view class="section-header">
				<text class="section-title">服务保障</text>
			</view>

			<view class="guarantee-list">
				<view class="guarantee-item" v-for="item in guarantees" :key="item.id">
					<view class="guarantee-icon">{{item.icon}}</view>
					<text class="guarantee-text">{{item.text}}</text>
				</view>
			</view>

			<!-- 立即预约 -->
			<view class="bottom-btn" @click="submitOrder">
				<text class="btn-text">立即预约</text>
			</view>
		</scroll-view>

