							<view class="progress-bar">
								<view class="progress-fill" :style="{width: item.progress + '%'}"></view>
							</view>
						</view>
					</view>
					<view class="add-cart-btn" @click.stop="addToCart(item)">
						<text class="add-icon">+</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 悬浮购物车图标 -->
		<view class="float-cart" @click="goToCart">
			<view class="cart-icon">🛒</view>
		</view>
	</view>
</template>

<script lang="uts">
	interface Product {
		id: number
		name: string
		desc: string
		prePrice: number
		originalPrice: number
		booked: number
		total: number
		progress: number
		image: string
	}

	export default {
		data() {
			return {
				products: [
					{ id: 1, name: '进口营养奶粉', desc: '新西兰进口 品质保证', prePrice: 188, originalPrice: 258, booked: 126, total: 200, progress: 63, image: '/static/images/presale/product.png' },
					{ id: 2, name: '智能健康手表', desc: '心率监测 睡眠分析', prePrice: 499, originalPrice: 699, booked: 89, total: 150, progress: 59, image: '/static/images/presale/product1.png' },
					{ id: 3, name: '助行机器人', desc: '智能跟随 轻松出行', prePrice: 1999, originalPrice: 2999, booked: 45, total: 100, progress: 45, image: '/static/images/presale/product2.png' },
					{ id: 4, name: '按摩椅豪华版', desc: '全身按摩 零重力体验', prePrice: 5999, originalPrice: 8999, booked: 23, total: 50, progress: 46, image: '/static/images/presale/product3.png' }
				] as Product[]
			}
		},
		methods: {
			goBack() {
				uni.navigateBack()
			},
			goToDetail(id: number) {
				uni.showToast({
					title: '商品详情开发中',
					icon: 'none'
				})
			},
			addToCart(item: Product) {
				uni.showToast({
					title: '已加入购物车',
					icon: 'success'
				})
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			}
		}
	}
</script>

