<script lang="uts">
	interface Product {
		id: number
		name: string
		desc: string
		price: number
		originalPrice: number
		badge?: string
		image: string
	}

	interface FunctionItem {
		icon: string
		name: string
		type: string
		bgColor: string
	}

	export default {
		data() {
			return {
				searchKey: '',
				products: [
					{ id: 1, name: '智能血压计', desc: '精准测量 一键操作', price: 159, originalPrice: 199, badge: '热销', image: '/static/images/product4.png' },
					{ id: 2, name: '轻便助行器', desc: '折叠便携 稳固安全', price: 298, originalPrice: 399, badge: '推荐', image: '/static/images/product5.png' },
					{ id: 3, name: '放大镜', desc: '高清放大 舒适阅读', price: 59, originalPrice: 89, image: '/static/images/product6.png' },
					{ id: 4, name: '智能按摩椅', desc: '全身按摩 舒缓疲劳', price: 5999, originalPrice: 7999, badge: '新品', image: '/static/images/product7.png' },
					{ id: 5, name: '中老年奶粉', desc: '高钙配方 营养丰富', price: 128, originalPrice: 168, image: '/static/images/product8.png' },
					{ id: 6, name: '足浴盆', desc: '恒温加热 多档调节', price: 299, originalPrice: 399, badge: '7.5折', image: '/static/images/product12.jpg' }
				] as Product[],
				functionItems: [
					{ icon: '/static/images/icon-popular.png', name: '热门促销', type: 'popular' },
					{ icon: '/static/images/icon-reserve.png', name: '预售', type: 'presale' },
					{ icon: '/static/images/icon-new.png', name: '生鲜', type: 'fresh' },
					{ icon: '/static/images/icon-drink.png', name: '乳品', type: 'milk' },
					{ icon: '/static/images/icon-care.png', name: '护工到家', type: 'nurse-home' },
					{ icon: '/static/images/icon-money.png', name: '服务', type: 'service' },
					{ icon: '/static/images/icon-frsh.png', name: '便利店', type: 'convenience' },
					{ icon: '/static/images/icon-self.png', name: '老人专区', type: 'elder' },
					{ icon: '/static/images/icon-recommend.png', name: '推荐', type: 'recommend' },
					{ icon: '/static/images/icon-more.png', name: '更多', type: 'more' }
				] as FunctionItem[]
			}
		},
		methods: {
			goBack() {
				uni.reLaunch({
					url: '/pages/elder/index'
				})
			},
			handleSearch() {
				uni.showToast({
					title: '搜索功能开发中',
					icon: 'none'
				})
			},
			togglePriceFilter() {
				uni.showToast({
					title: '筛选功能开发中',
					icon: 'none'
				})
			},
			handleFunction(type: string) {
				const urlMap: Record<string, string> = {
					'popular': '/pages/shop/popular',
					'presale': '/pages/shop/presale',
					'fresh': '/pages/shop/fresh',
					'milk': '/pages/shop/milk',
					'nurse-home': '/pages/shop/nurse-home',
					'service': '/pages/shop/service',
					'convenience': '/pages/shop/convenience',
					'elder': '/pages/shop/elder',
					'recommend': '/pages/shop/recommend'
				}
				const url = urlMap[type]
				if (url) {
					uni.navigateTo({ url })
				} else {
					uni.showToast({
						title: '功能开发中',
						icon: 'none'
					})
				}
			},
			goToDetail(id: number) {
				uni.showToast({
					title: '商品详情开发中',
					icon: 'none'
				})
			},
			addToCart(item: Product) {
				uni.showToast({
					title: '已加入购物车',
					icon: 'success'
				})
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			}
		}
	}
</script>

