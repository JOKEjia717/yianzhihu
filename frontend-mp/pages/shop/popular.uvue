		</view>
	</view>
</template>

<script lang="uts">
	interface Product {
		id: number
		name: string
		desc: string
		price: number
		originalPrice: number
		discount: string
		image: string
	}

	export default {
		data() {
			return {
				products: [
					{ id: 1, name: '智能血压计', desc: '精准测量 一键操作', price: 159, originalPrice: 199, discount: '8折', image: '/static/images/product4.png'},
