					{ id: 6, name: '足浴盆', desc: '恒温加热 多档调节', price: 299, originalPrice: 399, discount: '7.5折', image: '/static/images/product9.png' }
				] as Product[]
			}
		},
		methods: {
			goBack() {
				uni.navigateBack()
			},
			goToDetail(id: number) {
				uni.showToast({
					title: '商品详情开发中',
					icon: 'none'
				})
			},
			addToCart(item: Product) {
				uni.showToast({
					title: '已加入购物车',
					icon: 'success'
				})
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			}
		}
	}
</script>

