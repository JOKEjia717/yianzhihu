</template>

<script lang="uts">
	interface Product {
		id: number
		name: string
		desc: string
		price: number
		image: string
	}

	export default {
		data() {
			return {
				products: [
					{ id: 1, name: '助行器', desc: '轻便折叠 稳固安全', price: 299, image: '/static/images/product4.jpg' },
					{ id: 2, name: '血压计', desc: '一键测量 语音播报', price: 199, image: '/static/images/product6.jpg' },
					{ id: 3, name: '奶粉', desc: '中老年高钙配方', price: 128, image: '/static/images/product2.jpg' },
					{ id: 4, name: '放大镜', desc: '高清放大 手持便携', price: 59, image: '/static/images/product11.jpg' },
					{ id: 5, name: '收音机', desc: '大音量 清晰音质', price: 168, image: '/static/images/product10.jpg' },
					{ id: 6, name: '防滑拖鞋', desc: '柔软舒适 安全防滑', price: 35, image: '/static/images/product3.jpg' }
				] as Product[],
				history: [
					{ id: 2, name: '智能血压计', price: 199, image: '/static/images/product6.jpg' },
					{ id: 4, name: '放大镜', price: 59, image: '/static/images/product11.jpg' }
				] as Product[]
			}
		},
		methods: {
			goBack() {
				uni.navigateBack()
			},
			goToDetail(id: number) {
				uni.showToast({
					title: '商品详情开发中',
					icon: 'none'
				})
			},
			addToCart(item: Product) {
				uni.showToast({
					title: '已加入购物车',
					icon: 'success'
				})
			},
			deleteHistory(id: number) {
				this.history = this.history.filter(item => item.id !== id)
				uni.showToast({
					title: '已删除',
					icon: 'none'
				})
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			}
		}
	}
</script>

