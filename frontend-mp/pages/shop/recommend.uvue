				<view class="featured-overlay"></view>
				<view class="featured-info">
					<text class="featured-badge">今日精选</text>
					<text class="featured-name">智能按摩椅</text>
					<text class="featured-desc">全身按摩 零重力体验</text>
					<view class="featured-price-row">
						<text class="featured-price">¥2999</text>
						<view class="featured-btn">立即购买</view>
					</view>
				</view>
			</view>

			<!-- 猜你喜欢 -->
			<view class="section-header">
				<text class="section-title">猜你喜欢</text>
			</view>

			<view class="product-grid">
				<view class="product-item" v-for="item in products" :key="item.id">
					<image class="product-image" :src="item.image" mode="aspectFill" @click="goToDetail(item.id)"></image>
					<text class="product-name">{{item.name}}</text>
					<text class="product-desc">{{item.desc}}</text>
					<text class="product-price">¥{{item.price}}</text>
					<view class="add-cart-btn" @click.stop="addToCart(item)">
						<text class="add-icon">+</text>
					</view>
				</view>
			</view>

			<!-- 浏览记录 -->
			<view class="section-header">
				<text class="section-title">浏览记录</text>
			</view>

			<view class="history-list">
				<view class="history-item" v-for="item in history" :key="item.id" @click="goToDetail(item.id)">
					<image class="history-image" :src="item.image" mode="aspectFill"></image>
					<view class="history-info">
						<text class="history-name">{{item.name}}</text>
						<text class="history-price">¥{{item.price}}</text>
					</view>
					<text class="history-delete" @click.stop="deleteHistory(item.id)">删除</text>
				</view>
			</view>
		</scroll-view>

		<!-- 悬浮购物车图标 -->
		<view class="float-cart" @click="goToCart">
			<view class="cart-icon">🛒</view>
