<template>
  <view class="container">
    <view class="top-bar"></view>

    <!-- <view class="header">
      <text class="title">院下管理</text>
      <text class="subtitle">申请处理与院内老人管理</text>
    </view> -->

    <view class="login-options">
      <view class="option-card hero-card">
        <view class="card-content">
          <text class="option-title">入园申请</text>
          <text class="option-subtitle">Admission Requests</text>
          <text class="hero-desc">这里可以快速处理入园申请，并查看当前院下老人情况。</text>
          <view class="hero-actions">
            <view class="hero-btn primary" @click="fetchApplications">
              <text>刷新申请</text>
            </view>
            <view class="hero-btn" @click="fetchAllElderly">
              <text>刷新老人</text>
            </view>
          </view>
        </view>
      </view>

      <view class="option-card info-card">
        <view class="card-content">
          <text class="option-title">管理概览</text>
          <text class="option-subtitle">Management Overview</text>
          <view class="sub-options">
            <text>○ 入园申请：{{ applications.length }} 条</text>
            <text>○ 院下老人：{{ elderlies.length }} 人</text>
            <text>○ 当前状态：{{ loading || loadingElderly ? '加载中' : '已就绪' }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="content-stack">
      <view class="panel-card">
        <view class="section-title">
          <text>入园申请</text>
          <text class="section-subtitle">{{ applications.length }} 条</text>
        </view>

        <view v-if="loading" class="state-box">
          <text>加载中...</text>
        </view>
        <view v-else-if="applications.length === 0" class="state-box empty">
          <text>暂无申请信息</text>
        </view>
        <view v-else class="application-list">
          <view v-for="item in applications" :key="item.name + item.childrenPhone" class="application-item">
            <view class="avatar-wrapper">
              <image class="avatar" :src="item.photo || '/static/images/default-avatar.png'" mode="aspectFill"></image>
            </view>
            <view class="info-container">
              <view class="info-row top">
                <text class="name">{{ item.name }}</text>
                <text class="gender">{{ item.gender === 1 ? '男' : '女' }}</text>
                <text class="age">{{ item.age }}岁</text>
              </view>
              <view class="info-row">
                <text class="label">联系方式</text>
                <text class="value">{{ item.childrenPhone }}</text>
              </view>
              <view class="info-row">
                <text class="label">申请时间</text>
                <text class="value">{{ item.applicationTime }}</text>
              </view>
              <view class="action-buttons">
                <view class="approve-btn" @click="approveApplication(item)">
                  <text class="btn-text">同意</text>
                </view>
                <view class="reject-btn" @click="rejectApplication(item)">
                  <text class="btn-text">拒绝</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="panel-card">
        <view class="section-title">
          <text>院下老人</text>
          <text class="section-subtitle">{{ elderlies.length }} 人</text>
        </view>

        <view v-if="loadingElderly" class="state-box">
          <text>加载中...</text>
        </view>
        <view v-else-if="elderlies.length === 0" class="state-box empty">
          <text>暂无院下老人信息</text>
        </view>
        <view v-else class="elderly-list">
          <view v-for="item in elderlies" :key="item.name + item.childrenPhone" class="elderly-item">
            <view class="avatar-wrapper">
              <image class="avatar" :src="item.photo || '/static/images/default-avatar.png'" mode="aspectFill"></image>
            </view>
            <view class="info-container">
              <view class="info-row top">
                <text class="name">{{ item.name }}</text>
                <text class="gender">{{ item.gender === 1 ? '男' : '女' }}</text>
                <text class="age">{{ item.age }}岁</text>
              </view>
              <view class="info-row">
                <text class="label">子女</text>
                <text class="value">{{ item.childrenName }}</text>
              </view>
              <view class="info-row">
                <text class="label">联系方式</text>
                <text class="value">{{ item.childrenPhone }}</text>
              </view>
              <view class="info-row">
                <text class="label">入院时间</text>
                <text class="value">{{ item.applicationTime }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
        <text class="tabbar-text">详情</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/dispute')">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text">活动</text>
      </view>
      <view class="tabbar-item active" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text active">院下管理</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/profile')">
        <image class="tabbar-icon" src="/static/images/user.png"></image>
        <text class="tabbar-text">我的</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface Application {
  elderId?: string | null
  caretakerId?: string | null
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string | null
  photo?: string
  childrenId: number
  isEnable: number
}

interface ApiResponse {
  code: number
  msg: string | null
  data: Application[]
}

export default {
  data() {
    return {
      loading: false,
      loadingElderly: false,
      applications: [] as Application[],
      elderlies: [] as Application[]
    }
  },
  onLoad() {
    this.fetchApplications()
    this.fetchAllElderly()
  },
  methods: {
    async fetchApplications() {
      this.loading = true
      try {
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        if (!accessToken || !refreshToken) {
          uni.showToast({ title: '请先登录', icon: 'none' })
          uni.redirectTo({ url: '/pages/dean/login' })
          return
        }

        uni.request({
          url: 'http://localhost:8080/elder/getByElder',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          success: (res) => {
            const response = res.data as ApiResponse
            if (response.code === 1 && response.data) {
              this.applications = response.data
            } else {
              this.applications = []
              uni.showToast({ title: '获取申请数据失败', icon: 'none' })
            }
            this.loading = false
          },
          fail: (err) => {
            console.error('请求失败:', err)
            uni.showToast({ title: '网络请求失败', icon: 'none' })
            this.loading = false
          }
        })
      } catch (error) {
        console.error('获取申请数据出错:', error)
        uni.showToast({ title: '获取数据出错', icon: 'none' })
        this.loading = false
      }
    },
    async fetchAllElderly() {
      this.loadingElderly = true
      try {
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        if (!accessToken || !refreshToken) {
          uni.showToast({ title: '请先登录', icon: 'none' })
          uni.redirectTo({ url: '/pages/dean/login' })
          return
        }

        uni.request({
          url: 'http://localhost:8080/elder/getAllElder',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          success: (res) => {
            const response = res.data as ApiResponse
            if (response.code === 1 && response.data) {
              this.elderlies = response.data
            } else {
              this.elderlies = []
              uni.showToast({ title: '获取老人数据失败', icon: 'none' })
            }
            this.loadingElderly = false
          },
          fail: (err) => {
            console.error('请求失败:', err)
            uni.showToast({ title: '网络请求失败', icon: 'none' })
            this.loadingElderly = false
          }
        })
      } catch (error) {
        console.error('获取老人数据出错:', error)
        uni.showToast({ title: '获取数据出错', icon: 'none' })
        this.loadingElderly = false
      }
    },
    approveApplication(item: Application) {
      uni.showModal({
        title: '确认',
        content: `确定同意 ${item.name} 的入园申请吗？`,
        success: (res) => {
          if (res.confirm) {
            uni.showToast({ title: '已同意申请', icon: 'success' })
          }
        }
      })
    },
    rejectApplication(item: Application) {
      uni.showModal({
        title: '确认',
        content: `确定拒绝 ${item.name} 的入园申请吗？`,
        success: (res) => {
          if (res.confirm) {
            uni.showToast({ title: '已拒绝申请', icon: 'success' })
          }
        }
      })
    },
    redirectTo(url: string) {
      uni.redirectTo({ url: url })
    }
  }
}
</script>

