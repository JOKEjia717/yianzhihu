<template>
  <view class="page">
    <!-- 顶部标题 -->
    <view class="header">
      <text class="header-title">院下管理</text>
      <text class="sub-title">最懂你的系统</text>
    </view>
    
    <!-- 入园申请模块 -->
    <view class="content-section">
      <view class="section-title">
        <text>入园申请</text>
      </view>
      
      <view v-if="loading" class="loading">
        <text>加载中...</text>
      </view>
      
      <view v-else-if="applications.length === 0" class="no-data">
        <text>暂无申请信息</text>
      </view>
      
      <view v-else class="application-list">
        <view v-for="(item, index) in applications" :key="index" class="application-item">
          <view class="applicant-info">
            <view class="avatar-container" v-if="item.photo">
              <image class="avatar" :src="item.photo" mode="aspectFill"></image>
            </view>
            <view class="info-container">
              <view class="info-row">
                <text class="name">{{item.name}}</text>
                <text class="gender">{{item.gender === 1 ? '男' : '女'}}</text>
                <text class="age">{{item.age}}岁</text>
              </view>
              <view class="info-row">
                <text class="contact-label">联系方式:</text>
                <text class="contact">{{item.childrenPhone}}</text>
              </view>
              <view class="info-row">
                <text class="application-label">申请时间:</text>
                <text class="application-time">|{{item.applicationTime}}</text>
              </view>
              <view class="action-buttons">
                <view class="approve-btn" @click="approveApplication(item)">
                  <text class="btn-text">同意</text>
                </view>
                <view class="reject-btn" @click="rejectApplication(item)">
                  <text class="btn-text">拒绝</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 院下老人模块 -->
    <view class="content-section">
      <view class="section-title">
        <text>院下老人</text>
      </view>
      
      <view v-if="loadingElderly" class="loading">
        <text>加载中...</text>
      </view>
      
      <view v-else-if="elderlies.length === 0" class="no-data">
        <text>暂无院下老人信息</text>
      </view>
      
      <view v-else class="elderly-list">
        <view v-for="(item, index) in elderlies" :key="index" class="elderly-item">
          <view class="elderly-info">
            <view class="avatar-container" v-if="item.photo">
              <image class="avatar" :src="item.photo" mode="aspectFill"></image>
            </view>
            <view class="info-container">
              <view class="info-row">
                <text class="name">{{item.name}}</text>
                <text class="gender">{{item.gender === 1 ? '男' : '女'}}</text>
                <text class="age">{{item.age}}岁</text>
              </view>
              <view class="info-row">
                <text class="contact-label">子女:</text>
                <text class="contact">{{item.childrenName}}</text>
              </view>
              <view class="info-row">
                <text class="contact-label">联系方式:</text>
                <text class="contact">{{item.childrenPhone}}</text>
              </view>
              <view class="info-row">
                <text class="application-label">入院时间:</text>
                <text class="application-time">|{{item.applicationTime}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部导航栏 -->
    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
        <text class="tabbar-text">详情</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/dispute')">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text">活动</text>
      </view>
      <view class="tabbar-item active" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text active">院下管理</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/profile')">
        <image class="tabbar-icon" src="/static/images/user.png"></image>
        <text class="tabbar-text">我的</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface Application {
  elderId?: string | null
  caretakerId?: string | null
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string | null
  photo?: string
  childrenId: number
  isEnable: number
}

interface ApiResponse {
  code: number
  msg: string | null
  data: Application[]
}

export default {
  data() {
    return {
      loading: false,
      loadingElderly: false,
      applications: [] as Application[],
      elderlies: [] as Application[]
    }
  },
  onLoad() {
    this.fetchApplications()
    this.fetchAllElderly()
  },
  methods: {
    async fetchApplications() {
      this.loading = true
      
      try {
        // 从本地存储获取Token
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          // 跳转到登录页面
          uni.redirectTo({
            url: '/pages/dean/login'
          })
          this.loading = false
          return
        }
        
        // 发送axios请求获取数据
        uni.request({
          url: 'http://localhost:8080/elder/getByElder',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          success: (res) => {
            const response = res.data as ApiResponse
            if (response.code === 1 && response.data) {
              this.applications = response.data
            } else {
              uni.showToast({
                title: '获取申请数据失败',
                icon: 'none'
              })
            }
            this.loading = false
          },
          fail: (err) => {
            console.error('请求失败:', err)
            uni.showToast({
              title: '网络请求失败',
              icon: 'none'
            })
            this.loading = false
          }
        })
      } catch (error) {
        console.error('获取申请数据出错:', error)
        uni.showToast({
          title: '获取数据出错',
          icon: 'none'
        })
        this.loading = false
      }
    },
    
    async fetchAllElderly() {
      this.loadingElderly = true
      
      try {
        // 从本地存储获取Token
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          // 跳转到登录页面
          uni.redirectTo({
            url: '/pages/dean/login'
          })
          this.loadingElderly = false
          return
        }
        
        // 发送axios请求获取数据
        uni.request({
          url: 'http://localhost:8080/elder/getAllElder',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          success: (res) => {
            const response = res.data as ApiResponse
            if (response.code === 1 && response.data) {
              this.elderlies = response.data
            } else {
              uni.showToast({
                title: '获取老人数据失败',
                icon: 'none'
              })
            }
            this.loadingElderly = false
          },
          fail: (err) => {
            console.error('请求失败:', err)
            uni.showToast({
              title: '网络请求失败',
              icon: 'none'
            })
            this.loadingElderly = false
          }
        })
      } catch (error) {
        console.error('获取老人数据出错:', error)
        uni.showToast({
          title: '获取数据出错',
          icon: 'none'
        })
        this.loadingElderly = false
      }
    },
    
    // 同意申请
    approveApplication(item: Application) {
      uni.showModal({
        title: '确认',
        content: `确定同意 ${item.name} 的入园申请吗？`,
        success: (res) => {
          if (res.confirm) {
            uni.showToast({
              title: '已同意申请',
              icon: 'success'
            })
            // 这里可以添加向后端发送同意请求的逻辑
          }
        }
      })
    },
    
    // 拒绝申请
    rejectApplication(item: Application) {
      uni.showModal({
        title: '确认',
        content: `确定拒绝 ${item.name} 的入园申请吗？`,
        success: (res) => {
          if (res.confirm) {
            uni.showToast({
              title: '已拒绝申请',
              icon: 'success'
            })
            // 这里可以添加向后端发送拒绝请求的逻辑
          }
        }
      })
    },
    
    // 查看申请详情
    viewApplicationDetail(item: Application) {
      uni.showToast({
        title: '查看详情功能开发中',
        icon: 'none'
      })
    },
    
    // 跳转到院下老人页面
    navigateToElderly() {
      uni.navigateTo({
        url: '/pages/dean/elderly'
      })
    },
    
    // 页面跳转
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    }
  }
}
</script>

