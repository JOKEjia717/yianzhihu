<template>
  <view class="page">
    <!-- 顶部渐变背景 -->
    <view class="header">
      <text class="header-title">活动</text>
    </view>
    
    <!-- 搜索 -->
    <view class="search-box">
      <image class="search-icon" src="/static/images/Serch.png" mode=""></image>
      <input type="text" v-model="searchKey" placeholder="请输入您要查找的活动" @input="searchActivity" confirm-type="search" />
    </view>
    
    <!-- 替换原来的固定添加活动按钮，使用可拖动的浮动按钮 -->
    <view 
      class="add-btn" 
      :style="{ left: btnPosition.left + 'px', top: btnPosition.top + 'px', right: 'auto', bottom: 'auto' }"
      @click="showAddActivityModal" 
      @longpress="startMoveBtn"
      @touchmove="moveBtn"
      @touchend="endMoveBtn"
    >
      <text class="add-icon">+</text>
      <text v-if="isMoving" class="moving-tip">松开手指放置</text>
    </view>
    
    <!-- 活动推荐 -->
    <view class="content-section">
      <view class="section-title">
        <text>活动推荐</text>
        <view class="change-btn" @click="changeActivity">
          <text>换一批活动</text>
        </view>
      </view>
      
      <view v-if="loading" class="loading">
        <text>加载...</text>
      </view>
      
      <view v-else-if="!currentActivity" class="no-activity">
        <text>暂无活动信息</text>
      </view>
      
      <view v-else class="activity-card">
        <image class="activity-image" :src="currentActivity.activityData" mode="aspectFill"></image>
        <view class="activity-info">
          <text class="activity-name">{{currentActivity.name}}</text>
          <text class="activity-time">{{formattedStartTime}} - {{formattedEndTime}}</text>
          <text class="activity-desc">{{currentActivity.description}}</text>
          <view class="activity-tags">
            <text class="tag" v-for="tag in activityTags" :key="tag">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 功能指标 -->
    <view class="feature-section">
      <view class="feature-item">
        <image class="feature-icon" src="/static/images/calorie.png" mode="aspectFit"></image>
        <text class="feature-text">活动消耗热量</text>
        <text class="feature-value">300 大卡</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/static/images/food.png" mode="aspectFit"></image>
        <text class="feature-text">活动后推荐补给</text>
        <text class="feature-value">蛋白质饮料</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/static/images/time.png" mode="aspectFit"></image>
        <text class="feature-text">活动总计时长</text>
        <text class="feature-value">45 分钟</text>
      </view>
    </view>
    
    <!-- 老人信息列表 -->
    <view class="content-section">
      <view class="section-title">
        <text>参与老人</text>
      </view>
      
      <view class="elderly-list">
        <view v-for="(elderly, index) in filteredElderlyList" :key="elderly.id" class="elderly-item">
          <view class="elderly-avatar-container">
            <image class="elderly-avatar" :src="elderly.avatar || '/static/images/default-avatar.png'" mode="aspectFill"></image>
          </view>
          <view class="elderly-info">
            <text class="elderly-name">{{elderly.name}}</text>
            <view class="elderly-tags">
              <text :class="['status-tag', elderly.healthStatus === 'good' ? 'good' : 'warning']">{{elderly.healthStatus === 'good' ? '健康' : '需关注'}}</text>
            </view>
            <text class="elderly-contact">紧急联系人: {{elderly.emergencyContact}}</text>
          </view>
          <view :class="['query-btn', elderly.healthStatus === 'good' ? 'good' : 'warning']" @click="queryElderlyDetail(elderly.id)">
            <text>查询</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部导航 -->
    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
        <text class="tabbar-text">详情</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/dispute')">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item active" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text active">活动</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text">管理</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/profile')">
        <image class="tabbar-icon" src="/static/images/user.png"></image>
        <text class="tabbar-text">我的</text>
      </view>
    </view>
    
    <!-- 添加活动模态框 -->
    <view v-if="showAddModal" class="modal-mask" @click="hideAddActivityModal">
      <view class="add-activity-modal" @click.stop>
        <view class="modal-header">
          <text class="modal-title">新建活动</text>
          <text class="modal-close" @click="hideAddActivityModal">×</text>
        </view>
        
        <view class="modal-body">
          <view class="form-item">
            <text class="form-label">活动名称</text>
            <input class="form-input" v-model="newActivity.name" placeholder="请输入活动名称" />
          </view>
          
          <view class="form-item">
            <text class="form-label">开始时间</text>
            <view class="datetime-picker" @click="showStartTimePicker">
              <text class="picker-text">{{ newActivity.startTime || '请选择开始时间' }}</text>
            </view>
          </view>
          
          <view class="form-item">
            <text class="form-label">结束时间</text>
            <view class="datetime-picker" @click="showEndTimePicker">
              <text class="picker-text">{{ newActivity.endTime || '请选择结束时间' }}</text>
            </view>
          </view>
          
          <view class="form-item">
            <text class="form-label">活动描述</text>
            <textarea class="form-textarea" v-model="newActivity.description" placeholder="请输入活动描述" />
          </view>
          
          <view class="form-item">
            <text class="form-label">活动图片</text>
            <view class="upload-image" @click="chooseImage">
              <image v-if="newActivity.activityData" class="preview-image" :src="newActivity.activityData" mode="aspectFill"></image>
              <view v-else class="upload-placeholder">
                <text class="upload-icon">+</text>
                <text class="upload-text">上传图片</text>
              </view>
            </view>
          </view>
          
          <view class="form-item">
            <text class="form-label">活动标签</text>
            <view class="tag-container">
              <view 
                v-for="(tag, index) in availableTags" 
                :key="index" 
                :class="['tag-item', selectedTags.includes(tag) ? 'tag-selected' : '']"
                @click="toggleTag(tag)"
              >
                <text>{{ tag }}</text>
              </view>
            </view>
          </view>
        </view>
        
        <view class="modal-footer">
          <button class="cancel-btn" @click="hideAddActivityModal">取消</button>
          <button class="submit-btn" @click="submitNewActivity">确认提交</button>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface Elderly {
  id: string
  name: string
  avatar: string
  healthStatus: string // 'good' or 'warning'
  emergencyContact: string
}

interface Activity {
  activityId: string
  nursingHomeId: string
  name: string
  startTime: string
  endTime: string
  description: string
  activityData: string // 图片路径
  tags?: string[] // 添加对应的标签，用于显示
}

interface ActivityResponse {
  code: number
  msg: string | null
  data: {
    total: number
    pages: number
    current: number
    size: number
    records: Activity[]
  }
}

interface ElderlyResponse {
  code: number
  msg: string | null
  data: Array<{
    elderId: string | null
    caretakerId: string | null
    name: string
    gender: number
    age: number
    childrenName: string
    childrenPhone: string
    applicationTime: string
    createdTime: string | null
    photo: string | null
    childrenId: number
    isEnable: number
  }>
}

interface Position {
  left: number
  top: number
}

export default {
  data() {
    return {
      searchKey: '',
      deanId: '',
      page: 1,
      pageSize: 5,
      total: 0,
      loading: false,
      currentActivityIndex: 0,
      activityList: [] as Activity[],
      elderlyList: [] as Elderly[],
      // 添加活动模态框状态
      showAddModal: false,
      newActivity: {
        name: '',
        startTime: '',
        endTime: '',
        description: '',
        activityData: '',
        tags: [] as string[]
      },
      availableTags: ['健康', '娱乐', '学习', '运动', '文化', '手工', '美食', '户外活动', '室内活动', '亲子活动', '节日活动', '兴趣小组'],
      selectedTags: [] as string[],
      
      // 添加按钮拖动相关数据
      isMoving: false,
      btnPosition: {
        left: -1,
        top: -1
      } as Position
    }
  },
  onLoad() {
    this.fetchActivities()
    // 从本地存储中加载按钮位置
    this.loadBtnPosition()
  },
  computed: {
    filteredElderlyList(): Elderly[] {
      if (!this.searchKey.trim()) {
        return this.elderlyList
      }
      
      return this.elderlyList.filter(elderly => {
        return elderly.name.includes(this.searchKey) || 
               elderly.emergencyContact.includes(this.searchKey)
      })
    },
    currentActivity(): Activity | null {
      if (this.activityList.length === 0) {
        return null
      }
      return this.activityList[this.currentActivityIndex]
    },
    // 格式化开始时间，仅显示日期和时间
    formattedStartTime(): string {
      if (!this.currentActivity) return ''
      const startTime = this.currentActivity.startTime
      return this.formatDateTime(startTime)
    },
    // 格式化结束时间，仅显示时间
    formattedEndTime(): string {
      if (!this.currentActivity) return ''
      const endTime = this.currentActivity.endTime
      return this.formatTime(endTime)
    },
    // 获取活动的默认标签
    activityTags(): string[] {
      if (!this.currentActivity) return []
      
      // 如果活动有自定义标签则返回，否则根据活动名称和时间生成默认标签
      if (this.currentActivity.tags && this.currentActivity.tags.length > 0) {
        return this.currentActivity.tags
      }
      
      // 根据活动名称生成标签
      const tags: string[] = []
      
      if (this.currentActivity.name.includes('春游')) {
        tags.push('春游')
      } else if (this.currentActivity.name.includes('夏令营')) {
        tags.push('夏令营')
      } else if (this.currentActivity.name.includes('秋游')) {
        tags.push('秋游')
      } else if (this.currentActivity.name.includes('冬')) {
        tags.push('冬令营')
      }
      
      // 添加时间相关标签
      const time = new Date(this.currentActivity.startTime)
      const hour = time.getHours()
      if (hour >= 6 && hour < 12) {
        tags.push('上午')
      } else if (hour >= 12 && hour < 18) {
        tags.push('下午')
      } else {
        tags.push('晚上')
      }
      
      // 添加默认标签
      tags.push('园区活动')
      
      return tags
    }
  },
  methods: {
    async fetchActivities() {
      try {
        this.loading = true
        
        // 从本地存储获取Token
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          return
        }
        
        // 从本地存储获取用户信息中的deanId
        const userInfo = uni.getStorageSync('userInfo')
        if (userInfo) {
          this.deanId = userInfo.deanId || ''
        }
        
        // 发起请求获取活动数据
        const result = await uni.request({
          url: 'http://localhost:8080/activity/pageDetail',
          method: 'GET',
          data: {
            page: this.page.toString(),
            pageSize: this.pageSize.toString(),
            deanId: this.deanId
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })
        
        this.loading = false
        
        const response = result.data as ActivityResponse
        if (response.code === 1 && response.data) {
          this.activityList = response.data.records
          this.total = response.data.total
          
          // 为每个活动添加默认图片
          this.activityList.forEach(activity => {
            // 如果activityData路径不是有效的图片URL，则使用默认图片
            if (!activity.activityData || activity.activityData.includes('/path/to/')) {
              if (activity.name.includes('春游')) {
                activity.activityData = '/static/images/spring.jpg'
              } else if (activity.name.includes('夏令营')) {
                activity.activityData = '/static/images/summer.jpg'
              } else if (activity.name.includes('秋游')) {
                activity.activityData = '/static/images/autumn.jpg'
              } else if (activity.name.includes('冬')) {
                activity.activityData = '/static/images/winter.jpg'
              } else {
                activity.activityData = '/static/images/activity.jpg'
              }
            }
          })
          
          console.log('获取活动列表成功:', this.activityList)
          
          // 如果有活动则获取第一个活动的参与老人
          if (this.activityList.length > 0) {
            this.fetchActivityElders()
          }
        } else {
          uni.showToast({
            title: '获取活动列表失败',
            icon: 'none'
          })
        }
      } catch (error) {
        this.loading = false
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    
    async fetchActivityElders() {
      if (!this.currentActivity || !this.currentActivity.activityId) {
        console.error('无法获取老人信息：当前活动ID不存在')
        return
      }
      
      try {
        uni.showLoading({
          title: '加载中...'
        })
        
        // 从本地存储获取Token
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string
        
        if (!accessToken || !refreshToken) {
          uni.hideLoading()
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          return
        }
        
        // 发起请求获取参与该活动的老人数据
        const result = await uni.request({
          url: 'http://localhost:8080/activity/getElder',
          method: 'GET',
          data: {
            activityId: this.currentActivity.activityId
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })
        
        uni.hideLoading()
        
        const response = result.data as ElderlyResponse
        if (response.code === 1 && response.data) {
          // 转换API返回的老人数据格式为应用所需格式
          this.elderlyList = response.data.map((elderly, index) => {
            // 将childrenName和childrenPhone组合为紧急联系人信息
            const emergencyContact = `${elderly.childrenName} (子女) ${elderly.childrenPhone}`
            
            // 随机生成健康状态，80%概率为"健康"，20%概率为"需关注"
            const randomStatus = Math.random() > 0.2 ? 'good' : 'warning'
            
            // 直接使用photo作为URL，只有当它为null时才使用默认图片
            const avatarUrl = elderly.photo || '/static/images/default-avatar.png'
            
            return {
              id: (index + 1).toString(), // 使用索引作为临时ID
              name: elderly.name,
              avatar: avatarUrl,
              healthStatus: randomStatus,
              emergencyContact: emergencyContact
            } as Elderly
          })
          
          console.log('获取参与老人信息成功:', this.elderlyList)
        } else {
          console.error('获取参与老人信息失败:', response)
          uni.showToast({
            title: '获取参与老人信息失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求参与老人信息失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    
    searchActivity() {
      // 搜索活动的方法
      console.log('搜索关键词:', this.searchKey)
      // 这里可以添加搜索联想功能
    },
    
    changeActivity() {
      if (this.activityList.length <= 1) {
        uni.showToast({
          title: '没有更多活动',
          icon: 'none'
        })
        return
      }
      
      // 随机选择一个不同的活动索引
      let newIndex = this.currentActivityIndex
      while (newIndex === this.currentActivityIndex) {
        newIndex = Math.floor(Math.random() * this.activityList.length)
      }
      
      this.currentActivityIndex = newIndex
      console.log('切换到新活动:', this.currentActivity ? this.currentActivity.name : '无活动')
      
      // 获取新选中活动的参与老人
      this.fetchActivityElders()
    },
    
    queryElderlyDetail(id: string) {
      // 查询老人详情
      const elderly = this.elderlyList.find(item => item.id === id)
      if (elderly) {
        console.log('查询老人:', elderly.name, '健康状态:', elderly.healthStatus)
        uni.navigateTo({
          url: `/pages/dean/elderly-detail?id=${id}&status=${elderly.healthStatus}`
        })
      }
    },
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    },
    // 格式化日期时间，返回 yyyy-MM-dd HH:mm 格式
    formatDateTime(dateTimeStr: string): string {
      try {
        const date = new Date(dateTimeStr)
        const year = date.getFullYear()
        const month = this.padZero(date.getMonth() + 1)
        const day = this.padZero(date.getDate())
        const hours = this.padZero(date.getHours())
        const minutes = this.padZero(date.getMinutes())
        
        return `${year}-${month}-${day} ${hours}:${minutes}`
      } catch (e) {
        return dateTimeStr
      }
    },
    // 格式化时间，返回 HH:mm 格式
    formatTime(dateTimeStr: string): string {
      try {
        const date = new Date(dateTimeStr)
        const hours = this.padZero(date.getHours())
        const minutes = this.padZero(date.getMinutes())
        
        return `${hours}:${minutes}`
      } catch (e) {
        return dateTimeStr
      }
    },
    // 数字补零
    padZero(num: number): string {
      return num < 10 ? `0${num}` : `${num}`
    },
    // 加载按钮位置
    loadBtnPosition() {
      try {
        const position = uni.getStorageSync('activityAddBtnPosition')
        if (position) {
          const pos = JSON.parse(position) as Position
          this.btnPosition = pos
        } else {
          // 设置默认位置 (页面右下角)
          const systemInfo = uni.getSystemInfoSync()
          this.btnPosition = {
            left: systemInfo.windowWidth - 140,
            top: systemInfo.windowHeight - 220
          }
        }
      } catch (error) {
        console.error('获取按钮位置失败:', error)
        const systemInfo = uni.getSystemInfoSync()
        this.btnPosition = {
          left: systemInfo.windowWidth - 140,
          top: systemInfo.windowHeight - 220
        }
      }
    },
    
    // 开始移动按钮
    startMoveBtn(e: any) {
      this.isMoving = true
      uni.showToast({
        title: '按住拖动',
        icon: 'none',
        duration: 1000
      })
    },
    
    // 移动按钮
    moveBtn(e: any) {
      if (!this.isMoving) return
      
      // 防止事件冒泡和默认行为
      e.stopPropagation()
      e.preventDefault()
      
      // 更新按钮位置
      const touch = e.touches[0]
      this.btnPosition.left = touch.clientX - 50 // 按钮宽度的一半
      this.btnPosition.top = touch.clientY - 50 // 按钮高度的一半
    },
    
    // 结束移动按钮
    endMoveBtn() {
      if (!this.isMoving) return
      
      this.isMoving = false
      
      // 保存按钮位置到本地存储
      try {
        uni.setStorageSync('activityAddBtnPosition', JSON.stringify(this.btnPosition))
        uni.showToast({
          title: '位置已保存',
          icon: 'success',
          duration: 1000
        })
      } catch (error) {
        console.error('保存按钮位置失败:', error)
      }
    },
    
    // 显示添加活动模态框（更新，增加检查是否处于移动模式）
    showAddActivityModal() {
      // 如果按钮在移动模式下，不触发添加功能
      if (this.isMoving) return
      
      this.showAddModal = true
      this.resetNewActivity()
    },
    
    // 隐藏添加活动模态框
    hideAddActivityModal() {
      this.showAddModal = false
    },
    
    // 重置新建活动信息
    resetNewActivity() {
      this.newActivity = {
        name: '',
        startTime: '',
        endTime: '',
        description: '',
        activityData: '',
        tags: []
      }
      this.selectedTags = []
    },
    
    // 选择开始时间
    showStartTimePicker() {
      uni.showDatePicker({
        type: 'datetime',
        success: (res) => {
          this.newActivity.startTime = res.value
        }
      })
    },
    
    // 选择结束时间
    showEndTimePicker() {
      uni.showDatePicker({
        type: 'datetime',
        success: (res) => {
          this.newActivity.endTime = res.value
        }
      })
    },
    
    // 选择图片
    chooseImage() {
      uni.chooseImage({
        count: 1,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res) => {
          this.newActivity.activityData = res.tempFilePaths[0]
        }
      })
    },
    
    // 切换标签选择
    toggleTag(tag: string) {
      const index = this.selectedTags.indexOf(tag)
      if (index > -1) {
        this.selectedTags.splice(index, 1)
      } else {
        this.selectedTags.push(tag)
      }
    },
    
    // 提交新活动
    submitNewActivity() {
      // 验证表单
      if (!this.newActivity.name) {
        uni.showToast({
          title: '请输入活动名称',
          icon: 'none'
        })
        return
      }
      
      if (!this.newActivity.startTime) {
        uni.showToast({
          title: '请选择开始时间',
          icon: 'none'
        })
        return
      }
      
      if (!this.newActivity.endTime) {
        uni.showToast({
          title: '请选择结束时间',
          icon: 'none'
        })
        return
      }
      
      // 准备需要提交的数据
      const activityData = {
        nursingHomeId: this.deanId,
        name: this.newActivity.name,
        startTime: this.newActivity.startTime,
        endTime: this.newActivity.endTime,
        description: this.newActivity.description,
        activityData: this.newActivity.activityData,
        tags: this.selectedTags
      }
      
      // 显示加载
      uni.showLoading({
        title: '提交中...'
      })
      
      // 获取token
      const accessToken = uni.getStorageSync('accessToken') as string
      const refreshToken = uni.getStorageSync('refreshToken') as string
      
      // 发起请求
      uni.request({
        url: 'http://localhost:8080/activity/add',
        method: 'POST',
        data: activityData,
        header: {
          'accessToken': accessToken,
          'refreshToken': refreshToken,
          'Content-Type': 'application/json'
        },
        success: (res: any) => {
          uni.hideLoading()
          
          if (res.statusCode === 200 && res.data.code === 1) {
            uni.showToast({
              title: '添加活动成功',
              icon: 'success'
            })
            
            // 关闭模态框
            this.hideAddActivityModal()
            
            // 刷新活动列表
            this.fetchActivities()
          } else {
            uni.showToast({
              title: '提交失败',
              icon: 'none'
            })
          }
        },
        fail: () => {
          uni.hideLoading()
          uni.showToast({
            title: '提交失败',
            icon: 'none'
          })
        }
      })
    }
  }
}
</script>

