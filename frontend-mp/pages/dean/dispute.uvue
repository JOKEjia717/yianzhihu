<template>
  <view class="page">
    <view class="page-glow page-glow--left"></view>
    <view class="page-glow page-glow--right"></view>

    <view class="container">
      <view class="page-intro">
        <text class="page-title">纠纷台账</text>
        <text class="page-desc">查看新增、未解决和处理中事项。</text>
      </view>

      <view class="hero-card">
        <view class="hero-card__top">
          <view class="hero-card__title-wrap">

            <text class="hero-note">已完成 {{ disputeStats.resolved }} 条，当前还有 {{ getPendingCount() }} 条需要重点关注。</text>
          </view>
          <view class="hero-pill hero-pill--warning">
            <text class="hero-pill-text">{{ disputeStats.newCount }} 条新纠纷</text>
          </view>
        </view>

        <view class="hero-stats">
          <view class="hero-stat hero-stat--total">
            <text class="hero-stat-label">总数</text>
            <text class="hero-stat-value">{{ disputeStats.total }}</text>
          </view>
          <view class="hero-stat hero-stat--new">
            <text class="hero-stat-label">新增</text>
            <text class="hero-stat-value">{{ disputeStats.newCount }}</text>
          </view>
          <view class="hero-stat hero-stat--resolving">
            <text class="hero-stat-label">处理中</text>
            <text class="hero-stat-value">{{ disputeStats.resolving }}</text>
          </view>
          <view class="hero-stat hero-stat--unresolved">
            <text class="hero-stat-label">未解决</text>
            <text class="hero-stat-value">{{ disputeStats.unresolved }}</text>
          </view>
        </view>
      </view>

      <view class="section search-section">
        <view class="search-bar">
          <image class="search-icon" src="/static/images/Serch.png" mode="aspectFit"></image>
          <input
            class="search-input"
            type="text"
            v-model="searchKey"
            placeholder="搜索标题、描述或时间"
            confirm-type="search"
            @confirm="searchDispute"
          />
          <view v-if="searchKey" class="search-clear" @click="clearSearch">
            <text class="search-clear-text">清空</text>
          </view>
        </view>

        <view class="filter-row">
          <view
            v-for="tab in statusTabs"
            :key="tab.value || 'all'"
            :class="['filter-chip', selectedStatus === tab.value ? 'active' : '']"
            @click="selectStatus(tab.value)"
          >
            <text class="filter-chip-label">{{ tab.label }}</text>
            <text class="filter-chip-count">{{ getStatusCount(tab.value) }}</text>
          </view>
        </view>
      </view>

      <view class="section list-section">
        <view class="section-header">
          <view>
            <text class="section-title">纠纷列表</text>
            <text class="section-subtitle">{{ getListSubtitle() }}</text>
          </view>
          <view class="section-pill section-pill--soft">
            <text class="section-pill-text">{{ filteredDisputeList.length }} 条</text>
          </view>
        </view>

        <view v-if="filteredDisputeList.length > 0" class="dispute-list">
          <view
            v-for="dispute in filteredDisputeList"
            :key="dispute.id"
            class="dispute-card"
            :class="'dispute-card--' + dispute.status"
          >
            <view class="dispute-card__top">
              <view class="dispute-card__title-wrap">
                <text class="dispute-title">{{ dispute.title }}</text>
                <view class="dispute-meta">
                  <text class="dispute-time">{{ dispute.time }}</text>
                  <text class="dispute-id">编号 {{ dispute.id }}</text>
                </view>
              </view>
              <view class="status-pill" :class="getStatusClass(dispute.status)">
                <text class="status-pill-text">{{ getStatusText(dispute.status) }}</text>
              </view>
            </view>
            <text class="dispute-desc">{{ dispute.description }}</text>
          </view>
        </view>

        <view v-else class="empty-state">
          <view class="empty-icon">
            <image class="empty-icon-image" src="/static/images/dispute.png" mode="aspectFit"></image>
          </view>
          <text class="empty-title">暂无匹配的纠纷记录</text>
          <text class="empty-desc">可以切换状态筛选，或者清空关键词重新查找。</text>
          <view class="empty-action" @click="resetFilters">
            <text class="empty-action-text">重置筛选</text>
          </view>
        </view>
      </view>
    </view>

    <view class="fab" @click="addDispute">
      <text class="fab-plus">+</text>
      <text class="fab-text">新增纠纷</text>
    </view>

    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
        <text class="tabbar-text">首页</text>
      </view>
      <view class="tabbar-item active">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text active">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text">活动</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text">院下管理</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/profile')">
        <image class="tabbar-icon" src="/static/images/user.png"></image>
        <text class="tabbar-text">我的</text>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
interface Dispute {
  id: string
  title: string
  time: string
  description: string
  status: string
}

interface StatusOption {
  label: string
  value: string
}

interface DisputeStats {
  total: number
  resolved: number
  resolving: number
  unresolved: number
  newCount: number
}

export default {
  data() {
    return {
      searchKey: '',
      selectedStatus: '',
      statusTabs: [
        { label: '全部', value: '' },
        { label: '新增', value: 'new' },
        { label: '未解决', value: 'unresolved' },
        { label: '处理中', value: 'resolving' },
        { label: '已解决', value: 'resolved' }
      ] as StatusOption[],
      disputeList: [
        {
          id: '1',
          title: '食堂餐费金额问题',
          time: '2023-06-15 09:30',
          description: '多位患者反映食堂餐费金额下降，部分饭菜不新鲜。',
          status: 'resolved'
        },
        {
          id: '2',
          title: '管理人员服务态度问题',
          time: '2023-06-18 14:45',
          description: '据大家反馈三号护理人员服务态度不佳。',
          status: 'resolving'
        },
        {
          id: '3',
          title: '公共区域噪音问题',
          time: '2023-06-20 16:20',
          description: '二楼多位患者反映一号活动室音响过大。',
          status: 'unresolved'
        },
        {
          id: '4',
          title: '设备维修延误',
          time: '2023-06-22 10:15',
          description: '四楼浴室热水器故障三天未维修。',
          status: 'unresolved'
        },
        {
          id: '5',
          title: '档案管理投诉',
          time: '2023-06-23 11:30',
          description: '病历档案错漏多，前台信息登记完全混乱。',
          status: 'new'
        }
      ] as Dispute[]
    }
  },
  computed: {
    filteredDisputeList(): Dispute[] {
      const keyword = String(this.searchKey || '').trim()
      const status = String(this.selectedStatus || '').trim()

      const filteredList = this.disputeList.filter(dispute => {
        const matchesStatus = !status || dispute.status === status
        const matchesKeyword =
          !keyword ||
          dispute.title.includes(keyword) ||
          dispute.description.includes(keyword) ||
          dispute.time.includes(keyword)

        return matchesStatus && matchesKeyword
      })

      return filteredList.slice().sort((left, right) => {
        const leftPriority = this.getStatusPriority(left.status)
        const rightPriority = this.getStatusPriority(right.status)

        if (leftPriority !== rightPriority) {
          return leftPriority - rightPriority
        }

        return String(right.time).localeCompare(String(left.time))
      })
    },
    disputeStats(): DisputeStats {
      const stats: DisputeStats = {
        total: this.disputeList.length,
        resolved: 0,
        resolving: 0,
        unresolved: 0,
        newCount: 0
      }

      this.disputeList.forEach(dispute => {
        switch (dispute.status) {
          case 'resolved':
            stats.resolved += 1
            break
          case 'resolving':
            stats.resolving += 1
            break
          case 'unresolved':
            stats.unresolved += 1
            break
          case 'new':
            stats.newCount += 1
            break
        }
      })

      return stats
    }
  },
  methods: {
    getStatusPriority(status: string) {
      switch (status) {
        case 'new':
          return 0
        case 'unresolved':
          return 1
        case 'resolving':
          return 2
        case 'resolved':
          return 3
        default:
          return 4
      }
    },
    getStatusText(status: string): string {
      switch (status) {
        case 'resolved':
          return '已解决'
        case 'resolving':
          return '处理中'
        case 'unresolved':
          return '未解决'
        case 'new':
          return '新增纠纷'
        default:
          return '未知'
      }
    },
    getStatusClass(status: string): string {
      switch (status) {
        case 'resolved':
          return 'resolved'
        case 'resolving':
          return 'resolving'
        case 'unresolved':
          return 'unresolved'
        case 'new':
          return 'new'
        default:
          return 'unknown'
      }
    },
    getStatusCount(status: string) {
      if (!status) {
        return this.disputeStats.total
      }

      switch (status) {
        case 'resolved':
          return this.disputeStats.resolved
        case 'resolving':
          return this.disputeStats.resolving
        case 'unresolved':
          return this.disputeStats.unresolved
        case 'new':
          return this.disputeStats.newCount
        default:
          return 0
      }
    },
    getPendingCount() {
      return this.disputeStats.newCount + this.disputeStats.resolving + this.disputeStats.unresolved
    },
    getListSubtitle() {
      const keyword = String(this.searchKey || '').trim()
      const status = String(this.selectedStatus || '').trim()

      if (keyword && status) {
        return `正在查看“${keyword}”相关的${this.getStatusText(status)}记录`
      }

      if (keyword) {
        return `正在搜索“${keyword}”相关纠纷`
      }

      if (status) {
        return `当前筛选为${this.getStatusText(status)}，优先处理更紧急的事项`
      }

      return '默认按紧急程度排序，优先展示新增、未解决和处理中记录'
    },
    searchDispute() {
      this.searchKey = String(this.searchKey || '').trim()
    },
    clearSearch() {
      this.searchKey = ''
    },
    selectStatus(status: string) {
      if (this.selectedStatus === status) {
        this.selectedStatus = ''
        return
      }

      this.selectedStatus = status
    },
    resetFilters() {
      this.searchKey = ''
      this.selectedStatus = ''
    },
    addDispute() {
      uni.navigateTo({
        url: '/pages/dean/add-dispute'
      })
    },
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    }
  }
}
</script>

