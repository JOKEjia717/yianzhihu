          </view>
          <view class="overview-card">
            <text class="overview-label">院长</text>
            <text class="overview-value">{{ nursingHome.director || '暂无' }}</text>
          </view>
          <view class="overview-card">
            <text class="overview-label">成立时间</text>
            <text class="overview-value">{{ formatDate(nursingHome.createdTime) }}</text>
          </view>
          <view class="overview-card">
            <text class="overview-label">院所编号</text>
            <text class="overview-value">{{ nursingHome.nursingHomeId || '暂无' }}</text>
          </view>
        </view>
      </view>



      <view class="section action-section">
        <view class="section-header">
          <view>
            <text class="section-title">快捷操作</text>
            <text class="section-subtitle">常用动作放在这里，便于快速处理</text>
          </view>
        </view>
        <view class="action-grid">
          <view class="action-card action-card--phone" @click="makeCall">
            <view class="action-icon-box action-icon-box--phone">
              <image class="action-icon" src="/static/images/phone-icon.png" mode="aspectFit"></image>
            </view>
            <text class="action-title">拨打电话</text>
            <text class="action-desc">{{ getDisplayPhone() }}</text>
          </view>
          <view class="action-card action-card--map" @click="openMap">
            <view class="action-icon-box action-icon-box--map">
              <image class="action-icon" src="/static/images/location.png" mode="aspectFit"></image>
            </view>
            <text class="action-title">查看地图</text>
            <text class="action-desc">{{ hasCoordinates() ? '支持定位直达' : '支持复制地址' }}</text>
          </view>
          <view class="action-card action-card--share" @click="shareInfo">
            <view class="action-icon-box action-icon-box--share">
              <image class="action-icon" src="/static/images/icon-more.png" mode="aspectFit"></image>
            </view>
