</template>

<script lang="uts">
import { request } from '../../utils/request'

interface NursingHome {
  nursingHomeId: string
  name: string
  address: string
  photo: string
  director: string
  honors: string | null
  deanId: string
  createdTime: string
  isEnable: number
  phone?: string
  contactPhone?: string
  directorPhone?: string
  latitude?: number | string
  longitude?: number | string
}

interface ApiResponse {
  code: number
  msg: string | null
  data: NursingHome
}

export default {
  data() {
    return {
      nursingHome: {
        nursingHomeId: '',
        name: '',
        address: '',
        photo: '',
        director: '',
        honors: '',
        deanId: '',
        createdTime: '',
        isEnable: -1
      } as NursingHome,
      lastUpdatedText: '待同步'
    }
  },
  onLoad() {
    this.fetchNursingHomeInfo()
  },
  methods: {
    getHeroImage() {
      return this.nursingHome.photo || '/static/images/dean-card-bg.jpg'
    },
    getStatusText() {
      const statusCode = Number(this.nursingHome.isEnable)

      if (statusCode === 1) {
        return '正常营业'
      }

      if (statusCode === 0) {
        return '暂停营业'
      }

      return '待同步'
    },
    getStatusClass() {
      const statusCode = Number(this.nursingHome.isEnable)

      if (statusCode === 1) {
        return 'active'
      }

      if (statusCode === 0) {
        return 'inactive'
      }

      return 'loading'
    },
    getRawPhone() {
      const phone =
        this.nursingHome.directorPhone ||
        this.nursingHome.contactPhone ||
        this.nursingHome.phone ||
        ''

      return String(phone || '').trim()
    },
    getDisplayPhone() {
      const phone = this.getRawPhone()
      return phone || '未配置'
    },
    hasPhone() {
      return this.getRawPhone().length > 0
    },
    hasCoordinates() {
      const latitudeText = String(this.nursingHome.latitude ?? '').trim()
      const longitudeText = String(this.nursingHome.longitude ?? '').trim()

      if (!latitudeText || !longitudeText) {
        return false
      }

      const latitude = Number(latitudeText)
      const longitude = Number(longitudeText)
      return !isNaN(latitude) && !isNaN(longitude)
    },
    hasHonors() {
      return String(this.nursingHome.honors || '').trim().length > 0
    },
    getShareSummary() {
      const director = this.nursingHome.director || '院长信息待完善'
      const address = this.nursingHome.address || '地址信息待完善'
      return `院长：${director}，地址：${address}`
    },
    formatDate(dateStr: string | Date): string {
      if (!dateStr) return '暂无'

      try {
        if (dateStr instanceof Date) {
          const year = dateStr.getFullYear()
          const month = String(dateStr.getMonth() + 1).padStart(2, '0')
          const day = String(dateStr.getDate()).padStart(2, '0')
          return `${year}-${month}-${day}`
        }

        const normalizedDate = new Date(String(dateStr).replace(/-/g, '/'))
        if (!isNaN(normalizedDate.getTime())) {
          const year = normalizedDate.getFullYear()
          const month = String(normalizedDate.getMonth() + 1).padStart(2, '0')
          const day = String(normalizedDate.getDate()).padStart(2, '0')
          return `${year}-${month}-${day}`
        }

        return String(dateStr).substring(0, 10)
      } catch (error) {
        if (typeof dateStr === 'string') {
          return dateStr
        }
        return '暂无'
      }
    },
    formatDateTime(date: Date): string {
      const year = date.getFullYear()
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const hours = String(date.getHours()).padStart(2, '0')
      const minutes = String(date.getMinutes()).padStart(2, '0')
      return `${year}-${month}-${day} ${hours}:${minutes}`
    },
    async fetchNursingHomeInfo() {
      try {
        const accessToken = String(uni.getStorageSync('accessToken') || '').trim()
        const refreshToken = String(uni.getStorageSync('refreshToken') || '').trim()

        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '未登录或登录已过期',
            icon: 'none'
          })
          uni.redirectTo({
            url: '/pages/dean/login'
          })
          return
        }

        uni.showLoading({
          title: '加载中...'
        })

        const result = await request.get('/home/nursingHome') as {
          statusCode: number
          data: ApiResponse
        }

        if (result.statusCode === 200 && result.data && result.data.code === 1 && result.data.data) {
          this.nursingHome = result.data.data
          this.lastUpdatedText = this.formatDateTime(new Date())
          return
        }

        uni.showToast({
          title: result.data?.msg || '获取数据失败',
          icon: 'none'
        })
      } catch (error) {
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      } finally {
        uni.hideLoading()
      }
    },
    refreshInfo() {
      this.fetchNursingHomeInfo()
    },
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    },
    makeCall() {
      const rawPhoneNumber = this.getRawPhone()
      const phoneNumber = rawPhoneNumber.replace(/[^\d+]/g, '')
      if (!phoneNumber) {
        uni.showToast({
          title: '联系电话未配置',
          icon: 'none'
        })
        return
      }

      if (typeof uni.makePhoneCall !== 'function') {
        uni.setClipboardData({
          data: rawPhoneNumber,
          success: () => {
            uni.showToast({
              title: '电话已复制',
              icon: 'none'
            })
          },
          fail: () => {
            uni.showToast({
              title: '复制失败',
              icon: 'none'
            })
          }
        })
        return
      }

      uni.makePhoneCall({
        phoneNumber,
        fail: () => {
          uni.showToast({
            title: '拨打失败',
            icon: 'none'
          })
        }
      })
    },
    copyAddress() {
      const address = String(this.nursingHome.address || '').trim()
      if (!address) {
        uni.showToast({
          title: '暂无地址信息',
          icon: 'none'
        })
        return
      }

      uni.setClipboardData({
        data: address,
        success: () => {
          uni.showToast({
            title: '地址已复制',
            icon: 'none'
          })
        },
        fail: () => {
          uni.showToast({
            title: '复制失败',
            icon: 'none'
          })
        }
      })
    },
    openMap() {
      if (this.hasCoordinates()) {
        const latitude = Number(this.nursingHome.latitude)
        const longitude = Number(this.nursingHome.longitude)

        if (typeof uni.openLocation !== 'function') {
          this.copyAddress()
          return
        }

        uni.openLocation({
          latitude: latitude,
          longitude: longitude,
          name: this.nursingHome.name || '养老院详情',
          address: this.nursingHome.address || '',
          fail: () => {
            this.copyAddress()
          }
        })
        return
      }

      this.copyAddress()
    },
    shareInfo() {
      if (!this.nursingHome.name) {
        uni.showToast({
          title: '暂无可分享信息',
          icon: 'none'
        })
        return
      }

      if (typeof uni.share !== 'function') {
        const summary = `${this.nursingHome.name}\n${this.getShareSummary()}`
        uni.setClipboardData({
          data: summary,
          success: () => {
            uni.showToast({
              title: '分享文案已复制',
              icon: 'none'
            })
          },
          fail: () => {
            uni.showToast({
              title: '复制失败',
              icon: 'none'
            })
          }
        })
        return
      }

      uni.share({
        provider: 'weixin',
        title: this.nursingHome.name,
        summary: this.getShareSummary(),
        success: () => {
          uni.showToast({
            title: '分享成功'
          })
        },
        fail: () => {
          uni.showToast({
            title: '分享失败',
            icon: 'none'
          })
        }
      })
    }
  }
}
</script>

