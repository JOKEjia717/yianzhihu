          </view>
          <view class="info-row">
            <image class="info-icon" src="/static/images/time.png" mode="aspectFit"></image>
            <text class="info-label">成立时间</text>
            <text class="info-value">{{ formatDate(nursingHome.createdTime) }}</text>
          </view>
          <view class="info-row">
            <image class="info-icon" src="/static/images/id.png" mode="aspectFit"></image>
            <text class="info-label">院所编号</text>
            <text class="info-value">{{ nursingHome.nursingHomeId || '暂无' }}</text>
          </view>
        </view>
