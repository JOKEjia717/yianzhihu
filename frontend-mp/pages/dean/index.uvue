<script lang="uts">
interface NursingHome {
  nursingHomeId: string
  name: string
  address: string
  photo: string
  director: string
  honors: string | null
  deanId: string
  createdTime: string
  isEnable: number
}

interface ApiResponse {
  code: number
  msg: string | null
  data: NursingHome
}

export default {
  data() {
    return {
      nursingHome: {
        nursingHomeId: '',
        name: '',
        address: '',
        photo: '',
        director: '',
        honors: '',
        deanId: '',
        createdTime: '',
        isEnable: 0
      } as NursingHome
    }
  },
  onLoad() {
    this.fetchNursingHomeInfo()
  },
  methods: {
    // 格式化日�?
    formatDate(dateStr: string | Date): string {
      if (!dateStr) return '暂无';
      
      try {
        if (dateStr instanceof Date) {
          const year = dateStr.getFullYear();
          const month = (dateStr.getMonth() + 1).toString().padStart(2, '0');
          const day = dateStr.getDate().toString().padStart(2, '0');
          return `${year}-${month}-${day}`;
        }
        
        // 简单格式化，只显示年月�?
        return dateStr.substring(0, 10);
      } catch (e) {
        if (typeof dateStr === 'string') {
          return dateStr;
        }
        return '暂无';
      }
    },
    
    async fetchNursingHomeInfo() {
      try {
        // 从本地存储获取token
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '未登录或登录已过�?',
            icon: 'none'
          })
          // 跳转到登录页
          uni.redirectTo({
            url: '/pages/dean/login'
          })
          return
        }
        
        uni.showLoading({
          title: '加载�?...'
        })

        const result = await uni.request({
          url: 'http://localhost:8080/home/nursingHome',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })
        
        uni.hideLoading()
        
        // ��ӡ������Ӧ�����Ա����
        console.log('获取养老院信息完整响应:', result)
        
        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.nursingHome = response.data
          console.log('养老院信息:', this.nursingHome)
        } else {
          console.error('获取数据失败, 响应详情:', response)
          uni.showToast({
            title: '获取数据失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    },
    makeCall() {
      // 实现拨打电话的功�?
      uni.showToast({
        title: '暂无电话号码',
        icon: 'none'
      })
    },
    openMap() {
      // 实现查看地图的功�?
      uni.showToast({
        title: '地图功能开发中',
        icon: 'none'
      })
    },
    shareInfo() {
      // 实现分享信息的功能?
      uni.share({
        provider: 'weixin',
        title: this.nursingHome.name,
        summary: `院长: ${this.nursingHome.director}, 地址: ${this.nursingHome.address}`,
        success: () => {
          uni.showToast({
            title: '分享成功'
          })
        },
        fail: () => {
          uni.showToast({
            title: '分享失败',
            icon: 'none'
          })
        }
      })
    }
  }
}
</script>

