            <text class="action-desc">发送养老院简介</text>
          </view>
          <view class="action-card action-card--refresh" @click="refreshInfo">
            <view class="action-icon-box action-icon-box--refresh">
              <image class="action-icon" src="/static/images/refresh.png" mode="aspectFit"></image>
            </view>
            <text class="action-title">刷新资料</text>
            <text class="action-desc">重新拉取最新信息</text>
          </view>
        </view>
      </view>

      <view class="section info-section">
        <view class="section-header">
          <view>
            <text class="section-title">基本信息</text>
