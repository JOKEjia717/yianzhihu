            <text class="section-title">信息概览</text>
            <text class="section-subtitle">把最常看的资料整理成卡片</text>
          </view>
          <view class="section-pill">
            <text class="section-pill-text">4 项</text>
          </view>
        </view>
        <view class="overview-grid">
          <view class="overview-card">
            <text class="overview-label">运营状态</text>
