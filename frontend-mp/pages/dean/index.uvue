      <view class="section honor-section">
        <view class="section-header">
          <view>
            <text class="section-title">荣誉资质</text>
            <text class="section-subtitle">展示养老院的资质与荣誉</text>
          </view>
        </view>
        <view class="honor-panel" :class="{ 'honor-panel--empty': !nursingHome.honors }">
          <text class="honor-text">{{ nursingHome.honors || '当前暂无荣誉资质信息，可在后台补充后展示。' }}</text>
        </view>
      </view>
    </view>

    <view class="tabbar">
      <view class="tabbar-item active">
        <image class="tabbar-icon" src="/static/images/home-active.png"></image>
        <text class="tabbar-text active">详情</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/dispute')">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text">活动</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text">院下管理</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/profile')">
        <image class="tabbar-icon" src="/static/images/user.png"></image>
        <text class="tabbar-text">我的</text>
      </view>
