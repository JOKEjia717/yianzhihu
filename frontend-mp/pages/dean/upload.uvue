<template>
  <view class="container">
    <view class="info-section">
      <view class="info-header">
        <text class="title">养老院信息</text>
      </view>
      
      <view class="info-content">
        <view class="info-item">
          <text class="label">养老院：</text>
          <text class="value">慕江区养老院</text>
        </view>
        <view class="info-item">
          <text class="label">院长：</text>
          <text class="value">{{ userInfo.name }}</text>
        </view>
        <view class="info-item">
          <text class="label">联系电话：</text>
          <text class="value">{{ userInfo.phone }}</text>
        </view>
        <view class="info-item">
          <text class="label">地址：</text>
          <text class="value">慕江区</text>
        </view>
      </view>
    </view>

    <view class="upload-section">
      <view class="upload-header">
        <text class="title">养老院照片</text>
      </view>
      
      <view class="upload-content">
        <view class="image-grid">
          <view 
            v-for="(image, index) in images" 
            :key="index" 
            class="image-item"
          >
            <image 
              :src="image.url" 
              mode="aspectFill" 
              class="preview-image"
            />
            <view class="delete-btn" @click="deleteImage(index)">×</view>
          </view>
          
          <view 
            v-if="images.length < 9" 
            class="upload-btn"
            @click="chooseImage"
          >
            <text class="plus">+</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <button class="submit-btn" @click="handleSubmit">保存</button>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface UserInfo {
  deanId: string
  name: string
  avatar: string | null
  phone: string
}

export default {
  data() {
    return {
      userInfo: {
        deanId: '',
        name: '',
        avatar: '',
        phone: ''
      } as UserInfo,
      images: [] as Array<{url: string, file: File}>
    }
  },
  onLoad() {
    const userInfo = uni.getStorageSync('userInfo')
    if (userInfo) {
      this.userInfo = userInfo
    }
  },
  methods: {
    async chooseImage() {
      try {
        const res = await uni.chooseImage({
          count: 9 - this.images.length,
          sizeType: ['original', 'compressed'],
          sourceType: ['album', 'camera']
        })
        
        this.images.push(...res.tempFilePaths.map(path => ({
          url: path,
          file: new File([path], 'image.jpg')
        })))
      } catch (error: any) {
        uni.showToast({
          title: '选择图片失败',
          icon: 'none'
        })
      }
    },
    
    deleteImage(index: number) {
      this.images.splice(index, 1)
    },
    
    async handleSubmit() {
      if (this.images.length === 0) {
        uni.showToast({
          title: '请至少上传一张照片',
          icon: 'none'
        })
        return
      }

      try {
        const formData = new FormData()
        this.images.forEach((image, index) => {
          formData.append(`images[${index}]`, image.file)
        })

        const accessToken = uni.getStorageSync('accessToken')
        const res = await uni.request({
          url: 'http://localhost:8080/admin/dean/upload-images',
          method: 'POST',
          header: {
            'Authorization': `Bearer ${accessToken}`
          },
          data: formData
        })

        if (res.statusCode === 200) {
          uni.showToast({
            title: '上传成功',
            icon: 'success'
          })
          
          // 跳转到养老院详情页
          uni.navigateTo({
            url: '/pages/dean/detail'
          })
        } else {
          throw new Error('上传失败')
        }
      } catch (error: any) {
        uni.showToast({
          title: error.message || '上传失败',
          icon: 'none'
        })
      }
    }
  }
}
</script>

<style>
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 20rpx;
}

.info-section,
.upload-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-header,
.upload-header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
}

.label {
  width: 160rpx;
  color: #666666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  color: #333333;
  font-size: 28rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item,
.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.delete-btn {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.upload-btn {
  border: 2rpx dashed #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 60rpx;
  color: #999999;
}

.button-group {
  margin-top: 40rpx;
}

.submit-btn {
  background-color: #007AFF;
  color: #FFFFFF;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}
</style> 