            <text class="hero-action-sub">查看说明和帮助</text>
          </view>
          <view class="hero-action hero-action--primary" @click="showFeedbackPopup('院长板块')">
            <text class="hero-action-title">问题反馈</text>
            <text class="hero-action-sub">提交院长板块问题</text>
          </view>
        </view>
