      </view>
    </view>

    <view v-if="showPopup" class="popup" @click="closePopup">
      <view class="popup-mask"></view>
      <view class="popup-content" @click.stop>
        <view class="popup-handle"></view>
        <text class="popup-close popup-close--floating" @click="closePopup">×</text>
        <view class="popup-header">
          <text class="popup-title">{{ feedbackType }}问题反馈</text>
        </view>
        <text class="popup-subtitle">请尽量写清楚问题现象，方便快速定位。</text>

        <view class="popup-body">
          <view class="form-item">
            <text class="form-label">问题标题</text>
            <input class="form-input" v-model="feedbackTitle" placeholder="请输入问题标题" />
          </view>

          <view class="form-item">
            <text class="form-label">问题详情</text>
            <textarea class="form-textarea" v-model="feedbackContent" placeholder="请详细描述您遇到的问题" />
          </view>

          <view class="form-item">
            <text class="form-label">问题等级</text>
            <view class="level-selector">
              <view
                v-for="level in levelOptions"
                :key="level.value"
                :class="['level-item', feedbackLevel === level.value ? 'level-selected' : '']"
                @click="selectLevel(level.value)"
              >
                <text>{{ level.label }}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="popup-footer">
          <view class="popup-button popup-button--ghost" @click="closePopup">
            <text class="popup-button-text">取消</text>
          </view>
          <view class="popup-button popup-button--primary" @click="submitFeedback">
            <text class="popup-button-text">提交反馈</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface LevelOption {
  label: string
  value: number
}

interface QuickAction {
  type: string
  name: string
  icon: string
  desc: string
}

export default {
  data() {
    return {
      userName: '胡永龙',
      showPopup: false,
      feedbackType: '',
      feedbackTitle: '',
      feedbackContent: '',
      feedbackLevel: 1,
      levelOptions: [
        { label: '低', value: 1 },
        { label: '中', value: 2 },
        { label: '高', value: 3 },
        { label: '紧急', value: 4 }
      ] as LevelOption[],
      shortcutItems: [
        { type: 'daily', name: '每日待办', icon: '/static/images/refresh.png', desc: '查看今日任务' },
        { type: 'profile', name: '个人资料', icon: '/static/images/chates.png', desc: '查看账号信息' }
      ] as QuickAction[]
    }
  },
  onLoad() {
    this.fetchUserInfo()
  },
  methods: {
    async fetchUserInfo() {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        if (!accessToken || !refreshToken) {
          uni.showToast({ title: '未登录或登录已过期', icon: 'none' })
          uni.redirectTo({ url: '/pages/dean/login' })
          return
        }
        this.userName = '胡永龙'
      } catch (error) {
        console.error('获取用户信息失败:', error)
        uni.showToast({ title: '获取用户信息失败', icon: 'none' })
      }
    },
    getPhoneText() {
      return '未绑定手机号'
    },
    getStatusText() {
      return '已启用'
    },
    showDataInfo() {
      uni.showModal({
        title: '数据说明',
        content: '此处显示数据相关说明和帮助信息',
        showCancel: false
      })
    },
    showFeedbackPopup(type: string) {
      this.feedbackType = type
      this.showPopup = true
      this.feedbackTitle = ''
      this.feedbackContent = ''
      this.feedbackLevel = 1
    },
    closePopup() {
      this.showPopup = false
    },
    selectLevel(level: number) {
      this.feedbackLevel = level
    },
    submitFeedback() {
      if (!this.feedbackTitle.trim()) {
        uni.showToast({ title: '请输入问题标题', icon: 'none' })
        return
      }
      if (!this.feedbackContent.trim()) {
        uni.showToast({ title: '请输入问题详情', icon: 'none' })
        return
      }

      uni.showModal({
        title: '确认提交',
        content: '您确定要提交此问题反馈吗？',
        success: (res) => {
          if (res.confirm) {
            setTimeout(() => {
              uni.showToast({ title: '提交成功', icon: 'success' })
              this.closePopup()
            }, 500)
          }
        }
      })
    },
    handleQuickAction(type: string) {
      if (type === 'daily') {
        this.navigateTo('/pages/dean/daily-tasks')
        return
      }
      if (type === 'profile') {
        this.navigateTo('/pages/dean/user-profile')
      }
    },
    handleLogout() {
      uni.showModal({
        title: '退出登录',
        content: '确定要退出当前账号吗？',
        success: (res) => {
          if (res.confirm) {
            uni.clearStorageSync()
            uni.reLaunch({ url: '/pages/dean/login' })
          }
        }
      })
    },
    navigateTo(url: string) {
      uni.navigateTo({ url: url })
    },
    redirectTo(url: string) {
      uni.redirectTo({ url: url })
    }
  }
}
</script>

