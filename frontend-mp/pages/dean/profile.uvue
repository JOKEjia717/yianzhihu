      </view>
      <view class="header-right">
        <image class="search-icon" src="/static/images/Serch.png" mode="aspectFit"></image>
      </view>
    </view>
    
    <!-- 主要内容区域 -->
    <view class="container">
      <!-- 用户信息卡片 -->
      <view class="user-card">
        <view class="user-avatar">
          <image class="avatar-image" src="/static/images/avatared.jpg" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <text class="user-name">胡永龙</text>
          <text class="user-role">养老院管理院长板块</text>
        </view>
        <view class="user-arrow">
          <image class="arrow-icon" src="/static/images/arrow-right.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <!-- 问题反馈板块 -->
      <view class="panel feedback-panel">
        <view class="panel-header">
          <text class="panel-title">问题反馈</text>
          <view class="panel-action" @click="showDataInfo">
            <text class="action-text">数据说明</text>
            <image class="tiny-arrow" src="/static/images/arrow-right.png" mode="aspectFit"></image>
          </view>
        </view>
        
        <view class="icon-grid">
          <view class="icon-item" @click="showFeedbackPopup('院长板块')">
              <image class="feature-icon" src="/static/images/pen.png" mode="aspectFit"></image>
            <text class="icon-text">院长板块</text>
          </view>
          
          <view class="icon-item" @click="showFeedbackPopup('管理后台')">
              <image class="feature-icon" src="/static/images/duck.png" mode="aspectFit"></image>
            <text class="icon-text">管理后台</text>
          </view>
        </view>
      </view>
      
      <!-- 需放问题反馈板块 -->
      <view class="panel">
        <view class="panel-header">
          <text class="panel-title">需放问题反馈</text>
        </view>
        
        <view class="list-menu">
          <view class="list-item" @click="navigateTo('/pages/dean/daily-tasks')">
            <view class="item-left">
                <image class="list-icon" src="/static/images/refresh.png" mode="aspectFit"></image>
              <text class="item-text">每日待办</text>
            </view>
            <image class="arrow-icon" src="/static/images/arrow-right.png" mode="aspectFit"></image>
          </view>
          
          <view class="list-item" @click="navigateTo('/pages/dean/user-profile')">
            <view class="item-left">
                <image class="list-icon" src="/static/images/chates.png" mode="aspectFit"></image>
              <text class="item-text">个人资料</text>
            </view>
            <image class="arrow-icon" src="/static/images/arrow-right.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部导航栏 -->
    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
        <text class="tabbar-text">详情</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/dispute')">
        <image class="tabbar-icon" src="/static/images/dispute.png"></image>
        <text class="tabbar-text">纠纷</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/staff')">
        <image class="tabbar-icon" src="/static/images/staff.png"></image>
        <text class="tabbar-text">员工</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/activity')">
        <image class="tabbar-icon" src="/static/images/activity.png"></image>
        <text class="tabbar-text">活动</text>
      </view>
      <view class="tabbar-item" @click="redirectTo('/pages/dean/management')">
        <image class="tabbar-icon" src="/static/images/management.png"></image>
        <text class="tabbar-text">院下管理</text>
      </view>
      <view class="tabbar-item active">
