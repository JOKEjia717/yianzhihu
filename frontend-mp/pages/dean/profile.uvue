        <text class="tabbar-text active">我的</text>
      </view>
    </view>
    
    <!-- 问题反馈弹窗 -->
    <view v-if="showPopup" class="popup-mask" @click="closePopup">
      <view class="popup-content" @click.stop>
        <view class="popup-header">
          <text class="popup-title">{{feedbackType}}问题反馈</text>
          <view class="close-btn" @click="closePopup">
            <text class="close-icon">×</text>
          </view>
        </view>
        
        <view class="popup-body">
          <view class="form-item">
            <text class="form-label">问题标题</text>
            <input class="form-input" v-model="feedbackTitle" placeholder="请输入问题标题" />
          </view>
          
          <view class="form-item">
            <text class="form-label">问题详情</text>
            <textarea class="form-textarea" v-model="feedbackContent" placeholder="请详细描述您遇到的问题" />
          </view>
          
          <view class="form-item">
            <text class="form-label">问题等级</text>
            <view class="level-selector">
              <view 
                v-for="(level, index) in levelOptions" 
                :key="index" 
                :class="['level-item', feedbackLevel === level.value ? 'level-selected' : '']"
                @click="selectLevel(level.value)"
              >
                <text>{{level.label}}</text>
              </view>
            </view>
          </view>
          
          <view class="form-item">
            <button class="submit-btn" @click="submitFeedback">提交反馈</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface UserInfo {
  name: string
  avatar: string
  role: string
}

interface LevelOption {
  label: string
  value: number
}

export default {
  data() {
    return {
      currentTime: '',
      userName: '胡永龙',
      userRole: '',
      timerID: 0,
      
      // 问题反馈弹窗相关数据
      showPopup: false,
      feedbackType: '',
      feedbackTitle: '',
      feedbackContent: '',
      feedbackLevel: 1,
      levelOptions: [
        { label: '低', value: 1 },
        { label: '中', value: 2 },
        { label: '高', value: 3 },
        { label: '紧急', value: 4 }
      ] as LevelOption[]
    }
  },
  onLoad() {
    this.updateTime()
    this.fetchUserInfo()
    
    // 设置定时器，每秒更新一次时间
    this.timerID = setInterval(() => {
      this.updateTime()
    }, 1000) as unknown as number
  },
  onUnload() {
    // 页面卸载时清除定时器
    clearInterval(this.timerID)
  },
  methods: {
    updateTime() {
      const now = new Date()
      const hours = now.getHours().toString().padStart(2, '0')
      const minutes = now.getMinutes().toString().padStart(2, '0')
      this.currentTime = `${hours}:${minutes}`
    },
    
    async fetchUserInfo() {
      try {
        // 从本地存储获取token
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '未登录或登录已过期',
            icon: 'none'
          })
          // 跳转到登录页
          uni.redirectTo({
            url: '/pages/dean/login'
          })
          return
        }
        
        // 这里应该实现获取用户信息的逻辑
        // 目前使用假数据演示
        this.userName = '胡永龙'
      } catch (error) {
        console.error('获取用户信息失败:', error)
        uni.showToast({
          title: '获取用户信息失败',
          icon: 'none'
        })
      }
    },
    
    showDataInfo() {
      uni.showModal({
        title: '数据说明',
        content: '此处显示数据相关说明和帮助信息',
        showCancel: false
      })
    },
    
    // 显示问题反馈弹窗
    showFeedbackPopup(type: string) {
      this.feedbackType = type
      this.showPopup = true
      // 重置表单
      this.feedbackTitle = ''
      this.feedbackContent = ''
      this.feedbackLevel = 1
    },
    
    // 关闭问题反馈弹窗
    closePopup() {
      this.showPopup = false
    },
    
    // 选择问题等级
    selectLevel(level: number) {
      this.feedbackLevel = level
    },
    
    // 提交问题反馈
    submitFeedback() {
      // 表单验证
      if (!this.feedbackTitle.trim()) {
        uni.showToast({
          title: '请输入问题标题',
          icon: 'none'
        })
        return
      }
      
      if (!this.feedbackContent.trim()) {
        uni.showToast({
          title: '请输入问题详情',
          icon: 'none'
        })
        return
      }
      
      // 显示确认弹框
      uni.showModal({
        title: '确认提交',
        content: '您确定要提交此问题反馈吗？',
        success: (res) => {
          if (res.confirm) {
            // 这里可以添加实际的提交逻辑
            // 模拟提交成功
            setTimeout(() => {
              uni.showToast({
                title: '提交成功',
                icon: 'success'
              })
              this.closePopup()
            }, 500)
          }
        }
      })
    },
    
    navigateTo(url: string) {
      uni.navigateTo({
        url: url
      })
    },
    
    redirectTo(url: string) {
      uni.redirectTo({
        url: url
      })
    }
  }
}
</script>

