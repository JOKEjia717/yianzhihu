<template>
  <view class="page">
    <view class="page-glow page-glow--left"></view>
    <view class="page-glow page-glow--right"></view>

    <view class="container">
      <view class="hero-card">

        <text class="page-title">新增纠纷</text>
        <text class="page-desc">先把事实写清楚，再补充时间、类型和紧急程度，方便后续处理和跟进。</text>

        <view class="progress-card">
          <view class="progress-card__top">
            <text class="progress-label">填写进度</text>
            <text class="progress-text">{{ getFilledCount() }}/6 项已填写</text>
          </view>
          <view class="progress-bar">
            <view class="progress-bar__fill" :style="{ width: getFormProgress() + '%' }"></view>
          </view>
          <text class="progress-hint">{{ getCompletionHint() }}</text>
        </view>

<!--       <view class="summary-chips">
          <view class="summary-chip">
            <text class="summary-chip__label">时间</text>
            <text class="summary-chip__value">{{ disputeForm.date }} {{ disputeForm.time }}</text>
          </view>
          <view class="summary-chip">
            <text class="summary-chip__label">类型</text>
            <text class="summary-chip__value">{{ getSelectedType() }}</text>
          </view>
          <view class="summary-chip">
            <text class="summary-chip__label">紧急</text>
            <text class="summary-chip__value">{{ getUrgencyLabel(disputeForm.urgencyLevel) }}</text>
          </view>
        </view> -->
      </view>

      <view class="section">
        <view class="section-header">
          <view>
            <text class="section-title">基础信息</text>
            <text class="section-subtitle">标题和详情尽量写清楚，方便快速定位问题。</text>
          </view>
          <view class="section-pill">
            <text class="section-pill-text">必填</text>
          </view>
        </view>

        <view class="form-card">
          <view class="field">
            <view class="field-head">
              <text class="field-label">纠纷标题</text>
              <text class="field-required">必填</text>
            </view>
            <input
              class="field-input"
              v-model="disputeForm.title"
              placeholder="例如：食堂餐费争议"
              maxlength="30"
            />
          </view>

          <view class="field">
            <view class="field-head">
              <text class="field-label">纠纷详情</text>
              <text class="field-required">必填</text>
            </view>
            <textarea
              class="field-textarea"
              v-model="disputeForm.description"
              placeholder="请写清楚时间、地点、人物、发生了什么，以及目前影响..."
              maxlength="200"
              auto-height
            />
            <view class="field-foot">
              <text class="field-hint">建议写清楚具体事实，不要只写结论。</text>
              <text class="char-count">{{ disputeForm.description.length }}/200</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <view>
            <text class="section-title">时间与分类</text>
            <text class="section-subtitle">发生时间和类型会影响后续处理优先级。</text>
          </view>
          <view class="section-pill section-pill--soft">
            <text class="section-pill-text">{{ getUrgencyLabel(disputeForm.urgencyLevel) }}优先</text>
          </view>
        </view>

        <view class="picker-grid">
          <picker mode="date" :value="disputeForm.date" @change="onDateChange">
            <view class="picker-card">
              <text class="picker-label">发生日期</text>
              <view class="picker-value-row">
                <text class="picker-value-text">{{ disputeForm.date || '请选择日期' }}</text>
<!--                <text class="picker-arrow">▾</text> -->
              </view>
            </view>
          </picker>

          <picker mode="time" :value="disputeForm.time" @change="onTimeChange">
            <view class="picker-card">
              <text class="picker-label">发生时间</text>
              <view class="picker-value-row">
                <text class="picker-value-text">{{ disputeForm.time || '请选择时间' }}</text>
<!--                <text class="picker-arrow">▾</text> -->
              </view>
            </view>
          </picker>
        </view>

        <picker mode="selector" :range="disputeTypes" :value="disputeForm.typeIndex" @change="onTypeChange">
          <view class="picker-card picker-card--full">
            <text class="picker-label">纠纷类型</text>
            <view class="picker-value-row">
              <text class="picker-value-text">{{ getSelectedType() }}</text>
<!--              <text class="picker-arrow">▾</text> -->
            </view>
          </view>
        </picker>
      </view>

      <view class="section">
        <view class="section-header">
          <view>
            <text class="section-title">紧急程度</text>
            <text class="section-subtitle">尽量按实际情况选择，方便后续优先处理。</text>
          </view>
        </view>

        <view class="urgency-grid">
          <view
            v-for="level in urgencyLevels"
            :key="level.value"
            :class="['urgency-card', level.tone, disputeForm.urgencyLevel === level.value ? 'selected' : '']"
            @click="selectUrgency(level.value)"
          >
            <view class="urgency-card__top">
              <text class="urgency-label">{{ level.label }}</text>
              <view class="urgency-dot"></view>
            </view>
            <text class="urgency-desc">{{ level.desc }}</text>
          </view>
        </view>
      </view>

      <view class="section tip-section">
        <view class="section-header">
          <view>
            <text class="section-title">填写提示</text>
            <text class="section-subtitle">少写空话，多写事实，后续处理会更快。</text>
          </view>
        </view>

        <view class="tip-list">
          <view class="tip-item">
            <text class="tip-index">1</text>
            <text class="tip-text">优先写清楚“谁、何时、何地、发生了什么”。</text>
          </view>
          <view class="tip-item">
            <text class="tip-index">2</text>
            <text class="tip-text">尽量描述客观现象，避免只写结论。</text>
          </view>
          <view class="tip-item">
            <text class="tip-index">3</text>
            <text class="tip-text">如果影响面较大，建议把紧急程度调高。</text>
          </view>
        </view>
      </view>
    </view>

    <view class="submit-bar">
      <text class="submit-bar__hint">{{ getSubmitHint() }}</text>
      <view class="submit-btn" :class="{ disabled: isSubmitting }" @click="submitDispute">
        <text class="submit-btn__text">{{ isSubmitting ? '提交中...' : '提交纠纷' }}</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { request } from '../../utils/request'

interface DisputeForm {
  title: string
  description: string
  date: string
  time: string
  typeIndex: number
  urgencyLevel: number
  deanId: string
}

interface UrgencyOption {
  value: number
  label: string
  desc: string
  tone: string
}

interface ApiResponse {
  code: number
  msg: string | null
  data?: any
}

export default {
  data() {
    return {
      isSubmitting: false,
      disputeForm: {
        title: '',
        description: '',
        date: '',
        time: '',
        typeIndex: 0,
        urgencyLevel: 1,
        deanId: ''
      } as DisputeForm,
      disputeTypes: [
        '设施问题',
        '服务质量',
        '人员投诉',
        '安全隐患',
        '饮食问题',
        '其他'
      ],
      urgencyLevels: [
        { value: 0, label: '低', desc: '先记录，后续安排处理', tone: 'low' },
        { value: 1, label: '中', desc: '尽快纳入处理计划', tone: 'medium' },
        { value: 2, label: '高', desc: '优先跟进，避免扩大影响', tone: 'high' }
      ] as UrgencyOption[]
    }
  },
  onLoad() {
    this.initForm()
  },
  methods: {
    initForm() {
      const now = new Date()
      const year = now.getFullYear()
      const month = this.padZero(now.getMonth() + 1)
      const day = this.padZero(now.getDate())
      const hours = this.padZero(now.getHours())
      const minutes = this.padZero(now.getMinutes())

      this.disputeForm.date = `${year}-${month}-${day}`
      this.disputeForm.time = `${hours}:${minutes}`

      const userInfo = uni.getStorageSync('userInfo')
      if (userInfo && userInfo.deanId) {
        this.disputeForm.deanId = String(userInfo.deanId)
      }
    },
    padZero(num: number): string {
      return num < 10 ? `0${num}` : `${num}`
    },
    goBack() {
      uni.navigateBack({
        fail: () => {
          uni.redirectTo({
            url: '/pages/dean/dispute'
          })
        }
      })
    },
    onDateChange(e: any) {
      this.disputeForm.date = String(e.detail.value || '')
    },
    onTimeChange(e: any) {
      this.disputeForm.time = String(e.detail.value || '')
    },
    onTypeChange(e: any) {
      this.disputeForm.typeIndex = Number(e.detail.value)
    },
    selectUrgency(level: number) {
      this.disputeForm.urgencyLevel = level
    },
    getSelectedType(): string {
      return this.disputeTypes[this.disputeForm.typeIndex] || '请选择纠纷类型'
    },
    getUrgencyLabel(level: number): string {
      switch (level) {
        case 0:
          return '低'
        case 1:
          return '中'
        case 2:
          return '高'
        default:
          return '中'
      }
    },
    getUrgencyDesc(level: number): string {
      switch (level) {
        case 0:
          return '先记录，后续安排处理'
        case 1:
          return '尽快纳入处理计划'
        case 2:
          return '优先跟进，避免扩大影响'
        default:
          return '尽快纳入处理计划'
      }
    },
    getFilledCount(): number {
      let count = 0

      if (String(this.disputeForm.title || '').trim()) {
        count++
      }
      if (String(this.disputeForm.description || '').trim()) {
        count++
      }
      if (String(this.disputeForm.date || '').trim()) {
        count++
      }
      if (String(this.disputeForm.time || '').trim()) {
        count++
      }
      if (String(this.getSelectedType() || '').trim() !== '请选择纠纷类型') {
        count++
      }
      if (this.disputeForm.urgencyLevel >= 0) {
        count++
      }

      return count
    },
    getFormProgress(): number {
      const progress = Math.round((this.getFilledCount() / 6) * 100)
      return progress > 100 ? 100 : progress
    },
    getMissingFields(): string[] {
      const missing: string[] = []

      if (!String(this.disputeForm.title || '').trim()) {
        missing.push('标题')
      }
      if (!String(this.disputeForm.description || '').trim()) {
        missing.push('详情')
      }
      if (!String(this.disputeForm.date || '').trim()) {
        missing.push('日期')
      }
      if (!String(this.disputeForm.time || '').trim()) {
        missing.push('时间')
      }
      if (String(this.getSelectedType() || '').trim() === '请选择纠纷类型') {
        missing.push('类型')
      }
      if (this.disputeForm.urgencyLevel < 0) {
        missing.push('紧急程度')
      }

      return missing
    },
    getCompletionHint(): string {
      const missing = this.getMissingFields()
      if (missing.length === 0) {
        return '信息已经填写完整，可以直接提交'
      }
      if (missing.length === 1) {
        return `还差${missing[0]}，补齐后即可提交`
      }
      if (missing.length === 2) {
        return `还差${missing[0]}和${missing[1]}`
      }
      return `还差${missing[0]}、${missing[1]}等${missing.length}项`
    },
    getSubmitHint(): string {
      const missing = this.getMissingFields()
      if (missing.length === 0) {
        return `已完善全部信息，建议直接提交。当前紧急程度：${this.getUrgencyDesc(this.disputeForm.urgencyLevel)}`
      }
      return `请先补齐${missing.slice(0, 2).join('、')}。`
    },
    async submitDispute() {
      if (this.isSubmitting) {
        return
      }

      if (!String(this.disputeForm.title || '').trim()) {
        uni.showToast({
          title: '请输入纠纷标题',
          icon: 'none'
        })
        return
      }

      if (!String(this.disputeForm.description || '').trim()) {
        uni.showToast({
          title: '请输入纠纷详情',
          icon: 'none'
        })
        return
      }

      if (!String(this.disputeForm.date || '').trim() || !String(this.disputeForm.time || '').trim()) {
        uni.showToast({
          title: '请选择发生时间',
          icon: 'none'
        })
        return
      }

      if (String(this.getSelectedType() || '').trim() === '请选择纠纷类型') {
        uni.showToast({
          title: '请选择纠纷类型',
          icon: 'none'
        })
        return
      }

      if (!this.disputeForm.deanId) {
        uni.showToast({
          title: '院长信息缺失，请重新登录',
          icon: 'none'
        })
        uni.redirectTo({
          url: '/pages/dean/login'
        })
        return
      }

      const accessToken = String(uni.getStorageSync('accessToken') || '').trim()
      const refreshToken = String(uni.getStorageSync('refreshToken') || '').trim()

      if (!accessToken || !refreshToken) {
        uni.showToast({
          title: '请先登录',
          icon: 'none'
        })
        uni.redirectTo({
          url: '/pages/dean/login'
        })
        return
      }

      this.isSubmitting = true
      uni.showLoading({
        title: '提交中...'
      })

      try {
        const disputeData = {
          title: String(this.disputeForm.title).trim(),
          description: String(this.disputeForm.description).trim(),
          occurTime: `${this.disputeForm.date} ${this.disputeForm.time}`,
          type: this.getSelectedType(),
          urgencyLevel: this.disputeForm.urgencyLevel,
          deanId: this.disputeForm.deanId,
          status: 'new'
        }

        const result = await request.post('/dispute/add', {
          data: disputeData
        }) as {
          statusCode: number
          data: ApiResponse
        }

        const response = result.data
        if (result.statusCode === 200 && response && response.code === 1) {
          uni.showToast({
            title: '添加纠纷成功',
            icon: 'success',
            duration: 1500
          })

          setTimeout(() => {
            uni.navigateBack({
              fail: () => {
                uni.redirectTo({
                  url: '/pages/dean/dispute'
                })
              }
            })
          }, 1200)
          return
        }

        uni.showToast({
          title: response && response.msg ? response.msg : '添加失败',
          icon: 'none'
        })
      } catch (error) {
        console.error('请求错误:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      } finally {
        this.isSubmitting = false
        uni.hideLoading()
      }
    }
  }
}
</script>

