<template>
  <view class="page">
    <!-- 顶部标题 -->
    <view class="header">
      <view class="back-btn" @click="goBack">
        <text class="back-icon">←</text>
      </view>
      <text class="header-title">新增纠纷</text>
    </view>
    
    <!-- 表单内容 -->
    <view class="form-container">
      <!-- 纠纷标题 -->
      <view class="form-item">
        <text class="form-label">纠纷标题</text>
        <input 
          class="form-input" 
          v-model="disputeForm.title" 
          placeholder="请输入纠纷标题" 
          maxlength="30"
        />
      </view>
      
      <!-- 纠纷详情 -->
      <view class="form-item">
        <text class="form-label">纠纷详情</text>
        <textarea 
          class="form-textarea" 
          v-model="disputeForm.description" 
          placeholder="请详细描述纠纷内容..." 
          maxlength="200"
        />
        <text class="char-count">{{ disputeForm.description.length }}/200</text>
      </view>
      
      <!-- 纠纷发生时间 -->
      <view class="form-item">
        <text class="form-label">发生时间</text>
        <view class="time-picker">
          <picker 
            mode="date" 
            :value="disputeForm.date" 
            @change="(e) => { disputeForm.date = e.detail.value; onDateChange(e) }"
          >
            <view class="picker-value">
              <text>{{ disputeForm.date || '请选择日期' }}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <picker 
            mode="time" 
            :value="disputeForm.time" 
            @change="(e) => { disputeForm.time = e.detail.value; onTimeChange(e) }"
          >
            <view class="picker-value">
              <text>{{ disputeForm.time || '请选择时间' }}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 纠纷类型 -->
      <view class="form-item">
        <text class="form-label">纠纷类型</text>
        <picker 
          mode="selector" 
          :range="disputeTypes" 
          :value="disputeForm.typeIndex" 
          @change="(e) => { disputeForm.typeIndex = Number(e.detail.value); onTypeChange(e) }"
        >
          <view class="picker-value">
            <text>{{ disputeTypes[disputeForm.typeIndex] || '请选择纠纷类型' }}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      
      <!-- 紧急程度 -->
      <view class="form-item">
        <text class="form-label">紧急程度</text>
        <view class="urgency-selector">
          <view 
            v-for="(level, index) in urgencyLevels" 
            :key="index"
            :class="['urgency-item', { 'selected': disputeForm.urgencyLevel === index }]"
            @click="selectUrgency(index)"
          >
            <text>{{ level.text }}</text>
          </view>
        </view>
      </view>
      
      <!-- 提交按钮 -->
      <button class="submit-btn" @click="submitDispute" :disabled="isSubmitting">
        {{ isSubmitting ? '提交中...' : '提交纠纷' }}
      </button>
    </view>
  </view>
</template>

<script lang="uts">
interface DisputeForm {
  title: string;
  description: string;
  date: string;
  time: string;
  typeIndex: number;
  urgencyLevel: number;
  deanId: string;
}

export default {
  data() {
    return {
      isSubmitting: false,
      disputeForm: {
        title: '',
        description: '',
        date: '',
        time: '',
        typeIndex: 0,
        urgencyLevel: 1,
        deanId: ''
      } as DisputeForm,
      disputeTypes: [
        '设施问题',
        '服务质量',
        '人员投诉',
        '安全隐患',
        '饮食问题',
        '其他'
      ],
      urgencyLevels: [
        { text: '低', color: '#26c48b' },
        { text: '中', color: '#ffaa00' },
        { text: '高', color: '#ff6b6b' }
      ]
    };
  },
  onLoad() {
    // 获取当前日期和时间作为默认值
    const now = new Date();
    const year = now.getFullYear();
    const month = this.padZero(now.getMonth() + 1);
    const day = this.padZero(now.getDate());
    const hours = this.padZero(now.getHours());
    const minutes = this.padZero(now.getMinutes());
    
    this.disputeForm.date = `${year}-${month}-${day}`;
    this.disputeForm.time = `${hours}:${minutes}`;
    
    // 从本地存储获取deanId
    const userInfo = uni.getStorageSync('userInfo');
    if (userInfo && userInfo.deanId) {
      this.disputeForm.deanId = userInfo.deanId;
    }
  },
  methods: {
    padZero(num: number): string {
      return num < 10 ? `0${num}` : `${num}`;
    },
    goBack() {
      uni.navigateBack();
    },
    onDateChange(e: any) {
      this.disputeForm.date = e.detail.value;
    },
    onTimeChange(e: any) {
      this.disputeForm.time = e.detail.value;
    },
    onTypeChange(e: any) {
      this.disputeForm.typeIndex = Number(e.detail.value);
    },
    selectUrgency(level: number) {
      this.disputeForm.urgencyLevel = level;
    },
    async submitDispute() {
      // 表单验证
      if (!this.disputeForm.title.trim()) {
        uni.showToast({
          title: '请输入纠纷标题',
          icon: 'none'
        });
        return;
      }
      
      if (!this.disputeForm.description.trim()) {
        uni.showToast({
          title: '请输入纠纷详情',
          icon: 'none'
        });
        return;
      }
      
      if (!this.disputeForm.date || !this.disputeForm.time) {
        uni.showToast({
          title: '请选择发生时间',
          icon: 'none'
        });
        return;
      }
      
      this.isSubmitting = true;
      
      try {
        // 获取Token
        const accessToken = uni.getStorageSync('accessToken');
        const refreshToken = uni.getStorageSync('refreshToken');
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          });
          return;
        }
        
        // 构造请求数据
        const disputeData = {
          title: this.disputeForm.title,
          description: this.disputeForm.description,
          occurTime: `${this.disputeForm.date} ${this.disputeForm.time}`,
          type: this.disputeTypes[this.disputeForm.typeIndex],
          urgencyLevel: this.disputeForm.urgencyLevel,
          deanId: this.disputeForm.deanId,
          status: 'new' // 新增纠纷默认状态为"新增"
        };
        
        // 发送添加纠纷请求
        const result = await uni.request({
          url: 'http://localhost:8080/dispute/add',
          method: 'POST',
          data: disputeData,
          header: {
            'Content-Type': 'application/json',
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        });
        
        const response = result.data as any;
        console.log('添加纠纷响应:', response);
        
        if (response && response.code === 1) {
          uni.showToast({
            title: '添加纠纷成功',
            icon: 'success',
            duration: 2000
          });
          
          // 延迟返回上一页
          setTimeout(() => {
            uni.navigateBack();
          }, 2000);
        } else {
          uni.showToast({
            title: response.msg || '添加失败',
            icon: 'none'
          });
        }
      } catch (error) {
        console.error('请求错误:', error);
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        });
      } finally {
        this.isSubmitting = false;
      }
    }
  }
};
</script>

<style>
