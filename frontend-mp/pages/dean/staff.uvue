<script lang="uts">
interface Staff {
  caretakerId: string
  deanId: string
  name: string
  avatar: string
  phone: string
  specialty: string
  isEnable: number
}

interface ApiResponse {
  code: number
  msg: string | null
  data: {
    total: number
    pages: number
    list: Staff[]
  }
}

interface Position {
  left: number
  top: number
}

export default {
  data() {
    return {
      searchKey: '',
      staffList: [] as Staff[],
      total: 0,
      loading: false,
      isMoving: false,
      showDetail: false,
      selectedStaff: null as Staff | null,
      btnPosition: {
        left: -1,
        top: -1
      } as Position
    }
  },
  onLoad() {
    this.loadBtnPosition()
    this.fetchStaffList()
  },
  computed: {
    filteredStaffList(): Staff[] {
      const keyword = this.searchKey.trim()
      if (!keyword) {
        return this.staffList
      }

      return this.staffList.filter(staff => {
        return staff.name.includes(keyword) ||
          staff.phone.includes(keyword) ||
          staff.specialty.includes(keyword)
      })
    }
  },
  methods: {
    async fetchStaffList() {
      try {
        this.loading = true
        const accessToken = uni.getStorageSync('accessToken') as string
        const refreshToken = uni.getStorageSync('refreshToken') as string

        if (!accessToken || !refreshToken) {
          uni.showToast({ title: '请先登录', icon: 'none' })
          uni.redirectTo({ url: '/pages/dean/login' })
          return
        }

        const result = await uni.request({
          url: 'http://localhost:8080/dean/caretaker/page',
          method: 'GET',
          data: {
            pageNo: '1',
            pageSize: '999',
            name: '',
            phone: '',
            specialty: ''
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.staffList = response.data.list
          this.total = response.data.total
        } else {
          this.staffList = []
          uni.showToast({ title: '获取员工列表失败', icon: 'none' })
        }
      } catch (error) {
        console.error('请求失败:', error)
        uni.showToast({ title: '网络错误', icon: 'none' })
      } finally {
        this.loading = false
      }
    },
    reloadStaffList() {
      this.fetchStaffList()
    },
    loadBtnPosition() {
      try {
        const position = uni.getStorageSync('addBtnPosition')
        if (position) {
          this.btnPosition = JSON.parse(position) as Position
          return
        }
      } catch (error) {
        console.error('获取按钮位置失败:', error)
      }

      const systemInfo = uni.getSystemInfoSync()
      this.btnPosition = {
        left: systemInfo.windowWidth - 140,
        top: systemInfo.windowHeight - 220
      }
    },
    startMoveBtn() {
      this.isMoving = true
      uni.showToast({ title: '按住拖动', icon: 'none', duration: 1000 })
    },
    moveBtn(e: any) {
      if (!this.isMoving) return
      e.stopPropagation()
      e.preventDefault()
      const touch = e.touches[0]
      this.btnPosition.left = touch.clientX - 50
      this.btnPosition.top = touch.clientY - 50
    },
    endMoveBtn() {
      if (!this.isMoving) return
      this.isMoving = false
      try {
        uni.setStorageSync('addBtnPosition', JSON.stringify(this.btnPosition))
        uni.showToast({ title: '位置已保存', icon: 'success', duration: 1000 })
      } catch (error) {
        console.error('保存按钮位置失败:', error)
      }
    },
    prevPage() {
      if (this.pageNo <= 1) return
      this.pageNo--
      this.fetchStaffList()
    },
    nextPage() {
      if (this.pageNo >= this.pages) return
      this.pageNo++
      this.fetchStaffList()
    },
    openStaffDetail(staff: Staff) {
      this.selectedStaff = staff
      this.showDetail = true
    },
    closeStaffDetail() {
      this.showDetail = false
      this.selectedStaff = null
    },
    addNewStaff() {
      if (this.isMoving) return
      uni.navigateTo({
        url: '/pages/dean/staff-add'
      })
    },
    redirectTo(url: string) {
      uni.redirectTo({ url: url })
    }
  }
}
</script>

