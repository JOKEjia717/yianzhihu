    <view v-if="showDetail" class="detail-mask" @click="closeStaffDetail">
      <view class="detail-sheet" @click.stop>
        <view class="detail-header">
          <view>
            <text class="detail-title">{{ selectedStaff?.name || '员工详情' }}</text>
            <text class="detail-subtitle">{{ selectedStaff?.specialty || '暂无专业信息' }}</text>
          </view>
          <view
            class="detail-status"
            :class="selectedStaff?.isEnable === 1 ? 'active' : 'inactive'"
          >
            {{ selectedStaff?.isEnable === 1 ? '在岗' : '离岗' }}
          </view>
        </view>

        <view class="detail-row">
          <text class="detail-label">电话</text>
          <text class="detail-value">{{ selectedStaff?.phone || '暂无电话' }}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">院长ID</text>
          <text class="detail-value">{{ selectedStaff?.deanId || '暂无信息' }}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">员工ID</text>
          <text class="detail-value">{{ selectedStaff?.caretakerId || '暂无信息' }}</text>
        </view>

        <view class="detail-actions">
          <view class="detail-btn ghost" @click="closeStaffDetail">
            <text>关闭</text>
          </view>
          <view class="detail-btn primary" @click="addNewStaff">
            <text>新增员工</text>
          </view>
        </view>
      </view>
    </view>

    <view
      class="add-btn"
      :style="{ left: btnPosition.left + 'px', top: btnPosition.top + 'px', right: 'auto', bottom: 'auto' }"
      @click="addNewStaff"
      @longpress="startMoveBtn"
      @touchmove="moveBtn"
      @touchend="endMoveBtn"
    >
      <text class="add-icon">+</text>
      <text v-if="isMoving" class="moving-tip">松开手指放置</text>
    </view>

    <view class="tabbar">
      <view class="tabbar-item" @click="redirectTo('/pages/dean/index')">
        <image class="tabbar-icon" src="/static/images/home.png"></image>
