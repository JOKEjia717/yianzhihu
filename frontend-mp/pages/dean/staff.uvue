        <view class="section-header">
          <view>
            <text class="section-title">信息概览</text>
            <text class="section-subtitle">把常看的统计放在前面</text>
          </view>
          <view class="section-pill">
            <text class="section-pill-text">2 项</text>
          </view>
        </view>
        <view class="overview-grid">
          <view class="overview-card">
            <text class="overview-label">员工总数</text>
            <text class="overview-value">{{ total }}</text>
          </view>
          <view class="overview-card">
            <text class="overview-label">当前可见</text>
            <text class="overview-value">{{ filteredStaffList.length }}</text>
          </view>
        </view>
      </view>

      <view class="section staff-section">
        <view class="section-header">
          <view>
            <text class="section-title">我的员工</text>
            <text class="section-subtitle">点击卡片查看员工详情</text>
          </view>
          <view class="section-pill primary-pill" @click="addNewStaff">
            <text class="section-pill-text primary-pill-text">新增员工</text>
          </view>
        </view>

        <view v-if="loading" class="state-box">
          <text>正在加载员工信息...</text>
        </view>

        <view v-else-if="filteredStaffList.length === 0" class="state-box empty">
          <text>暂无匹配员工</text>
        </view>

        <view v-else class="staff-list">
          <view
            v-for="staff in filteredStaffList"
            :key="staff.caretakerId"
            class="staff-item"
            @click="openStaffDetail(staff)"
          >
            <image
              class="staff-avatar"
              :src="staff.avatar || '/static/images/default-avatar.png'"
              mode="aspectFill"
            ></image>
            <view class="staff-col">
              <text class="staff-name">{{ staff.name }}</text>
              <text class="staff-status" :class="staff.isEnable === 1 ? 'active' : 'inactive'">
                {{ staff.isEnable === 1 ? '在岗' : '离岗' }}
              </text>
            </view>
            <view class="staff-col">
              <text class="staff-position">{{ staff.specialty || '暂无专业信息' }}</text>
            </view>
            <view class="staff-col">
              <text class="staff-phone">{{ staff.phone || '暂无电话' }}</text>
            </view>
            <view class="view-btn">
              <text>详情</text>
            </view>
          </view>
        </view>
