<template>
  <view class="container">
    <!-- 图标 -->
    <image class="logo" src="/static/images/paper-plane.png" mode="aspectFit"></image>
    
    <!-- 欢迎标题 -->
    <view class="welcome-text">
      <text class="welcome-en">Welcome home !</text>
      <text class="welcome-cn">老人登录</text>
    </view>

    <!-- 登录表单 -->
    <view class="form-container">
      <view class="form-header">
        <view class="tab-group">
          <text class="tab-item active">登陆</text>
          <text class="tab-item" @click="goToRegister">注册</text>
        </view>
      </view>
      
      <view class="form-content">
        <input 
          class="input" 
          v-model="formData.account" 
          placeholder="请输入账号"
          type="text"
        />
        <input 
          class="input" 
          v-model="formData.password" 
          placeholder="请输入密码"
          type="password"
        />
        
        <!-- 确认按钮 -->
        <button class="submit-btn" @click="handleLogin">确认</button>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { request } from '../../utils/request'
import { updateTokens } from '../../utils/request'

interface UserInfo {
  accessToken: string
  refreshToken: string
  elderId: string
  avatar: string
  name: string
  phone: string
  isEnable: number
}

interface ApiResponse<T> {
  code: number
  msg: string | null
  data: T
}

interface LoginForm {
  account: string
  password: string
}

export default {
  data() {
    return {
      formData: {
        account: '',
        password: ''
      } as LoginForm
    }
  },
  methods: {
    async handleLogin() {
      if (!this.formData.account || !this.formData.password) {
        uni.showToast({
          title: '请输入账号和密码',
          icon: 'none'
        })
        return
      }

      try {
        const res = await request.post('/children/loginByUsername', {
          data: {
            account: this.formData.account,
            password: this.formData.password
          },
          skipToken: true
        }) as { 
          statusCode: number, 
          data: ApiResponse<UserInfo> 
        }
        
        if (res.statusCode === 200 && res.data.code === 1) {
          const { accessToken, refreshToken } = res.data.data
          
          updateTokens(accessToken, refreshToken)
          uni.setStorageSync('userInfo', res.data.data)
          
          uni.redirectTo({
            url: '/pages/elder/index'
          })
        } else {
          uni.showToast({
            title: res.data.msg || '登录失败',
            icon: 'none'
          })
        }
      } catch (error: any) {
        uni.showToast({
          title: error.message || '登录失败',
          icon: 'none'
        })
      }
    },
    goToRegister() {
      uni.navigateTo({
        url: '/pages/elder/register'
      })
    }
  }
}
</script>

