							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：番茄炒蛋、豆腐汤' }
						]
					},
					{
						day: 1,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '09:30', title: '健康讲座', desc: '高血压预防知识' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：红烧肉、青菜' },
							{ time: '14:00', title: '棋牌活动', desc: '棋牌室开放' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：糖醋排骨、紫菜蛋花汤' }
						]
					},
					{
						day: 2,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '手工制作', desc: '剪纸艺术课' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：宫保鸡丁、土豆丝' },
							{ time: '15:00', title: '电影放映', desc: '经典老电影欣赏' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：红烧鱼、清炒时蔬' }
						]
					},
					{
						day: 3,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '晨练活动', desc: '广场舞练习' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：狮子头、冬瓜汤' },
							{ time: '14:30', title: '书法课', desc: '毛笔字练习' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：炒面、海带排骨汤' }
						]
					},
					{
						day: 4,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '健康检查', desc: '定期血压测量' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：回锅肉、蒜蓉西兰花' },
							{ time: '15:00', title: '茶艺活动', desc: '茶文化品鉴' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：酸菜鱼、炒青菜' }
						]
					},
					{
						day: 5,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '晨练活动', desc: '太极剑练习' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：咖喱鸡饭、凉拌黄瓜' },
							{ time: '14:00', title: '棋牌比赛', desc: '麻将友谊赛' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：烤鸭、蔬菜沙拉' }
						]
					},
					{
						day: 6,
						items: [
							{ time: '08:30', title: '早餐时间', desc: '周末早茶' },
							{ time: '10:30', title: '户外活动', desc: '公园散步' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：饺子宴' },
							{ time: '15:00', title: '联欢会', desc: '周末文艺表演' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：火锅' }
						]
					}
				],
				showHealthModal: false,
				healthData: {
					title: '今日血压正常',
					systolic: '120',
					diastolic: '80',
					pulse: '72',
					advice: '您今日血压状态良好，请继续保持规律作息和健康饮食。建议每天进行适度的运动，如散步、太极等。'
				},
				weeklyHealthData: [
					{ day: 0, title: '今日血压正常', systolic: '122', diastolic: '82', pulse: '74', advice: '您今日血压状态良好，请继续保持规律作息和健康饮食。建议每天进行适度的运动，如散步、太极等。' },
					{ day: 1, title: '血压略偏高', systolic: '138', diastolic: '88', pulse: '78', advice: '今日血压略偏高，建议您保持情绪稳定，避免剧烈运动，适当休息。如有持续偏高请及时联系医生。' },
					{ day: 2, title: '今日血压正常', systolic: '118', diastolic: '78', pulse: '70', advice: '血压控制得很好！请继续保持健康的生活习惯，多喝水，适当补充营养。' },
					{ day: 3, title: '血压偏低', systolic: '108', diastolic: '68', pulse: '66', advice: '今日血压偏低，建议您适当补充盐分和水分，避免突然站立导致头晕。如有不适请及时告知医护人员。' },
					{ day: 4, title: '今日血压正常', systolic: '125', diastolic: '80', pulse: '73', advice: '血压状态良好，继续保持规律的作息时间，适当进行户外活动，呼吸新鲜空气。' },
					{ day: 5, title: '血压略偏高', systolic: '135', diastolic: '85', pulse: '76', advice: '血压略有上升，建议您放松心情，避免过度劳累。可以听一些舒缓的音乐来缓解压力。' },
					{ day: 6, title: '今日血压正常', systolic: '120', diastolic: '80', pulse: '72', advice: '周末愉快！今日血压状态很好，请好好休息，享受美好的周末时光。' }
				]
			}
		},
		onShow() {
			const userInfo = uni.getStorageSync('userInfo')
			if (userInfo && userInfo.name) {
				this.userName = userInfo.name
			}
			this.updateDate()
			this.updateGreeting()
			this.updateWeather()
			this.updateHealthData()
			this.updateScheduleData()
		},
		methods: {
			handleBannerChange(e: any) {
				this.currentBannerIndex = e.detail.current
			},
			updateDate() {
				const now = new Date()
				const year = now.getFullYear()
				const month = now.getMonth() + 1
				const day = now.getDate()
				const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
				const weekDay = weekDays[now.getDay()]
				this.currentDate = `${year}年${month}月${day}日`
				this.currentWeek = weekDay
			},
			updateGreeting() {
				const hour = new Date().getHours()
				if (hour < 6) {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				} else if (hour < 12) {
					this.greeting = '早上好，'
					this.greetingDesc = '新的一天开始了，祝您心情愉快'
				} else if (hour < 14) {
					this.greeting = '中午好，'
					this.greetingDesc = '记得按时吃饭，好好休息'
				} else if (hour < 18) {
					this.greeting = '下午好，'
					this.greetingDesc = '今天也是美好的一天'
				} else if (hour < 22) {
					this.greeting = '晚上好，'
					this.greetingDesc = '今天辛苦了，早点休息'
				} else {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				}
			},
			updateWeather() {
				const weathers = [
					{ icon: '☀', text: '晴' },
					{ icon: '⛅', text: '多云' },
					{ icon: '☁', text: '阴' },
					{ icon: '🌧', text: '小雨' },
					{ icon: '🌨', text: '小雪' },
					{ icon: '🌤', text: '晴转多云' },
					{ icon: '🌥', text: '多云转晴' },
					{ icon: '❄', text: '大雪' },
					{ icon: '🌩', text: '雷阵雨' },
					{ icon: '🌫', text: '雾霾' }
				]
				const randomIndex = Math.floor(Math.random() * weathers.length)
				const randomWeather = weathers[randomIndex]
				this.weatherIcon = randomWeather.icon
				this.weatherText = randomWeather.text
			},
			updateHealthData() {
				const dayOfWeek = new Date().getDay()
				const todayHealth = this.weeklyHealthData.find(item => item.day === dayOfWeek)
				if (todayHealth) {
					this.healthData = { ...todayHealth }
				}
			},
			updateScheduleData() {
				const dayOfWeek = new Date().getDay()
				const todaySchedule = this.weeklySchedules.find(item => item.day === dayOfWeek)
				if (todaySchedule) {
					this.schedules = [...todaySchedule.items]
				}
			},
			goToHealth() {
				uni.showToast({
					title: '健康查看功能开发中',
					icon: 'none'
				})
			},
			goToActivity() {
				uni.showToast({
					title: '活动预约功能开发中',
					icon: 'none'
				})
			},
			goToCare() {
				uni.showToast({
					title: '护理记录功能开发中',
					icon: 'none'
				})
			},
			goToContact() {
				uni.showToast({
					title: '联系子女功能开发中',
					icon: 'none'
				})
			}
		}
	}
</script>

