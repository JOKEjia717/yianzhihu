	.schedule-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		flex: 1;
		text-align: left;
	}

	.schedule-title {
		font-size: 32rpx;
		color: #1F2937;
		display: block;
		margin-bottom: 8rpx;
		font-weight: 700;
	}

	.schedule-desc {
		font-size: 28rpx;
		color: #6B7280;
		line-height: 1.5;
	}

	.schedule-status-row {
		margin-top: 16rpx;
		display: flex;
		justify-content: flex-start;
	}

	.schedule-status-badge {
		padding: 8rpx 16rpx;
		border-radius: 999rpx;
		background: #EEF2F4;
		border: 1rpx solid #DCE3E6;
	}

	.schedule-status-badge.active {
		background: rgba(46, 125, 50, 0.12);
		border-color: rgba(46, 125, 50, 0.18);
	}

	.schedule-status-badge.completed {
		background: #ECEFF1;
		border-color: #DDE3E7;
	}

