		onShow() {
			const userInfo = uni.getStorageSync('userInfo')
			if (userInfo && userInfo.name) {
				this.userName = userInfo.name
			}
			this.loadContactInfo()
			this.updateDate()
			this.updateGreeting()
			this.updateWeather()
			this.updateHealthData()
			this.updateScheduleData()
			this.startScheduleAutoRefresh()
		},
