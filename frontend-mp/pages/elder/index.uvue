<script lang="uts">
	export default {
		data() {
			return {
				currentBannerIndex: 0,
				userName: '张爷爷'
			}
		},
		onShow() {
			const userInfo = uni.getStorageSync('userInfo')
			if (userInfo && userInfo.name) {
				this.userName = userInfo.name
			}
		},
		methods: {
			handleBannerChange(e: any) {
				this.currentBannerIndex = e.detail.current
			},
			goToHealth() {
				uni.showToast({
					title: '健康查看功能开发中',
					icon: 'none'
				})
			},
			goToActivity() {
				uni.showToast({
					title: '活动预约功能开发中',
					icon: 'none'
				})
			},
			goToCare() {
				uni.showToast({
					title: '护理记录功能开发中',
					icon: 'none'
				})
			},
			goToContact() {
				uni.showToast({
					title: '联系子女功能开发中',
					icon: 'none'
				})
			}
		}
	}
</script>

