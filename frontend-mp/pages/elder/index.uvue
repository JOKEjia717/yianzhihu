			this.stopScheduleAutoRefresh()
		},
		methods: {
			handleBannerChange(e: any) {
				this.currentBannerIndex = e.detail.current
			},
			updateDate() {
				const now = new Date()
				const year = now.getFullYear()
				const month = now.getMonth() + 1
				const day = now.getDate()
				const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
				const weekDay = weekDays[now.getDay()]
				this.currentDate = `${year}年${month}月${day}日`
				this.currentWeek = weekDay
			},
			updateGreeting() {
				const hour = new Date().getHours()
				if (hour < 6) {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				} else if (hour < 12) {
					this.greeting = '早上好，'
					this.greetingDesc = '新的一天开始了，祝您心情愉快'
				} else if (hour < 14) {
					this.greeting = '中午好，'
					this.greetingDesc = '记得按时吃饭，好好休息'
				} else if (hour < 18) {
					this.greeting = '下午好，'
					this.greetingDesc = '今天也是美好的一天'
				} else if (hour < 22) {
					this.greeting = '晚上好，'
					this.greetingDesc = '今天辛苦了，早点休息'
				} else {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				}
			},
			updateWeather() {
				const weathers = [
					{ icon: '☀', text: '晴' },
					{ icon: '⛅', text: '多云' },
					{ icon: '☁', text: '阴' },
					{ icon: '🌧', text: '小雨' },
					{ icon: '🌨', text: '小雪' },
					{ icon: '🌤', text: '晴转多云' },
					{ icon: '🌥', text: '多云转晴' },
					{ icon: '❄', text: '大雪' },
					{ icon: '🌩', text: '雷阵雨' },
					{ icon: '🌫', text: '雾霾' }
				]
				const randomIndex = Math.floor(Math.random() * weathers.length)
				const randomWeather = weathers[randomIndex]
				this.weatherIcon = randomWeather.icon
				this.weatherText = randomWeather.text
			},
			getHealthDisplayMeta(healthItem) {
				const title = healthItem.title || ''
				const systolic = healthItem.systolic || ''
				const diastolic = healthItem.diastolic || ''
				if (title.indexOf('正常') !== -1) {
					return {
						statusLabel: '正常',
						statusType: 'success',
						summary: `血压 ${systolic}/${diastolic} mmHg，处于正常范围，请继续保持规律作息。`
					}
				}
				if (title.indexOf('偏高') !== -1) {
					return {
						statusLabel: '关注',
						statusType: 'warning',
						summary: `血压 ${systolic}/${diastolic} mmHg 略有升高，先休息一下，注意清淡饮食。`
					}
				}
				if (title.indexOf('偏低') !== -1) {
					return {
						statusLabel: '注意',
						statusType: 'info',
						summary: `血压 ${systolic}/${diastolic} mmHg 略偏低，请慢慢起身，注意补水。`
					}
				}
				return {
					statusLabel: '观察',
					statusType: 'neutral',
					summary: '请继续观察血压变化，如有不适及时联系护理人员。'
				}
			},
			updateHealthData() {
				const dayOfWeek = new Date().getDay()
				const todayHealth = this.weeklyHealthData.find(item => item.day === dayOfWeek)
				if (todayHealth) {
					this.healthData = { ...todayHealth, ...this.getHealthDisplayMeta(todayHealth) }
				}
			},
			updateScheduleData() {
				const now = new Date()
				const nowMinutes = now.getHours() * 60 + now.getMinutes()
				this.currentClockText = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`

				const dayOfWeek = now.getDay()
				const todaySchedule = this.weeklySchedules.find(item => item.day === dayOfWeek)
				if (todaySchedule) {
					this.schedules = [...todaySchedule.items]
					this.currentScheduleIndex = this.getCurrentScheduleIndex(todaySchedule.items, nowMinutes)
					const summaryIndex = this.getScheduleSummaryIndex(todaySchedule.items, this.currentScheduleIndex)
					if (summaryIndex >= 0) {
						this.scheduleSummary = { ...todaySchedule.items[summaryIndex] }
					}
					this.scheduleSummaryState = this.getScheduleSummaryState(todaySchedule.items, this.currentScheduleIndex)
					this.scheduleSummaryHint = this.currentScheduleIndex < 0
						? '第一项到点后会自动高亮显示'
						: '当前进行中的安排已高亮显示'
					return
				}

				this.currentScheduleIndex = -1
				this.schedules = []
				this.scheduleSummary = {
					time: '--',
					title: '暂无安排',
					desc: '今天暂时没有安排内容'
				}
				this.scheduleSummaryState = '暂无安排'
				this.scheduleSummaryHint = '今天暂时没有安排内容'
			},
			startScheduleAutoRefresh() {
				this.stopScheduleAutoRefresh()
				this.scheduleRefreshTimer = setInterval(() => {
					this.updateScheduleData()
				}, 60000) as unknown as number
			},
			stopScheduleAutoRefresh() {
				if (this.scheduleRefreshTimer) {
					clearInterval(this.scheduleRefreshTimer)
					this.scheduleRefreshTimer = 0
				}
			},
			getScheduleMinutes(time: string) {
				if (!time) return -1
				const parts = String(time).split(':')
				if (parts.length !== 2) return -1
				const hours = parseInt(parts[0])
				const minutes = parseInt(parts[1])
				if (isNaN(hours) || isNaN(minutes)) return -1
				return hours * 60 + minutes
			},
			getCurrentScheduleIndex(items: any[], nowMinutes: number) {
				if (!items || items.length === 0) return -1

				let activeIndex = -1
				for (let index = 0; index < items.length; index++) {
					const itemMinutes = this.getScheduleMinutes(items[index].time)
					if (itemMinutes < 0) {
						continue
					}
					if (nowMinutes >= itemMinutes) {
						activeIndex = index
						continue
					}
					break
				}

				if (activeIndex < 0) {
					return -1
				}

				return activeIndex
			},
			getScheduleSummaryIndex(items: any[], activeIndex: number) {
				if (!items || items.length === 0) return -1
				if (activeIndex < 0) {
					return 0
				}
				return activeIndex
			},
			getScheduleSummaryState(items: any[], activeIndex: number) {
				if (!items || items.length === 0) {
					return '暂无安排'
				}
				if (activeIndex < 0) {
					return '下一项安排'
				}
				return '当前进行中'
			},
			getScheduleSummaryStateClass() {
				if (!this.schedules || this.schedules.length === 0) {
					return 'idle'
				}
				if (this.currentScheduleIndex < 0) {
					return 'upcoming'
				}
				return 'active'
			},
			getScheduleItemState(index: number) {
				if (this.currentScheduleIndex < 0) {
					if (index === 0) {
						return 'upcoming'
					}
					return 'future'
				}
				if (index < this.currentScheduleIndex) {
					return 'completed'
				}
				if (index === this.currentScheduleIndex) {
					return 'active'
				}
				if (index === this.currentScheduleIndex + 1) {
					return 'upcoming'
				}
				return 'future'
			},
			getScheduleStatusLabel(index: number) {
				const state = this.getScheduleItemState(index)
				if (state === 'active') {
					return '进行中'
				}
				if (state === 'completed') {
					return '已完成'
				}
				if (state === 'upcoming') {
					if (this.currentScheduleIndex < 0 && index === 0) {
						return '即将开始'
					}
					return '下一项'
				}
				return '待开始'
			},
			applyStoredContactInfo() {
				const userInfo: any = uni.getStorageSync('userInfo') || {}
				const childrenName = userInfo.childrenName || userInfo.contactName || ''
				const childrenPhone = userInfo.childrenPhone || userInfo.contactPhone || ''

				this.contactChildName = String(childrenName || '').trim()
				this.contactChildPhone = String(childrenPhone || '').trim()
			},
			async loadContactInfo() {
				try {
					const res = await request.get('/elder/contact-child') as {
						statusCode: number,
						data: ApiResponse<ContactChildInfo>
					}

					if (res.statusCode === 200 && res.data && res.data.code === 1) {
						const contact = res.data.data || { childrenName: '', childrenPhone: '' }
						this.contactChildName = String(contact.childrenName || '').trim()
						this.contactChildPhone = String(contact.childrenPhone || '').trim()
						return
					}
				} catch (error) {
					console.log('加载子女联系信息失败，使用本地缓存兜底', error)
				}

				this.applyStoredContactInfo()
			},
			goToMall() {
				uni.navigateTo({
					url: '/pages/shop/mall-entrance'
				})
			},
			goToActivity() {
					uni.navigateTo({
						url: '/pages/elder/activity'
					})
				},
			goToCare() {
				uni.navigateTo({
					url: '/pages/elder/nursing'
				})
			},
			goToContact() {
				this.showContactModal = true
				this.loadContactInfo()
			},
			closeContactModal() {
				this.showContactModal = false
			},
			callChildPhone() {
				const phoneNumber = String(this.contactChildPhone || '').trim()
				if (!phoneNumber) {
					uni.showToast({
						title: '暂无子女电话',
						icon: 'none'
					})
					return
				}

				uni.makePhoneCall({
					phoneNumber,
					fail: () => {
						uni.showToast({
							title: '拨打失败',
							icon: 'none'
						})
					}
				})
			},
			handleLogout() {
				uni.showModal({
					title: '提示',
					content: '确定要退出登录吗？',
					success: (res) => {
						if (res.confirm) {
							uni.clearStorageSync()
							uni.reLaunch({
								url: '/pages/elder/login'
							})
						}
					}
				})
			}
		}
	}
</script>

