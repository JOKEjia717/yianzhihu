							<view class="health-detail-item">
								<text class="detail-label">舒张压</text>
								<text class="detail-value">{{ healthData.diastolic }} mmHg</text>
							</view>
							<view class="health-detail-item">
								<text class="detail-label">脉搏</text>
								<text class="detail-value">{{ healthData.pulse }} 次/分</text>
							</view>
						</view>
						<view class="health-advice">
							<text class="advice-title">健康建议</text>
							<text class="advice-content">{{ healthData.advice }}</text>
						</view>
