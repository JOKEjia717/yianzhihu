			</view>
		</scroll-view>

		<!-- 今日安排弹窗 -->
		<view v-if="showScheduleModal" class="modal-overlay" @click="showScheduleModal = false">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">今日安排</text>
				</view>
				<scroll-view class="modal-body" scroll-y>
					<view class="schedule-list modal-list">
						<view class="schedule-item" v-for="(item, index) in schedules" :key="index">
							<view class="schedule-time">{{ item.time }}</view>
							<view class="schedule-content">
								<text class="schedule-title">{{ item.title }}</text>
								<text class="schedule-desc">{{ item.desc }}</text>
							</view>
						</view>
					</view>
				</scroll-view>
				<view class="modal-footer">
					<view class="modal-close" @click="showScheduleModal = false">
						<text class="close-icon">×</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 健康提示弹窗 -->
		<view v-if="showHealthModal" class="modal-overlay" @click="showHealthModal = false">
			<view class="modal-content health-modal" @click.stop>
				<view class="health-modal-header">
					<view class="health-modal-heading">
						<text class="modal-title">健康信息</text>
						<text class="health-modal-subtitle">今天的血压和脉搏情况</text>
					</view>
					<view class="health-modal-close" @click="showHealthModal = false">
						<text class="health-close-icon">×</text>
					</view>
				</view>
				<scroll-view class="modal-body health-modal-scroll" scroll-y>
					<view class="health-modal-body">
						<view class="health-summary-card">
							<view class="health-summary-top">
								<view :class="['health-status-badge', healthData.statusType]">
									<text class="health-status-badge-text">{{ healthData.statusLabel }}</text>
								</view>
								<text class="health-summary-meta">{{ currentDate }} {{ currentWeek }}</text>
							</view>
							<view class="health-summary-main">
								<view class="health-icon-big">
									<text class="icon-text-big">医</text>
								</view>
								<view class="health-summary-content">
									<text class="health-summary-title">{{ healthData.title }}</text>
									<text class="health-summary-desc">{{ healthData.summary }}</text>
								</view>
							</view>
						</view>

						<view class="health-metrics">
							<view class="metric-row">
								<text class="metric-label">收缩压</text>
								<view class="metric-value-group">
									<text class="metric-value">{{ healthData.systolic }}</text>
									<text class="metric-unit">mmHg</text>
								</view>
							</view>
							<view class="metric-row">
								<text class="metric-label">舒张压</text>
								<view class="metric-value-group">
									<text class="metric-value">{{ healthData.diastolic }}</text>
									<text class="metric-unit">mmHg</text>
								</view>
							</view>
							<view class="metric-row">
								<text class="metric-label">脉搏</text>
								<view class="metric-value-group">
									<text class="metric-value">{{ healthData.pulse }}</text>
									<text class="metric-unit">次/分</text>
								</view>
							</view>
						</view>

						<view class="health-advice">
							<text class="advice-title">护理建议</text>
							<text class="advice-content">{{ healthData.advice }}</text>
						</view>

						<view class="health-note">
							<text class="health-note-text">如果有头晕、胸闷或者持续不舒服，请及时联系护理人员。</text>
						</view>
					</view>
				</scroll-view>
				<view class="modal-footer health-modal-footer">
					<view class="health-close-btn" @click="showHealthModal = false">
						<text class="health-close-text">关闭</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 退出登录按钮 -->
		<view class="logout-section">
			<view class="logout-btn" @click="handleLogout">
				<text class="logout-text">退出登录</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		data() {
			return {
				currentBannerIndex: 0,
				userName: '张爷爷',
				currentDate: '',
				currentWeek: '',
				greeting: '',
				greetingDesc: '',
				weatherIcon: '☀',
				weatherText: '晴',
				showScheduleModal: false,
				schedules: [
					{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
					{ time: '10:00', title: '晨练活动', desc: '太极广场集合' },
					{ time: '12:00', title: '午餐时间', desc: '今日菜单：红烧肉、青菜' },
					{ time: '15:00', title: '娱乐活动', desc: '棋牌室活动' }
				],
				weeklySchedules: [
					{
						day: 0,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '晨练活动', desc: '太极广场集合' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：清蒸鱼、西兰花' },
							{ time: '15:00', title: '文艺活动', desc: '合唱团排练' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：番茄炒蛋、豆腐汤' }
						]
					},
					{
						day: 1,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '09:30', title: '健康讲座', desc: '高血压预防知识' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：红烧肉、青菜' },
							{ time: '14:00', title: '棋牌活动', desc: '棋牌室开放' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：糖醋排骨、紫菜蛋花汤' }
						]
					},
					{
						day: 2,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '手工制作', desc: '剪纸艺术课' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：宫保鸡丁、土豆丝' },
							{ time: '15:00', title: '电影放映', desc: '经典老电影欣赏' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：红烧鱼、清炒时蔬' }
						]
					},
					{
						day: 3,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '晨练活动', desc: '广场舞练习' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：狮子头、冬瓜汤' },
							{ time: '14:30', title: '书法课', desc: '毛笔字练习' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：炒面、海带排骨汤' }
						]
					},
					{
						day: 4,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '健康检查', desc: '定期血压测量' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：回锅肉、蒜蓉西兰花' },
							{ time: '15:00', title: '茶艺活动', desc: '茶文化品鉴' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：酸菜鱼、炒青菜' }
						]
					},
					{
						day: 5,
						items: [
							{ time: '08:00', title: '早餐时间', desc: '营养早餐已准备好' },
							{ time: '10:00', title: '晨练活动', desc: '太极剑练习' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：咖喱鸡饭、凉拌黄瓜' },
							{ time: '14:00', title: '棋牌比赛', desc: '麻将友谊赛' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：烤鸭、蔬菜沙拉' }
						]
					},
					{
						day: 6,
						items: [
							{ time: '08:30', title: '早餐时间', desc: '周末早茶' },
							{ time: '10:30', title: '户外活动', desc: '公园散步' },
							{ time: '12:00', title: '午餐时间', desc: '今日菜单：饺子宴' },
							{ time: '15:00', title: '联欢会', desc: '周末文艺表演' },
							{ time: '18:00', title: '晚餐时间', desc: '今日菜单：火锅' }
						]
					}
				],
				showHealthModal: false,
				healthData: {
					title: '今日血压正常',
					summary: '血压和脉搏都在正常范围内，请继续保持规律作息。',
					statusLabel: '正常',
					statusType: 'success',
					systolic: '120',
					diastolic: '80',
					pulse: '72',
					advice: '您今日血压状态良好，请继续保持规律作息和健康饮食。建议每天进行适度的运动，如散步、太极等。'
				},
				weeklyHealthData: [
					{ day: 0, title: '今日血压正常', systolic: '122', diastolic: '82', pulse: '74', advice: '您今日血压状态良好，请继续保持规律作息和健康饮食。建议每天进行适度的运动，如散步、太极等。' },
					{ day: 1, title: '血压略偏高', systolic: '138', diastolic: '88', pulse: '78', advice: '今日血压略偏高，建议您保持情绪稳定，避免剧烈运动，适当休息。如有持续偏高请及时联系医生。' },
					{ day: 2, title: '今日血压正常', systolic: '118', diastolic: '78', pulse: '70', advice: '血压控制得很好！请继续保持健康的生活习惯，多喝水，适当补充营养。' },
					{ day: 3, title: '血压偏低', systolic: '108', diastolic: '68', pulse: '66', advice: '今日血压偏低，建议您适当补充盐分和水分，避免突然站立导致头晕。如有不适请及时告知医护人员。' },
					{ day: 4, title: '今日血压正常', systolic: '125', diastolic: '80', pulse: '73', advice: '血压状态良好，继续保持规律的作息时间，适当进行户外活动，呼吸新鲜空气。' },
					{ day: 5, title: '血压略偏高', systolic: '135', diastolic: '85', pulse: '76', advice: '血压略有上升，建议您放松心情，避免过度劳累。可以听一些舒缓的音乐来缓解压力。' },
					{ day: 6, title: '今日血压正常', systolic: '120', diastolic: '80', pulse: '72', advice: '周末愉快！今日血压状态很好，请好好休息，享受美好的周末时光。' }
				]
			}
		},
		onShow() {
			const userInfo = uni.getStorageSync('userInfo')
			if (userInfo && userInfo.name) {
				this.userName = userInfo.name
			}
			this.updateDate()
			this.updateGreeting()
			this.updateWeather()
			this.updateHealthData()
			this.updateScheduleData()
		},
		methods: {
			handleBannerChange(e: any) {
				this.currentBannerIndex = e.detail.current
			},
			updateDate() {
				const now = new Date()
				const year = now.getFullYear()
				const month = now.getMonth() + 1
				const day = now.getDate()
				const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
				const weekDay = weekDays[now.getDay()]
				this.currentDate = `${year}年${month}月${day}日`
				this.currentWeek = weekDay
			},
			updateGreeting() {
				const hour = new Date().getHours()
				if (hour < 6) {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				} else if (hour < 12) {
					this.greeting = '早上好，'
					this.greetingDesc = '新的一天开始了，祝您心情愉快'
				} else if (hour < 14) {
					this.greeting = '中午好，'
					this.greetingDesc = '记得按时吃饭，好好休息'
				} else if (hour < 18) {
					this.greeting = '下午好，'
					this.greetingDesc = '今天也是美好的一天'
				} else if (hour < 22) {
					this.greeting = '晚上好，'
					this.greetingDesc = '今天辛苦了，早点休息'
				} else {
					this.greeting = '夜深了，'
					this.greetingDesc = '早点休息，晚安'
				}
			},
			updateWeather() {
				const weathers = [
					{ icon: '☀', text: '晴' },
					{ icon: '⛅', text: '多云' },
					{ icon: '☁', text: '阴' },
					{ icon: '🌧', text: '小雨' },
					{ icon: '🌨', text: '小雪' },
					{ icon: '🌤', text: '晴转多云' },
					{ icon: '🌥', text: '多云转晴' },
					{ icon: '❄', text: '大雪' },
					{ icon: '🌩', text: '雷阵雨' },
					{ icon: '🌫', text: '雾霾' }
				]
				const randomIndex = Math.floor(Math.random() * weathers.length)
				const randomWeather = weathers[randomIndex]
				this.weatherIcon = randomWeather.icon
				this.weatherText = randomWeather.text
			},
			getHealthDisplayMeta(healthItem) {
				const title = healthItem.title || ''
				const systolic = healthItem.systolic || ''
				const diastolic = healthItem.diastolic || ''
				if (title.indexOf('正常') !== -1) {
					return {
						statusLabel: '正常',
						statusType: 'success',
						summary: `血压 ${systolic}/${diastolic} mmHg，处于正常范围，请继续保持规律作息。`
					}
				}
				if (title.indexOf('偏高') !== -1) {
					return {
						statusLabel: '关注',
						statusType: 'warning',
						summary: `血压 ${systolic}/${diastolic} mmHg 略有升高，先休息一下，注意清淡饮食。`
					}
				}
				if (title.indexOf('偏低') !== -1) {
					return {
						statusLabel: '注意',
						statusType: 'info',
						summary: `血压 ${systolic}/${diastolic} mmHg 略偏低，请慢慢起身，注意补水。`
					}
				}
				return {
					statusLabel: '观察',
					statusType: 'neutral',
					summary: '请继续观察血压变化，如有不适及时联系护理人员。'
				}
			},
			updateHealthData() {
				const dayOfWeek = new Date().getDay()
				const todayHealth = this.weeklyHealthData.find(item => item.day === dayOfWeek)
				if (todayHealth) {
					this.healthData = { ...todayHealth, ...this.getHealthDisplayMeta(todayHealth) }
				}
			},
			updateScheduleData() {
				const dayOfWeek = new Date().getDay()
				const todaySchedule = this.weeklySchedules.find(item => item.day === dayOfWeek)
				if (todaySchedule) {
					this.schedules = [...todaySchedule.items]
				}
			},
			goToMall() {
				uni.navigateTo({
					url: '/pages/shop/mall-entrance'
				})
			},
			goToActivity() {
					uni.navigateTo({
						url: '/pages/elder/activity'
					})
				},
			goToCare() {
				uni.navigateTo({
					url: '/pages/elder/nursing'
				})
			},
			goToContact() {
				uni.showToast({
					title: '联系子女功能开发中',
					icon: 'none'
				})
			},
			handleLogout() {
				uni.showModal({
					title: '提示',
					content: '确定要退出登录吗？',
					success: (res) => {
						if (res.confirm) {
							uni.clearStorageSync()
							uni.reLaunch({
								url: '/pages/elder/login'
							})
						}
					}
				})
			}
		}
	}
</script>

<style>
	.container {
		min-height: 100vh;
		background: #F8FAF8;
		position: relative;
	}

	.content {
		height: 100vh;
	}

	/* 轮播图样式 */
	.banner {
		width: 100%;
		height: 420rpx;
		position: relative;
