  background: #E0E0E0;
  box-shadow: none;
}

.join-btn.joined .join-text {
  color: #999999;
}

.join-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.join-btn.disabled .join-text {
  color: #999999;
}

.join-btn:active:not(.disabled) {
  transform: scale(0.96);
  opacity: 0.9;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  border-top: 1rpx solid #E8E8E8;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  font-size: 42rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #999999;
}

.tab-item.active {
  position: relative;
}

.tab-item.active::before {
  content: '';
