<template>
	<view class="container">
		<view class="header">
			<text class="title">订单详情</text>
		</view>
		
		<scroll-view class="content" scroll-y>
			<view class="detail-card" v-if="orderDetail">
				<view class="section">
					<text class="section-title">订单信息</text>
					<view class="info-row">
						<text class="label">订单编号</text>
						<text class="value">{{orderDetail.bizOrderNo}}</text>
					</view>
					<view class="info-row">
						<text class="label">订单状态</text>
						<text class="value status" :class="getStatusClass(orderDetail.status)">{{getStatusText(orderDetail.status)}}</text>
					</view>
					<view class="info-row">
						<text class="label">订单金额</text>
						<text class="value price">¥{{orderDetail.amount.toFixed(2)}}</text>
					</view>
				</view>
				
				<view class="section">
					<text class="section-title">商品信息</text>
					<view class="product-list">
						<view class="product-item" v-for="(item, index) in orderDetail.payOrderItemVoList" :key="index">
							<image class="product-image" :src="item.image" mode="aspectFill"></image>
							<view class="product-info">
								<text class="product-name">{{item.name}}</text>
								<view class="product-price">
									<text class="price-symbol">¥</text>
									<text class="price-value">{{item.price.toFixed(2)}}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts">
interface OrderItem {
	id: string
	childrenId: string
	itemId: string
	name: string
	price: number
	image: string
}

interface Order {
	id: string
	bizOrderNo: string
	amount: number
	status: number
	overTime: string
	payOrderItemVoList: OrderItem[]
}

export default {
	data() {
		return {
			orderDetail: null as Order | null
		}
	},
	onLoad(options: any) {
		const itemId = options.id
		if (itemId) {
			this.getOrderDetail(itemId)
		}
	},
	methods: {
		getOrderDetail(itemId: string) {
			uni.request({
				url: 'http://localhost:8080/goods/order/get',
				method: 'GET',
				data: {
					ids: itemId
				},
				header: {
					'accessToken': uni.getStorageSync('accessToken'),
					'refreshToken': uni.getStorageSync('refreshToken')
				},
				success: (res: any) => {
					if (res.statusCode === 200 && res.data.code === 1) {
						this.orderDetail = res.data.data
					} else {
						uni.showToast({
							title: '获取订单详情失败',
							icon: 'error'
						})
					}
				},
				fail: () => {
					uni.showToast({
						title: '获取订单详情失败',
						icon: 'error'
					})
				}
			})
		},
		getStatusText(status: number): string {
			switch(status) {
				case 1: return '待付款'
				case 2: return '已付款'
				case 3: return '已完成'
				case 4: return '已取消'
				case 5: return '退款中'
				case 6: return '已退款'
				default: return '未知状态'
			}
		},
		getStatusClass(status: number): string {
			switch(status) {
				case 1: return 'status-pending'
				case 2: return 'status-paid'
				case 3: return 'status-completed'
				case 4: return 'status-cancelled'
				case 5: return 'status-refunding'
				case 6: return 'status-refunded'
				default: return ''
			}
		}
	}
}
</script>

<style>
.container {
	min-height: 100vh;
	background: #F6F7FB;
}

.header {
	background: #FFFFFF;
	padding: 24rpx;
	text-align: center;
	position: relative;
}

.title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
}

.content {
	height: calc(100vh - 88rpx);
	padding: 24rpx;
}

.detail-card {
	background: #FFFFFF;
	border-radius: 12rpx;
	padding: 24rpx;
}

.section {
	margin-bottom: 32rpx;
}

.section-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 20rpx;
}

.info-row {
	display: flex;
	align-items: center;
	margin-bottom: 16rpx;
}

.label {
	font-size: 26rpx;
	color: #666666;
	width: 160rpx;
}

.value {
	font-size: 26rpx;
	color: #333333;
	flex: 1;
}

.value.status {
	font-weight: bold;
}

.value.price {
	color: #FF5722;
	font-weight: bold;
}

.product-list {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.product-item {
	display: flex;
	align-items: center;
	padding: 16rpx;
	background: #F8F8F8;
	border-radius: 8rpx;
}

.product-image {
	width: 120rpx;
	height: 120rpx;
	border-radius: 8rpx;
	margin-right: 16rpx;
}

.product-info {
	flex: 1;
}

.product-name {
	font-size: 26rpx;
	color: #333333;
	margin-bottom: 8rpx;
}

.product-price {
	display: flex;
	align-items: center;
}

.price-symbol {
	font-size: 24rpx;
	color: #FF5722;
	font-weight: bold;
}

.price-value {
	font-size: 28rpx;
	color: #FF5722;
	font-weight: bold;
	margin-left: 2rpx;
}

.status-pending {
	color: #FF9800;
}

.status-paid {
	color: #2196F3;
}

.status-completed {
	color: #4CAF50;
}

.status-cancelled {
	color: #9E9E9E;
}

.status-refunding {
	color: #FF9800;
}

.status-refunded {
	color: #9E9E9E;
}
</style> 