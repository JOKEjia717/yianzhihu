<template>
	<view class="page">
		<view class="bg-orb bg-orb--one"></view>
		<view class="bg-orb bg-orb--two"></view>
		<view class="bg-orb bg-orb--three"></view>
		<view class="hero-card">
			<view class="hero-content">
				<view class="hero-head">
					<view class="hero-avatar-shell" @click="showEditForm">
						<image class="hero-avatar" :src="userInfo.avatar || defaultAvatar" mode="aspectFill"></image>
						<view class="hero-avatar-tag">
							<image class="hero-avatar-tag-icon" src="/static/images/pen.png" mode="aspectFit"></image>
							<text class="hero-avatar-tag-text">编辑</text>
						</view>
					</view>

					<view class="hero-copy">
						<text class="hero-kicker">子女端 · 我的</text>
						<text class="hero-name">{{ userInfo.name || '未设置昵称' }}</text>
						<text class="hero-desc">关注长者照护，重要信息一屏掌握。</text>
					</view>
				</view>

				<view class="hero-meta">
					<view class="meta-item">
						<text class="meta-label">手机号</text>
						<text class="meta-value">{{ getPhoneText() }}</text>
					</view>
				</view>

				<view class="hero-actions">
					<view class="hero-action hero-action--secondary" @click="showBindForm">
						<text class="hero-action-title">绑定老人信息</text>
						<text class="hero-action-sub">{{ getBoundElderSummary() }}</text>
					</view>
					<view class="hero-action hero-action--primary" @click="showEditForm">
						<text class="hero-action-title">编辑资料</text>
						<text class="hero-action-sub">头像、昵称、手机号</text>
					</view>
				</view>
			</view>
		</view>

	<view class="panel bind-panel">
		<view class="panel-head">
			<view>
				<text class="panel-title">已绑定老人</text>
				<text class="panel-subtitle">{{ getBoundElderSummary() }}</text>
			</view>
			<view class="panel-action" @click="showBindForm">
				<text class="panel-action-text">新增绑定</text>
			</view>
		</view>

		<view v-if="boundElderList.length" class="bind-list">
			<view
				v-for="(item, index) in boundElderList"
				:key="item.elderId"
				class="bind-item bind-item--interactive"
				@click="showBoundElderDetail(item, index)"
			>
				<view class="bind-item-main">
					<text class="bind-item-name">{{ item.name || '未命名老人' }}</text>
					<text class="bind-item-meta">编号 {{ item.elderId }} · {{ item.phone || '无电话' }}</text>
				</view>
				<view class="bind-item-side">
					<view class="bind-item-tag">
						<text v-if="item.age > 0">{{ item.age }}岁</text>
						<text v-else>已绑定</text>
					</view>
				</view>
			</view>
		</view>

		<view v-else class="bind-empty">
			<text class="bind-empty-title">还没有绑定老人</text>
			<text class="bind-empty-subtitle">点击右上角「新增绑定」，输入老人编号即可完成关联。</text>
		</view>
	</view>

	<view class="panel">
		<view class="panel-head">
			<view>
				<text class="panel-title">快捷入口</text>
				<text class="panel-subtitle">常用功能一眼可达，点击即可快速进入</text>
			</view>
		</view>

		<view class="shortcut-grid">
			<view
				v-for="(item, index) in shortcutItems"
				:key="item.type"
				class="shortcut-item"
				:class="'shortcut-item--' + item.type + ' ' + (index === 0 ? 'shortcut-item--featured' : 'shortcut-item--compact')"
				@click="handleQuickAction(item.type)"
			>
				<view class="shortcut-item-icon-shell" :class="'shortcut-item-icon-shell--' + item.type">
					<image class="shortcut-item-icon" :src="item.icon" mode="aspectFit"></image>
				</view>
				<text class="shortcut-item-name">{{ item.name }}</text>
			</view>
		</view>

		<view class="logout-panel">
			<view class="logout-copy">
				<text class="logout-title">退出登录</text>
				<text class="logout-subtitle">退出后需要重新登录，才能继续使用家庭服务。</text>
			</view>
			<view class="logout-button" @click="handleLogout">
				<text class="logout-button-text">退出登录</text>
			</view>
		</view>

		<view class="popup" v-if="showPopup">
			<view class="popup-mask" @click="hideEditForm"></view>
			<view class="popup-content">
				<view class="popup-handle"></view>
				<text class="popup-close popup-close--floating" @click="hideEditForm">×</text>
				<view class="popup-header">
					<text class="popup-title">编辑资料</text>
				</view>
				<text class="popup-subtitle">更新头像、昵称和手机号，方便接收家庭通知。</text>

				<view class="popup-body">
					<view class="form-item">
						<text class="form-label">头像</text>
						<view class="avatar-upload" @click="chooseAvatar">
							<image class="avatar-preview" :src="formData.avatar || userInfo.avatar || defaultAvatar" mode="aspectFill"></image>
							<text class="avatar-hint">点击更换头像</text>
						</view>
					</view>

					<view class="form-item">
						<text class="form-label">昵称</text>
						<input class="form-input" type="text" v-model="formData.nickname" placeholder="请输入昵称" />
					</view>

					<view class="form-item">
						<text class="form-label">手机号</text>
						<input class="form-input" type="number" v-model="formData.phone" placeholder="请输入手机号" maxlength="11" />
					</view>

					<view class="form-item form-item--password">
						<view class="form-head">
							<text class="form-label">修改密码</text>
							<text class="form-tip">选填</text>
						</view>
						<view class="password-inputs">
							<input class="form-input" type="password" v-model="formData.oldPassword" placeholder="请输入原密码" />
							<input class="form-input" type="password" v-model="formData.newPassword" placeholder="请输入新密码" />
							<input class="form-input" type="password" v-model="formData.confirmPassword" placeholder="请确认新密码" />
						</view>
					</view>
				</view>

				<view class="popup-footer">
					<view class="popup-button popup-button--ghost" :class="{ 'is-disabled': isSubmitting }" @click="hideEditForm">
						<text class="popup-button-text">取消</text>
					</view>
					<view class="popup-button popup-button--primary" :class="{ 'is-disabled': isSubmitting }" @click="submitForm">
						<text class="popup-button-text">{{ isSubmitting ? '保存中...' : '保存' }}</text>
					</view>
				</view>
			</view>
		</view>

		<view class="popup" v-if="showBindPopup">
			<view class="popup-mask" @click="hideBindForm"></view>
			<view class="popup-content bind-popup-content">
				<view class="popup-handle"></view>
				<text class="popup-close popup-close--floating" @click="hideBindForm">×</text>
				<view class="popup-header bind-popup-header">
					<view class="bind-popup-headcopy">
						<view class="bind-popup-icon-shell">
							<image class="bind-popup-icon" src="/static/images/id.png" mode="aspectFit"></image>
						</view>
						<view class="bind-popup-headtext">
							<text class="bind-popup-kicker">家庭绑定</text>
							<text class="popup-title">绑定老人信息</text>
						</view>
					</view>
				</view>
				<text class="popup-subtitle bind-popup-subtitle">输入老人编号 elder_id，系统会自动把老人关联到当前子女账号。</text>

				<view class="bind-summary-card">
					<view class="bind-summary-item">
						<text class="bind-summary-label">已绑定</text>
						<text class="bind-summary-value">{{ boundElderList.length }} 位</text>
					</view>
					<view class="bind-summary-divider"></view>
					<view class="bind-summary-item">
						<text class="bind-summary-label">默认展示</text>
						<text class="bind-summary-value">{{ boundElderInfo ? (boundElderInfo.name || '未命名老人') : '暂无' }}</text>
					</view>
				</view>

				<view class="popup-body bind-popup-body">
					<view class="form-item">
						<view class="form-head">
							<text class="form-label">老人编号</text>
							<text class="form-tip">elder_id</text>
						</view>
						<view class="bind-input-shell">
							<input class="bind-input" type="text" v-model="elderBindForm.elderId" placeholder="例如：10001" confirm-type="done" @confirm="submitBindForm" />
<!-- 							<view class="bind-input-action" @click="clearBindForm">
								<text>清空</text>
							</view> -->
						</view>
						<text class="bind-input-help">建议填写准确编号，绑定后会立即刷新列表。</text>
					</view>
				</view>

				<view class="popup-footer">
					<view class="popup-button popup-button--primary" :class="{ 'is-disabled': isBindSubmitting }" @click="submitBindForm">
						<text class="popup-button-text">{{ isBindSubmitting ? '绑定中...' : '立即绑定' }}</text>
					</view>
				</view>
			</view>
		</view>

		<view class="popup" v-if="showBoundDetailPopup">
			<view class="popup-mask" @click="closeBoundElderDetail"></view>
			<view class="popup-content bound-detail-popup-content">
				<view class="popup-handle"></view>
				<text class="popup-close popup-close--floating" @click="closeBoundElderDetail">×</text>
				<view class="popup-header bound-detail-popup-header">
					<view class="bound-detail-headcopy">
						<text class="bound-detail-kicker">老人详情</text>
						<text class="popup-title">{{ boundDetailForm.name || '未命名老人' }}</text>
					</view>
				</view>
				<text class="popup-subtitle bound-detail-subtitle">点击可修改姓名、联系电话和年龄，保存后会同步到当前页面缓存。</text>

				<view class="popup-body bound-detail-popup-body">
					<view class="detail-summary-card">
						<view class="detail-summary-item">
							<text class="detail-summary-label">老人编号</text>
							<text class="detail-summary-value">{{ boundDetailForm.elderId }}</text>
						</view>
						<view class="detail-summary-divider"></view>
						<view class="detail-summary-item">
							<text class="detail-summary-label">当前年龄</text>
							<text class="detail-summary-value">{{ boundDetailForm.age || '未填写' }}</text>
						</view>
					</view>

					<view class="form-item">
						<view class="form-head">
							<text class="form-label">姓名</text>
							<text class="form-tip">必填</text>
						</view>
						<input class="form-input" type="text" v-model="boundDetailForm.name" placeholder="请输入老人姓名" />
					</view>

					<view class="form-item">
						<view class="form-head">
							<text class="form-label">联系电话</text>
							<text class="form-tip">选填</text>
						</view>
						<input class="form-input" type="number" v-model="boundDetailForm.phone" placeholder="请输入联系电话" maxlength="11" />
					</view>

					<view class="form-item">
						<view class="form-head">
							<text class="form-label">年龄</text>
							<text class="form-tip">数字</text>
						</view>
						<input class="form-input" type="number" v-model="boundDetailForm.age" placeholder="请输入年龄" />
					</view>
				</view>

				<view class="popup-footer">
					<view class="popup-button popup-button--ghost" :class="{ 'is-disabled': isBoundDetailSubmitting }" @click="closeBoundElderDetail">
						<text class="popup-button-text">取消</text>
					</view>
					<view class="popup-button popup-button--primary" :class="{ 'is-disabled': isBoundDetailSubmitting }" @click="saveBoundElderDetail">
						<text class="popup-button-text">{{ isBoundDetailSubmitting ? '保存中...' : '保存修改' }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</view>
</template>

<script lang="uts">
import { bindElder, getBoundElders } from '../../api/user'

const DEFAULT_AVATAR = '/static/images/default-avatar.png'

interface UserInfo {
	avatar: string
	name: string
	phone: string
	childrenId: string
	isEnable: number
}

interface EditFormData {
	avatar: string
	tempAvatarPath: string
	nickname: string
	phone: string
	oldPassword: string
	newPassword: string
	confirmPassword: string
}

interface BoundElderInfo {
	elderId: string
	name: string
	phone: string
	age: number
}

interface ApiResponse<T> {
	code: number
	msg: string | null
	data: T
}

interface ElderBindFormData {
	elderId: string
}

interface BoundElderDetailFormData {
	elderId: string
	name: string
	phone: string
	age: string
}

interface QuickAction {
	type: string
	name: string
	icon: string
}

export default {
	data() {
		return {
			defaultAvatar: DEFAULT_AVATAR,
			userInfo: {
				avatar: DEFAULT_AVATAR,
				name: '',
				phone: '',
				childrenId: '',
				isEnable: 0
			} as UserInfo,
			showPopup: false,
			showBindPopup: false,
			showBoundDetailPopup: false,
			isSubmitting: false,
			isBindSubmitting: false,
			isBoundDetailSubmitting: false,
			formData: {
				avatar: '',
				tempAvatarPath: '',
				nickname: '',
				phone: '',
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			} as EditFormData,
			boundElderList: [] as BoundElderInfo[],
			boundElderInfo: null as BoundElderInfo | null,
			selectedBoundElderIndex: -1,
			elderBindForm: {
				elderId: ''
			} as ElderBindFormData,
			boundDetailForm: {
				elderId: '',
				name: '',
				phone: '',
				age: ''
			} as BoundElderDetailFormData,
			boundElderOverrides: {} as any,
			shortcutItems: [
				{
					type: 'ai',
					name: 'AI咨询',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/ai.png'
				},
				{
					type: 'cart',
					name: '购物车',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/cart.png'
				},
				{
					type: 'nursing',
					name: '护理日常',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/nursing.png'
				}
			] as QuickAction[]
		}
	},
	onShow() {
		if (!this.ensureLoggedIn()) {
			return
		}

		this.loadUserInfo()
	},
	methods: {
		ensureLoggedIn() {
			const accessToken = uni.getStorageSync('accessToken')
			const refreshToken = uni.getStorageSync('refreshToken')
			if (!accessToken || !refreshToken) {
				uni.showToast({
					title: '请先登录',
					icon: 'none',
					duration: 1200
				})
				setTimeout(() => {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}, 1200)
				return false
			}

			return true
		},
		normalizeText(value: any) {
			const text = value ? String(value) : ''
			if (!text) {
				return ''
			}
			if (text === 'undefined' || text === 'null') {
				return ''
			}
			if (text.indexOf('未设置') === 0 || text.indexOf('未绑定') === 0) {
				return ''
			}

			return text
		},
		loadUserInfo() {
			const cachedUserInfo = uni.getStorageSync('userInfo')
			if (cachedUserInfo) {
				this.userInfo = {
					avatar: cachedUserInfo.avatar || this.defaultAvatar,
					name: this.normalizeText(cachedUserInfo.name || cachedUserInfo.nickname),
					phone: this.normalizeText(cachedUserInfo.phone),
					childrenId: this.normalizeText(cachedUserInfo.childrenId),
					isEnable: Number(cachedUserInfo.isEnable || 0)
				}
			} else {
				this.userInfo = {
					avatar: this.defaultAvatar,
					name: '',
					phone: '',
					childrenId: '',
					isEnable: 0
				}
			}

			this.boundElderOverrides = this.normalizeBoundElderOverrides(uni.getStorageSync('boundElderOverrides'))

			const cachedBoundElderList = uni.getStorageSync('boundElderList')
			const cachedBoundElderInfo = uni.getStorageSync('boundElderInfo')
			const nextBoundElderData = cachedBoundElderList || cachedBoundElderInfo || (cachedUserInfo ? (cachedUserInfo.boundElderList || cachedUserInfo.boundElderInfo) : null)
			this.boundElderList = this.applyBoundElderOverrides(this.normalizeBoundElderList(nextBoundElderData))
			this.boundElderInfo = this.boundElderList.length > 0 ? this.boundElderList[0] : null
			void this.loadBoundElders()
		},
		normalizeBoundElderList(value: any) {
			if (!value) {
				return [] as BoundElderInfo[]
			}

			let parsedValue = value
			if (typeof parsedValue === 'string') {
				try {
					parsedValue = JSON.parse(parsedValue)
				} catch (error) {
					return [] as BoundElderInfo[]
				}
			}

			const normalizedList = [] as BoundElderInfo[]
			if (Array.isArray(parsedValue)) {
				for (const item of parsedValue) {
					const normalizedItem = this.normalizeBoundElderInfo(item)
					if (normalizedItem) {
						normalizedList.push(normalizedItem)
					}
				}
				return normalizedList
			}

			const normalizedItem = this.normalizeBoundElderInfo(parsedValue)
			if (normalizedItem) {
				normalizedList.push(normalizedItem)
			}

			return normalizedList
		},
		normalizeBoundElderInfo(value: any) {
			if (!value) {
				return null
			}

			let parsedValue = value
			if (typeof parsedValue === 'string') {
				try {
					parsedValue = JSON.parse(parsedValue)
				} catch (error) {
					return null
				}
			}

			const elderId = this.normalizeText(parsedValue.elderId || parsedValue.elder_id || parsedValue.id)
			const name = this.normalizeText(parsedValue.name)
			const phone = this.normalizeText(parsedValue.phone)
			const age = Number(parsedValue.age || 0)

			if (!elderId) {
				return null
			}

			return {
				elderId: elderId,
				name: name,
				phone: phone,
				age: age > 0 ? age : 0
			} as BoundElderInfo
		},
		normalizeBoundElderOverrides(value: any) {
			if (!value) {
				return {} as any
			}

			let parsedValue = value
			if (typeof parsedValue === 'string') {
				try {
					parsedValue = JSON.parse(parsedValue)
				} catch (error) {
					return {} as any
				}
			}

			const normalizedOverrides: any = {}
			if (Array.isArray(parsedValue)) {
				for (const item of parsedValue) {
					const elderId = this.normalizeText(item && (item.elderId || item.elder_id || item.id))
					if (!elderId) {
						continue
					}

					normalizedOverrides[elderId] = {
						name: this.normalizeText(item.name),
						phone: this.normalizeText(item.phone),
						age: Number(item.age || 0) > 0 ? Number(item.age) : 0
					}
				}
				return normalizedOverrides
			}

			for (const elderId in parsedValue) {
				const item = parsedValue[elderId]
				if (!item || typeof item !== 'object') {
					continue
				}

				normalizedOverrides[elderId] = {
					name: this.normalizeText(item.name),
					phone: this.normalizeText(item.phone),
					age: Number(item.age || 0) > 0 ? Number(item.age) : 0
				}
			}

			return normalizedOverrides
		},
		applyBoundElderOverrides(boundElderList: BoundElderInfo[]) {
			if (!boundElderList.length) {
				return [] as BoundElderInfo[]
			}

			return boundElderList.map((item) => {
				const override = this.boundElderOverrides[item.elderId]
				if (!override) {
					return item
				}

				return {
					elderId: item.elderId,
					name: this.normalizeText(override.name || item.name),
					phone: this.normalizeText(override.phone || item.phone),
					age: override.age > 0 ? Number(override.age) : item.age
				} as BoundElderInfo
			})
		},
		getPhoneText() {
			return this.userInfo.phone || '未绑定手机号'
		},
		getChildrenIdText() {
			return this.userInfo.childrenId || '未绑定'
		},
		getStatusText() {
			return this.userInfo.isEnable === 1 ? '已启用' : '待激活'
		},
		getStatusClass() {
			return this.userInfo.isEnable === 1 ? 'meta-item--success' : 'meta-item--warning'
		},
		getBoundElderSummary() {
			if (!this.boundElderList.length) {
				return '输入 elder_id 即可绑定'
			}

			return '已绑定 ' + this.boundElderList.length + ' 位老人'
		},
		persistBoundElderList(boundElderList: BoundElderInfo[]) {
			const cachedUserInfo = uni.getStorageSync('userInfo')
			const nextUserInfo: any = cachedUserInfo ? cachedUserInfo : {}
			nextUserInfo.boundElderList = boundElderList
			nextUserInfo.boundElderInfo = boundElderList.length > 0 ? boundElderList[0] : null

			uni.setStorageSync('userInfo', nextUserInfo)
			uni.setStorageSync('boundElderList', boundElderList)
			if (boundElderList.length > 0) {
				uni.setStorageSync('boundElderInfo', boundElderList[0])
			} else {
				uni.removeStorageSync('boundElderInfo')
			}
		},
		persistBoundElderOverrides() {
			const overrideKeys = Object.keys(this.boundElderOverrides || {})
			if (!overrideKeys.length) {
				uni.removeStorageSync('boundElderOverrides')
				return
			}

			uni.setStorageSync('boundElderOverrides', this.boundElderOverrides)
		},
		async loadBoundElders() {
			try {
				const res = await getBoundElders() as { statusCode: number, data: ApiResponse<BoundElderInfo[]> }
				if (res.statusCode === 200 && res.data.code === 1) {
					const boundElders = this.applyBoundElderOverrides(this.normalizeBoundElderList(res.data.data))
					this.boundElderList = boundElders
					this.boundElderInfo = boundElders.length > 0 ? boundElders[0] : null
					this.persistBoundElderList(boundElders)
				}
			} catch (error) {
				// 保留本地缓存，避免拉取失败时列表闪空
			}
		},
		handleQuickAction(type: string) {
			switch (type) {
				case 'cart':
					this.goToCart()
					break
				case 'ai':
					this.goToAIConsult()
					break
				case 'nursing':
					this.goToNursing()
					break
			}
		},
		showEditForm() {
			if (!this.ensureLoggedIn()) {
				return
			}

			this.showBindPopup = false
			this.showBoundDetailPopup = false
			this.selectedBoundElderIndex = -1
			this.formData = {
				avatar: this.userInfo.avatar,
				tempAvatarPath: '',
				nickname: this.userInfo.name,
				phone: this.userInfo.phone,
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			}
			this.showPopup = true
		},
		showBindForm() {
			if (!this.ensureLoggedIn()) {
				return
			}

			this.showPopup = false
			this.showBoundDetailPopup = false
			this.selectedBoundElderIndex = -1
			this.elderBindForm = {
				elderId: ''
			} as ElderBindFormData
			this.showBindPopup = true
		},
		hideEditForm() {
			if (this.isSubmitting) {
				return
			}

			this.showPopup = false
		},
		hideBindForm() {
			if (this.isBindSubmitting) {
				return
			}

			this.showBindPopup = false
		},
		showBoundElderDetail(item: BoundElderInfo, index: number) {
			if (!item) {
				return
			}

			this.showPopup = false
			this.showBindPopup = false
			this.selectedBoundElderIndex = index
			this.boundDetailForm = {
				elderId: item.elderId,
				name: item.name || '',
				phone: item.phone || '',
				age: item.age > 0 ? String(item.age) : ''
			}
			this.showBoundDetailPopup = true
		},
		closeBoundElderDetail() {
			if (this.isBoundDetailSubmitting) {
				return
			}

			this.showBoundDetailPopup = false
			this.selectedBoundElderIndex = -1
		},
		async saveBoundElderDetail() {
			if (this.isBoundDetailSubmitting) {
				return
			}

			const targetIndex = this.selectedBoundElderIndex
			if (targetIndex < 0 || targetIndex >= this.boundElderList.length) {
				uni.showToast({
					title: '未找到老人信息',
					icon: 'none'
				})
				return
			}

			const elderId = this.boundDetailForm.elderId
			const name = this.boundDetailForm.name.trim()
			const phone = this.boundDetailForm.phone.trim()
			const ageText = this.boundDetailForm.age.trim()

			if (!name) {
				uni.showToast({
					title: '请输入老人姓名',
					icon: 'none'
				})
				return
			}

			if (phone && !/^1[3-9]\d{9}$/.test(phone)) {
				uni.showToast({
					title: '请输入正确的联系电话',
					icon: 'none'
				})
				return
			}

			let age = 0
			if (ageText) {
				if (!/^\d+$/.test(ageText)) {
					uni.showToast({
						title: '年龄只能输入数字',
						icon: 'none'
					})
					return
				}

				age = Number(ageText)
				if (age <= 0) {
					uni.showToast({
						title: '年龄需大于0',
						icon: 'none'
					})
					return
				}
			}

			this.isBoundDetailSubmitting = true

			try {
				const nextBoundElderList = this.boundElderList.slice()
				nextBoundElderList[targetIndex] = {
					elderId: elderId,
					name: name,
					phone: phone,
					age: age
				} as BoundElderInfo

				this.boundElderOverrides[elderId] = {
					name: name,
					phone: phone,
					age: age
				}

				const mergedBoundElderList = this.applyBoundElderOverrides(nextBoundElderList)
				this.boundElderList = mergedBoundElderList
				this.boundElderInfo = mergedBoundElderList.length > 0 ? mergedBoundElderList[0] : null
				this.persistBoundElderList(mergedBoundElderList)
				this.persistBoundElderOverrides()

				this.showBoundDetailPopup = false
				this.selectedBoundElderIndex = -1
				uni.showToast({
					title: '保存成功',
					icon: 'success'
				})
			} catch (error) {
				uni.showToast({
					title: '保存失败',
					icon: 'none'
				})
			} finally {
				this.isBoundDetailSubmitting = false
			}
		},
		// clearBindForm() {
		// 	if (this.isBindSubmitting) {
		// 		return
		// 	}

		// 	this.elderBindForm.elderId = ''
		// },
		async chooseAvatar() {
			try {
				const res = await uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['album', 'camera']
				})
				if (res.tempFilePaths.length > 0) {
					this.formData.avatar = res.tempFilePaths[0]
					this.formData.tempAvatarPath = res.tempFilePaths[0]
				}
			} catch (error) {
				uni.showToast({
					title: '选择图片失败',
					icon: 'none'
				})
			}
		},
		parseUploadResponse(data: any) {
			if (typeof data === 'string') {
				try {
					return JSON.parse(data)
				} catch (error) {
					return null
				}
			}

			return data
		},
		resolveUploadedAvatar(responseData: any) {
			if (!responseData) {
				return ''
			}

			const payload = responseData.data ? responseData.data : responseData
			if (typeof payload === 'string') {
				try {
					const parsed = JSON.parse(payload)
					return parsed.avatar || parsed.url || parsed.path || payload
				} catch (error) {
					return payload
				}
			}

			if (payload.avatar) {
				return payload.avatar
			}
			if (payload.url) {
				return payload.url
			}
			if (payload.path) {
				return payload.path
			}

			return ''
		},
		async submitForm() {
			if (this.isSubmitting) {
				return
			}

			const nickname = this.formData.nickname.trim()
			const phone = this.formData.phone.trim()

			if (!nickname) {
				uni.showToast({
					title: '请输入昵称',
					icon: 'none'
				})
				return
			}

			if (!phone) {
				uni.showToast({
					title: '请输入手机号',
					icon: 'none'
				})
				return
			}

			if (!/^1[3-9]\d{9}$/.test(phone)) {
				uni.showToast({
					title: '手机号格式不正确',
					icon: 'none'
				})
				return
			}

			if (this.formData.newPassword && !this.formData.oldPassword) {
				uni.showToast({
					title: '请输入原密码',
					icon: 'none'
				})
				return
			}

			if (this.formData.newPassword && this.formData.newPassword !== this.formData.confirmPassword) {
				uni.showToast({
					title: '两次输入的密码不一致',
					icon: 'none'
				})
				return
			}

			this.formData.nickname = nickname
			this.formData.phone = phone
			this.isSubmitting = true
			uni.showLoading({
				title: '保存中...'
			})

			let avatarUploadFailed = false
			let avatarToSave = this.userInfo.avatar || this.defaultAvatar

			try {
				if (this.formData.tempAvatarPath) {
					try {
						const accessToken = uni.getStorageSync('accessToken')
						const refreshToken = uni.getStorageSync('refreshToken')

						const uploadRes = await uni.uploadFile({
							url: 'http://localhost:8080/children/avatar',
							filePath: this.formData.tempAvatarPath,
							name: 'image',
							formData: {},
							header: {
								'accessToken': accessToken,
								'refreshToken': refreshToken
							}
						})

						const uploadData = this.parseUploadResponse(uploadRes.data)
						if (uploadRes.statusCode === 200 && uploadData && uploadData.code === 1) {
							const uploadedAvatar = this.resolveUploadedAvatar(uploadData)
							avatarToSave = uploadedAvatar || this.formData.avatar || this.userInfo.avatar || this.defaultAvatar
						} else {
							avatarUploadFailed = true
						}
					} catch (error) {
						avatarUploadFailed = true
					}
				}

				const updateData: any = {
					name: nickname,
					phone: phone
				}

				if (this.formData.newPassword) {
					updateData.oldPassword = this.formData.oldPassword
					updateData.newPassword = this.formData.newPassword
				}

				const accessToken = uni.getStorageSync('accessToken')
				const refreshToken = uni.getStorageSync('refreshToken')

				const res = await uni.request({
					url: 'http://localhost:8080/children/update/info',
					method: 'POST',
					data: updateData,
					header: {
						'accessToken': accessToken,
						'refreshToken': refreshToken
					}
				})

				const responseData = res.data as any
				if (res.statusCode === 200 && responseData.code === 1) {
					const cachedUserInfo = uni.getStorageSync('userInfo')
					const nextUserInfo: any = cachedUserInfo ? cachedUserInfo : {}
					nextUserInfo.avatar = avatarToSave
					nextUserInfo.name = nickname
					nextUserInfo.nickname = nickname
					nextUserInfo.phone = phone
					nextUserInfo.childrenId = this.userInfo.childrenId
					nextUserInfo.isEnable = this.userInfo.isEnable
					if (this.boundElderInfo) {
						nextUserInfo.boundElderInfo = this.boundElderInfo
					}
					uni.setStorageSync('userInfo', nextUserInfo)

					this.showPopup = false
					this.loadUserInfo()
					uni.hideLoading()
					uni.showToast({
						title: avatarUploadFailed ? '资料已保存，头像同步失败' : '更新成功',
						icon: avatarUploadFailed ? 'none' : 'success',
						duration: 2000
					})
				} else {
					uni.hideLoading()
					uni.showToast({
						title: responseData.msg || '更新失败',
						icon: 'none'
					})
				}
			} catch (error) {
				uni.hideLoading()
				uni.showToast({
					title: '更新失败',
					icon: 'none'
				})
			} finally {
				uni.hideLoading()
				this.isSubmitting = false
			}
		},
		async submitBindForm() {
			if (this.isBindSubmitting) {
				return
			}

			const elderId = this.elderBindForm.elderId.trim()
			if (!elderId) {
				uni.showToast({
					title: '请输入老人编号',
					icon: 'none'
				})
				return
			}

			if (!/^\d+$/.test(elderId)) {
				uni.showToast({
					title: '老人编号只能是数字',
					icon: 'none'
				})
				return
			}

			this.isBindSubmitting = true
			uni.showLoading({
				title: '绑定中...'
			})

			try {
				const res = await bindElder(elderId) as { statusCode: number, data: ApiResponse<any> }
				if (res.statusCode === 200 && res.data.code === 1) {
					await this.loadBoundElders()
					this.elderBindForm.elderId = ''
					this.showBindPopup = false
					uni.showToast({
						title: '绑定成功',
						icon: 'success',
						duration: 1600
					})
				} else {
					uni.showToast({
						title: res.data.msg || '绑定失败',
						icon: 'none'
					})
				}
			} catch (error) {
				uni.showToast({
					title: '绑定失败',
					icon: 'none'
				})
			} finally {
				uni.hideLoading()
				this.isBindSubmitting = false
			}
		},
		goToCart() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.navigateTo({
				url: '/pages/children/cart',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		goToAIConsult() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.navigateTo({
				url: '/pages/children/ai-consult',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		goToNursing() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.switchTab({
				url: '/pages/children/nursing',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		handleLogout() {
			if (this.isSubmitting) {
				return
			}

			uni.showModal({
				title: '确认退出',
				content: '确定要退出登录吗？',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						this.showPopup = false
						this.showBindPopup = false
						this.showBoundDetailPopup = false
						uni.removeStorageSync('accessToken')
						uni.removeStorageSync('refreshToken')
						uni.removeStorageSync('userInfo')
						uni.removeStorageSync('boundElderList')
						uni.removeStorageSync('boundElderInfo')
						uni.removeStorageSync('boundElderOverrides')
						this.boundElderInfo = null
						this.boundElderList = []
						this.boundElderOverrides = {}
						this.selectedBoundElderIndex = -1
						this.boundDetailForm = {
							elderId: '',
							name: '',
							phone: '',
							age: ''
						} as BoundElderDetailFormData

						uni.showToast({
							title: '退出成功',
							icon: 'success',
							duration: 1200
						})

						setTimeout(() => {
							uni.reLaunch({
								url: '/pages/index/index'
							})
						}, 1200)
					}
				}
			})
		}
	}
}
</script>

<style>
	.page {
		min-height: 100vh;
		padding: 24rpx 24rpx 180rpx;
		box-sizing: border-box;
		position: relative;
		overflow-x: hidden;
		background:
			radial-gradient(circle at top right, rgba(47, 185, 197, 0.16), transparent 34%),
			radial-gradient(circle at bottom left, rgba(60, 126, 255, 0.12), transparent 30%),
			linear-gradient(180deg, #EBFAF8 0%, #F6FAFD 38%, #F3F7FB 100%);
	}

	.bg-orb {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
	}

	.bg-orb--one {
		width: 240rpx;
		height: 240rpx;
		top: -54rpx;
		right: -96rpx;
		background: rgba(79, 209, 197, 0.16);
	}

	.bg-orb--two {
		width: 180rpx;
		height: 180rpx;
		top: 290rpx;
		left: -86rpx;
		background: rgba(79, 184, 209, 0.12);
	}

	.bg-orb--three {
		width: 140rpx;
		height: 140rpx;
		right: 18rpx;
		bottom: 430rpx;
		background: rgba(255, 255, 255, 0.44);
	}

	.hero-card,
	.panel,
	.logout-panel {
		position: relative;
		z-index: 1;
	}

	.hero-card {
		border-radius: 36rpx;
		padding: 34rpx;
		overflow: hidden;
		background-image:
			linear-gradient(135deg, rgba(7, 44, 66, 0.92), rgba(12, 124, 117, 0.82)),
			url('/static/images/children-card-bg.jpg');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		box-shadow: 0 24rpx 56rpx rgba(8, 44, 71, 0.18);
		border: 1rpx solid rgba(255, 255, 255, 0.06);
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.hero-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 18rpx;
	}

	.hero-copy {
		flex: 1;
		min-width: 0;
		margin-left: 5%;
	}

	.hero-kicker {
		display: block;
		font-size: 24rpx;
		letter-spacing: 1rpx;
		color: rgba(255, 255, 255, 0.82);
		margin-bottom: 16rpx;
	}

	.hero-name {
		display: block;
		font-size: 44rpx;
		line-height: 1.18;
		font-weight: 700;
		color: #FFFFFF;
		margin-bottom: 14rpx;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-desc {
		display: block;
		font-size: 26rpx;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.88);
	}

	.hero-avatar-shell {
		position: relative;
		width: 152rpx;
		height: 152rpx;
		padding: 6rpx;
		box-sizing: border-box;
		border-radius: 50%;
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.12);
		box-shadow: 0 18rpx 34rpx rgba(2, 15, 28, 0.2);
	}

	.hero-avatar {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: 2rpx solid rgba(255, 255, 255, 0.26);
		background: rgba(255, 255, 255, 0.16);
	}

	.hero-avatar-tag {
		position: absolute;
		right: -6rpx;
		bottom: -6rpx;
		display: flex;
		align-items: center;
		gap: 6rpx;
		padding: 8rpx 16rpx;
		border-radius: 999rpx;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 12rpx 24rpx rgba(8, 44, 71, 0.16);
	}

	.hero-avatar-tag-icon {
		width: 20rpx;
		height: 20rpx;
	}

	.hero-avatar-tag-text {
		font-size: 22rpx;
		line-height: 1;
		color: #147C74;
		font-weight: 600;
	}

	.hero-meta {
		display: flex;
		gap: 14rpx;
		margin-top: 28rpx;
	}

	.meta-item {
		flex: 1;
		min-width: 0;
		padding: 18rpx 16rpx;
		border-radius: 22rpx;
		background: rgba(255, 255, 255, 0.12);
		border: 1rpx solid rgba(255, 255, 255, 0.16);
		backdrop-filter: blur(8px);
	}

	.meta-item--success {
		background: rgba(34, 197, 94, 0.14);
		border-color: rgba(34, 197, 94, 0.18);
	}

	.meta-item--warning {
		background: rgba(251, 191, 36, 0.14);
		border-color: rgba(251, 191, 36, 0.18);
	}

	.meta-label {
		display: block;
		font-size: 22rpx;
		line-height: 1.3;
		color: rgba(255, 255, 255, 0.74);
		margin-bottom: 8rpx;
	}

	.meta-item--success .meta-label,
	.meta-item--warning .meta-label {
		color: rgba(255, 255, 255, 0.82);
	}

	.meta-value {
		display: block;
		font-size: 26rpx;
		line-height: 1.25;
		font-weight: 600;
		color: #FFFFFF;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		gap: 14rpx;
		margin-top: 26rpx;
	}

	.hero-action {
		width: 100%;
		min-width: 0;
		padding: 22rpx 20rpx;
		border-radius: 24rpx;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.hero-action:active {
		transform: scale(0.98);
	}

	.hero-action--primary {
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 14rpx 28rpx rgba(8, 44, 71, 0.12);
	}

	.hero-action--secondary {
		background: rgba(255, 255, 255, 0.14);
		border: 1rpx solid rgba(255, 255, 255, 0.14);
	}

	.hero-action-title {
		display: block;
		font-size: 30rpx;
		line-height: 1.25;
		font-weight: 700;
		color: #0F172A;
	}

	.hero-action--secondary .hero-action-title {
		color: #FFFFFF;
	}

	.hero-action-sub {
		display: block;
		margin-top: 6rpx;
		font-size: 22rpx;
		line-height: 1.35;
		color: #64748B;
		word-break: break-all;
	}

	.hero-action--secondary .hero-action-sub {
		color: rgba(255, 255, 255, 0.76);
	}

	.panel {
		margin-top: 24rpx;
		padding: 30rpx 28rpx 28rpx;
		border-radius: 32rpx;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 18rpx 40rpx rgba(15, 76, 123, 0.06);
		border: 1rpx solid rgba(120, 146, 172, 0.08);
	}

	.panel-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 22rpx;
	}

	.panel-title {
		display: block;
		font-size: 34rpx;
		line-height: 1.25;
		font-weight: 700;
		color: #0F172A;
	}

	.panel-subtitle {
		display: block;
		margin-top: 6rpx;
		font-size: 24rpx;
		line-height: 1.4;
		color: #6B7280;
	}

	.panel-action {
		flex-shrink: 0;
		padding: 14rpx 18rpx;
		border-radius: 999rpx;
		background: linear-gradient(135deg, rgba(25, 191, 175, 0.14), rgba(49, 124, 255, 0.14));
		border: 1rpx solid rgba(25, 191, 175, 0.18);
	}

	.panel-action-text {
		font-size: 24rpx;
		line-height: 1;
