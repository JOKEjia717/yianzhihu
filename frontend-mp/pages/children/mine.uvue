<template>
	<view class="page">
		<view class="bg-orb bg-orb--one"></view>
		<view class="bg-orb bg-orb--two"></view>
		<view class="bg-orb bg-orb--three"></view>
		<view class="hero-card">
			<view class="hero-content">
				<view class="hero-head">
					<view class="hero-avatar-shell" @click="showEditForm">
						<image class="hero-avatar" :src="userInfo.avatar || defaultAvatar" mode="aspectFill"></image>
						<view class="hero-avatar-tag">
							<image class="hero-avatar-tag-icon" src="/static/images/pen.png" mode="aspectFit"></image>
							<text class="hero-avatar-tag-text">编辑</text>
						</view>
					</view>

					<view class="hero-copy">
						<text class="hero-kicker">子女端 · 我的</text>
						<text class="hero-name">{{ userInfo.name || '未设置昵称' }}</text>
						<text class="hero-desc">关注长者照护，重要信息一屏掌握。</text>
					</view>
				</view>

				<view class="hero-meta">
					<view class="meta-item">
						<text class="meta-label">手机号</text>
						<text class="meta-value">{{ getPhoneText() }}</text>
					</view>
				</view>

				<view class="hero-actions">
					<view class="hero-action hero-action--primary" @click="showEditForm">
						<text class="hero-action-title">编辑资料</text>
						<text class="hero-action-sub">头像、昵称、手机号</text>
					</view>
				</view>
			</view>
		</view>

		<view class="panel">
			<view class="panel-head">
				<view>
					<text class="panel-title">快捷入口</text>
					<text class="panel-subtitle">常用功能一眼可达，点击即可快速进入</text>
				</view>
			</view>

			<view class="shortcut-grid">
				<view
					v-for="(item, index) in shortcutItems"
					:key="item.type"
					class="shortcut-item"
					:class="'shortcut-item--' + item.type + ' ' + (index === 0 ? 'shortcut-item--featured' : 'shortcut-item--compact')"
					@click="handleQuickAction(item.type)"
				>
					<view class="shortcut-item-icon-shell" :class="'shortcut-item-icon-shell--' + item.type">
						<image class="shortcut-item-icon" :src="item.icon" mode="aspectFit"></image>
					</view>
					<text class="shortcut-item-name">{{ item.name }}</text>
				</view>
			</view>
		</view>

		<view class="logout-panel">
			<view class="logout-copy">
				<text class="logout-title">退出登录</text>
				<text class="logout-subtitle">退出后需要重新登录，才能继续使用家庭服务。</text>
			</view>
			<view class="logout-button" @click="handleLogout">
				<text class="logout-button-text">退出登录</text>
			</view>
		</view>

		<view class="popup" v-if="showPopup">
			<view class="popup-mask" @click="hideEditForm"></view>
			<view class="popup-content">
				<view class="popup-handle"></view>
				<view class="popup-header">
					<text class="popup-title">编辑资料</text>
					<text class="popup-close" @click="hideEditForm">×</text>
				</view>
				<text class="popup-subtitle">更新头像、昵称和手机号，方便接收家庭通知。</text>

				<view class="popup-body">
					<view class="form-item">
						<text class="form-label">头像</text>
						<view class="avatar-upload" @click="chooseAvatar">
							<image class="avatar-preview" :src="formData.avatar || userInfo.avatar || defaultAvatar" mode="aspectFill"></image>
							<text class="avatar-hint">点击更换头像</text>
						</view>
					</view>

					<view class="form-item">
						<text class="form-label">昵称</text>
						<input class="form-input" type="text" v-model="formData.nickname" placeholder="请输入昵称" />
					</view>

					<view class="form-item">
						<text class="form-label">手机号</text>
						<input class="form-input" type="number" v-model="formData.phone" placeholder="请输入手机号" maxlength="11" />
					</view>

					<view class="form-item form-item--password">
						<view class="form-head">
							<text class="form-label">修改密码</text>
							<text class="form-tip">选填</text>
						</view>
						<view class="password-inputs">
							<input class="form-input" type="password" v-model="formData.oldPassword" placeholder="请输入原密码" />
							<input class="form-input" type="password" v-model="formData.newPassword" placeholder="请输入新密码" />
							<input class="form-input" type="password" v-model="formData.confirmPassword" placeholder="请确认新密码" />
						</view>
					</view>
				</view>

				<view class="popup-footer">
					<view class="popup-button popup-button--ghost" :class="{ 'is-disabled': isSubmitting }" @click="hideEditForm">
						<text class="popup-button-text">取消</text>
					</view>
					<view class="popup-button popup-button--primary" :class="{ 'is-disabled': isSubmitting }" @click="submitForm">
						<text class="popup-button-text">{{ isSubmitting ? '保存中...' : '保存' }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
const DEFAULT_AVATAR = '/static/images/default-avatar.png'

interface UserInfo {
	avatar: string
	name: string
	phone: string
	childrenId: string
	isEnable: number
}

interface EditFormData {
	avatar: string
	tempAvatarPath: string
	nickname: string
	phone: string
	oldPassword: string
	newPassword: string
	confirmPassword: string
}

interface QuickAction {
	type: string
	name: string
	icon: string
}

export default {
	data() {
		return {
			defaultAvatar: DEFAULT_AVATAR,
			userInfo: {
				avatar: DEFAULT_AVATAR,
				name: '',
				phone: '',
				childrenId: '',
				isEnable: 0
			} as UserInfo,
			showPopup: false,
			isSubmitting: false,
			formData: {
				avatar: '',
				tempAvatarPath: '',
				nickname: '',
				phone: '',
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			} as EditFormData,
			shortcutItems: [
				{
					type: 'ai',
					name: 'AI咨询',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/ai.png'
				},
				{
					type: 'cart',
					name: '购物车',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/cart.png'
				},
				{
					type: 'nursing',
					name: '护理日常',
					icon: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/icon/nursing.png'
				}
			] as QuickAction[]
		}
	},
	onShow() {
		if (!this.ensureLoggedIn()) {
			return
		}

		this.loadUserInfo()
	},
	methods: {
		ensureLoggedIn() {
			const accessToken = uni.getStorageSync('accessToken')
			const refreshToken = uni.getStorageSync('refreshToken')
			if (!accessToken || !refreshToken) {
				uni.showToast({
					title: '请先登录',
					icon: 'none',
					duration: 1200
				})
				setTimeout(() => {
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}, 1200)
				return false
			}

			return true
		},
		normalizeText(value: any) {
			const text = value ? String(value) : ''
			if (!text) {
				return ''
			}
			if (text === 'undefined' || text === 'null') {
				return ''
			}
			if (text.indexOf('未设置') === 0 || text.indexOf('未绑定') === 0) {
				return ''
			}

			return text
		},
		loadUserInfo() {
			const cachedUserInfo = uni.getStorageSync('userInfo')
			if (cachedUserInfo) {
				this.userInfo = {
					avatar: cachedUserInfo.avatar || this.defaultAvatar,
					name: this.normalizeText(cachedUserInfo.name || cachedUserInfo.nickname),
					phone: this.normalizeText(cachedUserInfo.phone),
					childrenId: this.normalizeText(cachedUserInfo.childrenId),
					isEnable: Number(cachedUserInfo.isEnable || 0)
				}
			} else {
				this.userInfo = {
					avatar: this.defaultAvatar,
					name: '',
					phone: '',
					childrenId: '',
					isEnable: 0
				}
			}
		},
		getPhoneText() {
			return this.userInfo.phone || '未绑定手机号'
		},
		getChildrenIdText() {
			return this.userInfo.childrenId || '未绑定'
		},
		getStatusText() {
			return this.userInfo.isEnable === 1 ? '已启用' : '待激活'
		},
		getStatusClass() {
			return this.userInfo.isEnable === 1 ? 'meta-item--success' : 'meta-item--warning'
		},
		handleQuickAction(type: string) {
			switch (type) {
				case 'cart':
					this.goToCart()
					break
				case 'ai':
					this.goToAIConsult()
					break
				case 'nursing':
					this.goToNursing()
					break
			}
		},
		showEditForm() {
			if (!this.ensureLoggedIn()) {
				return
			}

			this.formData = {
				avatar: this.userInfo.avatar,
				tempAvatarPath: '',
				nickname: this.userInfo.name,
				phone: this.userInfo.phone,
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			}
			this.showPopup = true
		},
		hideEditForm() {
			if (this.isSubmitting) {
				return
			}

			this.showPopup = false
		},
		async chooseAvatar() {
			try {
				const res = await uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['album', 'camera']
				})
				if (res.tempFilePaths.length > 0) {
					this.formData.avatar = res.tempFilePaths[0]
					this.formData.tempAvatarPath = res.tempFilePaths[0]
				}
			} catch (error) {
				uni.showToast({
					title: '选择图片失败',
					icon: 'none'
				})
			}
		},
		parseUploadResponse(data: any) {
			if (typeof data === 'string') {
				try {
					return JSON.parse(data)
				} catch (error) {
					return null
				}
			}

			return data
		},
		resolveUploadedAvatar(responseData: any) {
			if (!responseData) {
				return ''
			}

			const payload = responseData.data ? responseData.data : responseData
			if (typeof payload === 'string') {
				try {
					const parsed = JSON.parse(payload)
					return parsed.avatar || parsed.url || parsed.path || payload
				} catch (error) {
					return payload
				}
			}

			if (payload.avatar) {
				return payload.avatar
			}
			if (payload.url) {
				return payload.url
			}
			if (payload.path) {
				return payload.path
			}

			return ''
		},
		async submitForm() {
			if (this.isSubmitting) {
				return
			}

			const nickname = this.formData.nickname.trim()
			const phone = this.formData.phone.trim()

			if (!nickname) {
				uni.showToast({
					title: '请输入昵称',
					icon: 'none'
				})
				return
			}

			if (!phone) {
				uni.showToast({
					title: '请输入手机号',
					icon: 'none'
				})
				return
			}

			if (!/^1[3-9]\d{9}$/.test(phone)) {
				uni.showToast({
					title: '手机号格式不正确',
					icon: 'none'
				})
				return
			}

			if (this.formData.newPassword && !this.formData.oldPassword) {
				uni.showToast({
					title: '请输入原密码',
					icon: 'none'
				})
				return
			}

			if (this.formData.newPassword && this.formData.newPassword !== this.formData.confirmPassword) {
				uni.showToast({
					title: '两次输入的密码不一致',
					icon: 'none'
				})
				return
			}

			this.formData.nickname = nickname
			this.formData.phone = phone
			this.isSubmitting = true
			uni.showLoading({
				title: '保存中...'
			})

			let avatarUploadFailed = false
			let avatarToSave = this.userInfo.avatar || this.defaultAvatar

			try {
				if (this.formData.tempAvatarPath) {
					try {
						const accessToken = uni.getStorageSync('accessToken')
						const refreshToken = uni.getStorageSync('refreshToken')

						const uploadRes = await uni.uploadFile({
							url: 'http://localhost:8080/children/avatar',
							filePath: this.formData.tempAvatarPath,
							name: 'image',
							formData: {},
							header: {
								'accessToken': accessToken,
								'refreshToken': refreshToken
							}
						})

						const uploadData = this.parseUploadResponse(uploadRes.data)
						if (uploadRes.statusCode === 200 && uploadData && uploadData.code === 1) {
							const uploadedAvatar = this.resolveUploadedAvatar(uploadData)
							avatarToSave = uploadedAvatar || this.formData.avatar || this.userInfo.avatar || this.defaultAvatar
						} else {
							avatarUploadFailed = true
						}
					} catch (error) {
						avatarUploadFailed = true
					}
				}

				const updateData: any = {
					name: nickname,
					phone: phone
				}

				if (this.formData.newPassword) {
					updateData.oldPassword = this.formData.oldPassword
					updateData.newPassword = this.formData.newPassword
				}

				const accessToken = uni.getStorageSync('accessToken')
				const refreshToken = uni.getStorageSync('refreshToken')

				const res = await uni.request({
					url: 'http://localhost:8080/children/update/info',
					method: 'POST',
					data: updateData,
					header: {
						'accessToken': accessToken,
						'refreshToken': refreshToken
					}
				})

				const responseData = res.data as any
				if (res.statusCode === 200 && responseData.code === 1) {
					const cachedUserInfo = uni.getStorageSync('userInfo')
					const nextUserInfo: any = cachedUserInfo ? cachedUserInfo : {}
					nextUserInfo.avatar = avatarToSave
					nextUserInfo.name = nickname
					nextUserInfo.nickname = nickname
					nextUserInfo.phone = phone
					nextUserInfo.childrenId = this.userInfo.childrenId
					nextUserInfo.isEnable = this.userInfo.isEnable
					uni.setStorageSync('userInfo', nextUserInfo)

					this.showPopup = false
					this.loadUserInfo()
					uni.hideLoading()
					uni.showToast({
						title: avatarUploadFailed ? '资料已保存，头像同步失败' : '更新成功',
						icon: avatarUploadFailed ? 'none' : 'success',
						duration: 2000
					})
				} else {
					uni.hideLoading()
					uni.showToast({
						title: responseData.msg || '更新失败',
						icon: 'none'
					})
				}
			} catch (error) {
				uni.hideLoading()
				uni.showToast({
					title: '更新失败',
					icon: 'none'
				})
			} finally {
				uni.hideLoading()
				this.isSubmitting = false
			}
		},
		goToCart() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.navigateTo({
				url: '/pages/children/cart',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		goToAIConsult() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.navigateTo({
				url: '/pages/children/ai-consult',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		goToNursing() {
			if (!this.ensureLoggedIn()) {
				return
			}

			uni.switchTab({
				url: '/pages/children/nursing',
				fail: () => {
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		handleLogout() {
			if (this.isSubmitting) {
				return
			}

			uni.showModal({
				title: '确认退出',
				content: '确定要退出登录吗？',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						this.showPopup = false
						uni.removeStorageSync('accessToken')
						uni.removeStorageSync('refreshToken')
						uni.removeStorageSync('userInfo')

						uni.showToast({
							title: '退出成功',
							icon: 'success',
							duration: 1200
						})

						setTimeout(() => {
							uni.reLaunch({
								url: '/pages/index/index'
							})
						}, 1200)
					}
				}
			})
		}
	}
}
</script>

<style>
	.page {
		min-height: 100vh;
		padding: 24rpx 24rpx 180rpx;
		box-sizing: border-box;
		position: relative;
		overflow-x: hidden;
		background:
			radial-gradient(circle at top right, rgba(47, 185, 197, 0.16), transparent 34%),
			radial-gradient(circle at bottom left, rgba(60, 126, 255, 0.12), transparent 30%),
			linear-gradient(180deg, #EBFAF8 0%, #F6FAFD 38%, #F3F7FB 100%);
	}

	.bg-orb {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
	}

	.bg-orb--one {
		width: 240rpx;
		height: 240rpx;
		top: -54rpx;
		right: -96rpx;
		background: rgba(79, 209, 197, 0.16);
	}

	.bg-orb--two {
		width: 180rpx;
		height: 180rpx;
		top: 290rpx;
		left: -86rpx;
		background: rgba(79, 184, 209, 0.12);
	}

	.bg-orb--three {
		width: 140rpx;
		height: 140rpx;
		right: 18rpx;
		bottom: 430rpx;
		background: rgba(255, 255, 255, 0.44);
	}

	.hero-card,
	.panel,
	.logout-panel {
		position: relative;
		z-index: 1;
	}

	.hero-card {
		border-radius: 36rpx;
		padding: 34rpx;
		overflow: hidden;
		background-image:
			linear-gradient(135deg, rgba(7, 44, 66, 0.92), rgba(12, 124, 117, 0.82)),
			url('/static/images/children-card-bg.jpg');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		box-shadow: 0 24rpx 56rpx rgba(8, 44, 71, 0.18);
		border: 1rpx solid rgba(255, 255, 255, 0.06);
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.hero-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 18rpx;
	}

	.hero-copy {
		flex: 1;
		min-width: 0;
		margin-left: 5%;
	}

	.hero-kicker {
		display: block;
		font-size: 24rpx;
		letter-spacing: 1rpx;
		color: rgba(255, 255, 255, 0.82);
		margin-bottom: 16rpx;
	}

	.hero-name {
		display: block;
		font-size: 44rpx;
		line-height: 1.18;
		font-weight: 700;
		color: #FFFFFF;
		margin-bottom: 14rpx;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-desc {
		display: block;
		font-size: 26rpx;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.88);
	}

	.hero-avatar-shell {
		position: relative;
		width: 152rpx;
		height: 152rpx;
		padding: 6rpx;
		box-sizing: border-box;
		border-radius: 50%;
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.12);
		box-shadow: 0 18rpx 34rpx rgba(2, 15, 28, 0.2);
	}

	.hero-avatar {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: 2rpx solid rgba(255, 255, 255, 0.26);
		background: rgba(255, 255, 255, 0.16);
	}

	.hero-avatar-tag {
		position: absolute;
		right: -6rpx;
		bottom: -6rpx;
		display: flex;
		align-items: center;
		gap: 6rpx;
		padding: 8rpx 16rpx;
		border-radius: 999rpx;
		background: rgba(255, 255, 255, 0.96);
		box-shadow: 0 12rpx 24rpx rgba(8, 44, 71, 0.16);
	}

	.hero-avatar-tag-icon {
		width: 20rpx;
		height: 20rpx;
	}

	.hero-avatar-tag-text {
		font-size: 22rpx;
		line-height: 1;
		color: #147C74;
		font-weight: 600;
	}

	.hero-meta {
		display: flex;
		gap: 14rpx;
		margin-top: 28rpx;
	}

	.meta-item {
		flex: 1;
		min-width: 0;
		padding: 18rpx 16rpx;
		border-radius: 22rpx;
		background: rgba(255, 255, 255, 0.12);
		border: 1rpx solid rgba(255, 255, 255, 0.16);
		backdrop-filter: blur(8px);
	}

	.meta-item--success {
		background: rgba(34, 197, 94, 0.14);
		border-color: rgba(34, 197, 94, 0.18);
	}

	.meta-item--warning {
		background: rgba(251, 191, 36, 0.14);
		border-color: rgba(251, 191, 36, 0.18);
	}

	.meta-label {
		display: block;
		font-size: 22rpx;
		line-height: 1.3;
		color: rgba(255, 255, 255, 0.74);
		margin-bottom: 8rpx;
	}

	.meta-item--success .meta-label,
	.meta-item--warning .meta-label {
		color: rgba(255, 255, 255, 0.82);
	}

	.meta-value {
		display: block;
		font-size: 26rpx;
		line-height: 1.25;
		font-weight: 600;
		color: #FFFFFF;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
