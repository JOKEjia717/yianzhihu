<template>
	<view class="container">
		<!-- 用户信息卡片 -->
		<view class="user-card">
			<view class="user-info">
				<image class="avatar" :src="userInfo.avatar || '/static/images/default-avatar.png'" mode="aspectFill"></image>
				<view class="info-content">
					<view class="name-line">
						<text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
					</view>
					<view class="phone-line">
						<text class="phone">{{userInfo.phone || '未绑定手机号'}}</text>
					</view>
				</view>
			</view>
			<button class="edit-btn" @click="showEditForm">编辑资料</button>
		</view>

		<!-- 商品信息 -->
		<view class="shop-buttons">
			<button class="shop-btn" @click="goToCart">
				<image class="btn-icon" src="/static/images/cart.png" mode="aspectFit"></image>
				<text class="btn-text">购物车</text>
			</button>
			<button class="shop-btn" @click="goToOrders">
				<image class="btn-icon" src="/static/images/order.png" mode="aspectFit"></image>
				<text class="btn-text">我的订单</text>
			</button>
			<button class="shop-btn" @click="goToAIConsult">
				<image class="btn-icon" src="/static/images/ai.png" mode="aspectFit"></image>
				<text class="btn-text">AI咨询</text>
			</button>
		</view>

		<!-- 退出登录按钮 -->
		<view class="logout-area">
			<button class="logout-btn" @click="handleLogout">退出登录</button>
		</view>

		<!-- 编辑资料弹出层 -->
		<view class="popup" v-if="showPopup">
			<view class="popup-mask" @click="hideEditForm"></view>
			<view class="popup-content">
				<view class="popup-header">
					<text class="popup-title">编辑资料</text>
					<text class="popup-close" @click="hideEditForm">×</text>
				</view>
				<view class="popup-body">
					<!-- 头像上传 -->
					<view class="form-item">
						<text class="form-label">头像</text>
						<view class="avatar-upload" @click="chooseAvatar">
							<image class="avatar-preview" :src="formData.avatar || userInfo.avatar || '/static/images/default-avatar.png'" mode="aspectFill"></image>
							<text class="upload-text">点击更换</text>
						</view>
					</view>
					<!-- 用户名 -->
					<view class="form-item">
						<text class="form-label">用户名</text>
						<input class="form-input" type="text" v-model="formData.nickname" placeholder="请输入用户名" />
					</view>
					<!-- 手机号 -->
					<view class="form-item">
						<text class="form-label">手机号</text>
						<input class="form-input" type="number" v-model="formData.phone" placeholder="请输入手机号" maxlength="11" />
					</view>
					<!-- 修改密码 -->
					<view class="form-item">
						<text class="form-label">修改密码</text>
						<view class="password-inputs">
							<input class="form-input" type="password" v-model="formData.oldPassword" placeholder="请输入原密码" />
							<input class="form-input" type="password" v-model="formData.newPassword" placeholder="请输入新密码" />
							<input class="form-input" type="password" v-model="formData.confirmPassword" placeholder="请确认新密码" />
						</view>
					</view>
				</view>
				<view class="popup-footer">
					<button class="cancel-btn" @click="hideEditForm">取消</button>
					<button class="submit-btn" @click="submitForm">保存</button>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { request } from '../../utils/request'

interface UserInfo {
	avatar: string
	nickname: string
	phone: string
	childrenId: string
	isEnable: number
}

interface FormData {
	avatar: string
	tempAvatarPath: string
	nickname: string
	phone: string
	oldPassword: string
	newPassword: string
	confirmPassword: string
}

export default {
	data() {
		return {
			userInfo: {
				avatar: '',
				nickname: '',
				phone: '',
				childrenId: '',
				isEnable: 0
			} as UserInfo,
			showPopup: false,
			formData: {
				avatar: '',
				tempAvatarPath: '',
				nickname: '',
				phone: '',
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			} as FormData
		}
	},
	onShow() {
		this.loadUserInfo()
	},
	methods: {
		goToCart() {
		    // 检查登录状态
		    const accessToken = uni.getStorageSync('accessToken')
		    if (!accessToken) {
		      uni.showToast({ 
		        title: '请先登录', 
		        icon: 'none',
		        duration: 1500
		      })
		      setTimeout(() => {
		        uni.navigateTo({ url: '/pages/login/login' })
		      }, 1500)
		      return
		    }
		    
		    // 跳转逻辑
		    uni.navigateTo({
		      url: '/pages/children/cart',
		      success: () => {
		        console.log("跳转成功")
		      },
		      fail: (err) => {
		        console.error("跳转失败:", err)
		        uni.showToast({
		          title: '页面加载失败',
		          icon: 'none'
		        })
		      }
		    })
		  },
		loadUserInfo() {
			const userInfo = uni.getStorageSync('userInfo')
			if (userInfo) {
				this.userInfo = {
					avatar: userInfo.avatar ? userInfo.avatar : '/static/images/default-avatar.png',
					nickname: userInfo.name || '未设置昵称',
					phone: userInfo.phone || '未绑定手机号',
					childrenId: userInfo.childrenId || '',
					isEnable: userInfo.isEnable || 0
				}
			} else {
				this.userInfo.avatar = '/static/images/default-avatar.png'
			}
		},
		showEditForm() {
			// 初始化表单数据
			this.formData = {
				avatar: this.userInfo.avatar,
				tempAvatarPath: '',
				nickname: this.userInfo.nickname,
				phone: this.userInfo.phone,
				oldPassword: '',
				newPassword: '',
				confirmPassword: ''
			}
			this.showPopup = true
		},
		hideEditForm() {
			this.showPopup = false
		},
		async chooseAvatar() {
			try {
				const res = await uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['album', 'camera']
				})
				if (res.tempFilePaths.length > 0) {
					this.formData.avatar = res.tempFilePaths[0]
					this.formData.tempAvatarPath = res.tempFilePaths[0]
				}
			} catch (error) {
				uni.showToast({
					title: '选择图片失败',
					icon: 'none'
				})
			}
		},
		async submitForm() {
			// 表单验证
			if (!this.formData.nickname) {
				uni.showToast({
					title: '请输入用户名',
					icon: 'none'
				})
				return
			}
			if (!this.formData.phone) {
				uni.showToast({
					title: '请输入手机号',
					icon: 'none'
				})
				return
			}
			if (!/^1[3-9]\d{9}$/.test(this.formData.phone)) {
				uni.showToast({
					title: '手机号格式不正确',
					icon: 'none'
				})
				return
			}
			if (this.formData.newPassword && !this.formData.oldPassword) {
				uni.showToast({
					title: '请输入原密码',
					icon: 'none'
				})
				return
			}
			if (this.formData.newPassword && this.formData.newPassword !== this.formData.confirmPassword) {
				uni.showToast({
					title: '两次输入的密码不一致',
					icon: 'none'
				})
				return
			}

			try {
				// 如果选择了新头像，先上传头像
				if (this.formData.tempAvatarPath) {
					try {
						const accessToken = uni.getStorageSync('accessToken')
						const refreshToken = uni.getStorageSync('refreshToken')
						
						const uploadRes = await uni.uploadFile({
							url: 'http://localhost:8080/children/avatar',
							filePath: this.formData.tempAvatarPath,
							name: 'image',
							formData: {},
							header: {
								'accessToken': accessToken,
								'refreshToken': refreshToken
							}
						})
						
						if (uploadRes.statusCode !== 200) {
							uni.showToast({
								title: '头像上传失败',
								icon: 'none'
							})
						} else {
							// 解析服务器返回的数据
							const responseData = JSON.parse(uploadRes.data)
							if (responseData.code === 1) {
								// 更新本地缓存的用户信息
								const userInfo = uni.getStorageSync('userInfo')
								if (userInfo) {
									userInfo.avatar = this.formData.avatar  // 使用本地临时路径
									uni.setStorageSync('userInfo', userInfo)
								}
								uni.showToast({
									title: '更新成功',
									icon: 'success',
									duration: 2000
								})
							} else {
								uni.showToast({
									title: responseData.msg || '更新失败',
									icon: 'none'
								})
							}
						}
					} catch (error) {
						uni.showToast({
							title: '头像上传失败',
							icon: 'none'
						})
					}
				}

				// 更新其他用户信息
				const accessToken = uni.getStorageSync('accessToken')
				const refreshToken = uni.getStorageSync('refreshToken')
				
				const updateData = {
					name: this.formData.nickname,
					phone: this.formData.phone
				}
				
				if (this.formData.newPassword) {
					Object.assign(updateData, {
						oldPassword: this.formData.oldPassword,
						newPassword: this.formData.newPassword
					})
				}

				const res = await uni.request({
					url: 'http://localhost:8080/children/update/info',
					method: 'POST',
					data: updateData,
					header: {
						'accessToken': accessToken,
						'refreshToken': refreshToken
					}
				})

				// 解析响应数据
				const responseData = res.data as any
				if (responseData.code === 1) {
					// 更新本地缓存的用户信息
					const userInfo = uni.getStorageSync('userInfo')
					if (userInfo) {
						userInfo.name = this.formData.nickname
						userInfo.phone = this.formData.phone
						uni.setStorageSync('userInfo', userInfo)
					}

					uni.showToast({
						title: '更新成功',
						icon: 'success',
						duration: 2000
					})
					this.hideEditForm()
					this.loadUserInfo()
				} else {
					// 显示服务器返回的具体错误信息
					uni.showToast({
						title: responseData.msg || '更新失败',
						icon: 'none'
					})
				}
			} catch (error) {
				uni.showToast({
					title: '更新失败',
					icon: 'none'
				})
			}
		},
		goToCart() {
			uni.navigateTo({ url: '/pages/children/cart' })
		},
				goToOrders() {
					console.log('开始获取订单数据...')
					const accessToken = uni.getStorageSync('accessToken')
					const refreshToken = uni.getStorageSync('refreshToken')
					uni.request({
						url: 'http://localhost:8080/goods/order/list',
						method: 'GET',
						header: {
							'accessToken': accessToken,
							'refreshToken': refreshToken
						},
						success: (res: any) => {
							console.log('获取到的订单数据:', res)
							if (res.statusCode === 200 && res.data.code === 1) {
								const orders = res.data.data
								console.log('准备跳转到订单列表页面')
								uni.navigateTo({
									url: '/pages/children/order-list',
									success: (res) => {
										console.log('页面跳转成功')
										res.eventChannel.emit('acceptDataFromOpenerPage', { orders: orders })
									},
									fail: (err) => {
										console.error('页面跳转失败:', err)
									}
								})
							} else {
								console.error('获取订单数据失败:', res.data.msg)
							}
						},
						fail: (err) => {
							console.error('请求失败:', err)
						}
					})
				},
		goToAIConsult() {
			// 检查登录状态
			const accessToken = uni.getStorageSync('accessToken')
			if (!accessToken) {
				uni.showToast({ 
					title: '请先登录', 
					icon: 'none',
					duration: 1500
				})
				setTimeout(() => {
					uni.navigateTo({ url: '/pages/login/login' })
				}, 1500)
				return
			}
			
			// 跳转到AI咨询页面
			uni.navigateTo({
				url: '/pages/children/ai-consult',
				success: () => {
					console.log("跳转到AI咨询页面成功")
				},
				fail: (err) => {
					console.error("跳转失败:", err)
					uni.showToast({
						title: '页面加载失败',
						icon: 'none'
					})
				}
			})
		},
		handleLogout() {
			uni.showModal({
				title: '确认退出',
				content: '确定要退出登录吗？',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						// 清除本地存储的用户信息
						uni.removeStorageSync('accessToken')
						uni.removeStorageSync('refreshToken')
						uni.removeStorageSync('userInfo')
						
						uni.showToast({
							title: '退出成功',
							icon: 'success',
							duration: 1500
						})
						
						setTimeout(() => {
							// 跳转到登录选择页面
							uni.navigateTo({
								url: '/pages/index/index'
							})
						}, 1500)
					}
				}
			})
		}
	}
}
</script>

<style>
	.container {
		min-height: 100vh;
		background: #F5F7FA;
		padding-bottom: 120rpx;
	}

	/* 用户信息卡片样式 */
	.user-card {
		background: #FFFFFF;
		margin: 30rpx;
		padding: 30rpx;
		border-radius: 24rpx;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
	}

	.user-info {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		margin-bottom: 30rpx;
	}

	.avatar {
		width: 100rpx !important;
		height: 100rpx !important;
		border-radius: 50rpx;
		margin-right: 20rpx;
		border: 2rpx solid #F0F2F5;
	}

	.info-content {
		flex: 1;
		min-width: 0;
	}

	.nickname {
		font-size: 32rpx !important;
		font-weight: bold;
		color: #2D3748;
		max-width: 80%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.phone {
		font-size: 26rpx !important;
		color: #718096;
		margin-top: 8rpx;
		display: flex;
		align-items: center;
	}

	.edit-btn {
		width: 100%;
		height: 80rpx;
		line-height: 80rpx;
		text-align: center;
		background: #F8FAFC;
		color: #4FD1C5;
		font-size: 28rpx;
		border-radius: 40rpx;
		border: none;
		padding: 0;
		margin: 0;
	}

	.edit-btn::after {
		border: none;
	}

	.edit-btn:active {
		opacity: 0.8;
	}

	/* 弹出层样式 */
	.popup {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
	}

	.popup-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
	}

	.popup-content {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: #FFFFFF;
		border-radius: 32rpx 32rpx 0 0;
		padding: 40rpx;
		animation: slideUp 0.3s ease-out;
	}

	@keyframes slideUp {
		from {
			transform: translateY(100%);
		}
		to {
			transform: translateY(0);
		}
	}

	.popup-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 40rpx;
		position: relative;
	}

	.popup-title {
		font-size: 36rpx;
		font-weight: 600;
		color: #1A202C;
		flex: 1;
		text-align: center;
	}

	.popup-close {
		position: absolute;
		right: -20rpx;
		top: -10rpx;
		font-size: 44rpx;
		color: #718096;
		padding: 20rpx;
		line-height: 1;
	}

	.popup-body {
		max-height: 65vh;
		overflow-y: auto;
		padding: 0 10rpx;
	}

	.form-item {
		margin-bottom: 36rpx;
	}

	.form-label {
		font-size: 28rpx;
		color: #4A5568;
		margin-bottom: 16rpx;
		display: block;
		font-weight: 500;
	}

	.form-input {
		width: 100%;
		height: 88rpx;
		background: #F8FAFC;
		border-radius: 16rpx;
		padding: 0 32rpx;
		font-size: 30rpx;
		color: #2D3748;
		margin-bottom: 16rpx;
		transition: all 0.3s ease;
		border: 2rpx solid transparent;
	}

	.form-input:focus {
		background: #FFFFFF;
		border-color: #4FD1C5;
		box-shadow: 0 0 0 2rpx rgba(79, 209, 197, 0.1);
	}

	.avatar-upload {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16rpx;
		padding: 20rpx 0;
	}

	.avatar-preview {
		width: 160rpx;
		height: 160rpx;
		border-radius: 80rpx;
		border: 4rpx solid #E2E8F0;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
	}

	.avatar-preview:active {
		transform: scale(0.95);
	}

	.upload-text {
		font-size: 26rpx;
		color: #4FD1C5;
		font-weight: 500;
		background: rgba(79, 209, 197, 0.1);
		padding: 8rpx 24rpx;
		border-radius: 28rpx;
	}

	.password-inputs {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.popup-footer {
		display: flex;
		gap: 24rpx;
		margin-top: 40rpx;
		padding: 0 10rpx;
	}

	.cancel-btn, .submit-btn {
		flex: 1;
		height: 88rpx;
		line-height: 88rpx;
		text-align: center;
		border-radius: 44rpx;
		font-size: 30rpx;
		font-weight: 500;
		transition: all 0.3s ease;
	}

	.cancel-btn {
		background: #F8FAFC;
		color: #718096;
		border: none;
	}

	.cancel-btn:active {
		background: #EDF2F7;
		transform: scale(0.98);
	}

	.submit-btn {
		background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
		color: #FFFFFF;
		border: none;
		box-shadow: 0 4rpx 12rpx rgba(79, 209, 197, 0.3);
	}

	.submit-btn:active {
		transform: scale(0.98);
		box-shadow: 0 2rpx 6rpx rgba(79, 209, 197, 0.2);
	}

	/* 商品按钮样式 */
	.shop-buttons {
		display: flex;
		justify-content: space-between;
		padding: 30rpx;
		gap: 20rpx;
	}

	.shop-btn {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: #FFFFFF;
		border-radius: 24rpx;
		padding: 40rpx 20rpx;
		position: relative;
		border: none;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
	}

	.shop-btn::after {
		border: none;
	}

	.shop-btn:active {
		opacity: 0.8;
	}

	.btn-icon {
		width: 64rpx;
		height: 64rpx;
		margin-bottom: 16rpx;
	}

	.btn-text {
		font-size: 28rpx;
		color: #2D3748;
		line-height: 1;
	}

	/* 退出登录按钮样式 */
	.logout-area {
		padding: 30rpx;
		margin-top: 20rpx;
	}

	.logout-btn {
		width: 100%;
		height: 88rpx;
		line-height: 88rpx;
		text-align: center;
		background: #FFFFFF;
		color: #E53E3E;
		font-size: 30rpx;
		border-radius: 44rpx;
		border: 2rpx solid #E53E3E;
		padding: 0;
		margin: 0;
		box-shadow: 0 4rpx 20rpx rgba(229, 62, 62, 0.1);
		transition: all 0.3s ease;
	}

	.logout-btn::after {
		border: none;
	}

	.logout-btn:active {
		background: #FEF2F2;
		transform: scale(0.98);
	}
</style>