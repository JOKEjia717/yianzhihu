<template>
	<view class="container">
		<!-- 标签切换 -->
		<view class="tab-container">
			<view class="tab-item" :class="{ 'active': currentTab === 'list' }" @tap="switchTab('list')">
				<text class="tab-text">列表搜索</text>
			</view>
			<view class="tab-item" :class="{ 'active': currentTab === 'map' }" @tap="switchTab('map')">
				<text class="tab-text">地图搜索</text>
			</view>
		</view>

		<!-- 列表模式 -->
		<view v-if="currentTab === 'list'" class="list-container">
			<!-- 搜索区域 -->
			<view class="search-card">
				<view class="search-header">
					<text class="search-title">搜索养老院</text>
				</view>
				<view class="search-content">
					<view class="search-box">
						<view class="input-group">
							<image class="search-icon" src="/static/images/search.png" mode="aspectFit"></image>
							<input class="search-input" type="text" v-model="searchParams.name" placeholder="请输入机构名称" @confirm="handleSearch" />
						</view>
						<view class="input-group">
							<image class="search-icon" src="/static/images/location.png" mode="aspectFit"></image>
							<input class="search-input" type="text" v-model="searchParams.address" placeholder="请输入地址" @confirm="handleSearch" />
						</view>
					</view>
					<button class="search-btn" @click="handleSearch">
						<text class="search-btn-text">搜索</text>
					</button>
				</view>
			</view>

			<!-- 养老院列表 -->
			<scroll-view class="nursing-list" scroll-y @scrolltolower="loadMore">
				<view v-for="(item, index) in nursingHomes" 
					:key="item.nursingHomeId" 
					class="nursing-card"
					:style="{ backgroundColor: getCardColor(index) }"
					@tap="handleCardClick(item.nursingHomeId)">
					<view class="nursing-card-content">
						<image class="nursing-card-image" :src="item.photo.split(',')[0]" mode="aspectFill"></image>
						<view class="nursing-card-info">
							<text class="nursing-card-name">{{ item.name }}</text>
							<text class="nursing-card-address">地址：{{ item.address }}</text>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 地图模式 -->
		<view v-if="currentTab === 'map'" class="map-container">
			<view class="search-section" :class="{ 'hidden': isSearchHidden }">
				<view class="search-box">
					<input type="text" 
						v-model="mapSearchQuery" 
						placeholder="请输入养老院名称" 
						class="search-input"
						@confirm="handleMapSearch" />
					<button class="search-btn" @click="handleMapSearch">
						<text>搜索</text>
						<view class="ripple-effect"></view>
					</button>
				</view>
			</view>

			<!-- 替换为 web-view 组件 -->
			<web-view 
				:src="mapUrl" 
				class="map-webview"
				@message="handleMapMessage">
			</web-view>

			<!-- 搜索结果列表 -->
			<view class="search-result" :class="{ 'expanded': isResultExpanded }">
				<view class="drag-handle" @click="toggleResultExpand"></view>
				<scroll-view scroll-y class="result-list" :style="{ opacity: mapLoading ? 0.5 : 1 }">
					<view v-for="(item, index) in searchResults" 
						:key="index" 
						class="result-item"
						:class="{ 'fade-in': true }"
						:style="{ animationDelay: index * 0.1 + 's' }">
						<view class="item-header">
							<text class="item-name">{{item.name}}</text>
							<text class="item-distance">{{(item.distance / 1000).toFixed(2)}}km</text>
						</view>
						<view class="item-info">
							<view class="info-row">
								<text class="info-label">地址：</text>
								<text class="info-value">{{item.address}}</text>
							</view>
							<view class="info-row" v-if="item.tel">
								<text class="info-label">电话：</text>
								<text class="info-value">{{item.tel}}</text>
							</view>
							<view class="info-row" v-if="item.type">
								<text class="info-label">类型：</text>
								<text class="info-value">{{item.type}}</text>
							</view>
						</view>
					</view>
					<view v-if="searchResults.length === 0 && !mapLoading" class="empty-state">
						<text class="empty-text">暂无搜索结果</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
import { request } from '../../utils/request'

interface NursingHome {
	nursingHomeId: string
	name: string
	address: string
	photo: string
}

interface SearchParams {
	pageNo: number
	pageSize: number
	name: string
	address: string
}

interface ApiResponse<T> {
	code: number
	msg: string | null
	data: T
}

interface PageResult<T> {
	total: number
	pages: number
	list: T[]
}

interface SearchResult {
	id: string
	name: string
	address: string
	distance: number
	latitude: number
	longitude: number
	tel?: string
	type?: string
}

interface AmapPoi {
	id: string
	name: string
	address?: string
	location: string  // 经度,纬度
	distance?: number
	tel?: string
	type?: string
}

interface AmapResponse {
	status: string
	info: string
	infocode: string
	count: string
	pois: AmapPoi[]
}

export default {
	data() {
		return {
			// 通用
			currentTab: 'list',
			
			// 高德地图Key
			amapKey: '1db93ddf57523eb18a461389935cee31',

			// 列表搜索相关数据
			nursingHomes: [] as NursingHome[],
			searchParams: {
				pageNo: 1,
				pageSize: 10,
				name: '',
				address: ''
			} as SearchParams,
			total: 0,
			loading: false,
			colors: [
				'rgba(135, 206, 235, 0.2)', // 天蓝色
				'rgba(144, 238, 144, 0.2)', // 淡绿色
				'rgba(255, 182, 193, 0.2)', // 淡粉色
				'rgba(230, 230, 250, 0.2)', // 淡紫色
				'rgba(255, 218, 185, 0.2)', // 桃色
				'rgba(176, 224, 230, 0.2)'  // 粉蓝色
			],

			// 地图搜索相关数据
			mapSearchQuery: '养老院',  // 默认搜索养老院
			latitude: 29.82819,  // 默认纬度
			longitude: 106.4784, // 默认经度
			markers: [] as any[],
			searchResults: [] as SearchResult[],
			mapLoading: false,
			isResultExpanded: false,
			isSearchHidden: false,
			lastScrollTop: 0,
			hasSearched: false,
			currentLocation: {
				latitude: 29.82819,
				longitude: 106.4784
			},
			searchAttempts: 0,
			maxSearchAttempts: 3,  // 最大尝试次数
			mapUrl: ''
		}
	},
	onLoad(options: Record<string, string>) {
		this.loadNursingHomes()
		this.getCurrentLocation()
		
		// 监听页面滚动
		uni.onWindowResize(() => {
			if (this.currentTab === 'map') {
				const query = uni.createSelectorQuery()
				query.select('.result-list').boundingClientRect((rect: any) => {
					if (rect) {
						const currentScrollTop = rect.top
						this.isSearchHidden = currentScrollTop < this.lastScrollTop
						this.lastScrollTop = currentScrollTop
					}
				}).exec()
			}
		})
	},
	methods: {
		// 通用方法
		switchTab(tab: string) {
			this.currentTab = tab
			if (tab === 'map') {
				this.getCurrentLocation()
				setTimeout(() => {
					this.handleMapSearch(false)
				}, 1000)
			}
		},

		// 列表搜索相关方法
		getCardColor(index: number): string {
			return this.colors[index % this.colors.length]
		},
		
		handleCardClick(nursingHomeId: string) {
			console.log('点击养老院卡片，ID:', nursingHomeId)
			uni.navigateTo({
				url: `/pages/children/nursing-detail?nursingHomeId=${nursingHomeId}`,
				success: () => {
					console.log('页面跳转成功')
				},
				fail: (err) => {
					console.error('页面跳转失败:', err)
					uni.showToast({
						title: '页面跳转失败',
						icon: 'none'
					})
				}
			})
		},
		
		handleSearch() {
			// 重置页码
			this.searchParams.pageNo = 1
			// 重新加载数据
			this.loadNursingHomes()
		},
		
		async loadNursingHomes() {
			if (this.loading) return
			this.loading = true
			
			try {
				const res = await request.get('/home/list', {
					data: this.searchParams
				}) as { statusCode: number, data: ApiResponse<PageResult<NursingHome>> }
				
				if (res.statusCode === 200 && res.data.code === 1) {
					const { total, list } = res.data.data
					this.total = total
					
					if (this.searchParams.pageNo === 1) {
						this.nursingHomes = list
					} else {
						this.nursingHomes = [...this.nursingHomes, ...list]
					}
				}
			} catch (error) {
				uni.showToast({
					title: '加载失败',
					icon: 'none'
				})
			} finally {
				this.loading = false
			}
		},
		
		loadMore() {
			if (this.nursingHomes.length >= this.total) return
			this.searchParams.pageNo++
			this.loadNursingHomes()
		},

		// 地图搜索相关方法
		handleMapSearch() {
			if (this.mapLoading) return
			
			if (!this.mapSearchQuery.trim()) {
				this.mapSearchQuery = '养老院'
			}

			if (this.currentLocation.latitude === 0 || this.currentLocation.longitude === 0) {
				uni.showToast({
					title: '正在获取位置信息，请稍后再试',
					icon: 'none'
				})
				return
			}

			// 如果超过最大尝试次数，重置并提示用户
			if (this.searchAttempts >= this.maxSearchAttempts) {
				this.searchAttempts = 0
				uni.showToast({
					title: '未找到相关养老院，请尝试其他区域',
					icon: 'none',
					duration: 2000
				})
				return
			}

			this.mapLoading = true
			this.hasSearched = true

			// 使用高德地图API搜索周边POI
			this.searchAroundByAmap()

			// 同时更新地图页面URL
			const baseUrl = '/pages/children/map.html'
			const query = this.mapSearchQuery.trim()
			this.mapUrl = `${baseUrl}?query=${encodeURIComponent(query)}&lat=${this.currentLocation.latitude}&lng=${this.currentLocation.longitude}`
		},
		
		searchAroundByAmap() {
			console.log('发送高德地图搜索请求，参数：', {
				经度: this.currentLocation.longitude,
				纬度: this.currentLocation.latitude,
				查询: this.mapSearchQuery,
				尝试次数: this.searchAttempts + 1
			})
			
			// 构建高德地图API请求URL
			// 参考文档: https://lbs.amap.com/api/webservice/guide/api/search
			const url = `https://restapi.amap.com/v3/place/around?key=${this.amapKey}&location=${this.currentLocation.longitude},${this.currentLocation.latitude}&keywords=${encodeURIComponent(this.mapSearchQuery)}&radius=5000&extensions=all&offset=20&page=1`
			
			uni.request({
				url: url,
				method: 'GET',
				success: (res: any) => {
					console.log('高德地图搜索结果：', res)
					
					if (res.statusCode === 200) {
						const amapRes = res.data as AmapResponse
						
						if (amapRes.status === '1' && amapRes.pois && amapRes.pois.length > 0) {
							// 找到结果
							this.searchAttempts = 0
							this.processAmapResults(amapRes.pois)
						} else {
							// 没有找到结果，调整位置后重试
							this.searchAttempts++
							this.adjustLocationAndRetry()
						}
					} else {
						// 请求失败，调整位置重试
						this.searchAttempts++
						this.adjustLocationAndRetry()
					}
				},
				fail: (err) => {
					console.error('高德地图搜索失败：', err)
					// 请求失败，调整位置重试
					this.searchAttempts++
					this.adjustLocationAndRetry()
					
					uni.showToast({
						title: '搜索失败，请检查网络',
						icon: 'none'
					})
				},
				complete: () => {
					this.mapLoading = false
				}
			})
		},
		
		processAmapResults(pois: AmapPoi[]) {
			// 将高德地图的POI结果转换为我们的结果格式
			this.searchResults = pois.map((poi: AmapPoi) => {
				const location = poi.location.split(',')
				const longitude = Number(location[0]) || 0
				const latitude = Number(location[1]) || 0
				
				return {
					id: poi.id || '',
					name: poi.name || '未知名称',
					address: poi.address || '未知地址',
					distance: Number(poi.distance) || 0,
					latitude: latitude,
					longitude: longitude,
					tel: poi.tel || '',
					type: poi.type || ''
				} as SearchResult
			})
			
			// 更新地图标记
			this.updateMapMarkers()
		},

		adjustLocationAndRetry() {
			// 在当前位置基础上，随机调整一定范围内的位置
			// 经度和纬度各调整 0.01-0.05 度（约1-5公里）
			const adjustment = 0.01 + Math.random() * 0.04
			const direction = Math.random() < 0.5 ? 1 : -1

			// 随机调整经度或纬度
			if (Math.random() < 0.5) {
				this.currentLocation.longitude += adjustment * direction
			} else {
				this.currentLocation.latitude += adjustment * direction
			}

			// 更新地图中心点
			const mapContext = uni.createMapContext('map')
			mapContext.moveToLocation({
				latitude: this.currentLocation.latitude,
				longitude: this.currentLocation.longitude
			})

			// 显示正在搜索的提示
			uni.showToast({
				title: `正在搜索新位置...`,
				icon: 'loading',
				duration: 1500
			})

			// 延迟后发送新的搜索请求
			setTimeout(() => {
				this.handleMapSearch(true)
			}, 1500)
		},

		updateMapMarkers() {
			this.markers = []
			
			// 添加搜索结果的标记
			this.markers = this.searchResults.map((place, index) => ({
				id: index,
				latitude: place.latitude,
				longitude: place.longitude,
				title: place.name,
				iconPath: '/static/images/marker.png',
				width: 32,
				height: 32,
				callout: {
					content: place.name,
					padding: 8,
					borderRadius: 4,
					display: 'ALWAYS'
				}
			}))

			// 添加当前位置标记
			this.markers.push({
				id: this.markers.length,
				latitude: this.currentLocation.latitude,
				longitude: this.currentLocation.longitude,
				title: '当前位置',
				iconPath: '/static/images/location.png',
				width: 32,
				height: 32,
				callout: {
					content: '当前位置',
					padding: 8,
					borderRadius: 4,
					display: 'ALWAYS'
				}
			})

			// 调整地图视野
			const mapContext = uni.createMapContext('map')
			mapContext.includePoints({
				points: this.markers,
				padding: [80, 80, 80, 80]
			})
		},

		getCurrentLocation() {
			uni.getLocation({
				type: 'gcj02',  // 使用国测局坐标系，与高德地图兼容
				success: (res) => {
					console.log('获取位置成功：', res)
					this.currentLocation.latitude = res.latitude
					this.currentLocation.longitude = res.longitude
					this.latitude = res.latitude
					this.longitude = res.longitude
					
					// 更新地图中心点
					if (this.currentTab === 'map') {
						const mapContext = uni.createMapContext('map')
						mapContext.moveToLocation({
							latitude: this.currentLocation.latitude,
							longitude: this.currentLocation.longitude
						})
					}
				}
			})
		},
		
		onMarkerTap(e: any) {
			const marker = this.markers[e.detail.markerId]
			if (marker) {
				const place = this.searchResults[e.detail.markerId]
				if (place) {
					this.selectPlace(place)
				}
			}
		},
		
		selectPlace(place: SearchResult) {
			// 添加点击反馈
			const feedback = new Promise((resolve) => {
				setTimeout(resolve, 200)
			})

			feedback.then(() => {
				uni.showModal({
					title: place.name,
					content: `地址：${place.address}\n距离：${(place.distance / 1000).toFixed(2)}km${place.tel ? '\n电话：'+place.tel : ''}`,
					showCancel: true,
					cancelText: '关闭',
					confirmText: '查看详情',
					success: (res) => {
						if (res.confirm) {
							// 这里可以跳转到详情页，如果有的话
							uni.showToast({
								title: '功能开发中',
								icon: 'none'
							})
						}
					}
				})
			})
		},
		
		toggleResultExpand() {
			this.isResultExpanded = !this.isResultExpanded
		}
	}
}
</script>

<style>
.container {
	min-height: 100vh;
	background: #F5F7FA;
	padding: 12rpx;
}

/* 标签切换 */
.tab-container {
	display: flex;
	flex-direction: row;
	margin-bottom: 20rpx;
	background: #FFFFFF;
	border-radius: 16rpx;
	padding: 8rpx;
	box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.tab-item {
	flex: 1;
	text-align: center;
	padding: 16rpx 0;
	border-radius: 12rpx;
	transition: all 0.3s;
}

.tab-item.active {
	background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
}

.tab-text {
	margin: auto;
	font-size: 28rpx;
	color: #666;
	transition: all 0.3s;
}

.tab-item.active .tab-text {
	color: #FFFFFF;
	font-weight: 500;
}

/* 列表模式样式 */
.list-container {
	height: calc(100vh - 100rpx);
}

.search-card {
	margin-bottom: 16rpx;
	padding: 12rpx;
	background: linear-gradient(135deg, rgba(135, 206, 235, 0.15) 0%, rgba(144, 238, 144, 0.15) 100%);
	border-radius: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
	border: 1rpx solid rgba(135, 206, 235, 0.3);
}

.search-header {
	margin-bottom: 12rpx;
	text-align: center;
	padding: 8rpx;
}

.search-title {
	font-size: 28rpx;
	color: #2D3748;
	font-weight: 500;
	line-height: 1;
	text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.search-content {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	padding: 0 8rpx;
}

.search-box {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.input-group {
	background: rgba(255, 255, 255, 0.9);
	border-radius: 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	height: 56rpx;
	padding: 0 24rpx;
	border: 1rpx solid rgba(135, 206, 235, 0.4);
	box-shadow: 0 2rpx 8rpx rgba(135, 206, 235, 0.1);
	transition: all 0.3s ease;
}

.input-group:active {
	transform: scale(0.98);
	border-color: rgba(135, 206, 235, 0.6);
	background: rgba(255, 255, 255, 0.95);
}

.search-icon {
	width: 24rpx;
	height: 24rpx;
	margin-right: 8rpx;
	opacity: 0.7;
	margin-top: -2rpx;
}

.search-input {
	flex: 1;
	height: 100%;
	font-size: 24rpx;
	color: #333333;
	margin-top: -2rpx;
	text-align: center;
}

.search-input::placeholder {
	color: #94A3B8;
	font-size: 24rpx;
	text-align: center;
}

.search-btn {
	background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
	border-radius: 16rpx;
	height: 56rpx;
	line-height: 56rpx;
	text-align: center;
	margin-top: 8rpx;
	border: none;
	box-shadow: 0 2rpx 8rpx rgba(79, 209, 197, 0.3);
	transition: all 0.3s ease;
}

.search-btn:active {
	transform: scale(0.98);
	opacity: 0.9;
	box-shadow: 0 1rpx 4rpx rgba(79, 209, 197, 0.2);
}

.search-btn-text {
	color: #FFFFFF;
	font-size: 24rpx;
	font-weight: normal;
}

.nursing-list {
	height: calc(100vh - 280rpx);
	padding: 0 20rpx;
}

.nursing-card {
	background-color: #fff;
	border-radius: 20rpx;
	box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
	margin-bottom: 20rpx;
	padding: 0;
	transition: all 0.3s;
}

.nursing-card-content {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 24rpx;
}

.nursing-card-image {
	width: 180rpx;
	height: 180rpx;
	border-radius: 10rpx;
	background: #F8FAFC;
	margin-right: 32rpx;
	object-fit: cover;
	border: 1rpx solid #eee;
}

.nursing-card-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.nursing-card-name {
	font-size: 32rpx;
	font-weight: 600;
	color: #2D3748;
	margin-bottom: 16rpx;
}

.nursing-card-address {
	font-size: 28rpx;
	color: #666;
	word-break: break-all;
}

/* 地图模式样式 */
.map-container {
	height: calc(100vh - 130rpx);
	display: flex;
	flex-direction: column;
	background: #F6F7FB;
}

.search-section {
	padding: 20rpx;
	background: #FFFFFF;
	transform: translateY(0);
	transition: transform 0.3s ease;
	z-index: 2;
	position: relative;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-section.hidden {
	transform: translateY(-100%);
}

.map {
	width: 100%;
	height: 60vh;
	position: relative;
	z-index: 1;
	transition: all 0.3s ease;
}

.search-result {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 40%;
	background: #FFFFFF;
	border-radius: 20rpx 20rpx 0 0;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
	padding: 20rpx;
	transform: translateY(0);
	transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.search-result.expanded {
	height: 80%;
}

.search-result::before {
	content: '';
	position: absolute;
	top: 12rpx;
	left: 50%;
	transform: translateX(-50%);
	width: 60rpx;
	height: 6rpx;
	background: #E2E8F0;
	border-radius: 3rpx;
}

.result-list {
	height: 100%;
	padding-top: 20rpx;
}

.loading-container {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	z-index: 2;
}

.loading-circle {
	width: 80rpx;
	height: 80rpx;
	border: 4rpx solid #E2E8F0;
	border-top-color: #4FD1C5;
	border-radius: 50%;
	animation: spin 1s linear infinite;
}

@keyframes spin {
	to {
		transform: rotate(360deg);
	}
}

.drag-handle {
	width: 60rpx;
	height: 6rpx;
	background: #E2E8F0;
	border-radius: 3rpx;
	margin: 0 auto 20rpx;
	transition: all 0.3s ease;
}

.drag-handle:active {
	width: 80rpx;
	background: #4FD1C5;
}

.loading-text {
	margin-top: 20rpx;
	font-size: 24rpx;
	color: #666666;
	text-align: center;
}

.ripple-effect {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: rgba(255, 255, 255, 0.3);
	border-radius: 8rpx;
	transform: scale(0);
	opacity: 1;
	transition: transform 0.6s ease-out, opacity 0.6s ease-out;
}

.search-btn:active .ripple-effect {
	transform: scale(2);
	opacity: 0;
}

@keyframes fadeIn {
	from {
		opacity: 0;
		transform: translateY(20rpx);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.loading-container {
	animation: fadeIn 0.3s ease-out;
}

.result-item {
	padding: 20rpx;
	margin-bottom: 16rpx;
	background: #FFFFFF;
	border-radius: 12rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-header {
	display: flex;
