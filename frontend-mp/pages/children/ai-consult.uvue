<template>
	<view class="container">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="back-btn" @click="goBack">
				<view class="arrow-box">
					<view class="arrow-left"></view>
				</view>
			</view>
			<text class="title">AI 智能咨询</text>
		</view>
		
		<!-- 聊天内容区域 -->
		<scroll-view class="chat-container" scroll-y="true" :scroll-top="scrollTop" @scrolltoupper="loadMoreMessages">
			<view class="message-list">
				<view v-for="(message, index) in messages" :key="index" class="message-item" :class="message.type">
					<view class="message-content">
						<template v-if="message.type === 'ai'">
							<view v-for="(block, blockIndex) in parseMessageContent(message.content)" :key="blockIndex" class="message-block" :class="['block-' + block.type]">
								<view v-if="block.type === 'gap'" class="message-gap"></view>
								<view v-else-if="block.type === 'heading'" class="heading-row" :class="['heading-level-' + (block.level || 1)]">
									<view class="message-inline">
										<text
											v-for="(part, partIndex) in block.parts"
											:key="partIndex"
											class="message-text"
											:class="{ 'bold': part.bold, 'code': part.code }"
										>{{ part.text }}</text>
									</view>
								</view>
								<view v-else-if="block.type === 'bullet'" class="list-row">
									<text class="list-marker">•</text>
									<view class="message-inline">
										<text
											v-for="(part, partIndex) in block.parts"
											:key="partIndex"
											class="message-text"
											:class="{ 'bold': part.bold, 'code': part.code }"
										>{{ part.text }}</text>
									</view>
								</view>
								<view v-else-if="block.type === 'ordered'" class="list-row">
									<text class="list-marker">{{ block.order }}.</text>
									<view class="message-inline">
										<text
											v-for="(part, partIndex) in block.parts"
											:key="partIndex"
											class="message-text"
											:class="{ 'bold': part.bold, 'code': part.code }"
										>{{ part.text }}</text>
									</view>
								</view>
								<view v-else-if="block.type === 'quote'" class="quote-row">
									<view class="quote-bar"></view>
									<view class="message-inline quote-content">
										<text
											v-for="(part, partIndex) in block.parts"
											:key="partIndex"
											class="message-text"
											:class="{ 'bold': part.bold, 'code': part.code }"
										>{{ part.text }}</text>
									</view>
								</view>
								<view v-else-if="block.type === 'table'" class="table-wrapper">
									<scroll-view class="table-scroll" scroll-x="true">
										<view class="table">
											<view class="table-row table-header-row">
												<view
													v-for="(cell, cellIndex) in block.tableHeaders"
													:key="cellIndex"
													class="table-cell table-header-cell"
												>
													<text
														v-for="(part, partIndex) in cell.parts"
														:key="partIndex"
														class="message-text table-text"
														:class="{ 'bold': part.bold, 'code': part.code }"
													>{{ part.text }}</text>
												</view>
											</view>
											<view
												v-for="(row, rowIndex) in block.tableRows"
												:key="rowIndex"
												class="table-row"
											>
												<view
													v-for="(cell, cellIndex) in row.cells"
													:key="cellIndex"
													class="table-cell"
												>
													<text
														v-for="(part, partIndex) in cell.parts"
														:key="partIndex"
														class="message-text table-text"
														:class="{ 'bold': part.bold, 'code': part.code }"
													>{{ part.text }}</text>
												</view>
											</view>
										</view>
									</scroll-view>
								</view>
								<view v-else-if="block.type === 'code'" class="code-block">
									<text class="code-text">{{ block.codeText }}</text>
								</view>
								<view v-else class="paragraph-row">
									<view class="message-inline">
										<text
											v-for="(part, partIndex) in block.parts"
											:key="partIndex"
											class="message-text"
											:class="{ 'bold': part.bold, 'code': part.code }"
										>{{ part.text }}</text>
									</view>
								</view>
							</view>
						</template>
						<text v-else class="message-text user-text">{{ message.content }}</text>
						<image v-if="message.imageUrl" :src="message.imageUrl" class="message-image" mode="widthFix"></image>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<!-- 底部输入区域 -->
		<view class="input-wrapper">
			<!-- 照片缩略图和删除按钮，放在输入区上方靠左 -->
			<view v-if="tempImagePath" class="thumb-wrapper-outside">
				<image :src="tempImagePath" class="thumb-image"></image>
				<view class="thumb-remove" @click="removeImage">×</view>
			</view>
			<view class="input-area">
				<button class="upload-btn" @click="chooseImage">
					<image src="../../static/images/camera.png" class="camera-icon"></image>
				</button>
				<input 
					class="message-input" 
					type="text" 
					v-model="inputMessage" 
					placeholder="请输入您的问题" 
					@confirm="sendMessage"
				/>
				<button class="send-btn" :disabled="isLoading" @click="sendMessage">
					{{isLoading ? '回复中...' : '发送'}}
				</button>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
interface InlinePart {
	text: string
	bold: boolean
	code: boolean
}

interface TableCell {
	parts: InlinePart[]
}

interface TableRow {
	cells: TableCell[]
}

interface MessageBlock {
	type: 'paragraph' | 'heading' | 'bullet' | 'ordered' | 'quote' | 'table' | 'code' | 'gap'
	parts: InlinePart[]
	level?: number
	order?: string
	codeText?: string
	tableHeaders?: TableCell[]
	tableRows?: TableRow[]
}

interface Message {
	content: string
	type: 'user' | 'ai'
	timestamp: number
	imageUrl?: string
}

export default {
	data() {
		return {
			messages: [] as Message[],
			inputMessage: '',
			scrollTop: 0,
			isLoading: false,
			sessionId: '123', // 固定为123
			streamResponse: '', // 用于存储流式响应
			tempImagePath: '' // 临时存储选中的图片路径
		}
	},
	onLoad() {
		// 添加欢迎消息
		this.messages.push({
			content: '您好！我是您的AI助手，请问有什么可以帮您？',
			type: 'ai',
			timestamp: Date.now()
		})
	},
	methods: {
		parseInlineParts(content: string): InlinePart[] {
			if (!content) {
				return []
			}
			const parts: InlinePart[] = []
			const regex = /(\*\*[^*]+?\*\*|`[^`]+`)/g
			let lastIndex = 0
			let match
			
			while ((match = regex.exec(content)) !== null) {
				if (match.index > lastIndex) {
					const normalText = content.substring(lastIndex, match.index)
					if (normalText) {
						parts.push({ text: normalText, bold: false, code: false })
					}
				}
				const token = match[0]
				if (token.startsWith('**') && token.endsWith('**')) {
					const boldText = token.substring(2, token.length - 2)
					if (boldText) {
						parts.push({ text: boldText, bold: true, code: false })
					}
				} else if (token.startsWith('`') && token.endsWith('`')) {
					const codeText = token.substring(1, token.length - 1)
					if (codeText) {
						parts.push({ text: codeText, bold: false, code: true })
					}
				}
				lastIndex = regex.lastIndex
			}
			
			if (lastIndex < content.length) {
				const remainingText = content.substring(lastIndex)
				if (remainingText) {
					parts.push({ text: remainingText, bold: false, code: false })
				}
			}
			
			if (parts.length === 0) {
				parts.push({ text: content, bold: false, code: false })
			}
			
			return parts
		},
		parseMessageContent(content: string): MessageBlock[] {
			if (!content) {
				return []
			}

			const normalized = content.replace(/\r\n/g, '\n')
			const lines = normalized.split('\n')
			const blocks: MessageBlock[] = []
			let paragraphBuffer: string[] = []
			let codeBuffer: string[] = []
			let inCodeBlock = false

			const flushParagraph = () => {
				if (paragraphBuffer.length === 0) {
					return
				}
				const paragraphText = paragraphBuffer.join(' ').replace(/\s+/g, ' ').trim()
				if (paragraphText) {
					blocks.push({
						type: 'paragraph',
						parts: this.parseInlineParts(paragraphText)
					})
				}
				paragraphBuffer = []
			}

			const flushCodeBlock = () => {
				if (codeBuffer.length === 0) {
					return
				}
				blocks.push({
					type: 'code',
					parts: [],
					codeText: codeBuffer.join('\n')
				})
				codeBuffer = []
			}

			const pushGap = () => {
				if (blocks.length === 0) {
					return
				}
				const lastBlock = blocks[blocks.length - 1]
				if (lastBlock.type === 'gap') {
					return
				}
				blocks.push({
					type: 'gap',
					parts: []
				})
			}

			const isMarkdownSeparator = (line: string): boolean => {
				return /^(-{3,}|\*{3,}|_{3,})$/.test(line)
			}

			const isMarkdownTableDivider = (line: string): boolean => {
				let cleaned = line.trim()
				if (cleaned.startsWith('|')) {
					cleaned = cleaned.substring(1)
				}
				if (cleaned.endsWith('|')) {
					cleaned = cleaned.substring(0, cleaned.length - 1)
				}

				if (!cleaned.includes('|')) {
					return false
				}

				const cells = cleaned.split('|').map(cell => cell.trim())
				if (cells.length < 2) {
					return false
				}

				return cells.every(cell => /^:?-{3,}:?$/.test(cell))
			}

			const splitMarkdownTableRow = (line: string): string[] => {
				let row = line.trim()
				if (row.startsWith('|')) {
					row = row.substring(1)
				}
				if (row.endsWith('|')) {
					row = row.substring(0, row.length - 1)
				}

				const cells: string[] = []
				let currentCell = ''
				let escapeNext = false

				for (let index = 0; index < row.length; index++) {
					const char = row.charAt(index)
					if (escapeNext) {
						currentCell += char
						escapeNext = false
						continue
					}
					if (char === '\\') {
						escapeNext = true
						continue
					}
					if (char === '|') {
						cells.push(currentCell.trim())
						currentCell = ''
						continue
					}
					currentCell += char
				}

				cells.push(currentCell.trim())
				return cells
			}

			const parseTableBlock = (startIndex: number): { block: MessageBlock; consumed: number } | null => {
				if (startIndex + 1 >= lines.length) {
					return null
				}

				const headerLine = lines[startIndex].trim()
				const dividerLine = lines[startIndex + 1].trim()
				if (!headerLine.includes('|') || !isMarkdownTableDivider(dividerLine)) {
					return null
				}

				const rowTexts: string[][] = [splitMarkdownTableRow(headerLine)]
				let consumed = 2
				let cursor = startIndex + 2

				while (cursor < lines.length) {
					const candidate = lines[cursor].trim()
					if (!candidate) {
						break
					}
					if (!candidate.includes('|') || candidate.startsWith('```') || isMarkdownSeparator(candidate)) {
						break
					}
					rowTexts.push(splitMarkdownTableRow(candidate))
					consumed += 1
					cursor += 1
				}

				const columnCount = rowTexts.reduce((max, row) => Math.max(max, row.length), 0)
				if (columnCount === 0) {
					return null
				}

				const buildCells = (row: string[]): TableCell[] => {
					const cells: TableCell[] = []
					for (let columnIndex = 0; columnIndex < columnCount; columnIndex++) {
						cells.push({
							parts: this.parseInlineParts(row[columnIndex] || '')
						})
					}
					return cells
				}

				return {
					type: 'table',
					parts: [],
					tableHeaders: buildCells(rowTexts[0]),
					tableRows: rowTexts.slice(1).map(row => ({
						cells: buildCells(row)
					}))
				}
			}

			let lineIndex = 0
			while (lineIndex < lines.length) {
				const rawLine = lines[lineIndex]
				const trimmedLine = rawLine.trim()

				if (trimmedLine.startsWith('```')) {
					if (inCodeBlock) {
						flushCodeBlock()
						inCodeBlock = false
					} else {
						flushParagraph()
						inCodeBlock = true
					}
					lineIndex++
					continue
				}

				if (inCodeBlock) {
					codeBuffer.push(rawLine)
					lineIndex++
					continue
				}

				if (!trimmedLine) {
					flushParagraph()
					pushGap()
					lineIndex++
					continue
				}

				// Markdown 分隔线只保留为空白，不直接展示在正文里
				if (isMarkdownSeparator(trimmedLine)) {
					flushParagraph()
					pushGap()
					lineIndex++
					continue
				}

				const tableBlock = parseTableBlock(lineIndex)
				if (tableBlock) {
					flushParagraph()
					blocks.push(tableBlock.block)
					lineIndex += tableBlock.consumed
					continue
				}

				if (trimmedLine.startsWith('### ')) {
					flushParagraph()
					blocks.push({
						type: 'heading',
						parts: this.parseInlineParts(trimmedLine.substring(4).trim()),
						level: 3
					})
					lineIndex++
					continue
				}

				if (trimmedLine.startsWith('## ')) {
					flushParagraph()
					blocks.push({
						type: 'heading',
						parts: this.parseInlineParts(trimmedLine.substring(3).trim()),
						level: 2
					})
					lineIndex++
					continue
				}

				if (trimmedLine.startsWith('# ')) {
					flushParagraph()
					blocks.push({
						type: 'heading',
						parts: this.parseInlineParts(trimmedLine.substring(2).trim()),
						level: 1
					})
					lineIndex++
					continue
				}

				const orderedMatch = trimmedLine.match(/^(\d+)[\.、]\s+(.*)$/)
				if (orderedMatch) {
					flushParagraph()
					blocks.push({
						type: 'ordered',
						parts: this.parseInlineParts(orderedMatch[2].trim()),
						order: orderedMatch[1]
					})
					lineIndex++
					continue
				}

				const bulletMatch = trimmedLine.match(/^[-*•·]\s+(.*)$/)
				if (bulletMatch) {
					flushParagraph()
					blocks.push({
						type: 'bullet',
						parts: this.parseInlineParts(bulletMatch[1].trim())
					})
					lineIndex++
					continue
				}

				const quoteMatch = trimmedLine.match(/^>\s?(.*)$/)
				if (quoteMatch) {
					flushParagraph()
					blocks.push({
						type: 'quote',
						parts: this.parseInlineParts(quoteMatch[1].trim())
					})
					lineIndex++
					continue
				}

				paragraphBuffer.push(trimmedLine)
				lineIndex++
			}

			flushParagraph()
			if (inCodeBlock) {
				flushCodeBlock()
			}

			return blocks
		},
		goBack() {
			// 返回到mine页面
			uni.navigateBack({
				delta: 1
			})
		},
		
		// 选择图片
		chooseImage() {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					this.tempImagePath = res.tempFilePaths[0]
					// 如果已经有输入文本，直接发送
					if (this.inputMessage.trim()) {
						this.sendMessage()
					}
				}
			})
		},
		
		async sendMessage() {
			if (!this.inputMessage.trim() && !this.tempImagePath) {
				uni.showToast({
					title: '请输入内容或选择图片',
					icon: 'none'
				})
				return
			}
			
			// 添加用户消息
			const userMessage: Message = {
				content: this.inputMessage,
				type: 'user',
				timestamp: Date.now()
			}
			
			// 如果有图片，添加到消息中
			if (this.tempImagePath) {
				userMessage.imageUrl = this.tempImagePath
			}
			
			this.messages.push(userMessage)
			
			// 清空输入框和临时图片路径
			const tempMessage = this.inputMessage
			this.inputMessage = ''
			const tempImage = this.tempImagePath
			this.tempImagePath = ''
			
			// 滚动到底部
			this.scrollToBottom()
			
			try {
				// 显示加载状态
				this.isLoading = true
				
				// 添加一个空的AI回复消息，用于后续流式更新
				const aiMessage: Message = {
					content: '',
					type: 'ai',
					timestamp: Date.now()
				}
				this.messages.push(aiMessage)
				
				// 如果有图片，先上传图片
				if (tempImage) {
					await this.uploadImage(tempImage, tempMessage)
				} else {
					// 创建EventSource获取流式响应
					this.handleStreamResponse(tempMessage)
				}
			} catch (error) {
				uni.showToast({
					title: error.message || '发送失败，请重试',
					icon: 'none'
				})
				// 如果出错，移除空的AI消息
				if (this.messages.length > 0 && this.messages[this.messages.length - 1].content === '') {
					this.messages.pop()
				}
				this.isLoading = false
			}
		},
		
		// 上传图片
		async uploadImage(imagePath: string, message: string) {
			try {
				// 更新AI消息为等待状态
				if (this.messages.length > 0) {
					this.messages[this.messages.length - 1].content = '正在分析图片，请稍候...'
				}
				
				// 显示加载提示
				uni.showLoading({
					title: '正在分析图片...',
					mask: true
				})
				
				// 使用uni.uploadFile上传图片
				uni.uploadFile({
					url: 'http://localhost:8080/deepSeek/imagesQuestion',
					filePath: imagePath,
					name: 'file',
					formData: {
						msg: message
					},
					header: {
						'accessToken': uni.getStorageSync('accessToken') || '',
						'refreshToken': uni.getStorageSync('refreshToken') || ''
					},
					success: (uploadFileRes) => {
						try {
							if (!uploadFileRes || !uploadFileRes.data) {
								throw new Error('响应数据为空')
							}
							const response = typeof uploadFileRes.data === 'object' 
								? uploadFileRes.data 
								: JSON.parse(uploadFileRes.data)
							if (!response || typeof response !== 'object') {
								throw new Error('响应数据格式错误')
							}
							if (response.code === 1) {
								if (!response.data) {
									throw new Error('缺少taskId')
								}
								this.pollImageResult(response.data)
							} else {
								uni.showToast({
									title: response.msg || '图片分析失败',
									icon: 'none'
								})
								this.isLoading = false
							}
						} catch (error) {
							console.error('图片分析失败:', error)
							uni.showToast({
								title: '图片分析失败',
								icon: 'none'
							})
							this.isLoading = false
						}
					},
					fail: (error) => {
						uni.showToast({
							title: '图片上传失败',
							icon: 'none'
						})
						this.isLoading = false
					},
					complete: () => {
						uni.hideLoading()
					}
				})
				
			} catch (error) {
				uni.hideLoading()
				uni.showToast({
					title: '图片上传失败',
					icon: 'none'
				})
				this.isLoading = false
			}
		},
		
		// 轮询获取图片分析结果
		pollImageResult(taskId: string) {
			const self = this
			let retryCount = 0
			const maxRetries = 20 // 最多等待20次，每次1秒
			
			const poll = () => {
				if (retryCount >= maxRetries) {
					uni.showToast({
						title: '获取结果超时',
						icon: 'none'
					})
					self.isLoading = false
					return
				}
				
				uni.request({
					url: `http://localhost:8080/deepSeek/getPictureAns?taskId=${taskId}`,
					method: 'GET',
					header: {
						'accessToken': uni.getStorageSync('accessToken') || '',
						'refreshToken': uni.getStorageSync('refreshToken') || ''
					},
					success: (res) => {
						const response = res.data as any
						if (response.code === 1) {
							// 获取到完整答案后，开始流式输出
							const answer = response.data
							let currentIndex = 0
							const interval = setInterval(() => {
								if (currentIndex < answer.length) {
									// 更新最后一条AI消息的内容
									if (self.messages.length > 0) {
										self.messages[self.messages.length - 1].content = answer.substring(0, currentIndex + 1)
									}
									currentIndex++
									// 滚动到底部
									self.scrollToBottom()
								} else {
									clearInterval(interval)
									self.isLoading = false
								}
							}, 50) // 每50毫秒输出一个字符
						} else if (response.code === 0) {
							// 结果还未准备好，继续轮询
							retryCount++
							setTimeout(poll, 1000)
						} else {
							uni.showToast({
								title: response.msg || '获取结果失败',
								icon: 'none'
							})
							self.isLoading = false
						}
					},
					fail: (error) => {
						uni.showToast({
							title: '获取结果失败',
							icon: 'none'
						})
						self.isLoading = false
					}
				})
			}
			
			// 开始轮询
			poll()
		},
		
		handleStreamResponse(userInput: string) {
			// 重置流式响应
			this.streamResponse = ''
			
			// 构建请求URL（使用GET请求，参数通过params传递）
			const url = `http://localhost:8080/deepSeek/stream?content=${encodeURIComponent(userInput)}&sessionId=${this.sessionId}`
			
			// 创建XMLHttpRequest对象
			const xhr = new XMLHttpRequest()
			xhr.open('GET', url)
			xhr.setRequestHeader('Content-Type', 'application/json')
			xhr.setRequestHeader('Accept', 'text/event-stream')
			
			// 添加身份验证令牌
			const accessToken = uni.getStorageSync('accessToken')
			const refreshToken = uni.getStorageSync('refreshToken')
			if (accessToken) {
				xhr.setRequestHeader('accessToken', accessToken)
			}
			if (refreshToken) {
				xhr.setRequestHeader('refreshToken', refreshToken)
			}
			
			// 存储当前实例的引用
			const self = this
			let responseBuffer = ''
			let lastProcessedLength = 0
			let pendingEventLines: string[] = []

			const appendAssistantContent = (content: string) => {
				if (!content) {
					return
				}

				self.streamResponse += content
				if (self.messages.length > 0) {
					self.messages[self.messages.length - 1].content = self.streamResponse
				}
				self.scrollToBottom()
			}

			const flushPendingEvent = () => {
				if (pendingEventLines.length === 0) {
					return
				}

				const dataContent = pendingEventLines
					.filter(line => line.startsWith('data:'))
					.map(line => line.substring(5).trimStart())
					.join('\n')
					.trim()
				pendingEventLines = []

				if (!dataContent || dataContent === '[DONE]') {
					return
				}

				let jsonData = null
				try {
					jsonData = JSON.parse(dataContent)
				} catch (parseError) {
					console.warn('JSON解析失败，跳过:', dataContent)
					return
				}

				if (!jsonData || typeof jsonData !== 'object') {
					return
				}

				if (!jsonData.choices ||
					!Array.isArray(jsonData.choices) ||
					jsonData.choices.length === 0 ||
					!jsonData.choices[0].delta ||
					jsonData.choices[0].delta.content === undefined) {
					return
				}

				const content = jsonData.choices[0].delta.content
				if (typeof content === 'string' && content.length > 0) {
					appendAssistantContent(content)
				}
			}

			const consumeResponseBuffer = (finalChunk: boolean = false) => {
				while (true) {
					const newlineIndex = responseBuffer.indexOf('\n')
					if (newlineIndex === -1) {
						break
					}

					const rawLine = responseBuffer.substring(0, newlineIndex)
					responseBuffer = responseBuffer.substring(newlineIndex + 1)
					const line = rawLine.replace(/\r$/, '')

					if (!line.trim()) {
						flushPendingEvent()
						continue
					}

					pendingEventLines.push(line)
				}

				if (finalChunk) {
					const tail = responseBuffer.replace(/\r$/, '')
					responseBuffer = ''
					if (tail.trim()) {
						pendingEventLines.push(tail)
					}
					flushPendingEvent()
				}
			}
			
			// 设置响应类型为文本
			xhr.responseType = 'text'
			
			// 处理流式数据
			xhr.onprogress = function() {
				try {
					if (!xhr.responseText) {
						return
					}

					const newData = xhr.responseText.substring(lastProcessedLength)
					lastProcessedLength = xhr.responseText.length

					if (!newData) {
						return
					}

					responseBuffer += newData
					consumeResponseBuffer()
				} catch (error) {
					console.error('流式响应处理失败:', error)
				}
			}
			
			// 请求完成处理
			xhr.onload = function() {
				consumeResponseBuffer(true)
				
				if (xhr.status === 200) {
					// 请求成功完成
					self.isLoading = false
				} else {
					// 请求失败
					uni.showToast({
						title: '获取响应失败',
						icon: 'none'
					})
					self.isLoading = false
				}
			}
			
			// 请求错误处理
			xhr.onerror = function() {
				uni.showToast({
					title: '网络请求失败',
					icon: 'none'
				})
				self.isLoading = false
			}
			
			// 发送请求
			xhr.send()
		},
		
		scrollToBottom() {
			setTimeout(() => {
				this.scrollTop = 9999999
			}, 100)
		},
		
		loadMoreMessages() {
			// 实现加载更多历史消息的逻辑
			console.log('加载更多消息')
		},
		
		// 取消选中图片
		removeImage() {
			this.tempImagePath = ''
		}
	}
}
</script>

