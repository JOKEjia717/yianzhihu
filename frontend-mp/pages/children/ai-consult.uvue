<template>
	<view class="container">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="back-btn" @click="goBack">
				<view class="arrow-box">
					<view class="arrow-left"></view>
				</view>
			</view>
			<text class="title">AI 智能咨询</text>
		</view>
		
		<!-- 聊天内容区域 -->
		<scroll-view class="chat-container" scroll-y="true" :scroll-top="scrollTop" @scrolltoupper="loadMoreMessages">
			<view class="message-list">
				<view v-for="(message, index) in messages" :key="index" class="message-item" :class="message.type">
					<view class="message-content">
						<text class="message-text">{{message.content}}</text>
						<image v-if="message.imageUrl" :src="message.imageUrl" class="message-image" mode="widthFix"></image>
					</view>
				</view>
			</view>
		</scroll-view>
		
		<!-- 底部输入区域 -->
		<view class="input-wrapper">
			<!-- 照片缩略图和删除按钮，放在输入区上方靠左 -->
			<view v-if="tempImagePath" class="thumb-wrapper-outside">
				<image :src="tempImagePath" class="thumb-image"></image>
				<view class="thumb-remove" @click="removeImage">×</view>
			</view>
			<view class="input-area">
				<button class="upload-btn" @click="chooseImage">
					<image src="../../static/images/camera.png" class="camera-icon"></image>
				</button>
				<input 
					class="message-input" 
					type="text" 
					v-model="inputMessage" 
					placeholder="请输入您的问题" 
					@confirm="sendMessage"
				/>
				<button class="send-btn" :disabled="isLoading" @click="sendMessage">
					{{isLoading ? '回复中...' : '发送'}}
				</button>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
interface Message {
	content: string
	type: 'user' | 'ai'
	timestamp: number
	imageUrl?: string
}

export default {
	data() {
		return {
			messages: [] as Message[],
			inputMessage: '',
			scrollTop: 0,
			isLoading: false,
			sessionId: '123', // 固定为123
			streamResponse: '', // 用于存储流式响应
			tempImagePath: '' // 临时存储选中的图片路径
		}
	},
	onLoad() {
		// 添加欢迎消息
		this.messages.push({
			content: '您好！我是您的AI助手，请问有什么可以帮您？',
			type: 'ai',
			timestamp: Date.now()
		})
	},
	methods: {
		goBack() {
			// 返回到mine页面
			uni.navigateBack({
				delta: 1
			})
		},
		
		// 选择图片
		chooseImage() {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res) => {
					this.tempImagePath = res.tempFilePaths[0]
					// 如果已经有输入文本，直接发送
					if (this.inputMessage.trim()) {
						this.sendMessage()
					}
				}
			})
		},
		
		async sendMessage() {
			if (!this.inputMessage.trim() && !this.tempImagePath) {
				uni.showToast({
					title: '请输入内容或选择图片',
					icon: 'none'
				})
				return
			}
			
			// 添加用户消息
			const userMessage: Message = {
				content: this.inputMessage,
				type: 'user',
				timestamp: Date.now()
			}
			
			// 如果有图片，添加到消息中
			if (this.tempImagePath) {
				userMessage.imageUrl = this.tempImagePath
			}
			
			this.messages.push(userMessage)
			
			// 清空输入框和临时图片路径
			const tempMessage = this.inputMessage
			this.inputMessage = ''
			const tempImage = this.tempImagePath
			this.tempImagePath = ''
			
			// 滚动到底部
			this.scrollToBottom()
			
			try {
				// 显示加载状态
				this.isLoading = true
				
				// 添加一个空的AI回复消息，用于后续流式更新
				const aiMessage: Message = {
					content: '',
					type: 'ai',
					timestamp: Date.now()
				}
				this.messages.push(aiMessage)
				
				// 如果有图片，先上传图片
				if (tempImage) {
					await this.uploadImage(tempImage, tempMessage)
				} else {
					// 创建EventSource获取流式响应
					this.handleStreamResponse(tempMessage)
				}
			} catch (error) {
				uni.showToast({
					title: error.message || '发送失败，请重试',
					icon: 'none'
				})
				// 如果出错，移除空的AI消息
				if (this.messages.length > 0 && this.messages[this.messages.length - 1].content === '') {
					this.messages.pop()
				}
				this.isLoading = false
			}
		},
		
		// 上传图片
		async uploadImage(imagePath: string, message: string) {
			try {
				// 更新AI消息为等待状态
				if (this.messages.length > 0) {
					this.messages[this.messages.length - 1].content = '正在分析图片，请稍候...'
				}
				
				// 显示加载提示
				uni.showLoading({
					title: '正在分析图片...',
					mask: true
				})
				
				// 使用uni.uploadFile上传图片
				uni.uploadFile({
					url: 'http://localhost:8080/deepSeek/imagesQuestion',
					filePath: imagePath,
					name: 'file',
					formData: {
						msg: message
					},
					header: {
						'accessToken': uni.getStorageSync('accessToken') || '',
						'refreshToken': uni.getStorageSync('refreshToken') || ''
					},
					success: (uploadFileRes) => {
						try {
							const response = JSON.parse(uploadFileRes.data)
							if (response.code === 1) {
								// 获取到taskid后，开始轮询获取结果
								this.pollImageResult(response.data)
							} else {
								uni.showToast({
									title: response.msg || '图片分析失败',
									icon: 'none'
								})
								this.isLoading = false
							}
						} catch (error) {
							uni.showToast({
								title: '解析响应失败',
								icon: 'none'
							})
							this.isLoading = false
						}
					},
					fail: (error) => {
						uni.showToast({
							title: '图片上传失败',
							icon: 'none'
						})
						this.isLoading = false
					},
					complete: () => {
						uni.hideLoading()
					}
				})
				
			} catch (error) {
				uni.hideLoading()
				uni.showToast({
					title: '图片上传失败',
					icon: 'none'
				})
				this.isLoading = false
			}
		},
		
		// 轮询获取图片分析结果
		pollImageResult(taskId: string) {
			const self = this
			let retryCount = 0
			const maxRetries = 20 // 最多等待20次，每次1秒
			
			const poll = () => {
				if (retryCount >= maxRetries) {
					uni.showToast({
						title: '获取结果超时',
						icon: 'none'
					})
					self.isLoading = false
					return
				}
				
				uni.request({
					url: `http://localhost:8080/deepSeek/getPictureAns?taskId=${taskId}`,
					method: 'GET',
					header: {
						'accessToken': uni.getStorageSync('accessToken') || '',
						'refreshToken': uni.getStorageSync('refreshToken') || ''
					},
					success: (res) => {
						const response = res.data as any
						if (response.code === 1) {
							// 获取到完整答案后，开始流式输出
							const answer = response.data
							let currentIndex = 0
							const interval = setInterval(() => {
								if (currentIndex < answer.length) {
									// 更新最后一条AI消息的内容
									if (self.messages.length > 0) {
										self.messages[self.messages.length - 1].content = answer.substring(0, currentIndex + 1)
									}
									currentIndex++
									// 滚动到底部
									self.scrollToBottom()
								} else {
									clearInterval(interval)
									self.isLoading = false
								}
							}, 50) // 每50毫秒输出一个字符
						} else if (response.code === 0) {
							// 结果还未准备好，继续轮询
							retryCount++
							setTimeout(poll, 1000)
						} else {
							uni.showToast({
								title: response.msg || '获取结果失败',
								icon: 'none'
							})
							self.isLoading = false
						}
					},
					fail: (error) => {
						uni.showToast({
							title: '获取结果失败',
							icon: 'none'
						})
						self.isLoading = false
					}
				})
			}
			
			// 开始轮询
			poll()
		},
		
		handleStreamResponse(userInput: string) {
			// 重置流式响应
			this.streamResponse = ''
			
			// 构建请求URL（使用GET请求，参数通过params传递）
			const url = `http://localhost:8080/deepSeek/stream?content=${encodeURIComponent(userInput)}&sessionId=${this.sessionId}`
			
			// 创建XMLHttpRequest对象
			const xhr = new XMLHttpRequest()
			xhr.open('GET', url)
			xhr.setRequestHeader('Content-Type', 'application/json')
			xhr.setRequestHeader('Accept', 'text/event-stream')
			
			// 添加身份验证令牌
			const accessToken = uni.getStorageSync('accessToken')
			const refreshToken = uni.getStorageSync('refreshToken')
			if (accessToken) {
				xhr.setRequestHeader('accessToken', accessToken)
			}
			if (refreshToken) {
				xhr.setRequestHeader('refreshToken', refreshToken)
			}
			
			// 存储当前实例的引用
			const self = this
			let buffer = ''
			
			// 设置响应类型为文本
			xhr.responseType = 'text'
			
			// 处理流式数据
			xhr.onprogress = function() {
				// 获取新的响应文本
				const newData = xhr.responseText.substring(buffer.length)
				buffer = xhr.responseText
				
				// 处理新数据
				if (newData.trim()) {
					const lines = newData.split('\n')
					for (let i = 0; i < lines.length; i++) {
						const line = lines[i].trim()
						if (line.startsWith('data:')) {
							if (line === 'data:[DONE]') {
								// 流式响应结束
								continue
							}
							try {
								const dataContent = line.substring(5) // 去掉 'data:' 前缀
								const jsonData = JSON.parse(dataContent)
								
								// 提取content
								if (jsonData.choices && 
									jsonData.choices.length > 0 && 
									jsonData.choices[0].delta && 
									jsonData.choices[0].delta.content !== undefined) {
									const content = jsonData.choices[0].delta.content
									// 追加内容到当前响应
									self.streamResponse += content
									
									// 更新最后一条AI消息
									if (self.messages.length > 0) {
										self.messages[self.messages.length - 1].content = self.streamResponse
									}
									
									// 滚动到底部
									self.scrollToBottom()
								}
							} catch (error) {
								console.error('解析响应数据失败:', error)
							}
						}
					}
				}
			}
			
			// 请求完成处理
			xhr.onload = function() {
				if (xhr.status === 200) {
					// 请求成功完成
					self.isLoading = false
				} else {
					// 请求失败
					uni.showToast({
						title: '获取响应失败',
						icon: 'none'
					})
					self.isLoading = false
				}
			}
			
			// 请求错误处理
			xhr.onerror = function() {
				uni.showToast({
					title: '网络请求失败',
					icon: 'none'
				})
				self.isLoading = false
			}
			
			// 发送请求
			xhr.send()
		},
		
		scrollToBottom() {
			setTimeout(() => {
				this.scrollTop = 9999999
			}, 100)
		},
		
		loadMoreMessages() {
			// 实现加载更多历史消息的逻辑
			console.log('加载更多消息')
		},
		
		// 取消选中图片
		removeImage() {
			this.tempImagePath = ''
		}
	}
}
</script>

<style>
.container {
	display: flex;
	flex-direction: column;
	height: 100vh;
	background-color: #F5F7FA;
}

.nav-bar {
	height: 88rpx;
	background-color: #FFFFFF;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
	position: relative;
}

.back-btn {
	position: absolute;
	left: 20rpx;
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
}

.arrow-box {
	width: 50rpx;
	height: 50rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.arrow-left {
	width: 20rpx;
	height: 20rpx;
	border-top: 3rpx solid #333;
	border-left: 3rpx solid #333;
	transform: rotate(-45deg);
}

.title {
	font-size: 32rpx;
	font-weight: 600;
	color: #333333;
}

.chat-container {
	flex: 1;
	padding: 20rpx;
}

.message-list {
	padding-bottom: 20rpx;
}

.message-item {
	margin-bottom: 20rpx;
	display: flex;
	flex-direction: column;
}

.message-item.user {
	align-items: flex-end;
}

.message-item.ai {
	align-items: flex-start;
}

.message-content {
	max-width: 70%;
	padding: 20rpx;
	border-radius: 20rpx;
	word-break: break-all;
}

.user .message-content {
	background-color: #4FD1C5;
}

.ai .message-content {
	background-color: #FFFFFF;
}

.message-text {
	font-size: 28rpx;
	line-height: 1.5;
	color: #333333;
}

.user .message-text {
	color: #FFFFFF;
}

.input-wrapper {
	width: 750rpx;
	background-color: #FFFFFF;
	border-top: 1rpx solid #F0F0F0;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.input-area {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 20rpx 30rpx;
	box-sizing: border-box;
	width: 100%;
	gap: 16rpx;
}

.upload-btn {
	width: 60rpx;
	height: 60rpx;
	background-color: #F5F7FA;
	border-radius: 30rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border: none;
	margin: 0;
	padding: 0;
}

.camera-icon {
	width: 40rpx;
	height: 40rpx;
}

.message-input {
	flex: 1 1 60%;
	min-width: 0;
	height: 80rpx;
	background-color: #F5F7FA;
	border-radius: 40rpx;
	padding: 0 30rpx;
	font-size: 28rpx;
	margin: 0 8rpx;
}

.send-btn {
	width: 120rpx;
	height: 80rpx;
	background: linear-gradient(135deg, #4FD1C5 0%, #4FB8D1 100%);
	color: #FFFFFF;
	border-radius: 40rpx;
	font-size: 28rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border: none;
	box-shadow: 0 2rpx 6rpx rgba(79, 209, 197, 0.3);
	margin: 0;
	padding: 0;
	transition: all 0.3s ease;
}

.message-image {
	max-width: 100%;
	margin-top: 10rpx;
	border-radius: 10rpx;
}

.thumb-wrapper-outside {
	display: flex;
	align-items: flex-start;
	margin-left: 30rpx;
	margin-bottom: 8rpx;
	position: relative;
	width: 140rpx;
	height: 140rpx;
}

.thumb-image {
	width: 140rpx;
	height: 140rpx;
	border-radius: 8rpx;
	object-fit: cover;
	border: 1rpx solid #eee;
}

.thumb-remove {
	position: absolute;
	top: -10rpx;
