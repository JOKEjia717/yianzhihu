	font-size: 24rpx;
	text-align: center;
	line-height: 28rpx;
	box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08);
	cursor: pointer;
	border: 1rpx solid #eee;
	z-index: 2;
}
</style> 