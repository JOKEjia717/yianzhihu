		width: 100%;
		height: 68rpx;
	}

	/* 价格筛选 */
	.price-filter {
		width: 110rpx;
		height: 100%;
		background: #FFFFFF;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #4CAF50;
		border-radius: 34rpx 0 0 34rpx;
	}

	.filter-icon {
		font-size: 20rpx;
		margin-left: 2rpx;
		color: #4CAF50;
	}

	/* 搜索输入框容器 */
	.search-input-wrapper {
		flex: 1;
		height: 100%;
		background: #FFFFFF;
		display: flex;
		align-items: center;
		padding: 0 20rpx;
	}

	/* 搜索输入框 */
	.search-input {
		flex: 1;
		height: 100%;
		font-size: 28rpx;
		color: #4CAF50;
		padding: 0;
		margin: 0;
		background: transparent;
		border: none;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
	}

	.placeholder-style {
		color: #A5D6A7;
		font-size: 28rpx;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
	}

	/* 搜索按钮 */
	.search-btn {
		width: 110rpx;
		height: 100%;
		background: #FFFFFF;
		border-radius: 0 34rpx 34rpx 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #4CAF50;
	}

