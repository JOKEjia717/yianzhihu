		min-height: 100vh;
		background: #F5F9F6;
	}

	/* 顶部导航栏 */
	.nav-bar {
		background: #4CAF50;
		padding: 20rpx 30rpx;
		display: flex;
		align-items: center;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
	}

	.back-icon {
		color: #FFFFFF;
		font-size: 40rpx;
		font-weight: bold;
		margin-right: 20rpx;
	}

	.title {
		color: #FFFFFF;
		font-size: 32rpx;
		font-weight: bold;
	}

	/* 搜索区域 */
	.search-area {
		padding: 20rpx 24rpx;
		background: #4CAF50;
