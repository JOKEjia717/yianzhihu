		flex-direction: column;
		align-items: flex-end;
	}

	.banner-title {
		font-size: 36rpx;
		font-weight: bold;
		margin-bottom: 8rpx;
		display: block;
	}

	.banner-subtitle {
		font-size: 24rpx;
		margin-bottom: 8rpx;
		display: block;
	}

	.banner-tag {
		font-size: 20rpx;
		background: rgba(255, 255, 255, 0.3);
		padding: 4rpx 12rpx;
		border-radius: 10rpx;
		display: inline-block;
	}

	/* 功能图标网格 */
	.function-grid {
		background: #FFFFFF;
		border-radius: 16rpx;
		padding: 24rpx 20rpx;
		margin-bottom: 30rpx;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 24rpx 16rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
	}

	.function-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12rpx;
	}

	.function-item image {
		width: 84rpx;
		height: 84rpx;
		transition: transform 0.3s ease;
	}

	.function-item:active image {
		transform: scale(0.92);
	}

	.function-item text {
		font-size: 24rpx;
		color: #4CAF50;
	}

	/* 商品区域 */
	.section-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #2E7D32;
		margin: 30rpx 0 20rpx;
		padding-left: 10rpx;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20rpx;
	}

	.product-item {
		background: #FFFFFF;
		border-radius: 16rpx;
		overflow: hidden;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
		transition: transform 0.3s ease;
	}

	.product-item:active {
		transform: scale(0.98);
	}

	.product-image {
		width: 100%;
		height: 320rpx;
		object-fit: cover;
	}

	.product-info {
		padding: 16rpx 20rpx;
	}

	.product-name {
		font-size: 28rpx;
		color: #333333;
		margin-bottom: 12rpx;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.product-price {
		display: flex;
		align-items: baseline;
	}

	.price-symbol {
		font-size: 24rpx;
		color: #4CAF50;
	}

	.price-value {
		font-size: 32rpx;
		color: #4CAF50;
		font-weight: bold;
		margin-right: 12rpx;
	}

	.sold-count {
		font-size: 24rpx;
		color: #999999;
	}

	.product-status {
		position: absolute;
		top: 10rpx;
		right: 10rpx;
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		font-size: 20rpx;
	}

	.status-normal {
		background: rgba(76, 175, 80, 0.1);
		color: #4CAF50;
	}

	.status-offline {
		background: rgba(255, 152, 0, 0.1);
		color: #FF9800;
	}

	.status-deleted {
		background: rgba(244, 67, 54, 0.1);
		color: #F44336;
	}

	.add-to-cart {
		position: absolute;
		right: 20rpx;
		bottom: 20rpx;
		width: 48rpx;
		height: 48rpx;
		background: #4CAF50;
		color: #FFFFFF;
		border-radius: 24rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 32rpx;
		font-weight: bold;
		box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
		transition: transform 0.2s ease;
	}

	.add-to-cart:active {
		transform: scale(0.9);
	}

