<template>
	<view class="container">



		<!-- 搜索区域 -->
		<view class="search-area">
			<view class="search-row">
				<!-- 图标 -->
				<view class="search-icon-wrapper">
					<text class="search-icon">🔍</text>
				</view>
				<!-- 搜索输入框 -->
				<view class="search-input-wrapper">
					<input
						class="search-input"
						type="text"
						v-model="searchKey"
						placeholder="搜索商品"
						placeholder-class="placeholder-style"
						@confirm="handleSearch"
					/>
				</view>
				<!-- 价格筛选 -->
				<view class="price-filter" @click="showPriceFilter = true">
					<text>价格</text>
				</view>
			</view>
		</view>

		<!-- 价格筛选弹窗 -->
		<view class="price-filter-mask" v-if="showPriceFilter" @click="showPriceFilter = false">
			<view class="price-filter-content" @click.stop>
				<view class="price-filter-header">
					<text class="price-filter-title">价格区间</text>
					<text class="price-filter-close" @click="showPriceFilter = false">×</text>
				</view>
				<view class="price-range-input">
					<input
						type="number"
						v-model="tempPriceRange.min"
						placeholder="最低价"
					/>
					<text class="price-range-separator">-</text>
					<input
						type="number"
						v-model="tempPriceRange.max"
						placeholder="最高价"
					/>
				</view>
				<view class="price-quick-select">
					<view
						class="price-range-item"
						v-for="(range, index) in priceRanges"
						:key="index"
						:class="{'active': isSelectedRange(range)}"
						@click="selectPriceRange(range)"
					>
						<text>{{range.text}}</text>
					</view>
				</view>
				<view class="price-filter-actions">
					<button class="reset-btn" @click="resetPriceFilter">重置</button>
					<button class="confirm-btn" @click="confirmPriceFilter">确定</button>
				</view>
			</view>
		</view>

		<!-- 内容区域 -->
		<scroll-view class="content" scroll-y @scrolltolower="loadMore">
			<!-- 广告横幅 -->
			<view class="banner" @click="handleBannerClick">
				<image src="/static/images/banner.jpg" mode="aspectFill"></image>
				<view class="banner-overlay"></view>
				<view class="banner-content">
					<text class="banner-subtitle">关爱老人 从心开始</text>
					<text class="banner-title">健康生活 品质保障</text>
					<view class="banner-btn">
						<text>立即选购</text>
					</view>
				</view>
			</view>

			<!-- 功能图标网格 -->
			<view class="function-grid">
				<view class="function-item" v-for="(item, index) in functionItems" :key="index" @click="handleFunction(item.type)">
					<view class="function-icon-wrapper">
						<image :src="item.icon" mode="aspectFit"></image>
					</view>
					<text class="function-name">{{item.name}}</text>
				</view>
			</view>

			<!-- 商品区域标题 -->
			<view class="section-header">
				<view class="section-title">
					<view class="title-line"></view>
					<text>热门商品</text>
					<view class="title-line"></view>
				</view>
			</view>

			<!-- 商品列表 -->
			<view class="product-grid">
				<view class="product-card" v-for="item in products" :key="item.id" @click="goToDetail(item.id)">
					<view class="product-image-wrapper">
						<image class="product-image" :src="item.image || '/static/images/product4.png'" mode="aspectFill"></image>
						<view class="product-status" :class="getStatusClass(item.status)">
							<text>{{getStatusText(item.status)}}</text>
						</view>
						<view class="add-to-cart" 
						      v-if="item.status === 0"
						      @click.stop="handleAddCart(item)">
							<text>+</text>
						</view>
					</view>
					<view class="product-info">
						<view class="product-row">
							<text class="product-name">{{item.name}}</text>
							<text class="price-value">¥{{item.price}}</text>
						</view>
						<text class="sold-count">已售{{item.sold}}</text>
					</view>
				</view>
			</view>

			<!-- 查看更多按钮 -->
			<view class="view-more-area" v-if="products.length < total && !isLoading">
				<button class="view-more-btn" @click="viewMore">查看更多</button>
			</view>

			<!-- 加载更多 -->
			<view class="loading" v-if="isLoading">
				<view class="loading-spinner"></view>
				<text>加载中...</text>
			</view>
			<!-- 已经到底了 -->
			<view class="no-more" v-else-if="products.length >= total && products.length > 0">
				<text>— 已经到底了 —</text>
			</view>
		</scroll-view>

		<!-- 悬浮购物车图标 -->
		<view class="float-cart" @click="goToCart">
			<view class="cart-icon">🛒</view>
		</view>
	</view>
</template>

<script lang="uts">
	interface Category {
		id: string
		name: string
	}

	interface Product {
		id: number
		name: string
		price: number
		stock: number
		image: string | null
		sold: number
		status: number
		createTime: string
	}

	interface FunctionItem {
		icon: string
		name: string
		type: string
	}

	interface SearchParams {
		pageNo: number
		pageSize: number
		itemName?: string
		isAsc?: boolean
		maxPrice?: number
		minPrice?: number
	}

	interface ApiResponse<T> {
		code: number
		msg: string | null
		data: {
			total: number
			pages: number
			list: T[]
		}
	}

	interface PriceRange {
		min: number | null
		max: number | null
		text: string
	}

	export default {
		data() {
			return {
				searchKey: '',
				isLoading: false,
				searchParams: {
					pageNo: 1,
					pageSize: 10,
					itemName: '',
					isAsc: true
				} as SearchParams,
				total: 0,
				products: [] as Product[],
				functionItems: [
					{ icon: '/static/images/icon-popular.png', name: '热门促销', type: 'popular' },
					{ icon: '/static/images/icon-reserve.png', name: '预售', type: 'presale' },
					{ icon: '/static/images/icon-new.png', name: '生鲜', type: 'fresh' },
					{ icon: '/static/images/icon-drink.png', name: '乳品', type: 'milk' },
					{ icon: '/static/images/icon-care.png', name: '护工到家', type: 'nurse-home' },
					{ icon: '/static/images/icon-money.png', name: '服务', type: 'service' },
					{ icon: '/static/images/icon-frsh.png', name: '便利店', type: 'convenience' },
					{ icon: '/static/images/icon-self.png', name: '老人专区', type: 'elder' },
					{ icon: '/static/images/icon-recommend.png', name: '推荐', type: 'recommend' },
					{ icon: '/static/images/icon-more.png', name: '更多', type: 'more' }
				] as FunctionItem[],
				showPriceFilter: false,
				tempPriceRange: {
					min: null,
					max: null
				} as PriceRange,
				priceRanges: [
					{ min: null, max: 100, text: '100元以下' },
					{ min: 100, max: 500, text: '100-500元' },
					{ min: 500, max: 1000, text: '500-1000元' },
					{ min: 1000, max: 2000, text: '1000-2000元' },
					{ min: 2000, max: null, text: '2000元以上' }
				] as PriceRange[]
			}
		},
		onLoad() {
			this.fetchProducts()
		},
		methods: {
			 async handleAddCart(item: Product) {
			    // 检查登录状态
			    const accessToken = uni.getStorageSync('accessToken')
			    const refreshToken = uni.getStorageSync('refreshToken')
			    if (!accessToken || !refreshToken) {
			      uni.showToast({
			        title: '请先登录',
			        icon: 'none'
			      })
			      setTimeout(() => {
			        uni.navigateTo({ url: '/pages/login/login' })
			      }, 1500)
			      return
			    }
			
			    // 构建请求参数
			    const params = {
			      itemId: item.id.toString(),
			      name: item.name,
			      price: item.price.toFixed(2),
			      num: 1 ,// 默认添加1件，可按需调整
				  image:item.image
			    }
			
			    try {
			      const res = await uni.request({
			        url: 'http://localhost:8080/goods/cart/save',
			        method: 'POST',
			        header: {
			          'Content-Type': 'application/json',
			          'accessToken': accessToken,
			          'refreshToken': refreshToken
			        },
			        data: JSON.stringify(params)
			      })
			
			      const response = res.data as ApiResponse<null>
			      if (response.code === 1) {
			        uni.showToast({
			          title: '已加入购物车',
			          icon: 'success'
			        })
			      } else {
			        uni.showToast({
			          title: response.msg || '操作失败',
			          icon: 'none'
			        })
			      }
			    } catch (error) {
			      uni.showToast({
			        title: '网络异常，请稍后重试',
			        icon: 'none'
			      })
			    }
			  },
			async fetchProducts() {
				if (this.isLoading) return
				this.isLoading = true

				try {
					// 构建查询参数
					const queryParams = Object.entries(this.searchParams)
						.filter(([_, value]) => value !== undefined)
						.map(([key, value]) => `${key}=${encodeURIComponent(String(value))}`)
						.join('&')

					// 获取token
					const accessToken = uni.getStorageSync('accessToken')
					const refreshToken = uni.getStorageSync('refreshToken')

					const res = await uni.request({
						url: `http://localhost:8080/goods/search?${queryParams}`,
						method: 'GET',
						header: {
							'accessToken': accessToken,
							'refreshToken': refreshToken
						}
					})

					const response = res.data as ApiResponse<Product>
					if (response.code === 1 && response.data) {
						if (this.searchParams.pageNo === 1) {
							this.products = response.data.list
						} else {
							this.products = [...this.products, ...response.data.list]
						}
						this.total = response.data.total
					} else {
						uni.showToast({
							title: '获取商品列表失败',
							icon: 'none'
						})
					}
				} catch (error) {
					uni.showToast({
						title: '网络请求失败',
						icon: 'none'
					})
				} finally {
					this.isLoading = false
				}
			},
			handleSearch() {
				this.searchParams.pageNo = 1
				this.searchParams.itemName = this.searchKey
				this.fetchProducts()
			},
			handleFunction(type: string) {
				const urlMap: Record<string, string> = {
					'popular': '/pages/shop/popular',
					'presale': '/pages/shop/presale',
					'fresh': '/pages/shop/fresh',
					'milk': '/pages/shop/milk',
					'nurse-home': '/pages/shop/nurse-home',
					'service': '/pages/shop/service',
					'convenience': '/pages/shop/convenience',
					'elder': '/pages/shop/elder',
					'recommend': '/pages/shop/recommend'
				}
				const url = urlMap[type]
				if (url) {
					uni.navigateTo({ url })
				} else {
					uni.showToast({
						title: '功能开发中',
						icon: 'none'
					})
				}
			},
			goToCart() {
				uni.navigateTo({
					url: '/pages/children/cart'
				})
			},
			handleBannerClick() {
				uni.pageScrollTo({
					selector: '.product-grid',
					duration: 300
				})
			},
			viewMore() {
				if (this.isLoading) return
				this.searchParams.pageNo += 1
				this.fetchProducts()
			},
			loadMore() {
				if (this.isLoading) return
				if (this.products.length >= this.total) {
					uni.showToast({
						title: '没有更多商品了',
						icon: 'none'
					})
					return
				}
				this.searchParams.pageNo += 1
				this.fetchProducts()
			},
			goToDetail(id: number) {
				uni.navigateTo({
					url: `/pages/children/product-detail?id=${id}`
				})
			},
			isSelectedRange(range: PriceRange): boolean {
				return this.tempPriceRange.min === range.min && this.tempPriceRange.max === range.max
			},
			selectPriceRange(range: PriceRange) {
				this.tempPriceRange = { ...range }
			},
			resetPriceFilter() {
				this.tempPriceRange.min = null
				this.tempPriceRange.max = null
				this.searchParams.minPrice = undefined
				this.searchParams.maxPrice = undefined
				this.showPriceFilter = false
				this.searchParams.pageNo = 1
				this.fetchProducts()
			},
			confirmPriceFilter() {
				if (this.tempPriceRange.min !== null && this.tempPriceRange.max !== null &&
					this.tempPriceRange.min > this.tempPriceRange.max) {
					uni.showToast({
						title: '价格区间不合法',
						icon: 'none'
					})
					return
				}

				this.searchParams.minPrice = this.tempPriceRange.min ?? undefined
				this.searchParams.maxPrice = this.tempPriceRange.max ?? undefined
				this.searchParams.pageNo = 1
				this.showPriceFilter = false
				this.fetchProducts()
			},
			getStatusClass(status: number): string {
				switch(status) {
					case 0:
						return 'status-normal'
					case 1:
						return 'status-offline'
					case 2:
						return 'status-deleted'
					default:
						return ''
				}
			},
			getStatusText(status: number): string {
				switch(status) {
					case 0:
						return '正常'
					case 1:
						return '下架'
					case 2:
						return '已删除'
					default:
						return ''
				}
			}

		}
	}
</script>

<style>
	.container {
		min-height: 100vh;
		background: #F5F9F6;
	}

	/* 顶部导航栏 */
	.nav-bar {
		background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
		padding: 20rpx 30rpx;
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.2);
	}

	.back-icon {
		color: #FFFFFF;
		font-size: 44rpx;
		font-weight: bold;
	}

	.title {
		color: #FFFFFF;
		font-size: 34rpx;
		font-weight: 600;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 20rpx;
	}

	.cart-icon {
		font-size: 36rpx;
	}

	/* 搜索区域 */
	.search-area {
		padding: 20rpx 30rpx;
		background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
		position: fixed;

		left: 0;
		right: 0;
		z-index: 100;
	}

	.search-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		height: 76rpx;
		background: #FFFFFF;
		border-radius: 38rpx;
		overflow: hidden;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
	}

	/* 图标容器 */
	.search-icon-wrapper {
		width: 88rpx;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #F8FAF8;
	}

	.search-icon {
		font-size: 34rpx;
		color: #4CAF50;
	}

	/* 搜索输入框容器 */
	.search-input-wrapper {
		flex: 1;
		height: 100%;
		display: flex;
		align-items: center;
		padding-right: 16rpx;
	}

	/* 搜索输入框 */
	.search-input {
		flex: 1;
		height: 100%;
		font-size: 28rpx;
		color: #333333;
		padding: 0;
		margin: 0;
		background: transparent;
		border: none;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
	}

	.placeholder-style {
		color: #CCCCCC;
		font-size: 28rpx;
		font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", Arial, sans-serif;
	}

	/* 价格筛选 */
	.price-filter {
		width: 130rpx;
		height: 60rpx;
		margin: 0 8rpx;
		background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #FFFFFF;
		border-radius: 30rpx;
		box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
	}

	.filter-icon {
		font-size: 20rpx;
		margin-left: 6rpx;
		color: #FFFFFF;
	}

	.price-filter:active {
		transform: scale(0.96);
	}

	/* 价格筛选弹窗 */
	.price-filter-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.price-filter-content {
		width: 80%;
		background: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
	}

	.price-filter-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 30rpx;
	}

	.price-filter-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}

	.price-filter-close {
		font-size: 40rpx;
		color: #999999;
		padding: 10rpx;
	}

	.price-range-input {
		display: flex;
		align-items: center;
		gap: 20rpx;
		margin-bottom: 30rpx;
	}

	.price-range-input input {
		flex: 1;
		height: 80rpx;
		border: 2rpx solid #E0E0E0;
		border-radius: 10rpx;
		padding: 0 20rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.price-range-separator {
		color: #999999;
		font-size: 28rpx;
	}

	.price-quick-select {
		display: flex;
		flex-wrap: wrap;
		gap: 20rpx;
		margin-bottom: 30rpx;
	}

	.price-range-item {
		padding: 15rpx 30rpx;
		border-radius: 30rpx;
		background: #F5F9F6;
		font-size: 24rpx;
		color: #4CAF50;
	}

	.price-range-item.active {
		background: #4CAF50;
		color: #FFFFFF;
	}

	.price-filter-actions {
		display: flex;
		gap: 20rpx;
	}

	.price-filter-actions button {
		flex: 1;
		height: 80rpx;
		border-radius: 40rpx;
		font-size: 28rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.reset-btn {
		background: #F5F9F6;
		color: #4CAF50;
		border: 2rpx solid #4CAF50;
	}

	.confirm-btn {
		background: #4CAF50;
		color: #FFFFFF;
	}

	/* 内容区域 */
	.content {
		margin-top: 15%;
		padding: 20rpx;
		box-sizing: border-box;
	}

	/* 广告横幅 */
	.banner {
		position: relative;
		height: 320rpx;
		border-radius: 20rpx;
		overflow: hidden;
		margin-bottom: 30rpx;
		box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
	}

	.banner image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.banner-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, rgba(76, 175, 80, 0.7) 0%, rgba(56, 142, 60, 0.5) 100%);
	}

	.banner-content {
		position: absolute;
		right: 40rpx;
		top: 50%;
		transform: translateY(-50%);
		color: #FFFFFF;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		z-index: 10;
	}

	.banner-subtitle {
		font-size: 26rpx;
		margin-bottom: 12rpx;
		opacity: 0.9;
	}

	.banner-title {
		font-size: 44rpx;
		font-weight: bold;
		margin-bottom: 20rpx;
	}

	.banner-btn {
		background: #FFFFFF;
		padding: 16rpx 40rpx;
		border-radius: 30rpx;
		box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
	}

	.banner-btn text {
		font-size: 28rpx;
		color: #4CAF50;
		font-weight: 500;
	}

	.banner:active {
		transform: scale(0.98);
	}

	/* 功能图标网格 */
	.function-grid {
		background: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx 20rpx;
		margin-bottom: 30rpx;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 30rpx 16rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
	}

	.function-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16rpx;
	}

	.function-icon-wrapper {
		width: 100rpx;
		height: 100rpx;
		background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
		border-radius: 24rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s ease;
