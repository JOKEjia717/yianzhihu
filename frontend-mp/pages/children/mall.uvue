		display: flex;
		align-items: center;
		justify-content: center;
	}

	.price-filter-content {
		width: 80%;
		background: #FFFFFF;
		border-radius: 20rpx;
		padding: 30rpx;
	}

	.price-filter-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 30rpx;
	}

	.price-filter-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}

	.price-filter-close {
		font-size: 40rpx;
