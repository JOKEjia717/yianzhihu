    transition: all 0.3s ease;
    
   /* &:active {
      transform: scale(0.98);
      box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.2);
    } */
  }

/* 骨架屏样式 */
.skeleton-container {
  padding: 24rpx;
  
 
}
 .skeleton-item {
    display: flex;
    margin-bottom: 24rpx;
    background: white;
    border-radius: 20rpx;
    padding: 28rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
    
   
    
   
    
   
  }
  .skeleton-info {
    flex: 1;
    margin-left: 28rpx;
  }
  .skeleton-line {
    height: 36rpx;
