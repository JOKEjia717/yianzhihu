<template>
  <view class="container">
    <!-- 顶部导航栏 -->
    <view class="header">
      <text class="back-icon" @click="navigateBack">‹</text>
      <text class="title">购物车</text>
      <text class="edit-btn" @click="toggleEditMode">{{ isEditMode ? '完成' : '编辑' }}</text>
    </view>

    <!-- 主要内容区域 -->
    <scroll-view class="content" scroll-y>
      <!-- 加载状态 -->
      <view v-if="loading" class="skeleton-container">
        <view v-for="i in 3" :key="i" class="skeleton-item">
          <view class="skeleton-image"></view>
          <view class="skeleton-info">
            <view class="skeleton-line"></view>
            <view class="skeleton-line short"></view>
            <view class="skeleton-line short"></view>
          </view>
        </view>
      </view>

      <!-- 空购物车状态 -->
      <view v-else-if="cartItems.length === 0" class="empty-cart">
        <image src="/static/images/empty-cart.png" class="empty-image" mode="aspectFit"></image>
        <text class="empty-text">购物车还是空的，去添加商品吧~</text>
        <button class="browse-btn" @click="navigateToMall">去购物</button>
      </view>

      <block v-else>
        <!-- 老人选择区域 -->
        <view class="elder-selection">
          <text class="section-title">为谁购买</text>
          <view class="elder-scroll">
            <view class="elder-list">
              <view 
                v-for="elder in elderList" 
                :key="elder.elderId"
                class="elder-card"
                :class="{'selected': selectedElderId === elder.elderId}"
                @tap="selectElder(elder.elderId)"
              >
                <image class="elder-avatar" :src="elder.photo || '/static/images/default-avatar.png'" mode="aspectFill"></image>
                <view class="elder-info">
                  <text class="elder-name">{{elder.name}}</text>
                  <text class="elder-age">{{elder.age}}岁</text>
                </view>
                <view class="select-mark" v-if="selectedElderId === elder.elderId">✓</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 商品列表 -->
        <view v-for="(item, index) in cartItems" 
          :key="item.id"
          class="cart-item"
          :class="{'item-animation': animateItem === item.id}"
        >
          <!-- 左侧：图片 -->
          <image 
            class="item-image" 
            :src="item.image || '/static/images/product4.png'"
            mode="aspectFill"
          ></image>
          
          <!-- 右侧：商品信息 -->
          <view class="item-right">
            <text class="item-name clamp-2">{{item.name}}</text>
            <view class="price-section">
              <text class="item-price">¥{{item.price.toFixed(2)}}</text>
            </view>
            <view class="action-bar">
              <view 
                v-if="isEditMode"
                class="delete-btn"
                @tap="deleteItem(item.id)"
              >删除</view>
              <view class="quantity-control">
                <view 
                  class="control-btn" 
                  @tap="updateQuantity(index, -1)"
                >-</view>
                <input 
                  class="quantity-input" 
                  type="number" 
                  v-model="item.quantity" 
                  @blur="validateQuantity(index)"
                />
                <view 
                  class="control-btn"
                  @tap="updateQuantity(index, 1)"
                >+</view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <!-- 底部结算栏 -->
    <view class="bottom-bar-taobao">
      <view class="bottom-bar-content">
        <view class="total-section-taobao">
            <text class="total-label-taobao">¥{{totalPrice.toFixed(2)}}</text>
            <text class="total-desc-taobao">共{{cartItems.length}}件商品</text>
          </view>
        <button 
          class="checkout-btn-taobao"
          :disabled="!selectedElderId || cartItems.length === 0"
          @tap="handleCheckout"
        >
          结算{{cartItems.length > 0 ? `(${cartItems.length})` : ''}}
        </button>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
interface CartItem {
  id: number
  itemId: string
  name: string
  price: number
  image: string | null
  quantity: number
}

interface Elder {
  elderId: string
  name: string
  age: number
  photo: string
  gender: number
}

export default {
  data() {
    return {
      cartItems: [] as CartItem[],
      loading: false,
      isEditMode: false,
      animateItem: -1,
      elderList: [] as Elder[],
      selectedElderId: '',
      elderIndex: 0,
      selectedElderName: '',
      colorList: ['#F1FAF5', '#E6F9F0', '#F9F6E6', '#F6F1FA', '#F1F6FA', '#F9F1F1', '#F1F9F3', '#F1F3F9']
    }
  },

  onShow() {
    this.loadCartData()
    this.loadElderData()
  },

  computed: {
    totalPrice(): number {
      return this.cartItems.reduce((total, item) => total + item.price * item.quantity, 0)
    }
  },

  methods: {
    navigateBack() {
      uni.navigateBack({
        delta: 1,
        fail: () => {
          uni.switchTab({ url: '/pages/children/mine' })
        }
      })
    },

    toggleEditMode() {
      this.isEditMode = !this.isEditMode
    },

    navigateToMall() {
      uni.switchTab({ url: '/pages/children/mall' })
    },

    async loadCartData() {
      try {
        this.loading = true
        
        // 检查登录状态
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        if (!accessToken || !refreshToken) {
          uni.showToast({ title: '请先登录', icon: 'none' })
          setTimeout(() => uni.navigateTo({ url: '/pages/login/login' }), 1500)
          return
        }

        // 请求购物车数据
        const res = await uni.request({
          url: 'http://localhost:8080/goods/cart/get',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        // 处理响应数据
        if (res.statusCode === 200) {
          const response = res.data as any
          if (response.code === 1) {
            this.cartItems = response.data.map((item: any) => ({
              id: item.id,
              itemId: String(item.itemId),
              name: item.name,
              price: item.price,
              image: item.image,
              quantity: item.num
            }))
          } else {
            uni.showToast({ title: response.msg || '获取数据失败', icon: 'none' })
          }
        } else {
          uni.showToast({ title: '网络请求失败', icon: 'none' })
        }
      } catch (error) {
        uni.showToast({ title: '获取数据失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },

    async loadElderData() {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        const res = await uni.request({
          url: 'http://localhost:8080/elder/getByChildrenId',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        if (res.statusCode === 200) {
          const response = res.data as any
          if (response.code === 1 && response.data && response.data.length > 0) {
            this.elderList = response.data
          } else {
            // 使用模拟数据
            this.loadMockElderData()
          }
        } else {
          // 使用模拟数据
          this.loadMockElderData()
        }
      } catch (error) {
        // 使用模拟数据
        this.loadMockElderData()
      }
      
      // 如果有老人数据且未选择老人，默认选择第一个
      if (this.elderList.length > 0 && !this.selectedElderId) {
        this.selectElder(this.elderList[0].elderId)
      }
    },
    
    loadMockElderData() {
      this.elderList = [
        {
          elderId: '1',
          name: '王爷爷',
          age: 72,
          photo: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/elder-avatar/elder-avatar1.png',
          gender: 1
        },
        {
          elderId: '2',
          name: '李奶奶',
          age: 68,
          photo: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/elder-avatar/elder-avatar2.png',
          gender: 2
        },
        {
          elderId: '3',
          name: '张爷爷',
          age: 75,
          photo: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/elder-avatar/elder-avatar.png',
          gender: 1
        },
        {
          elderId: '4',
          name: '刘奶奶',
          age: 70,
          photo: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/elder-avatar/elder-avatar3.png',
          gender: 2
        },
        {
          elderId: '5',
          name: '陈爷爷',
          age: 78,
          photo: 'https://zhihu7.oss-cn-beijing.aliyuncs.com/yianzhihu/elder-avatar/elder-avatar4.png',
          gender: 1
        }
      ]
    },

    selectElder(elderId: string) {
      this.selectedElderId = elderId
      const elder = this.elderList.find(e => e.elderId === elderId)
      if (elder) {
        this.selectedElderName = elder.name
        // 选择老人后刷新购物车数据
        this.loadCartData()
      }
    },

    validateQuantity(index: number) {
      if (this.cartItems[index].quantity < 1) {
        this.cartItems[index].quantity = 1
      }
    },

    async updateQuantity(index: number, delta: number) {
      const item = this.cartItems[index]
      
      try {
        // 先更新UI，提高响应速度
        this.cartItems[index].quantity += delta
        this.animateItem = item.id
        setTimeout(() => this.animateItem = -1, 300)
        
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        const url = delta > 0 
          ? `http://localhost:8080/goods/cart/add?id=${encodeURIComponent(item.itemId)}`
          : `http://localhost:8080/goods/cart/less?id=${encodeURIComponent(item.itemId)}`
        
        const res = await uni.request({
          url: url,
          method: 'PUT',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        if (res.statusCode === 200) {
          const response = res.data as any
          if (response.code !== 1) {
            // 如果请求失败，回滚UI更新
            this.cartItems[index].quantity -= delta
            uni.showToast({ title: response.msg || '操作失败', icon: 'none' })
          } else {
            // 请求成功后重新获取购物车数据
            await this.loadCartData()
          }
        } else {
          // 如果请求失败，回滚UI更新
          this.cartItems[index].quantity -= delta
          uni.showToast({ title: '网络请求失败', icon: 'none' })
        }
      } catch (error) {
        // 如果请求失败，回滚UI更新
        this.cartItems[index].quantity -= delta
        uni.showToast({ title: '操作失败', icon: 'none' })
      }
    },

    async deleteItem(id: number) {
      try {
        uni.showLoading({ title: '删除中...' })
        
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        const res = await uni.request({
          url: `http://localhost:8080/goods/cart/delete?id=${id}&elderId=${this.selectedElderId}`,
          method: 'DELETE',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        if (res.statusCode === 200) {
          const response = res.data as any
          if (response.code === 1) {
            // 删除成功，更新本地数据
            this.cartItems = this.cartItems.filter(item => item.id !== id)
            uni.showToast({ title: '删除成功', icon: 'success' })
          } else {
            uni.showToast({ title: response.msg || '删除失败', icon: 'none' })
          }
        } else {
          uni.showToast({ title: '网络请求失败', icon: 'none' })
        }
      } catch (error) {
        uni.showToast({ title: '删除失败', icon: 'none' })
      } finally {
        uni.hideLoading()
      }
    },

    async handleCheckout() {
      if (!this.selectedElderId) {
        uni.showToast({ title: '请先选择老人', icon: 'none' })
        return
      }

      if (this.cartItems.length === 0) {
        uni.showToast({ title: '购物车为空', icon: 'none' })
        return
      }

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        const orderDtolist = this.cartItems.map(item => ({
          itemId: item.itemId,
          totalPrice: item.price * item.quantity,
          name: item.name,
          image: item.image || '',
          num: item.quantity
        }))

        // 先调用下单接口
        const res = await uni.request({
          url: 'http://localhost:8080/goods/order/add',
          method: 'POST',
          header: {
            'Content-Type': 'application/json',
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          data: {
            elderId: this.selectedElderId,
            orderDtolist
          }
        })

        if (res.statusCode === 200 && res.data && res.data.code === 1) {
          // 保存订单ID到本地存储
          const orderId = res.data.data
          console.log('创建订单成功，订单ID:', orderId)
          uni.setStorageSync('orderId', orderId)
          
          // 下单成功，存储订单信息并跳转支付
          uni.setStorageSync('orderInfo', {
            items: orderDtolist,
            totalAmount: this.totalPrice,
            elderId: this.selectedElderId,
            elderName: this.selectedElderName
          })
          uni.navigateTo({ url: '/pages/children/payment' })
        } else {
          uni.showToast({ title: res.data.msg || '下单失败', icon: 'none' })
        }
      } catch (error) {
        uni.showToast({ title: '创建订单失败', icon: 'none' })
      }
    }
  }
}
</script>

<style>
.container {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

.header {
  position: relative;
  background: linear-gradient(135deg, #4CAF50 0%, #45A049 100%);
  height: 104rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.15);
  z-index: 20;
  box-sizing: border-box;
}

.back-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transition: all 0.2s;
}

.back-icon:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  white-space: nowrap;
  padding: 0 16rpx;
}

.edit-btn {
  font-size: 28rpx;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-weight: 500;
  transition: all 0.2s;
  flex-shrink: 0;
  white-space: nowrap;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 老人选择区域 */
.elder-selection {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #4CAF50 0%, #45A049 100%);
  margin-right: 12rpx;
  border-radius: 4rpx;
}

.elder-scroll {
  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  height: 300rpx;
}

.elder-list {
  display: flex;
  flex-direction: row;
  padding: 8rpx 24rpx;
  width: max-content;
}

.elder-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
  margin-right: 20rpx;
  transition: all 0.3s ease;
  position: relative;
  width: 280rpx;
  border: 3rpx solid transparent;
  flex-shrink: 0;
}

.elder-card.selected {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-color: #4CAF50;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.elder-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.elder-info {
  flex: 1;
}

.elder-name {
  font-size: 28rpx;
  color: #2C3E50;
  font-weight: 600;
  margin-bottom: 4rpx;
  display: block;
}

.elder-age {
  font-size: 24rpx;
  color: #7F8C8D;
  display: block;
}

.select-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45A049 100%);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

/* 商品项 - 左右分栏布局 */
.cart-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  gap: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

.item-animation {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F5F7FA;
  object-fit: cover;
  flex-shrink: 0;
  flex-grow: 0;
  margin-left:20px;
}

.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 180rpx;
}

.item-name {
  font-size: 30rpx;
  color: #2C3E50;
  line-height: 1.4;
  font-weight: 600;
  margin-bottom: 12rpx;
  text-align:center;
}

.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-section {
  margin-bottom: 12rpx;
}

.item-price {
  color: #E74C3C;
  font-size: 38rpx;
  font-weight: 700;
  text-align:center;
}

.action-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.quantity-control {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 4rpx;
  border: none;
}

.control-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #2C3E50;
  margin: 0;
  box-shadow: none;
  transition: all 0.2s;
  font-weight: 600;
}

.control-btn:active {
  background: #4CAF50;
  border-color: #4CAF50;
  color: #FFFFFF;
  transform: scale(0.95);
}

.quantity-input {
  width: 72rpx;
  height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
  border: none;
  margin: 0;
  color: #2C3E50;
  font-weight: 700;
}

.delete-btn {
  color: #E74C3C;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #FDEDEC;
  border: none;
  transition: all 0.2s ease;
  font-weight: 600;
}

.delete-btn:active {
  color: #FFFFFF;
  background: #E74C3C;
  transform: scale(0.95);
}

/* 底部结算栏 */
.bottom-bar-taobao {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 30;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.bottom-bar-content {
  width: 100%;
  max-width: 750rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  flex-wrap: nowrap;
}

.total-section-taobao {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.total-label-taobao {
  color: #E74C3C;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.total-desc-taobao {
  font-size: 24rpx;
  color: #7F8C8D;
  margin-top: 4rpx;
  font-weight: 500;
}

.checkout-btn-taobao {
  background: linear-gradient(135deg, #4CAF50 0%, #45A049 100%) !important;
  color: #FFFFFF !important;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
