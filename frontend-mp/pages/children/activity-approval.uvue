  font-size: 32rpx;
  color: #fff;
  margin-right: 4rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.elder-info {
  min-width: 150rpx;
  margin-left: auto;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  color: #fff;
  font-size: 28rpx;
  text-align: right;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.content {
  padding: 30rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-top: 20rpx;
}

.requests-list {
  margin-top: 20rpx;
}

.request-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #e8f0ef;
}

.request-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8f0ef;
}

.activity-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-pending {
  background-color: #f39c12;
}

.status-approved {
  background-color: #2ecc71;
}

.status-rejected {
  background-color: #e74c3c;
}

.request-details {
  margin-bottom: 20rpx;
}

.detail-item {
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.detail-label {
  font-size: 28rpx;
  color: #666;
  min-width: 160rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.action-buttons {
  display: flex;
  flex-direction: row;
  margin: auto;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8f0ef;
}

.btn {
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #fff;
  border: none;
}

.reject {
  background-color: #e74c3c;
}

