  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #7AB8B3 0%, #5A9A95 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  height: 88rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

