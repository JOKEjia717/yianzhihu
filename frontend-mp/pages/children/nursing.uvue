<template>
  <view class="page">
    <!-- 顶部标题栏 -->
    <view class="header">
      <view class="back-btn" @click="handleBack">
        <text class="back-icon">←</text>
        <text class="back-text"></text>
      </view>
      <text class="title" @click="goToActivityApproval">护理日常</text>
      <view class="dropdown">
        <picker 
          :range="elderNames" 
          @change="handleElderChange" 
          :value="currentElderIndex"
        >
          <view class="picker-content">
            <text class="picker-text">{{ elderNames[currentElderIndex] || '选择老人' }}</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 主要内容区域 -->
    <view class="content">
      <!-- 顶部轮播图 -->
      <swiper class="banner-swiper" 
        :autoplay="true" 
        :interval="3000" 
        :duration="500"
        circular>
        <swiper-item>
          <image src="/static/images/banner1.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
        <swiper-item>
          <image src="/static/images/banner2.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
        <swiper-item>
          <image src="/static/images/banner3.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
      </swiper>

      <!-- 每日三餐 -->
      <view class="section">
        <view class="section-header">
          <picker mode="date" :value="mealDate" @change="handleMealDateChange">
            <view class="date-picker">
              <text>{{ mealDate || '选择日期' }}</text>
            </view>
          </picker>
          <text class="section-title">每日三餐</text>
        </view>
        <view class="section-content">
          <swiper v-if="mealData.breakfastPhotos || mealData.lunchPhotos || mealData.dinnerPhotos" class="meal-swiper" indicator-dots>
            <swiper-item v-if="mealData.breakfastPhotos">
              <image 
                :src="mealData.breakfastPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.breakfastPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">早餐：</text>
                <text class="meal-description">{{ mealData.breakfastDesc || '小米粥一碗、鸡蛋一个' }}</text>
              </view>
            </swiper-item>
            <swiper-item v-if="mealData.lunchPhotos">
              <image 
                :src="mealData.lunchPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.lunchPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">午餐：</text>
                <text class="meal-description">{{ mealData.lunchDesc || '米饭一碗、清蒸鱼、炒青菜' }}</text>
              </view>
            </swiper-item>
            <swiper-item v-if="mealData.dinnerPhotos">
              <image 
                :src="mealData.dinnerPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.dinnerPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">晚餐：</text>
                <text class="meal-description">{{ mealData.dinnerDesc || '豆腐汤、馒头一个' }}</text>
              </view>
            </swiper-item>
          </swiper>
          <view v-else-if="mealData.mealRecords && mealData.mealRecords.length > 0" class="record-list">
            <view v-for="(record, index) in mealData.mealRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 衣物穿戴 -->
      <view class="section">
        <view class="section-header">
          <picker mode="date" :value="clothingDate" @change="handleClothingDateChange">
            <view class="date-picker">
              <text>{{ clothingDate || '选择日期' }}</text>
            </view>
          </picker>
          <text class="section-title">衣物穿戴</text>
        </view>
        <view class="section-content">
          <image 
            v-if="clothingData.clothingPhotos" 
            :src="clothingData.clothingPhotos" 
            mode="aspectFill" 
            class="clothing-image"
            @click="previewImage(clothingData.clothingPhotos)"
          ></image>
          <view v-else-if="clothingData.clothingRecords && clothingData.clothingRecords.length > 0" class="record-list">
            <view v-for="(record, index) in clothingData.clothingRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 住宿环境 -->
      <view class="section">
        <view class="section-header">
          <picker mode="date" :value="livingDate" @change="handleLivingDateChange">
            <view class="date-picker">
              <text>{{ livingDate || '选择日期' }}</text>
            </view>
          </picker>
          <text class="section-title">住宿环境</text>
        </view>
        <view class="section-content">
          <image 
            v-if="livingData.lodgingPhotos" 
            :src="livingData.lodgingPhotos" 
            mode="aspectFill" 
            class="living-image"
            @click="previewImage(livingData.lodgingPhotos)"
          ></image>
          <view v-else-if="livingData.livingRecords && livingData.livingRecords.length > 0" class="record-list">
            <view v-for="(record, index) in livingData.livingRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 健康状态 -->
      <view class="section">
        <view class="section-header">
          <picker 
            :range="healthIds.map(id => `第${id}次`)" 
            :value="currentHealthIndex"
            @change="handleHealthChange"
          >
            <view class="date-picker">
              <text>{{ healthIds.length > 0 ? `第${healthIds[currentHealthIndex]}次` : '暂无记录' }}</text>
            </view>
          </picker>
          <text class="section-title">健康状态</text>
        </view>
        <view class="section-content">
          <view v-if="healthData.assessDate" class="health-info">
            <view class="health-item">
              <text class="health-label">评估日期</text>
              <text class="health-value">{{ healthData.assessDate.split('T')[0] }}</text>
            </view>
            <view class="health-item">
              <text class="health-label">健康报告</text>
              <text class="health-value">{{ healthData.report }}</text>
            </view>
            <view class="health-item">
              <text class="health-label">护理建议</text>
              <text class="health-value">{{ healthData.caretakerComment }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>
    </view>

    <!-- 底部导航栏 -->
    
  </view>
</template>

<script lang="uts">
interface Elder {
  elderId: string
  caretakerId: string
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string
  photo: string
  childrenId: number
  isEnable: number
}

interface DailyData {
  dailyId: string
  elderId: string
  caretakerId: string
  date: string
  breakfastPhotos: string
  lunchPhotos: string
  dinnerPhotos: string
  lodgingPhotos: string
  clothingPhotos: string
  aiComment: string | null
  childrenId: string
  deanId: string
}

interface ApiResponse {
  code: number
  msg: string | null
  data: Elder[] | DailyData
}

export default {
  data() {
    return {
      elders: [] as Elder[],
      elderNames: [] as string[],
      currentElderIndex: 0,
      selectedElderId: '',
      selectedChildrenId: '',
      deanId: '',
      nurseInfo: {
        name: '',
        avatar: '',
        phone: '',
        specialty: ''
      },
      mealDate: '',
      clothingDate: '',
      livingDate: '',
      mealData: {} as DailyData,
      clothingData: {} as DailyData,
      livingData: {} as DailyData,
      currentDailyId: '',
      healthIds: [] as string[],
      currentHealthIndex: 0,
      healthData: {
        healthId: null,
        assessDate: '',
        report: '',
        caretakerComment: '',
        number: null
      }
    }
  },
  onLoad() {
    const userInfo = uni.getStorageSync('userInfo')
    if (userInfo) {
      this.deanId = userInfo.deanId
      this.nurseInfo = {
        name: userInfo.name,
        avatar: userInfo.avatar,
        phone: userInfo.phone,
        specialty: userInfo.specialty
      }
    }
    this.initData()
  },
  methods: {
    async initData() {
      try {
        this.setDefaultDates()
        await this.fetchElders()
      } catch (error) {
        console.error('初始化数据失败:', error)
      }
    },
    setDefaultDates() {
      const today = new Date()
      const year = today.getFullYear()
      const month = String(today.getMonth() + 1).padStart(2, '0')
      const day = String(today.getDate()).padStart(2, '0')
      const todayStr = `${year}-${month}-${day}`
      
      this.mealDate = todayStr
      this.clothingDate = todayStr
      this.livingDate = todayStr
    },
    async fetchElders() {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          uni.redirectTo({
            url: '/pages/nurse/login'
          })
          return
        }

        uni.showLoading({
          title: '加载中...'
        })

        console.log('开始获取老人列表')

        const result = await uni.request({
          url: 'http://localhost:8080/elder/getByChildrenId',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        console.log('老人列表响应:', result)

        uni.hideLoading()

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data && response.data.length > 0) {
          this.elders = response.data as Elder[]
          this.elderNames = this.elders.map(elder => elder.name)
          
          this.selectedElderId = this.elders[0].elderId
          this.selectedChildrenId = this.elders[0].childrenId.toString()
          
          console.log('已选择老人:', this.selectedElderId)
          
          // 获取其他数据
          await this.fetchDailyData('meal')
          await this.fetchDailyData('clothing')
          await this.fetchDailyData('living')
          await this.fetchHealthIds()
        } else {
          console.log('使用模拟老人数据')
          
          // 使用模拟数据
          this.elders = [
            {
              elderId: '1',
              childrenId: 1,
              name: '张爷爷',
              age: 75,
              gender: '男',
              avatar: '',
              phone: '13800138001',
              address: '幸福养老院 3号楼 201室',
              createdAt: '2024-01-15',
              updatedAt: '2024-01-15'
            },
            {
              elderId: '2',
              childrenId: 1,
              name: '李奶奶',
              age: 72,
              gender: '女',
              avatar: '',
              phone: '13900139002',
              address: '幸福养老院 3号楼 202室',
              createdAt: '2024-01-16',
              updatedAt: '2024-01-16'
            }
          ]
          this.elderNames = this.elders.map(elder => elder.name)
          
          this.selectedElderId = this.elders[0].elderId
          this.selectedChildrenId = this.elders[0].childrenId.toString()
          
          // 获取其他数据
          await this.fetchDailyData('meal')
          await this.fetchDailyData('clothing')
          await this.fetchDailyData('living')
          await this.fetchHealthIds()
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    async fetchDailyData(type: string) {
      if (!this.selectedElderId) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        let date = ''
        switch(type) {
          case 'meal':
            date = this.mealDate
            break
          case 'clothing':
            date = this.clothingDate
            break
          case 'living':
            date = this.livingDate
            break
        }

        const result = await uni.request({
          url: 'http://localhost:8080/daily/day',
          method: 'POST',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json'
          },
          data: {
            date: date,
            elderId: this.selectedElderId
          }
        })

        const response = result.data as ApiResponse
        // 只有当接口成功返回且有有效数据时才使用接口数据
        const hasValidData = response.code === 1 && 
                            response.data && 
                            ((type === 'meal' && response.data.mealRecords && response.data.mealRecords.length > 0) ||
                             (type === 'clothing' && response.data.clothingRecords && response.data.clothingRecords.length > 0) ||
                             (type === 'living' && response.data.livingRecords && response.data.livingRecords.length > 0))
        
        if (hasValidData) {
          const dailyData = response.data as DailyData
          // 保存 dailyId
          this.currentDailyId = dailyData.dailyId
          
          switch(type) {
            case 'meal':
              this.mealData = dailyData
              break
            case 'clothing':
              this.clothingData = dailyData
              break
            case 'living':
              this.livingData = dailyData
              break
          }
        } else {
          console.log(`使用${type}模拟数据`)
          const mealRecords = [
            { time: '08:00', content: '早餐：小米粥、鸡蛋、馒头' },
            { time: '12:00', content: '午餐：红烧肉、清炒青菜、米饭' },
            { time: '18:00', content: '晚餐：清蒸鱼、豆腐汤、米饭' }
          ]
          const clothingRecords = [
            { time: '07:30', content: '今日穿着：长袖衬衫+长裤，外套一件' },
            { time: '20:00', content: '夜间穿着：棉质睡衣一套' }
          ]
          const livingRecords = [
            { time: '08:00', content: '房间温度：24°C，湿度：55%' },
            { time: '14:00', content: '通风换气：已完成，时长30分钟' },
            { time: '18:00', content: '房间清洁：已完成' }
          ]
          
          const mockData: DailyData = {
            dailyId: 'mock-' + Date.now(),
            elderId: this.selectedElderId,
            mealRecords: type === 'meal' ? mealRecords : [],
            clothingRecords: type === 'clothing' ? clothingRecords : [],
            livingRecords: type === 'living' ? livingRecords : [],
            date: date,
            breakfastPhotos: '/static/images/breakfast.png',
            lunchPhotos: '/static/images/lunch.png',
            dinnerPhotos: '/static/images/dinner.png',
            clothingPhotos: '/static/images/clothing.jpg',
            roomPhotos: '/static/images/room.jpg'
          }
          
          switch(type) {
            case 'meal':
              this.mealData = mockData
              break
            case 'clothing':
              this.clothingData = mockData
              break
            case 'living':
              this.livingData = mockData
              break
          }
          this.currentDailyId = mockData.dailyId
        }
      } catch (error) {
        console.error('获取日常数据失败:', error)
        console.log(`使用${type}模拟数据`)
        const mealRecords = [
          { time: '08:00', content: '早餐：小米粥、鸡蛋、馒头' },
          { time: '12:00', content: '午餐：红烧肉、清炒青菜、米饭' },
          { time: '18:00', content: '晚餐：清蒸鱼、豆腐汤、米饭' }
        ]
        const clothingRecords = [
          { time: '07:30', content: '今日穿着：长袖衬衫+长裤，外套一件' },
          { time: '20:00', content: '夜间穿着：棉质睡衣一套' }
        ]
        const livingRecords = [
          { time: '08:00', content: '房间温度：24°C，湿度：55%' },
          { time: '14:00', content: '通风换气：已完成，时长30分钟' },
          { time: '18:00', content: '房间清洁：已完成' }
        ]
        
        switch(type) {
          case 'meal':
            this.mealData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords, clothingRecords: [], livingRecords: [], date: this.mealDate }
            break
          case 'clothing':
            this.clothingData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords: [], clothingRecords, livingRecords: [], date: this.clothingDate }
            break
          case 'living':
            this.livingData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords: [], clothingRecords: [], livingRecords, date: this.livingDate }
            break
        }
        this.currentDailyId = 'mock-' + Date.now()
      }
    },
    async fetchHealthIds() {
      if (!this.selectedElderId) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        const result = await uni.request({
          url: 'http://localhost:8080/health/getHealthIds',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          data: {
            elderId: this.selectedElderId
          }
        })

        const response = result.data as ApiResponse
        // 只有当接口成功返回且有有效数据时才使用接口数据
        const hasValidData = response.code === 1 && 
                            response.data && 
                            response.data.healthId && 
                            response.data.healthId.length > 0
        
        if (hasValidData) {
          const data = response.data as { elderId: string | null, healthId: string[] }
          // 倒序排列并设置默认选中最大值
          this.healthIds = data.healthId.reverse()
          this.currentHealthIndex = 0
          // 获取第一条健康记录数据
          await this.fetchHealthData()
        } else {
          console.log('使用模拟健康数据')
          // 使用模拟数据
          this.healthIds = ['1', '2', '3']
          this.currentHealthIndex = 0
          // 设置模拟健康数据
          this.healthData = {
            healthId: '1',
            assessDate: '2024-01-15',
            report: '【身体检查报告】\n\n一、基本指标\n• 身高：172cm\n• 体重：65kg\n• 体质指数(BMI)：22.0（正常范围）\n\n二、血压测量\n• 收缩压：125mmHg\n• 舒张压：80mmHg\n• 血压状态：正常\n\n三、心率监测\n• 静息心率：72次/分钟\n• 心率状态：正常\n\n四、血糖检测\n• 空腹血糖：5.2mmol/L\n• 餐后2小时血糖：7.8mmol/L\n• 血糖状态：正常\n\n五、血脂分析\n• 总胆固醇：4.8mmol/L\n• 甘油三酯：1.5mmol/L\n• 血脂状态：正常\n\n六、健康建议\n1. 饮食：建议低盐低脂饮食，多吃蔬菜水果\n2. 运动：每日保持30分钟以上适度运动\n3. 作息：保持规律作息，避免熬夜\n4. 监测：建议每月测量一次血压和血糖',
            caretakerComment: '老人今日精神状态良好，饮食正常，无异常情况。\n\n【今日护理记录】\n• 晨起血压测量：120/78mmHg\n• 早餐：小米粥一碗、鸡蛋一个\n• 上午活动：花园散步30分钟\n• 午餐：米饭一碗、清蒸鱼、炒青菜\n• 下午活动：棋牌室活动1小时\n• 晚餐：豆腐汤、馒头一个\n• 晚间血压测量：125/80mmHg\n• 睡眠情况：良好',
            number: 1
          }
        }
      } catch (error) {
        console.error('获取健康记录ID失败:', error)
        console.log('使用模拟健康数据')
        // 使用模拟数据
        this.healthIds = ['1', '2', '3']
        this.currentHealthIndex = 0
        // 设置模拟健康数据
        this.healthData = {
          healthId: '1',
          assessDate: '2024-01-15',
          report: '经检查，老人身体状况良好，血压控制在正常范围内，建议继续保持规律作息和适度运动。',
          caretakerComment: '老人今日精神状态良好，饮食正常，无异常情况。',
          number: 1
        }
      }
    },
    async fetchHealthData() {
      if (!this.selectedElderId || this.healthIds.length === 0) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        const result = await uni.request({
          url: 'http://localhost:8080/health/getHealthByNumber',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          data: {
            elderId: this.selectedElderId,
            number: this.healthIds[this.currentHealthIndex]
          }
        })

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.healthData = response.data as {
            healthId: string | null,
            assessDate: string,
            report: string,
            caretakerComment: string,
            number: string | null
          }
        }
      } catch (error) {
        console.error('获取健康记录数据失败:', error)
        this.healthData = {
          healthId: null,
          assessDate: '',
          report: '',
          caretakerComment: '',
          number: null
        }
      }
    },
    handleElderChange(e: any) {
      this.currentElderIndex = parseInt(e.detail.value)
      if (this.elders[this.currentElderIndex]) {
        this.selectedElderId = this.elders[this.currentElderIndex].elderId
        this.selectedChildrenId = this.elders[this.currentElderIndex].childrenId.toString()
        this.fetchDailyData('meal')
        this.fetchDailyData('clothing')
        this.fetchDailyData('living')
        this.fetchHealthIds()
      }
    },
    handleMealDateChange(e: any) {
      this.mealDate = e.detail.value
      this.fetchDailyData('meal')
    },
    handleClothingDateChange(e: any) {
      this.clothingDate = e.detail.value
      this.fetchDailyData('clothing')
    },
    handleLivingDateChange(e: any) {
      this.livingDate = e.detail.value
      this.fetchDailyData('living')
    },
    handleBack() {
      uni.removeStorageSync('accessToken')
      uni.removeStorageSync('refreshToken')
      uni.removeStorageSync('userInfo')
      
      uni.redirectTo({
        url: '/pages/nurse/login',
        success: () => {
          console.log('成功跳转到登录页')
        },
        fail: (err) => {
          console.error('跳转失败:', err)
          uni.showToast({
            title: '跳转失败',
            icon: 'none'
          })
        }
      })
    },
    handleTabClick(tab: string) {
      if (tab === 'nursing') {
        // 点击护理日常按钮时，刷新数据
        this.fetchElders()
      } else {
        // 其他标签页的跳转逻辑
        uni.switchTab({
          url: `/pages/nurse/${tab}`
        })
      }
    },
    previewImage(url: string) {
      if (!url) return
      uni.previewImage({
        urls: [url],
        current: url,
        indicator: 'number',
        loop: false,
        success: () => {
          console.log('图片预览成功')
        },
        fail: (err) => {
          console.error('图片预览失败:', err)
          uni.showToast({
            title: '图片预览失败',
            icon: 'none'
          })
        }
      })
    },
    handleHealthChange(e: any) {
      this.currentHealthIndex = parseInt(e.detail.value)
      this.fetchHealthData()
    },
    goToActivityApproval() {
      if (this.selectedElderId) {
        uni.navigateTo({
          url: `/pages/children/activity-approval?elderId=${this.selectedElderId}&elderName=${this.elderNames[this.currentElderIndex]}`,
          success: () => {
            console.log('成功跳转到活动申请页面')
          },
          fail: (err) => {
            console.error('跳转失败:', err)
            uni.showToast({
              title: '跳转失败',
              icon: 'none'
            })
          }
        })
      } else {
        uni.showToast({
          title: '请先选择老人',
          icon: 'none'
        })
      }
    }
  }
}
</script>

