<script lang="uts">
	export default {
		data() {
			return {
				currentTab: 'home',
				currentBannerIndex: 0
			}
		},
		methods: {
			handleBannerChange(e: any) {
				this.currentBannerIndex = e.detail.current
			},
			switchTab(tab: string) {
				this.currentTab = tab;
				// 根据tab跳转到对应页面
				switch(tab) {
					case 'nursing':
						uni.navigateTo({ url: '/pages/children/nursing' });
						break;
					case 'mall':
						uni.navigateTo({ url: '/pages/children/mall' });
						break;
					case 'discover':
						uni.navigateTo({ url: '/pages/children/discover' });
						break;
					case 'mine':
						uni.navigateTo({ url: '/pages/children/mine' });
						break;
				}
			}
		}
	}
</script>

