<template>
  <view class="page">

    <!-- 顶部导航栏 -->
   
    <view class="header" >
      <text class="title">活动详情</text>
      <view class="right-icons">
        <view class="dropdown">
          <picker 
            :range="elderNames" 
            @change="handleElderChange" 
            :value="currentElderIndex"
          >
            <view class="picker-content">
              <text class="picker-text">{{ elderNames[currentElderIndex] || '选择老人' }}</text>
              <image class="down-icon" src="/static/images/down.png" mode="aspectFit"></image>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar" v-if="showSearch">
      <input 
        type="text" 
        v-model="searchText"
        placeholder="搜索活动名称、描述"
        class="search-input"
        @input="handleSearch"
      />
      <text class="cancel-btn" @click="toggleSearch">取消</text>
    </view>

    <!-- 筛选面板 -->
    <view class="filter-panel" v-if="showFilter">
      <view class="filter-header">
        <text class="filter-title">筛选条件</text>
        <text class="clear-btn" @click="clearFilter">清除</text>
      </view>
      <view class="filter-content">
        <view class="filter-section">
          <text class="section-title">活动时间</text>
          <view class="date-range">
            <picker mode="date" :value="startDate" @change="handleStartDateChange">
              <text class="date-text">{{ startDate || '开始日期' }}</text>
            </picker>
            <text class="date-separator">至</text>
            <picker mode="date" :value="endDate" @change="handleEndDateChange">
              <text class="date-text">{{ endDate || '结束日期' }}</text>
            </picker>
          </view>
        </view>
        <view class="filter-section">
          <text class="section-title">活动状态</text>
          <view class="status-options">
            <view 
              v-for="status in statusList" 
              :key="status.value"
              :class="['status-item', { active: selectedStatus === status.value }]"
              @click="selectStatus(status.value)"
            >
              {{ status.label }}
            </view>
          </view>
        </view>
      </view>
      <view class="filter-footer">
        <button class="confirm-btn" @click="applyFilter">确定</button>
      </view>
    </view>

    <!-- 页面指示器 -->
    <view class="page-indicator">
      <view class="indicator-content">
        <text class="current">{{ currentIndex + 1 }}</text>
        <view class="progress-bar">
          <view class="progress" :style="{ width: `${(currentIndex + 1) * 100 / filteredActivities.length}%` }"></view>
        </view>
        <text class="total">{{ filteredActivities.length }}</text>
      </view>
    </view>

    <!-- 活动列表 -->
    <scroll-view 
      class="activity-list"
      scroll-y
      @scroll="handleScroll"
      :scroll-top="scrollTop"
      @scrolltolower="handleScrollToLower"
      @refresherrefresh="handleRefresh"
      refresher-enabled
      :refresher-triggered="isRefreshing"
      :scroll-with-animation="true"
      :scroll-anchoring="true"
    >
      <!-- 骨架屏 -->
      <activity-skeleton v-if="loading && !activities.length"></activity-skeleton>

      <view 
        v-for="(activity, index) in filteredActivities" 
        :key="index"
        class="activity-card"
        :class="{ 
          'card-active': currentIndex === index,
          'card-enter': isCardEntering(index)
        }"
        :style="{ 
          transform: `translateY(${getCardOffset(index)}px)`,
          opacity: getCardOpacity(index)
        }"
      >
        <!-- 颜色块 -->
        <view :class="['color-block', `color-${index % 5}`]"></view>

        <!-- 活动信息头部 -->
        <view class="activity-header">
          <view class="header-left">
            <text class="activity-tag">{{ getActivityTag(activity) }}</text>
            <text class="activity-name">{{ activity.name }}</text>
          </view>
        </view>

        <!-- 活动图片 -->
        <view class="image-container" @click="previewImage(activity.activityData)">
          <swiper 
            class="image-swiper" 
            :indicator-dots="activity.images?.length > 1"
            :autoplay="true"
            :interval="3000"
            circular
          >
            <swiper-item v-for="(image, imgIndex) in activity.images || [activity.activityData]" :key="imgIndex">
              <image 
                :src="image || '/static/images/default-activity.png'" 
                mode="aspectFill" 
                class="activity-image"
                :class="{ 'image-loading': !imageLoaded }"
                @load="handleImageLoad"
              ></image>
            </swiper-item>
          </swiper>
          <view class="image-overlay">
            <text class="image-hint">点击查看大图</text>
            <text class="image-count" v-if="activity.images?.length > 1">
              {{ activity.images.length }}张图片
            </text>
          </view>
        </view>

        <!-- 活动时间和地点 -->
        <view class="info-section time-location">
          <view class="time-item">
            <image src="/static/images/time.png" class="info-icon"></image>
            <view class="time-details">
              <text class="date">{{ formatDate(activity.startTime) }}</text>
              <text class="time">{{ formatTime(activity.startTime) }} - {{ formatTime(activity.endTime) }}</text>
            </view>
          </view>
          <view class="location-item">
            <image src="/static/images/location.png" class="info-icon"></image>
            <text class="location">{{ activity.location || '活动室' }}</text>
          </view>
        </view>

        <!-- 活动描述 -->
        <view class="info-section description">
          <text class="section-title">活动详情</text>
          <text 
            class="description-text" 
            :class="{ 'expanded': activity.isExpanded }"
            @click="toggleDescription(index)"
          >{{ activity.description }}</text>
          <text 
            v-if="activity.description.length > 100" 
            class="expand-btn"
            @click="toggleDescription(index)"
          >
            {{ activity.isExpanded ? '收起' : '展开' }}
          </text>
        </view>

        <!-- 参与人数 -->
        <view class="info-section participants">
          <text class="section-title">参与人数</text>
          <view class="participant-list">
            <text class="participant-count">
              {{ activity.participantCount || 0 }}人参与
            </text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="action-buttons">
          <button 
            class="action-btn register" 
            @click="registerActivity(activity)"
            :disabled="activity.registered"
            :class="{
              'registered': activity.registered && activity.applicationStatus === 0,
              'success': activity.registered && activity.applicationStatus === 1,
              'rejected': activity.registered && activity.applicationStatus === 2
            }"
          >
            <image 
              :src="getActionButtonIcon(activity)" 
              class="btn-icon"
            ></image>
            <text>{{ getActionButtonText(activity) }}</text>
          </button>
        </view>
      </view>
    </scroll-view>

    <!-- 错误重试提示 -->
    <view class="error-tips" v-if="showError">
      <text class="error-text">{{ errorMessage }}</text>
      <view class="retry-btn" @click="handleRetry">重试</view>
    </view>

    <!-- 添加底部导航栏 -->
    <nurse-tabbar current-path="/pages/nurse/activity"></nurse-tabbar>
  </view>
</template>

<script lang="uts">
import ActivitySkeleton from './components/ActivitySkeleton.uvue'
import NurseTabbar from '../../components/nurse-tabbar.uvue'

interface ActivityApplication {
  activityApplicationId: string
  activityId: string
  caretakerId: string
  childrenId: string
  elderId: string
  ispass: number
}

interface ActivityData {
  activityId: string
  name: string
  startTime: string
  endTime: string
  description: string
  activityData: string
  location?: string
  images?: string[]
  participants?: string[]
  participantCount?: number
  likeCount?: number
  collectCount?: number
  isLiked?: boolean
  isCollected?: boolean
  isExpanded?: boolean
  registered?: boolean
  applicationStatus?: number
}

interface PageData {
  total: number
  pages: number
  current: number
  size: number
  records: ActivityData[]
}

interface ApiResponse {
  code: number
  msg: string | null
  data: PageData
}

interface StatusOption {
  label: string
  value: string
}

interface Elder {
  elderId: string
  caretakerId: string
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string
  photo: string
  childrenId: string
  isEnable: number
}

export default {
  components: {
    ActivitySkeleton,
    NurseTabbar
  },
  data() {
    return {
      activities: [] as ActivityData[],
      deanId: '',
      currentPage: 1,
      pageSize: 10,
      total: 0,
      loading: false,
      currentIndex: 0,
      isAnimating: false,
      headerOpacity: 1,
      scrollTop: 0,
      lastScrollTop: 0,
      showSearch: false,
      showFilter: false,
      searchText: '',
      startDate: '',
      endDate: '',
      selectedStatus: '',
      statusList: [
        { label: '全部', value: '' },
        { label: '未开始', value: 'upcoming' },
        { label: '进行中', value: 'ongoing' },
        { label: '已结束', value: 'ended' }
      ] as StatusOption[],
      imageLoaded: false,
      sharing: false,
      registering: false,
      isRefreshing: false,
      showError: false,
      errorMessage: '',
      retryCount: 0,
      maxRetries: 3,
      imageCache: new Map(),
      isScrolling: false,
      touchStartY: 0,
      cardOffsets: new Map<number, number>(),
      elders: [] as Elder[],
      elderNames: [] as string[],
      currentElderIndex: 0,
      selectedElderId: '',
      selectedChildrenId: '',
      showElderSelectModal: false,
      currentActivity: null as ActivityData | null
    }
  },

  computed: {
    filteredActivities(): ActivityData[] {
      let result = this.activities

      // 搜索过滤
      if (this.searchText) {
        result = result.filter(activity => 
          activity.name.toLowerCase().includes(this.searchText.toLowerCase()) ||
          activity.description.toLowerCase().includes(this.searchText.toLowerCase())
        )
      }

      // 日期过滤
      if (this.startDate && this.endDate) {
        result = result.filter(activity => {
          const activityDate = new Date(activity.startTime).getTime()
          const start = new Date(this.startDate).getTime()
          const end = new Date(this.endDate).getTime()
          return activityDate >= start && activityDate <= end
        })
      }

      // 状态过滤
      if (this.selectedStatus) {
        const now = new Date().getTime()
        result = result.filter(activity => {
          const start = new Date(activity.startTime).getTime()
          const end = new Date(activity.endTime).getTime()
          switch (this.selectedStatus) {
            case 'upcoming':
              return start > now
            case 'ongoing':
              return start <= now && end >= now
            case 'ended':
              return end < now
            default:
              return true
          }
        })
      }

      return result
    }
  },

  onLoad() {
    // 从本地存储获取deanId
    this.deanId = uni.getStorageSync('currentDeanId')
    this.loadActivities()
    this.fetchElders()
  },

  methods: {
    async loadActivities() {
      if (this.loading) return
      this.loading = true

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        const userInfo = uni.getStorageSync('userInfo')
        const deanId = userInfo?.deanId as string

        if (!accessToken || !refreshToken) {
          uni.redirectTo({
            url: '/pages/nurse/login'
          })
          return
        }

        if (!deanId) {
          uni.showToast({
            title: '获取院长信息失败',
            icon: 'none'
          })
          return
        }

        const result = await uni.request({
          url: 'http://localhost:8080/activity/pageDetail',
          method: 'GET',
          data: {
            page: this.currentPage,
            pageSize: this.pageSize,
            deanId: deanId
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        if (result.data.code === 1 && result.data.data) {
          const data = result.data.data
          
          // 获取每个活动的报名人数
          const activitiesWithCount = await Promise.all(
            data.records.map(async (activity: ActivityData) => {
              const count = await this.fetchActivityCount(activity.activityId)
              return {
                ...activity,
                participantCount: count
              }
            })
          )
          
          this.activities = [...this.activities, ...activitiesWithCount]
          this.total = data.total
          this.currentPage++
          
          // 如果已选择老人，获取申请记录
          if (this.selectedElderId) {
            await this.fetchActivityApplications(this.selectedElderId)
          }
        }
      } catch (error) {
        console.error('获取活动列表失败:', error)
        uni.showToast({
          title: '获取活动列表失败',
          icon: 'none'
        })
      } finally {
        this.loading = false
      }
    },

    // 下拉刷新
    async onPullDownRefresh() {
      this.currentPage = 1
      this.activities = []
      await this.loadActivities()
      uni.stopPullDownRefresh()
    },

    // 上拉加载更多
    async onReachBottom() {
      if (this.activities.length < this.total) {
        await this.loadActivities()
      }
    },

    formatDate(timeStr: string): string {
      if (!timeStr) return ''
      const date = new Date(timeStr)
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      return `${month}月${day}日`
    },

    formatTime(timeStr: string): string {
      if (!timeStr) return ''
      const date = new Date(timeStr)
      const hours = String(date.getHours()).padStart(2, '0')
      const minutes = String(date.getMinutes()).padStart(2, '0')
      return `${hours}:${minutes}`
    },

    getActivityTag(activity: ActivityData): string {
      const now = new Date().getTime()
      const start = new Date(activity.startTime).getTime()
      const end = new Date(activity.endTime).getTime()
      
      if (start > now) return '未开始'
      if (end < now) return '已结束'
      return '进行中'
    },

    handleBack() {
      uni.navigateBack()
    },

    handleSwiperChange(e: any) {
      this.currentIndex = e.detail.current
      this.scrollTop = 0
      // 当滑动到倒数第二个时，加载更多数据
      if (this.currentIndex === this.activities.length - 2) {
        this.loadActivities()
      }
    },

    handleAnimationFinish() {
      this.isAnimating = false
    },

    handleTransition(e: any) {
      this.isAnimating = true
    },

    handleScroll(e: any) {
      const scrollTop = e.detail.scrollTop
      // 只控制顶部导航栏的透明度
      this.headerOpacity = Math.max(0, Math.min(1, 1 - scrollTop / 100))
      this.lastScrollTop = scrollTop
      
      // 计算当前显示的活动索引
      const cardHeight = 1000 // 预估每个卡片的高度
      const newIndex = Math.floor(scrollTop / cardHeight)
      
      // 确保索引在有效范围内
      if (newIndex >= 0 && newIndex < this.filteredActivities.length) {
        this.currentIndex = newIndex
      }
      
      // 更新卡片偏移量
      this.updateCardOffsets()
    },
    
    updateCardOffsets() {
      const scrollTop = this.lastScrollTop
      const cardHeight = 1000 // 预估每个卡片的高度
      
      this.filteredActivities.forEach((_, index) => {
        const cardTop = index * cardHeight
        const offset = Math.max(0, Math.min(50, (scrollTop - cardTop) / 20))
        this.cardOffsets.set(index, offset)
      })
    },
    
    getCardOffset(index: number): number {
      return this.cardOffsets.get(index) || 0
    },
    
    getCardOpacity(index: number): number {
      const scrollTop = this.lastScrollTop
      const cardHeight = 1000 // 预估每个卡片的高度
      const cardTop = index * cardHeight
      const distance = Math.abs(scrollTop - cardTop)
      return Math.max(0.8, Math.min(1, 1 - distance / (cardHeight * 2)))
    },
    
    isCardEntering(index: number): boolean {
      return this.currentIndex === index && this.cardOffsets.get(index) === 0
    },

    handleScrollToLower() {
      if (this.currentIndex === this.activities.length - 1) {
        this.loadActivities()
      }
    },

    toggleSearch() {
      this.showSearch = !this.showSearch
      if (!this.showSearch) {
        this.searchText = ''
      }
    },

    handleSearch() {
      // 实现实时搜索
    },

    toggleFilter() {
      this.showFilter = !this.showFilter
    },

    clearFilter() {
      this.startDate = ''
      this.endDate = ''
      this.selectedStatus = ''
    },

    handleStartDateChange(e: any) {
      this.startDate = e.detail.value
    },

    handleEndDateChange(e: any) {
      this.endDate = e.detail.value
    },

    selectStatus(status: string) {
      this.selectedStatus = status
    },

    applyFilter() {
      this.showFilter = false
    },

    async toggleLike(index: number) {
      if (!this.activities[index].isLiked) {
        uni.vibrateShort()
        this.activities[index].likeCount = (this.activities[index].likeCount || 0) + 1
      } else {
        this.activities[index].likeCount = (this.activities[index].likeCount || 1) - 1
      }
      this.activities[index].isLiked = !this.activities[index].isLiked
    },

    async toggleCollect(index: number) {
      if (!this.activities[index].isCollected) {
        uni.vibrateShort()
        this.activities[index].collectCount = (this.activities[index].collectCount || 0) + 1
      } else {
        this.activities[index].collectCount = (this.activities[index].collectCount || 1) - 1
      }
      this.activities[index].isCollected = !this.activities[index].isCollected
    },

    toggleDescription(index: number) {
      this.activities[index].isExpanded = !this.activities[index].isExpanded
    },

    handleImageLoad() {
      this.imageLoaded = true
    },

    previewImage(url: string) {
      if (!url || !this.imageCache.get(url)) return
      uni.previewImage({
        urls: [url],
        current: 0
      })
    },

    async shareActivity(activity: ActivityData) {
      this.sharing = true
      try {
        await uni.showShareMenu({
          withShareTicket: true
        })
      } catch (error) {
        uni.showToast({
          title: '分享失败',
          icon: 'none'
        })
      } finally {
        this.sharing = false
      }
    },

    handleRefresh() {
      this.isRefreshing = true
      this.retryCount = 0
      this.loadActivities()
    },

    handleRetry() {
      this.retryCount = 0
      this.loadActivities()
    },

    handleTouchStart(e: any) {
      this.touchStartY = e.touches[0].clientY
      this.isScrolling = true
    },

    handleTouchEnd(e: any) {
      const touchEndY = e.changedTouches[0].clientY
      const deltaY = touchEndY - this.touchStartY
      
      // 如果滑动距离很小，认为是点击事件
      if (Math.abs(deltaY) < 10) {
        this.isScrolling = false
        return
      }
      
      // 延迟重置isScrolling，避免滑动冲突
      setTimeout(() => {
        this.isScrolling = false
      }, 100)
    },

    async fetchElders() {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          uni.redirectTo({
            url: '/pages/nurse/login'
          })
          return
        }

        uni.showLoading({
          title: '加载中...'
        })

        const result = await uni.request({
          url: 'http://localhost:8080/elder/elders',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })

        uni.hideLoading()

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.elders = response.data.map(elder => ({
            ...elder,
            elderId: elder.elderId.toString(),
            caretakerId: elder.caretakerId.toString(),
            childrenId: elder.childrenId.toString()
          })) as Elder[]
          
          this.elderNames = this.elders.map(elder => elder.name)
          
          if (this.elders.length > 0) {
            this.selectedElderId = this.elders[0].elderId
            this.selectedChildrenId = this.elders[0].childrenId
            this.currentElderIndex = 0
          }
        } else {
          uni.showToast({
            title: '获取数据失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },

    handleElderChange(e: any) {
      this.currentElderIndex = parseInt(e.detail.value)
      if (this.elders[this.currentElderIndex]) {
        this.selectedElderId = this.elders[this.currentElderIndex].elderId
        this.selectedChildrenId = this.elders[this.currentElderIndex].childrenId
        // 当选择老人后，获取该老人的活动申请记录
        this.fetchActivityApplications(this.selectedElderId)
      }
    },

    async registerActivity(activity: ActivityData) {
      if (activity.registered || this.registering) return
      
      this.registering = true
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        const userInfo = uni.getStorageSync('userInfo')
        const caretakerId = userInfo?.caretakerId?.toString()

        if (!accessToken || !refreshToken || !caretakerId) {
          uni.showToast({
            title: '获取用户信息失败',
            icon: 'none'
          })
          return
        }

        if (this.currentElderIndex < 0 || !this.elders[this.currentElderIndex]) {
          uni.showToast({
            title: '请先选择老人',
            icon: 'none'
          })
          return
        }

        const selectedElder = this.elders[this.currentElderIndex]

        const result = await uni.request({
          url: 'http://localhost:8080/activity/apply',
          method: 'POST',
          data: {
            activityId: activity.activityId.toString(),
            caretakerId: caretakerId.toString(),
            childrenId: selectedElder.childrenId.toString(),
            elderId: selectedElder.elderId.toString()
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })

        if (result.data.code === 1) {
          // 立即更新活动状态
          activity.registered = true
          activity.applicationStatus = 0  // 设置为已申请状态
          activity.participantCount = (activity.participantCount || 0) + 1
          
          uni.showToast({
            title: '报名成功',
            icon: 'success'
          })
        } else {
          uni.showToast({
            title: result.data.msg || '报名失败',
            icon: 'none'
          })
        }
      } catch (error) {
        console.error('报名失败:', error)
        uni.showToast({
          title: '报名失败',
          icon: 'none'
        })
      } finally {
        this.registering = false
      }
    },

    closeElderSelect() {
      this.showElderSelectModal = false
      this.currentActivity = null
    },

    selectElder(elder: Elder) {
      this.selectedElderId = elder.elderId
      this.selectedChildrenId = elder.childrenId
      this.closeElderSelect()
    },

    // 获取老人的活动申请记录
    async fetchActivityApplications(elderId: string) {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        if (!accessToken || !refreshToken) {
          return
        }

        const result = await uni.request({
          url: 'http://localhost:8080/activity/byElderId',
          method: 'GET',
          data: {
            elderId: elderId
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })

        if (result.data.code === 1 && result.data.data) {
          const applications = result.data.data as ActivityApplication[]
          
          // 更新活动状态
          this.activities = this.activities.map(activity => {
            const application = applications.find(app => app.activityId === activity.activityId)
            if (application) {
              return {
                ...activity,
                registered: true,
                applicationStatus: application.ispass
              }
            }
            return activity
          })
        }
      } catch (error) {
        console.error('获取申请记录失败:', error)
      }
    },

    // 获取按钮文本
    getActionButtonText(activity: ActivityData): string {
      if (!activity.registered) {
        return '立即报名'
      }
      
      switch (activity.applicationStatus) {
        case 0:
          return '已申请'
        case 1:
          return '报名成功'
        case 2:
          return '报名拒绝'
        default:
          return '立即报名'
      }
    },

    // 获取按钮图标
    getActionButtonIcon(activity: ActivityData): string {
      if (!activity.registered) {
        return '/static/images/register.png'
      }
      
      switch (activity.applicationStatus) {
        case 0:
          return '/static/images/pending.png'
        case 1:
          return '/static/images/success.png'
        case 2:
          return '/static/images/rejected.png'
        default:
          return '/static/images/register.png'
      }
    },

    // 获取单个活动的报名人数
    async fetchActivityCount(activityId: string): Promise<number> {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        if (!accessToken || !refreshToken) {
          return 0
        }

        const result = await uni.request({
          url: 'http://localhost:8080/activity/count',
          method: 'GET',
          data: {
            activityId: activityId
          },
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        if (result.data.code === 1) {
          return parseInt(result.data.data) || 0
        }
        return 0
      } catch (error) {
        console.error('获取活动报名人数失败:', error)
        return 0
      }
    }
  }
}
</script>

