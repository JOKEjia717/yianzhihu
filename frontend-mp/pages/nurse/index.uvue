<template>
  <view class="page">
    <!-- 顶部标题栏 -->
    <view class="header">
      <view class="header-left">
        <view class="dropdown">
          <picker mode="date" :value="selectedDate" @change="handleDateChange">
            <view class="picker-content">
              <text class="picker-text">{{ selectedDate || '选择日期' }}</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="header-center">
        <text class="title">护理日常</text>
      </view>
      <view class="header-right">
        <view class="dropdown">
          <picker 
            :range="elderNames" 
            @change="handleElderChange" 
            :value="currentElderIndex"
          >
            <view class="picker-content">
              <text class="picker-text">{{ elderNames[currentElderIndex] || '选择老人' }}</text>
              <image class="down-icon" src="/static/images/down.png" mode="aspectFit"></image>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 主要内容区域 -->
    <view class="content">
      <!-- 顶部轮播图 -->
      <swiper class="banner-swiper" 
        :autoplay="true" 
        :interval="3000" 
        :duration="500"
        circular>
        <swiper-item>
          <image src="/static/images/banner1.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
        <swiper-item>
          <image src="/static/images/banner2.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
        <swiper-item>
          <image src="/static/images/banner3.jpg" mode="aspectFill" class="banner-image"></image>
        </swiper-item>
      </swiper>

      <!-- 每日三餐 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">每日三餐</text>
          <button class="btn-upload" @click="handleMealUpload">上传</button>
        </view>
        <view class="section-content">
          <swiper v-if="mealData.breakfastPhotos || mealData.lunchPhotos || mealData.dinnerPhotos" class="meal-swiper" indicator-dots>
            <swiper-item v-if="mealData.breakfastPhotos">
              <image 
                :src="mealData.breakfastPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.breakfastPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">早餐：</text>
                <text class="meal-description">{{ mealData.breakfastDesc || '小米粥一碗、鸡蛋一个' }}</text>
              </view>
            </swiper-item>
            <swiper-item v-if="mealData.lunchPhotos">
              <image 
                :src="mealData.lunchPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.lunchPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">午餐：</text>
                <text class="meal-description">{{ mealData.lunchDesc || '米饭一碗、清蒸鱼、炒青菜' }}</text>
              </view>
            </swiper-item>
            <swiper-item v-if="mealData.dinnerPhotos">
              <image 
                :src="mealData.dinnerPhotos" 
                mode="aspectFill" 
                class="meal-image"
                @click="previewImage(mealData.dinnerPhotos)"
              ></image>
              <view class="meal-label">
                <text class="meal-time">晚餐：</text>
                <text class="meal-description">{{ mealData.dinnerDesc || '豆腐汤、馒头一个' }}</text>
              </view>
            </swiper-item>
          </swiper>
          <view v-else-if="mealData.mealRecords && mealData.mealRecords.length > 0" class="record-list">
            <view v-for="(record, index) in mealData.mealRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 衣物穿戴 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">衣物穿戴</text>
          <button class="btn-upload" @click="handleUpload('clothing')">上传</button>
        </view>
        <view class="section-content">
          <image 
            v-if="clothingData.clothingPhotos" 
            :src="clothingData.clothingPhotos" 
            mode="aspectFill" 
            class="clothing-image"
            @click="previewImage(clothingData.clothingPhotos)"
          ></image>
          <view v-else-if="clothingData.clothingRecords && clothingData.clothingRecords.length > 0" class="record-list">
            <view v-for="(record, index) in clothingData.clothingRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 住宿环境 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">住宿环境</text>
          <button class="btn-upload" @click="handleUpload('living')">上传</button>
        </view>
        <view class="section-content">
          <image 
            v-if="livingData.lodgingPhotos" 
            :src="livingData.lodgingPhotos" 
            mode="aspectFill" 
            class="living-image"
            @click="previewImage(livingData.lodgingPhotos)"
          ></image>
          <view v-else-if="livingData.livingRecords && livingData.livingRecords.length > 0" class="record-list">
            <view v-for="(record, index) in livingData.livingRecords" :key="index" class="record-item">
              <text class="record-time">{{ record.time }}</text>
              <text class="record-content">{{ record.content }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 健康状态 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">健康状态</text>
          <button class="btn-upload" @click="showHealthUploadModal">上传</button>
        </view>
        <view class="section-content">
          <view v-if="healthData.report || healthData.healthSuggestion" class="health-info">
            <view v-if="healthData.report" class="health-item">
              <text class="health-label">健康报告：</text>
              <text class="health-value">{{ healthData.report }}</text>
            </view>
            <view v-if="healthData.healthSuggestion" class="health-item">
              <text class="health-label">护理建议：</text>
              <text class="health-value">{{ healthData.healthSuggestion }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 护理记录 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">护理记录</text>
        </view>
        <view class="section-content">
          <view v-if="healthData.nursingRecords && healthData.nursingRecords.length > 0" class="record-list">
            <view v-for="(record, index) in healthData.nursingRecords" :key="index" class="record-item">
              <text class="record-content">{{ record }}</text>
            </view>
          </view>
          <view v-else class="empty-tip">暂无记录</view>
        </view>
      </view>

      <!-- 健康状态上传弹窗 -->
      <view v-if="showHealthModal" class="modal-mask">
        <view class="modal-content">
          <view class="modal-header">
            <text class="modal-title">上传健康状态</text>
            <text class="modal-close" @click="closeHealthModal">×</text>
          </view>
          <view class="modal-body">
            <view class="form-item">
              <text class="form-label">健康报告</text>
              <textarea 
                class="form-input" 
                v-model="healthForm.report" 
                placeholder="请输入健康报告"
                maxlength="500"
              ></textarea>
            </view>
            <view class="form-item">
              <text class="form-label">护理建议</text>
              <textarea 
                class="form-input" 
                v-model="healthForm.healthSuggestion" 
                placeholder="请输入护理建议"
                maxlength="500"
              ></textarea>
            </view>
          </view>
          <view class="modal-footer">
            <button class="modal-btn cancel" @click="closeHealthModal">取消</button>
            <button class="modal-btn confirm" @click="submitHealthInfo" :disabled="isSubmitting">
              {{ isSubmitting ? '提交中...' : '确认' }}
            </button>
          </view>
        </view>
      </view>
    </view>
    
    <!-- AI咨询浮动按钮 -->
    <view 
      class="ai-btn" 
      :style="{ left: btnPosition.left + 'px', top: btnPosition.top + 'px', right: 'auto', bottom: 'auto' }"
      @click="goToAiConsult" 
      @longpress="startMoveBtn"
      @touchmove="moveBtn"
      @touchend="endMoveBtn"
    >
      <image class="ai-icon" src="/static/images/ai.png" mode="aspectFit"></image>
      <text class="ai-text">AI咨询</text>
      <text v-if="isMoving" class="moving-tip">拖动调整位置</text>
    </view>
    
    <nurse-tabbar current-path="/pages/nurse/index"></nurse-tabbar>
  </view>
</template>

<script lang="uts">
import NurseTabbar from '../../components/nurse-tabbar.uvue'
import { getDateIndex, getElderData, getClothingByDate } from '@/data/mockData.ts'

interface Elder {
  elderId: string
  caretakerId: string
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string
  photo: string
  childrenId: number
  isEnable: number
}

interface DailyData {
  dailyId: string
  elderId: string
  caretakerId: string
  date: string
  breakfastPhotos: string
  lunchPhotos: string
  dinnerPhotos: string
  lodgingPhotos: string
  clothingPhotos: string
  aiComment: string | null
  childrenId: string
  deanId: string
}

interface HealthIdsResponse {
  elderId: string | null
  healthId: string[]
}

interface HealthData {
  healthId: number | null
  assessDate: string
  report: string
  healthSuggestion: string
  nursingRecords: string[]
  number: number | null
}

interface ApiResponse {
  code: number
  msg: string | null
  data: Elder[] | DailyData | HealthIdsResponse | HealthData
}

interface HealthForm {
  report: string
  healthSuggestion: string
  nursingRecords: string[]
}

interface Position {
  left: number
  top: number
}

export default {
  components: {
    NurseTabbar
  },
  data() {
    return {
      elders: [] as Elder[],
      elderNames: [] as string[],
      currentElderIndex: 0,
      selectedElderId: '',
      selectedChildrenId: '',
      deanId: '',
      nurseInfo: {
        name: '',
        avatar: '',
        phone: '',
        specialty: ''
      },
      selectedDate: '',
      mealData: {} as DailyData,
      clothingData: {} as DailyData,
      livingData: {} as DailyData,
      healthData: {
        healthId: null,
        assessDate: '',
        report: '',
        healthSuggestion: '',
        nursingRecords: [] as string[],
        number: null
      } as HealthData,
      healthIds: [] as string[],
      currentDailyId: '',
      showHealthModal: false,
      healthForm: {
        report: '',
        healthSuggestion: '',
        nursingRecords: [] as string[]
      } as HealthForm,
      isSubmitting: false,
      // AI按钮位置数据
      isMoving: false,
      btnPosition: {
        left: -1,
        top: -1
      } as Position
    }
  },
  onLoad() {
    console.log('页面加载开始')
    const userInfo = uni.getStorageSync('userInfo')
    if (userInfo) {
      this.deanId = userInfo.deanId
      this.nurseInfo = {
        name: userInfo.name,
        avatar: userInfo.avatar,
        phone: userInfo.phone,
        specialty: userInfo.specialty
      }
      console.log('用户信息已加载:', this.nurseInfo)
    } else {
      console.log('未找到用户信息')
      uni.redirectTo({
        url: '/pages/nurse/login'
      })
      return
    }
    this.setDefaultDates()
    this.fetchElders()
    // 加载AI按钮位置
    this.loadBtnPosition()
  },
  methods: {
    setDefaultDates() {
      const today = new Date()
      const year = today.getFullYear()
      const month = String(today.getMonth() + 1).padStart(2, '0')
      const day = String(today.getDate()).padStart(2, '0')
      this.selectedDate = `${year}-${month}-${day}`
    },
    async fetchElders() {
      try {
        console.log('开始获取老人列表')
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          console.log('未找到token')
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          uni.redirectTo({
            url: '/pages/nurse/login'
          })
          return
        }

        uni.showLoading({
          title: '加载中...'
        })

        const result = await uni.request({
          url: 'http://localhost:8080/elder/elders',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        uni.hideLoading()

        console.log('老人列表接口返回:', result)
        const response = result.data as ApiResponse
        if (response.code === 1 && response.data && response.data.length > 0) {
          this.elders = response.data as Elder[]
          this.elderNames = this.elders.map(elder => elder.name)
          console.log('老人列表数据:', this.elders)
          
          this.selectedElderId = this.elders[0].elderId
          this.selectedChildrenId = this.elders[0].childrenId.toString()
          console.log('已选择老人:', this.selectedElderId)
          
          // 获取健康数据
          this.fetchHealthData()
          // 获取其他数据
          this.fetchDailyData('meal')
          this.fetchDailyData('clothing')
          this.fetchDailyData('living')
        } else {
          console.log('使用模拟老人数据')
          
          // 使用模拟数据
          this.elders = [
            {
              elderId: '1',
              childrenId: 1,
              name: '张爷爷',
              age: 75,
              gender: '男',
              avatar: '',
              phone: '13800138001',
              address: '幸福养老院 3号楼 201室',
              createdAt: '2024-01-15',
              updatedAt: '2024-01-15'
            },
            {
              elderId: '2',
              childrenId: 1,
              name: '李奶奶',
              age: 72,
              gender: '女',
              avatar: '',
              phone: '13900139002',
              address: '幸福养老院 3号楼 202室',
              createdAt: '2024-01-16',
              updatedAt: '2024-01-16'
            },
            {
              elderId: '3',
              childrenId: 1,
              name: '王爷爷',
              age: 78,
              gender: '男',
              avatar: '',
              phone: '13700137003',
              address: '幸福养老院 3号楼 203室',
              createdAt: '2024-01-17',
              updatedAt: '2024-01-17'
            }
          ]
          this.elderNames = this.elders.map(elder => elder.name)
          
          this.selectedElderId = this.elders[0].elderId
          this.selectedChildrenId = this.elders[0].childrenId.toString()
          
          // 获取健康数据
          this.fetchHealthData()
          // 获取其他数据
          this.fetchDailyData('meal')
          this.fetchDailyData('clothing')
          this.fetchDailyData('living')
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    async fetchDailyData(type: string) {
      console.log('开始获取日常数据:', type, '老人ID:', this.selectedElderId)
      if (!this.selectedElderId) {
        console.log('未选择老人，跳过获取日常数据')
        return
      }

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        const date = this.selectedDate

        console.log('准备请求日常数据:', {
          type,
          date,
          elderId: this.selectedElderId
        })

        const result = await uni.request({
          url: 'http://localhost:8080/daily/day',
          method: 'POST',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json'
          },
          data: {
            date: date,
            elderId: this.selectedElderId
          }
        })

        console.log('日常数据接口返回:', result)
        const response = result.data as ApiResponse
        // 只有当接口成功返回且有有效数据时才使用接口数据
        const hasValidData = response.code === 1 && 
                            response.data && 
                            ((type === 'meal' && response.data.mealRecords && response.data.mealRecords.length > 0) ||
                             (type === 'clothing' && response.data.clothingRecords && response.data.clothingRecords.length > 0) ||
                             (type === 'living' && response.data.livingRecords && response.data.livingRecords.length > 0))
        
        if (hasValidData) {
          const dailyData = response.data as DailyData
          // 保存 dailyId
          this.currentDailyId = dailyData.dailyId
          console.log('获取到日常数据:', dailyData)
          
          switch(type) {
            case 'meal':
              this.mealData = dailyData
              break
            case 'clothing':
              this.clothingData = dailyData
              break
            case 'living':
              this.livingData = dailyData
              break
          }
        } else {
          console.log(`使用${type}模拟数据`)
          
          // 根据日期和老人ID生成不同的模拟数据
          const dateIndex = getDateIndex(date)
          const elderData = getElderData(this.currentElderIndex)
          const healthReportIndex = dateIndex % elderData.healthReports.length
          const selectedMeal = elderData.mealOptions[healthReportIndex]
          const selectedClothing = getClothingByDate(date, elderData.clothingOptions)
          const selectedLiving = elderData.livingOptions[dateIndex % elderData.livingOptions.length]
          const selectedHealthReport = elderData.healthReports[healthReportIndex]
          
          const nursingMealRecords = selectedHealthReport.nursingRecords.filter((record: string) => 
            record.includes('早餐：') || record.includes('午餐：') || record.includes('晚餐：')
          )
          
          const breakfastRecord = nursingMealRecords.find((r: string) => r.includes('早餐：'))
          const lunchRecord = nursingMealRecords.find((r: string) => r.includes('午餐：'))
          const dinnerRecord = nursingMealRecords.find((r: string) => r.includes('晚餐：'))
          
          const mockData: DailyData = {
            dailyId: 'mock-' + Date.now(),
            elderId: this.selectedElderId,
            mealRecords: type === 'meal' ? selectedMeal.mealRecords : [],
            clothingRecords: type === 'clothing' ? selectedClothing.clothingRecords : [],
            livingRecords: type === 'living' ? selectedLiving.livingRecords : [],
            date: date,
            breakfastPhotos: selectedMeal.breakfastPhoto || `/static/images/breakfast${dateIndex % 3 + 1}.jpg`,
            lunchPhotos: selectedMeal.lunchPhoto || `/static/images/lunch${dateIndex % 3 + 1}.jpg`,
            dinnerPhotos: selectedMeal.dinnerPhoto || `/static/images/dinner${dateIndex % 3 + 1}.jpg`,
            breakfastDesc: breakfastRecord ? breakfastRecord.replace('早餐：', '') : selectedMeal.breakfast,
            lunchDesc: lunchRecord ? lunchRecord.replace('午餐：', '') : selectedMeal.lunch,
            dinnerDesc: dinnerRecord ? dinnerRecord.replace('晚餐：', '') : selectedMeal.dinner,
            clothingPhotos: selectedClothing.clothingPhoto || '/static/images/clothing.jpg',
            lodgingPhotos: ''
          }
          
          switch(type) {
            case 'meal':
              this.mealData = mockData
              break
            case 'clothing':
              this.clothingData = mockData
              break
            case 'living':
              this.livingData = mockData
              break
          }
          this.currentDailyId = mockData.dailyId
        }
      } catch (error) {
        console.error('获取日常数据失败:', error)
        console.log(`使用${type}模拟数据`)
        const mealRecords = [
          { time: '08:00', content: '早餐：小米粥、鸡蛋、馒头' },
          { time: '12:00', content: '午餐：红烧肉、清炒青菜、米饭' },
          { time: '18:00', content: '晚餐：清蒸鱼、豆腐汤、米饭' }
        ]
        const clothingRecords = [
          { time: '07:30', content: '今日穿着：长袖衬衫+长裤，外套一件' },
          { time: '20:00', content: '夜间穿着：棉质睡衣一套' }
        ]
        const livingRecords = [
          { time: '08:00', content: '房间温度：24°C，湿度：55%' },
          { time: '14:00', content: '通风换气：已完成，时长30分钟' },
          { time: '18:00', content: '房间清洁：已完成' }
        ]
        
        switch(type) {
          case 'meal':
            this.mealData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords, clothingRecords: [], livingRecords: [], date: this.mealDate }
            break
          case 'clothing':
            this.clothingData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords: [], clothingRecords, livingRecords: [], date: this.clothingDate }
            break
          case 'living':
            this.livingData = { dailyId: 'mock-' + Date.now(), elderId: this.selectedElderId, mealRecords: [], clothingRecords: [], livingRecords, date: this.livingDate }
            break
        }
        this.currentDailyId = 'mock-' + Date.now()
      }
    },
    async fetchHealthData() {
      if (!this.selectedElderId) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        const result = await uni.request({
          url: 'http://localhost:8080/health/getHealthByNumber',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          data: {
            elderId: this.selectedElderId,
            number: '1'
          }
        })

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.healthData = response.data as HealthData
        } else {
          console.log('使用模拟健康数据')
          this.setMockHealthData()
        }
      } catch (error) {
        console.error('获取健康数据失败:', error)
        this.setMockHealthData()
      }
    },
    setMockHealthData() {
      const dateIndex = this.healthDate ? getDateIndex(this.healthDate) % 3 : 0
      const elderData = getElderData(this.currentElderIndex)
      const healthReport = elderData.healthReports[dateIndex % elderData.healthReports.length]
      
      this.healthData = {
        healthId: null,
        assessDate: this.healthDate || healthReport.assessDate,
        report: healthReport.report,
        healthSuggestion: healthReport.healthSuggestion,
        nursingRecords: healthReport.nursingRecords,
        number: null
      }
    },

    handleElderChange(e: any) {
      this.currentElderIndex = parseInt(e.detail.value)
      if (this.elders[this.currentElderIndex]) {
        this.selectedElderId = this.elders[this.currentElderIndex].elderId
        this.selectedChildrenId = this.elders[this.currentElderIndex].childrenId.toString()
        this.fetchDailyData('meal')
        this.fetchDailyData('clothing')
        this.fetchDailyData('living')
        this.fetchHealthData()
      }
    },
    handleDateChange(e: any) {
      this.selectedDate = e.detail.value
      this.fetchDailyData('meal')
      this.fetchDailyData('clothing')
      this.fetchDailyData('living')
      this.fetchHealthData()
    },
    handleBack() {
      uni.removeStorageSync('accessToken')
      uni.removeStorageSync('refreshToken')
      uni.removeStorageSync('userInfo')
      
      uni.redirectTo({
        url: '/pages/index/index',
        success: () => {
          console.log('成功跳转到登录页')
        },
        fail: (err) => {
          console.error('跳转失败:', err)
          uni.showToast({
            title: '跳转失败',
            icon: 'none'
          })
        }
      })
    },
    handleUpload(type: string) {
      if (!this.selectedElderId) {
        uni.showToast({
          title: '请先选择老人',
          icon: 'none'
        })
        return
      }

      // 选择图片
      uni.chooseImage({
        count: 1,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res) => {
          const tempFilePath = res.tempFilePaths[0]
          
          // 显示上传确认对话框
          uni.showModal({
            title: '确认上传',
            content: '是否保存此照片？',
            success: (modalRes) => {
              if (modalRes.confirm) {
                this.saveUpload(type, tempFilePath)
              }
            }
          })
        },
        fail: () => {
          uni.showToast({
            title: '选择图片失败',
            icon: 'none'
          })
        }
      })
    },
    async saveUpload(type: string, filePath: string) {
      if (!this.currentDailyId) {
        uni.showToast({
          title: '无效的数据ID',
          icon: 'none'
        })
        return
      }

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        uni.showLoading({
          title: '上传中...'
        })

        // 构建formData，设置所有必需的字段
        const formData = {
          'dailyId': this.currentDailyId,
          'breakfastPhotos': null,
          'lunchPhotos': null,
          'dinnerPhotos': null,
          'clothingPhotos': null,
          'lodgingPhotos': null
        }

        // 使用uni.uploadFile发送multipart/form-data请求
        const uploadResult = await uni.uploadFile({
          url: 'http://localhost:8080/daily/update',
          filePath: filePath,
          name: type === 'clothing' ? 'clothingPhotos' : 'lodgingPhotos',
          formData: formData,
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
          }
        })

        uni.hideLoading()

        const response = JSON.parse(uploadResult.data) as ApiResponse
        if (response.code === 1) {
          uni.showToast({
            title: '上传成功',
            icon: 'success'
          })
          // 刷新数据
          this.fetchDailyData(type)
        } else {
          uni.showToast({
            title: response.msg || '上传失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('上传失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    switchTab(url: string): void {
      // 如果是跳转到活动页面，先保存deanId
      if (url === '/pages/nurse/activity') {
        // 将deanId保存到本地存储中
        uni.setStorageSync('currentDeanId', this.deanId)
      }
      
      uni.switchTab({
        url: url,
        fail: (err: any): void => {
          console.error('切换标签页失败:', err)
          uni.showToast({
            title: '页面跳转失败',
            icon: 'none'
          })
        }
      })
    },
    // 添加图片预览方法
    previewImage(url: string) {
      if (!url) return
      uni.previewImage({
        urls: [url],
        current: url,
        indicator: 'number',
        loop: false,
        success: () => {
          console.log('图片预览成功')
        },
        fail: (err) => {
          console.error('图片预览失败:', err)
          uni.showToast({
            title: '图片预览失败',
            icon: 'none'
          })
        }
      })
    },
    // 添加每日三餐上传方法
    handleMealUpload() {
      if (!this.selectedElderId) {
        uni.showToast({
          title: '请先选择老人',
          icon: 'none'
        })
        return
      }

      // 显示选择对话框，移除多餐选择选项
      uni.showActionSheet({
        itemList: ['早餐', '午餐', '晚餐'],
        success: (res) => {
          const mealTypes = ['breakfast', 'lunch', 'dinner']
          this.handleSingleMealUpload(mealTypes[res.tapIndex])
        }
      })
    },
    // 处理单餐上传
    handleSingleMealUpload(mealType: string) {
      uni.chooseImage({
        count: 1,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res) => {
          const tempFilePath = res.tempFilePaths[0]
          
          // 显示上传确认对话框
          uni.showModal({
            title: '确认上传',
            content: '是否保存此照片？',
            success: (modalRes) => {
              if (modalRes.confirm) {
                const files = {
                  type: mealType,  // 添加类型标识
                  breakfastPhotos: mealType === 'breakfast' ? tempFilePath : null,
                  lunchPhotos: mealType === 'lunch' ? tempFilePath : null,
                  dinnerPhotos: mealType === 'dinner' ? tempFilePath : null
                }
                this.saveMealUpload(files)
              }
            }
          })
        }
      })
    },
    // 保存餐饮照片
    async saveMealUpload(files: any) {
      if (!this.currentDailyId) {
        uni.showToast({
          title: '无效的数据ID',
          icon: 'none'
        })
        return
      }

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        uni.showLoading({
          title: '上传中...'
        })

        // 构建formData
        const formData = {
          'dailyId': this.currentDailyId,
          'breakfastPhotos': files.breakfastPhotos || null,
          'lunchPhotos': files.lunchPhotos || null,
          'dinnerPhotos': files.dinnerPhotos || null,
          'clothingPhotos': null,
          'lodgingPhotos': null
        }

        // 根据类型获取对应的文件路径和name
        let filePath = null
        let fieldName = ''
        switch(files.type) {
          case 'breakfast':
            filePath = files.breakfastPhotos
            fieldName = 'breakfastPhotos'
            break
          case 'lunch':
            filePath = files.lunchPhotos
            fieldName = 'lunchPhotos'
            break
          case 'dinner':
            filePath = files.dinnerPhotos
            fieldName = 'dinnerPhotos'
            break
        }

        // 使用uni.uploadFile发送请求
        const uploadResult = await uni.uploadFile({
          url: 'http://localhost:8080/daily/update',
          filePath: filePath,
          name: fieldName,  // 使用对应的字段名
          formData: formData,
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        uni.hideLoading()

        const response = JSON.parse(uploadResult.data) as ApiResponse
        if (response.code === 1) {
          uni.showToast({
            title: '上传成功',
            icon: 'success'
          })
          // 刷新数据
          this.fetchDailyData('meal')
        } else {
          uni.showToast({
            title: response.msg || '上传失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('上传失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    showHealthUploadModal() {
      this.showHealthModal = true
    },
    closeHealthModal() {
      this.showHealthModal = false
      this.healthForm = {
        report: '',
        healthSuggestion: '',
        nursingRecords: []
      }
    },
    async submitHealthInfo() {
      if (!this.healthForm.report || !this.healthForm.healthSuggestion) {
        uni.showToast({
          title: '请填写完整信息',
          icon: 'none'
        })
        return
      }

      this.isSubmitting = true

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        // 获取当前最大的number值
        const maxNumber = this.healthIds.length > 0 
          ? Math.max(...this.healthIds.map(id => parseInt(id))) + 1 
          : 1

        const result = await uni.request({
          url: 'http://localhost:8080/health/addHealthInfo',
          method: 'POST',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken,
            'Content-Type': 'application/json'
          },
          data: {
            elderId: this.selectedElderId,
            report: this.healthForm.report,
            healthSuggestion: this.healthForm.healthSuggestion,
            number: maxNumber.toString()
          }
        })

        const response = result.data as ApiResponse
        if (response.code === 1) {
          uni.showToast({
            title: '上传成功',
            icon: 'success'
          })
          this.closeHealthModal()
          // 刷新健康数据
          this.fetchHealthData()
        } else {
          uni.showToast({
            title: response.msg || '上传失败',
            icon: 'none'
          })
        }
      } catch (error) {
        console.error('上传健康信息失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      } finally {
        this.isSubmitting = false
      }
    },
    // AI咨询按钮拖拽逻辑
    loadBtnPosition() {
      try {
        const position = uni.getStorageSync('aiConsultBtnPosition')
        if (position) {
          const pos = JSON.parse(position) as Position
          this.btnPosition = pos
        } else {
          // 设置默认位置 (页面右下角)
          const systemInfo = uni.getSystemInfoSync()
          this.btnPosition = {
            left: systemInfo.windowWidth - 140,
            top: systemInfo.windowHeight - 220
          }
        }
      } catch (error) {
        console.error('获取按钮位置失败:', error)
        const systemInfo = uni.getSystemInfoSync()
        this.btnPosition = {
          left: systemInfo.windowWidth - 140,
          top: systemInfo.windowHeight - 220
        }
      }
    },
    startMoveBtn(e: any) {
      this.isMoving = true
      uni.showToast({
        title: '按住拖动',
        icon: 'none',
        duration: 1000
      })
    },
    moveBtn(e: any) {
      if (!this.isMoving) return
      
      // 阻止事件冒泡和默认行为
      e.stopPropagation()
      e.preventDefault()
      
      // 更新按钮位置
      const touch = e.touches[0]
      this.btnPosition.left = touch.clientX - 50 // 按钮宽度的一半
      this.btnPosition.top = touch.clientY - 50 // 按钮高度的一半
    },
    endMoveBtn() {
      if (!this.isMoving) return
      
      this.isMoving = false
      
      // 将按钮位置持久化存储
      try {
        uni.setStorageSync('aiConsultBtnPosition', JSON.stringify(this.btnPosition))
        uni.showToast({
          title: '位置已保存',
          icon: 'success',
          duration: 1000
        })
      } catch (error) {
        console.error('保存按钮位置失败:', error)
      }
    },
    goToAiConsult() {
      // 在按钮可拖动状态下，不执行页面跳转
      if (this.isMoving) return
      
      // 跳转至AI咨询页面
      uni.navigateTo({
        url: '/pages/children/ai-consult',
        success: () => {
          console.log('成功跳转至AI咨询页面')
        },
        fail: (err) => {
          console.error('跳转失败:', err)
          uni.showToast({
            title: '跳转失败',
            icon: 'none'
          })
        }
      })
    }
  }
}
</script>

<style>
.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  height: 88rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

.header-left {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  flex-shrink: 0;
}

.header-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  flex-shrink: 0;
}

.header-right {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  flex-shrink: 0;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  margin: 0;
}

.header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: auto;
}

.dropdown {
  flex-shrink: 0;
}

.picker-content {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  backdrop-filter: blur(10rpx);
}

.picker-text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
}

.down-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) invert(1);
}

.content {
  padding: 30rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  position: relative;
  height: 80rpx;
  margin-bottom: 30rpx;
}

.date-picker {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.section-title {
  position: absolute;
  left: 50%;
  top:5px;
  transform: translateX(-50%);
  font-size: 15px;
  font-weight: bold;
  color: #2d3748;
  white-space: nowrap;
}

.btn-upload {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(79, 209, 197, 0.3);
}

.section-content {
  min-height: 160rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.empty-tip {
  color: #a0aec0;
  font-size: 26rpx;
}

.record-list {
  width: 100%;
  padding: 10rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E8E8E8;
}

.record-item:last-child {
  border-bottom: none;
}

.record-time {
  font-size: 28rpx;
  color: #7AB8B3;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.record-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.Bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  border-top: 1rpx solid #edf2f7;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 24rpx;
  color: #a0aec0;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #319795;
}

.tab-item.active .tab-icon {
  filter: hue-rotate(180deg) saturate(1.5);
}

.time-picker {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  background-color: #f0f9f8;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #319795;
  border: 1rpx solid #e6fffa;
}

.meal-swiper {
  width: 100%;
  height: 400rpx;
}

.meal-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.meal-label {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  max-width: 80%;
}

.meal-time {
  font-size: 24rpx;
  font-weight: bold;
}

.meal-description {
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.clothing-image {
  width: 100%;
  height: 550rpx;
  border-radius: 12rpx;
}

.living-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

.health-info {
  width: 100%;
  padding: 20rpx;
}

.health-item {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.health-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.health-value {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}

.banner-swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 30rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  padding: 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background-color: #007AFF;
  color: #fff;
}

.modal-btn.confirm:disabled {
  background-color: #ccc;
}

/* AI咨询按钮样式 */
.ai-btn {
  position: fixed;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(49, 151, 149, 0.5);
  z-index: 99;
}

.ai-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 4rpx;
}

.ai-text {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.moving-tip {
  position: absolute;
  white-space: nowrap;
  font-size: 20rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  top: -40rpx;
  transform: translateX(-50%);
  left: 50%;
}
</style>