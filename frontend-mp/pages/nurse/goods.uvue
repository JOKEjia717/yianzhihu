<template>
  <view class="page">
    <!-- 顶部标题栏 -->
    <view class="header">
      <view class="title-switch">
        <text 
          class="title-item"
          @click="switchMode"
        >{{ currentMode === 'items' ? '物品管理' : '物流管理' }}</text>
        <image class="switch-icon" src="/static/images/switch.png" mode="aspectFit"></image>
      </view>
      <view class="dropdown">
        <picker 
          :range="elderNames" 
          @change="handleElderChange" 
          :value="currentElderIndex"
        >
          <view class="picker-content">
            <text class="picker-text">{{ elderNames[currentElderIndex] || '选择老人' }}</text>
            <image class="down-icon" src="/static/images/down.png" mode="aspectFit"></image>
          </view>
        </picker>
      </view>
    </view>
    
    <!-- 切换提示 -->
    <view class="switch-tip">
      <image class="tip-icon" src="/static/images/tap.png" mode="aspectFit"></image>
      <text class="tip-text">点击标题可切换{{ currentMode === 'items' ? '物流' : '物品' }}管理</text>
    </view>

    <!-- 主要内容区域 -->
    <view class="content">
      <!-- 物品列表 -->
      <view v-if="currentMode === 'items'">
        <view v-if="items.length > 0" class="items-list">
          <view v-for="item in items" :key="item.personalItemId" class="item-card">
            <view class="item-image">
              <image 
                v-if="item.photo" 
                :src="item.photo" 
                mode="aspectFill" 
                class="item-photo"
              ></image>
              <view v-else class="no-photo">
                <text class="no-photo-text">暂无图片</text>
              </view>
            </view>
            <view class="item-info">
              <view class="item-header">
                <text class="item-name">{{ item.itemName }}</text>
                <view :class="['status-tag', getStatusClass(item.status)]">
                  {{ getStatusText(item.status) }}
                </view>
              </view>
              <view class="item-details">
                <view class="detail-row">
                  <text class="detail-label">最后检查：</text>
                  <text class="detail-value">{{ item.lastCheck }}</text>
                </view>
                <view class="detail-row">
                  <text class="detail-label">备注：</text>
                  <text class="detail-value">{{ item.notes || '无' }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view v-else class="empty-state">
          <text class="empty-text">暂无物品记录</text>
        </view>
      </view>

      <!-- 物流列表 -->
      <view v-if="currentMode === 'logistics'">
        <view v-if="logistics.length > 0" class="logistics-list">
          <view v-for="logistic in logistics" :key="logistic.logisticsId" class="logistic-card">
            <view class="logistic-header">
              <text class="logistic-company">{{ logistic.logisticsCompany }}</text>
              <text class="logistic-time">{{ formatTime(logistic.createTime) }}</text>
            </view>
            <view class="logistic-info">
              <view class="info-row">
                <text class="info-label">联系人：</text>
                <text class="info-value">{{ logistic.contact }}</text>
              </view>
              <view class="info-row">
                <text class="info-label">联系电话：</text>
                <text class="info-value">{{ logistic.mobile }}</text>
              </view>
              <view class="info-row">
                <text class="info-label">收货地址：</text>
                <text class="info-value">{{ logistic.address || '暂无地址信息' }}</text>
              </view>
            </view>
          </view>
        </view>
        <view v-else class="empty-state">
          <text class="empty-text">暂无物流记录</text>
        </view>
      </view>
    </view>
    
    <!-- 添加底部导航栏 -->
    <nurse-tabbar current-path="/pages/nurse/goods"></nurse-tabbar>
  </view>
</template>

<script lang="uts">
// 引入导航栏组件
import NurseTabbar from '../../components/nurse-tabbar.uvue'

interface Elder {
  elderId: string
  caretakerId: string
  name: string
  gender: number
  age: number
  childrenName: string
  childrenPhone: string
  applicationTime: string
  createdTime: string
  photo: string
  childrenId: number
  isEnable: number
}

interface PersonalItem {
  personalItemId: number
  photo: string | null
  elderId: number
  itemName: string
  status: number
  lastCheck: string
  notes: string
}

interface ApiResponse {
  code: number
  msg: string | null
  data: Elder[] | PersonalItem[]
}

interface Logistics {
  orderId: string
  logisticsId: string
  logisticsCompany: string
  contact: string
  mobile: string
  address: string | null
  createTime: string
  updateTime: string
  childrenId: string
  elderId: string
}

export default {
  components: {
    NurseTabbar
  },
  data() {
    return {
      elders: [] as Elder[],
      elderNames: [] as string[],
      currentElderIndex: 0,
      selectedElderId: '',
      items: [] as PersonalItem[],
      logistics: [] as Logistics[],
      currentMode: 'items' as string
    }
  },
  onLoad() {
    this.fetchElders()
  },
  methods: {
    async fetchElders() {
      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')
        
        if (!accessToken || !refreshToken) {
          uni.showToast({
            title: '请先登录',
            icon: 'none'
          })
          uni.redirectTo({
            url: '/pages/nurse/login'
          })
          return
        }

        uni.showLoading({
          title: '加载中...'
        })

        const result = await uni.request({
          url: 'http://localhost:8080/elder/elders',
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        uni.hideLoading()

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.elders = response.data as Elder[]
          this.elderNames = this.elders.map(elder => elder.name)
          
          if (this.elders.length > 0) {
            this.selectedElderId = this.elders[0].elderId
            this.fetchItems()
          }
        } else {
          uni.showToast({
            title: '获取数据失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('请求失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    async fetchItems() {
      if (!this.selectedElderId) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        uni.showLoading({
          title: '加载中...'
        })

        const result = await uni.request({
          url: `http://localhost:8080/personal-item/items/${this.selectedElderId}`,
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          }
        })

        uni.hideLoading()

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.items = response.data as PersonalItem[]
        } else {
          this.items = []
          uni.showToast({
            title: '获取物品列表失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('获取物品列表失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    handleElderChange(e: any) {
      this.currentElderIndex = parseInt(e.detail.value)
      if (this.elders[this.currentElderIndex]) {
        this.selectedElderId = this.elders[this.currentElderIndex].elderId
        if (this.currentMode === 'items') {
          this.fetchItems()
        } else {
          this.fetchLogistics()
        }
      }
    },
    getStatusText(status: number): string {
      switch (status) {
        case 0:
          return '正常'
        case 1:
          return '损坏'
        case 2:
          return '丢失'
        case 3:
          return '已报废'
        default:
          return '未知'
      }
    },
    getStatusClass(status: number): string {
      switch (status) {
        case 0:
          return 'status-pending'
        case 1:
          return 'status-normal'
        case 2:
          return 'status-repairing'
        case 3:
          return 'status-scrapped'
        default:
          return 'status-unknown'
      }
    },
    switchTab(url: string) {
      uni.switchTab({
        url,
        fail: (err) => {
          console.error('切换标签页失败:', err)
          uni.showToast({
            title: '页面跳转失败',
            icon: 'none'
          })
        }
      })
    },
    async fetchLogistics() {
      if (!this.selectedElderId) return

      try {
        const accessToken = uni.getStorageSync('accessToken')
        const refreshToken = uni.getStorageSync('refreshToken')

        uni.showLoading({
          title: '加载中...'
        })

        const result = await uni.request({
          url: `http://localhost:8080/goods/order/logistics`,
          method: 'GET',
          header: {
            'accessToken': accessToken,
            'refreshToken': refreshToken
          },
          data: {
            elderId: this.selectedElderId
          }
        })

        uni.hideLoading()

        const response = result.data as ApiResponse
        if (response.code === 1 && response.data) {
          this.logistics = response.data as Logistics[]
        } else {
          this.logistics = []
          uni.showToast({
            title: '获取物流信息失败',
            icon: 'none'
          })
        }
      } catch (error) {
        uni.hideLoading()
        console.error('获取物流信息失败:', error)
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        })
      }
    },
    switchMode() {
      this.currentMode = this.currentMode === 'items' ? 'logistics' : 'items'
      if (this.currentMode === 'logistics') {
        this.fetchLogistics()
      } else {
        this.fetchItems()
      }
    },
    formatTime(time: string): string {
      if (!time) return ''
      const date = new Date(time)
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')} ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
    }
  }
}
</script>

<style>
