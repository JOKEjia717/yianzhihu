  background: linear-gradient(135deg, #4FD1C5 0%, #319795 100%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  height: 88rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

