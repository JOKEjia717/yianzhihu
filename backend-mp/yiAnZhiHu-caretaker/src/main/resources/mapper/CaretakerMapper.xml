<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zhihu.mapper.CaretakerMapper">

    <select id="findCaretakerByPage" resultType="com.zhihu.po.Caretaker">
        SELECT * FROM `zh-caretaker`.`caretaker` <!-- 修改点1：用反引号包裹带连字符的数据库名 -->
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%',#{name},'%') <!-- 修改点2：条件前加AND -->
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%',#{phone},'%') <!-- 修改点2：条件前加AND -->
            </if>
            <if test="specialty != null and specialty != ''">
                AND specialty LIKE CONCAT('%',#{specialty},'%') <!-- 修改点2：条件前加AND -->
            </if>
        </where>
        LIMIT #{page},#{size}
    </select>

    <select id="findCaretakerCount" resultType="long">
        SELECT COUNT(1) FROM `zh-caretaker`.`caretaker` <!-- 修改点1：同样处理count查询 -->
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="address != null and address != ''">
                AND address LIKE CONCAT('%',#{address},'%')
            </if>
        </where>
    </select>

    <update id="updateCaretakerSelective">
        UPDATE caretaker
        <set>
            <if test="filePath != null and filePath != ''">
                avatar = #{filePath},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="specialty != null and specialty != ''">
                specialty = #{specialty},
            </if>
        </set>
        WHERE caretaker_id = #{caretakerId}
    </update>
</mapper>